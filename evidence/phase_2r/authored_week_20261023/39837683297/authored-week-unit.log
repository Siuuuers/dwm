arkers": [{ "marker_id": "Day2.result.A.next", "label": "Day2.result.A.next", "after_line_id": "line.Day2.result.A.031", "kind": "scene.transition", "payload": { "target_id": "target.Day3" } }] }, { "entry_id": "Day2.result.B", "content_version": 1, "content_sha256": "3b051abf1f2bc7ed4ac3c62947ede08b882118ff3a4d8731d8333d45d8f53602", "program_sha256": "de3856721978de4d0d2a5e5f0f88c52cd198fbdb4dd6ad027bbf509cff36f7a6", "markers": [{ "marker_id": "Day2.result.B.next", "label": "Day2.result.B.next", "after_line_id": "line.Day2.result.B.018", "kind": "scene.transition", "payload": { "target_id": "target.Day3" } }] }, { "entry_id": "Day2.result.C", "content_version": 1, "content_sha256": "3b051abf1f2bc7ed4ac3c62947ede08b882118ff3a4d8731d8333d45d8f53602", "program_sha256": "75506622dc789631fb346e91fff5b3fa4fa5c698ffd80b42d97a161a738dac53", "markers": [{ "marker_id": "Day2.result.C.next", "label": "Day2.result.C.next", "after_line_id": "line.Day2.result.C.042", "kind": "scene.transition", "payload": { "target_id": "target.Day3" } }] }, { "entry_id": "Day2.result.D", "content_version": 1, "content_sha256": "3b051abf1f2bc7ed4ac3c62947ede08b882118ff3a4d8731d8333d45d8f53602", "program_sha256": "d4117087b4fce8a2c6c9814c5bc41aae2492fce77232cd08a9a327619985660f", "markers": [{ "marker_id": "Day2.result.D.thought", "label": "Day2.result.D.thought", "after_line_id": "line.Day2.result.D.048", "kind": "thought.options", "payload": { "opportunity_id": "Day2.threshold", "options": [{ "choice_id": "stay", "text": "Go back to the table and ask her to stay.", "target_id": "target.Day2.threshold.stay" }, { "choice_id": "cruel", "text": "Ask her again while her hand is in my hair.", "target_id": "target.Day2.threshold.cruel" }], "pass_target_id": "target.Day2.threshold.benchmark" } }] }, { "entry_id": "Day2.result.E", "content_version": 1, "content_sha256": "3b051abf1f2bc7ed4ac3c62947ede08b882118ff3a4d8731d8333d45d8f53602", "program_sha256": "ac9120efbc180066da3c3f41ef54a784b0a8e88f0494c8d9