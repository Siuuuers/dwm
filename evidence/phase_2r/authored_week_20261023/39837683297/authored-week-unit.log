_id": "line.ending.alone.normal.019", "owning_entry_id": "ending.alone.normal" }, { "line_id": "line.ending.alone.normal.020", "owning_entry_id": "ending.alone.normal" }, { "line_id": "line.ending.alone.normal.021", "owning_entry_id": "ending.alone.normal" }, { "line_id": "line.ending.alone.normal.022", "owning_entry_id": "ending.alone.normal" }], "signals": [{ "signal_id": "challenge.end", "payload_fields": ["challenge_id"] }, { "signal_id": "challenge.playable", "payload_fields": ["challenge_id"] }, { "signal_id": "challenge.recall", "payload_fields": ["challenge_id", "never_started_target_id", "unfinished_target_id", "won_target_id", "lost_target_id", "perfect_target_id"] }, { "signal_id": "history.line.witness", "payload_fields": ["entry_id", "line_id", "playback_token", "receipt_id"] }, { "signal_id": "scene.transition", "payload_fields": ["target_id"] }, { "signal_id": "thought.options", "payload_fields": ["opportunity_id", "options", "pass_target_id"] }, { "signal_id": "thought.pass", "payload_fields": ["opportunity_id", "yes_target_id", "pass_target_id"] }] }, "caption_registry": { "kind": "scene_caption_registry", "schema_version": 1, "entries": [{ "entry_id": "Day1", "lines": [{ "beat_id": "beat.line.Day1.one", "line_id": "line.Day1.one", "text": "Sylvia slides the fuller teacup onto my mat and keeps the one with the small chip on the rim for herself.", "revision": "1" }, { "beat_id": "beat.line.Day1.002", "line_id": "line.Day1.002", "text": "“The tables by the door are in a draught,” she says. “You always complain about your throat when you sit under the vent.”", "revision": "1" }, { "beat_id": "beat.line.Day1.003", "line_id": "line.Day1.003", "text": "“And the window light happens to be behind your chair.”", "revision": "1" }, { "beat_id": "beat.line.Day1.004", "line_id": "line.Day1.004", "text": "“Someone had to face the glare.”", "revision": "1" }, { "beat_id": "beat.line.Day1.005", "line_id": "line.Day1.005", "text": "She holds her phone out at arm\'s length, then lowers it half an inch without taking the shot.", "revision": "1" }, { "beat_id": "beat.line.Day1.006", "line_id": "line.Day1.006", "text": "“Wait. Your left collar is turned under,” she says. “Don\'t move.”", "revision": "1" }, { "beat_id": "beat.line.Day1.007", "line_id": "line.Day1.007", "text": "Her free hand reaches across the corner of the table. Two cool fingers slip beneath the lapel of my blouse, smooth the linen flat against the collarbone, and withdraw before the cloth can warm them.", "revision": "1" }, { "beat_id": "beat.line.Day1.008", "line_id": "line.Day1.008", "text": "The chair legs scrape half an inch closer until both faces fit inside the screen.", "revision": "1" }, { "beat_id": "beat.line.Day1.009", "line_id": "line.Day1.009", "text": "“Not that expression,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day1.010", "line_id": "line.Day1.010", "text": "“It\'s my expression.”", "revision": "1" }, { "beat_id": "beat.line.Day1.011", "line_id": "line.Day1.011", "text": "“It\'s the one you save for university circulars.”", "revision": "1" }, { "beat_id": "beat.line.Day1.012", "line_id": "line.Day1.012", "text": "A slight widening of the mouth.", "revision": "1" }, { "beat_id": "beat.line.Day1.013", "line_id": "line.Day1.013", "text": "“Worse.”", "revision": "1" }, { "beat_id": "beat.line.Day1.014", "line_id": "line.Day1.014", "text": "On the table between the saucers, my own phone sounds.", "revision": "1" }, { "beat_id": "beat.line.Day1.015", "line_id": "line.Day1.015", "text": "Lavinia, message: Try not to look too pleased when you see me tomorrow.", "revision": "1" }, { "beat_id": "beat.line.Day1.016", "line_id": "line.Day1.016", "text": "Eleven words. No greeting, and tomorrow at the end.", "revision": "1" }, { "beat_id": "beat.line.Day1.017", "line_id": "line.Day1.017", "text": "Above the keyboard bar, a small grey line appears: Lavinia is recording an audio message...", "revision": "1" }, { "beat_id": "beat.line.Day1.018", "line_id": "line.Day1.018", "text": "The three dots pulse between the cups for a few seconds, then vanish without sending, leaving the bar blank.", "revision": "1" }, { "beat_id": "beat.line.Day1.019", "line_id": "line.Day1.019", "text": "Sylvia takes the photograph.", "revision": "1" }, { "beat_id": "beat.line.Day1.020", "line_id": "line.Day1.020", "text": "“Oh,” she says, lowering the phone. “You were looking down. Shall I delete that one for you?”", "revision": "1" }, { "beat_id": "beat.line.Day1.021", "line_id": "line.Day1.021", "text": "“Let me see it first.”", "revision": "1" }, { "beat_id": "beat.line.Day1.022", "line_id": "line.Day1.022", "text": "She brings her phone between us. In the picture, the gaze is dropped slightly below the lens—still toward the table where the message lit—while Sylvia has caught herself watching the side of my face.", "revision": "1" }, { "beat_id": "beat.line.Day1.023", "line_id": "line.Day1.023", "text": "“Who was it?”", "revision": "1" }, { "beat_id": "beat.line.Day1.024", "line_id": "line.Day1.024", "text": "“Lavinia.”", "revision": "1" }, { "beat_id": "beat.line.Day1.025", "line_id": "line.Day1.025", "text": "“I should have asked her to help earlier.”", "revision": "1" }, { "beat_id": "beat.line.Day1.026", "line_id": "line.Day1.026", "text": "Two fingers spread across the glass to enlarge the picture. Sylvia leans against my arm to see what is being inspected.", "revision": "1" }, { "beat_id": "beat.line.Day1.027", "line_id": "line.Day1.027", "text": "“Don\'t inspect it that closely.”", "revision": "1" }, { "beat_id": "beat.line.Day1.028", "line_id": "line.Day1.028", "text": "“I like it.”", "revision": "1" }, { "beat_id": "beat.line.Day1.029", "line_id": "line.Day1.029", "text": "“That isn\'t usually why you zoom in.”", "revision": "1" }, { "beat_id": "beat.line.Day1.030", "line_id": "line.Day1.030", "text": "Her face in this one, too.", "revision": "1" }, { "beat_id": "beat.line.Day1.031", "line_id": "line.Day1.031", "text": "Ask for another photograph.", "revision": "1" }] }, { "entry_id": "Day1.coda", "lines": [{ "beat_id": "beat.line.Day1.coda.001", "line_id": "line.Day1.coda.001", "text": "A zip runs close to Lavinia\'s microphone.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.002", "line_id": "line.Day1.coda.002", "text": "“Hold on.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.003", "line_id": "line.Day1.coda.003", "text": "Something scrapes. She breathes out sharply.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.004", "line_id": "line.Day1.coda.004", "text": "“Too much?” I ask.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.005", "line_id": "line.Day1.coda.005", "text": "“For the case.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.006", "line_id": "line.Day1.coda.006", "text": "“Take something out.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.007", "line_id": "line.Day1.coda.007", "text": "“I want it.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.008", "line_id": "line.Day1.coda.008", "text": "A corner of the mouth lifts in the quiet room.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.009", "line_id": "line.Day1.coda.009", "text": "She tries the zip again.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.010", "line_id": "line.Day1.coda.010", "text": "“What are you taking?”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.011", "line_id": "line.Day1.coda.011", "text": "“I haven\'t decided what I\'m leaving.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.012", "line_id": "line.Day1.coda.012", "text": "“That\'s going well.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.013", "line_id": "line.Day1.coda.013", "text": "“Very.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.014", "line_id": "line.Day1.coda.014", "text": "For a while the line carries only the sound of her moving things. Once she laughs at something unseen.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.015", "line_id": "line.Day1.coda.015", "text": "“What?”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.016", "line_id": "line.Day1.coda.016", "text": "“Nothing.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.017", "line_id": "line.Day1.coda.017", "text": "“That was a laugh.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.018", "line_id": "line.Day1.coda.018", "text": "“Yes.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.019", "line_id": "line.Day1.coda.019", "text": "Silence waits for her to continue.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.020", "line_id": "line.Day1.coda.020", "text": "“You\'ll see tomorrow,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.021", "line_id": "line.Day1.coda.021", "text": "After a moment, the zip closes.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.022", "line_id": "line.Day1.coda.022", "text": "“There.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.023", "line_id": "line.Day1.coda.023", "text": "The chair turns back toward the desk.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.024", "line_id": "line.Day1.coda.024", "text": "“Stay on the call.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.025", "line_id": "line.Day1.coda.025", "text": "“I\'ve finished.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.026", "line_id": "line.Day1.coda.026", "text": "“I know.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.027", "line_id": "line.Day1.coda.027", "text": "A faint knock comes through the phone.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.028", "line_id": "line.Day1.coda.028", "text": "“Priscilla.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.029", "line_id": "line.Day1.coda.029", "text": "“Yes?”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.030", "line_id": "line.Day1.coda.030", "text": "“You don\'t have to stay.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.031", "line_id": "line.Day1.coda.031", "text": "“Would you like me to go?”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.032", "line_id": "line.Day1.coda.032", "text": "“I asked if you wanted to.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.033", "line_id": "line.Day1.coda.033", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.034", "line_id": "line.Day1.coda.034", "text": "“All right.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.035", "line_id": "line.Day1.coda.035", "text": "The phone comes a little closer to the chin; something brushes against the microphone.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.036", "line_id": "line.Day1.coda.036", "text": "“Put it down,” Lavinia says. “I can hear you moving it.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.037", "line_id": "line.Day1.coda.037", "text": "It settles flat beside the lamp.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.038", "line_id": "line.Day1.coda.038", "text": "“Like that?”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.039", "line_id": "line.Day1.coda.039", "text": "“Yes.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.040", "line_id": "line.Day1.coda.040", "text": "The desk is lit in a small circle; the rest of the room is dark.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.041", "line_id": "line.Day1.coda.041", "text": "“Don\'t hang up when I stop talking,” Lavinia says.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.042", "line_id": "line.Day1.coda.042", "text": "“I wasn\'t going to.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.043", "line_id": "line.Day1.coda.043", "text": "She asks what was so funny about the book.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.044", "line_id": "line.Day1.coda.044", "text": "“She keeps stopping her own funeral.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.045", "line_id": "line.Day1.coda.045", "text": "“Is she dead?”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.046", "line_id": "line.Day1.coda.046", "text": "“She\'s practising.”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.047", "line_id": "line.Day1.coda.047", "text": "Into the quiet room, in the aunt\'s voice: “‘Again. You sound relieved.’”", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.048", "line_id": "line.Day1.coda.048", "text": "The laugh comes through the phone, then a rustle.", "revision": "1" }, { "beat_id": "beat.line.Day1.coda.049", "line_id": "line.Day1.coda.049", "text": "When she becomes quiet, the phone stays where it is.", "revision": "1" }] }, { "entry_id": "Day1.photo.default", "lines": [{ "beat_id": "beat.line.Day1.photo.default.001", "line_id": "line.Day1.photo.default.001", "text": "“Send it to me.”", "revision": "1" }, { "beat_id": "beat.line.Day1.photo.default.002", "line_id": "line.Day1.photo.default.002", "text": "“Without making me take six more?”", "revision": "1" }, { "beat_id": "beat.line.Day1.photo.default.003", "line_id": "line.Day1.photo.default.003", "text": "“Before you change your mind.”", "revision": "1" }, { "beat_id": "beat.line.Day1.photo.default.004", "line_id": "line.Day1.photo.default.004", "text": "Sylvia sends the photograph, then checks it once herself.", "revision": "1" }, { "beat_id": "beat.line.Day1.photo.default.005", "line_id": "line.Day1.photo.default.005", "text": "“You can have one more later. If necessary.”", "revision": "1" }] }, { "entry_id": "Day1.photo.yes", "lines": [{ "beat_id": "beat.line.Day1.photo.yes.001", "line_id": "line.Day1.photo.yes.001", "text": "“Wait. One more.”", "revision": "1" }, { "beat_id": "beat.line.Day1.photo.yes.002", "line_id": "line.Day1.photo.yes.002", "text": "“We have a good one.”", "revision": "1" }, { "beat_id": "beat.line.Day1.photo.yes.003", "line_id": "line.Day1.photo.yes.003", "text": "“You aren\'t looking at the camera.”", "revision": "1" }, { "beat_id": "beat.line.Day1.photo.yes.004", "line_id": "line.Day1.photo.yes.004", "text": "“I was supervising.”", "revision": "1" }, { "beat_id": "beat.line.Day1.photo.yes.005", "line_id": "line.Day1.photo.yes.005", "text": "The chair pulls closer; this time the eyes stay on the screen instead of my phone.", "revision": "1" }, { "beat_id": "beat.line.Day1.photo.yes.006", "line_id": "line.Day1.photo.yes.006", "text": "Sylvia tries to arrange her mouth, looks across the screen, and laughs before she takes the picture.", "revision": "1" }, { "beat_id": "beat.line.Day1.photo.yes.007", "line_id": "line.Day1.photo.yes.007", "text": "“Now you aren\'t looking at the camera either,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day1.photo.yes.008", "line_id": "line.Day1.photo.yes.008", "text": "“Send me both.”", "revision": "1" }, { "beat_id": "beat.line.Day1.photo.yes.009", "line_id": "line.Day1.photo.yes.009", "text": "She does.", "revision": "1" }] }, { "entry_id": "Day1.reading", "lines": [{ "beat_id": "beat.line.Day1.reading.001", "line_id": "line.Day1.reading.001", "text": "Sylvia puts her phone away and moves her chair to the other side of the table.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.002", "line_id": "line.Day1.reading.002", "text": "The paperback beneath Sylvia\'s bag has a bent cover. She smooths it with her palm.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.003", "line_id": "line.Day1.reading.003", "text": "The Funeral Rehearsal.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.004", "line_id": "line.Day1.reading.004", "text": "“She insists on attending,” Sylvia says.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.005", "line_id": "line.Day1.reading.005", "text": "“Her own?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.006", "line_id": "line.Day1.reading.006", "text": "“Listen.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.007", "line_id": "line.Day1.reading.007", "text": "She opens it near the beginning.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.008", "line_id": "line.Day1.reading.008", "text": "“‘The eulogy was excellent. She asked whether it could be about her.’”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.009", "line_id": "line.Day1.reading.009", "text": "A laugh escapes before the cup reaches the saucer. Sylvia\'s finger stays beneath the sentence.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.010", "line_id": "line.Day1.reading.010", "text": "“I read that standing in the shop.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.011", "line_id": "line.Day1.reading.011", "text": "“You bought a whole novel for one line?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.012", "line_id": "line.Day1.reading.012", "text": "“I wanted to know what she\'d object to next.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.013", "line_id": "line.Day1.reading.013", "text": "The corner of the next page lifts under her thumb.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.014", "line_id": "line.Day1.reading.014", "text": "Sylvia lowers her voice.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.015", "line_id": "line.Day1.reading.015", "text": "“‘Again,’ said the aunt. ‘You sound relieved.’”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.016", "line_id": "line.Day1.reading.016", "text": "“Is she in the coffin?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.017", "line_id": "line.Day1.reading.017", "text": "“An armchair.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.018", "line_id": "line.Day1.reading.018", "text": "“More convenient for supervising.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.019", "line_id": "line.Day1.reading.019", "text": "Sylvia finds the next speech.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.020", "line_id": "line.Day1.reading.020", "text": "“There\'s a man at the door. He says he\'s come about a carriage.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.021", "line_id": "line.Day1.reading.021", "text": "Sylvia puts one hand against her chest.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.022", "line_id": "line.Day1.reading.022", "text": "“‘My cousin required the carriage.’”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.023", "line_id": "line.Day1.reading.023", "text": "A laugh catches before she has finished the last word.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.024", "line_id": "line.Day1.reading.024", "text": "“What?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.025", "line_id": "line.Day1.reading.025", "text": "“The voice.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.026", "line_id": "line.Day1.reading.026", "text": "“He\'s in love.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.027", "line_id": "line.Day1.reading.027", "text": "“Give me his part.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.028", "line_id": "line.Day1.reading.028", "text": "She turns the book toward me, keeping a finger beneath the line. I read his next speech in the same voice.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.029", "line_id": "line.Day1.reading.029", "text": "Sylvia bends over the table. A moment passes before she can stop laughing.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.030", "line_id": "line.Day1.reading.030", "text": "“Too pleased with himself,” she says. “He thinks this is working.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.031", "line_id": "line.Day1.reading.031", "text": "The line repeats without the flourish on the last word.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.032", "line_id": "line.Day1.reading.032", "text": "“Yes. Like that.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.033", "line_id": "line.Day1.reading.033", "text": "She takes the book back.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.034", "line_id": "line.Day1.reading.034", "text": "For a while, we read in turns. Sylvia gives the aunt the careful, carrying voice of someone repeating a reasonable request. When I try to do her as well, Sylvia kicks the leg of my chair.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.035", "line_id": "line.Day1.reading.035", "text": "“Mine.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.036", "line_id": "line.Day1.reading.036", "text": "“All right.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.037", "line_id": "line.Day1.reading.037", "text": "The aunt again. Before he can finish.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.038", "line_id": "line.Day1.reading.038", "text": "The phone lights up on the table.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.039", "line_id": "line.Day1.reading.039", "text": "Lavinia, message: Are you busy?", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.040", "line_id": "line.Day1.reading.040", "text": "Priscilla, message: Reading with Sylvia.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.041", "line_id": "line.Day1.reading.041", "text": "Lavinia, message: Anything good?", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.042", "line_id": "line.Day1.reading.042", "text": "Priscilla, message: She\'s making it better.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.043", "line_id": "line.Day1.reading.043", "text": "“Should I send it to you?” Sylvia asks.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.044", "line_id": "line.Day1.reading.044", "text": "“What?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.045", "line_id": "line.Day1.reading.045", "text": "“My part. You\'re answering those quite quickly.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.046", "line_id": "line.Day1.reading.046", "text": "The message goes through; the phone returns to the wood.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.047", "line_id": "line.Day1.reading.047", "text": "“Sorry. Where are we?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.048", "line_id": "line.Day1.reading.048", "text": "She puts her finger beneath the line.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.049", "line_id": "line.Day1.reading.049", "text": "One exchange, then another, before a hand stops her at the margin.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.050", "line_id": "line.Day1.reading.050", "text": "“He says the flowers are for the funeral.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.051", "line_id": "line.Day1.reading.051", "text": "“They are now.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.052", "line_id": "line.Day1.reading.052", "text": "“They\'ve got the niece\'s name on them.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.053", "line_id": "line.Day1.reading.053", "text": "“The aunt has taken the ribbon off.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.054", "line_id": "line.Day1.reading.054", "text": "“He could say he wanted to see her.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.055", "line_id": "line.Day1.reading.055", "text": "Sylvia offers the book across the saucers.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.056", "line_id": "line.Day1.reading.056", "text": "“Then say it.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.057", "line_id": "line.Day1.reading.057", "text": "“I wanted to see you.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.058", "line_id": "line.Day1.reading.058", "text": "She looks down at the page; her finger stays still for half a beat.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.059", "line_id": "line.Day1.reading.059", "text": "“Much shorter.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.060", "line_id": "line.Day1.reading.060", "text": "“They could have saved paper.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.061", "line_id": "line.Day1.reading.061", "text": "Sylvia begins the woman\'s answer without the voice. Halfway through, she remembers it, and the place on the page is lost in laughing.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.062", "line_id": "line.Day1.reading.062", "text": "The aunt invites everyone back for another rehearsal.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.063", "line_id": "line.Day1.reading.063", "text": "“‘Tomorrow, do try to look a little less pleased,’” Sylvia reads.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.064", "line_id": "line.Day1.reading.064", "text": "“Let me see.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.065", "line_id": "line.Day1.reading.065", "text": "Sylvia turns the book toward me.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.066", "line_id": "line.Day1.reading.066", "text": "Tomorrow. At the beginning, this time.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.067", "line_id": "line.Day1.reading.067", "text": "“Have you read this part before?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.068", "line_id": "line.Day1.reading.068", "text": "“No. Why?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.069", "line_id": "line.Day1.reading.069", "text": "“Keep going.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.070", "line_id": "line.Day1.reading.070", "text": "She waits. The corner of the page is still between my fingers.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.071", "line_id": "line.Day1.reading.071", "text": "The fingers open; she draws the book back.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.072", "line_id": "line.Day1.reading.072", "text": "The phone lights again.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.073", "line_id": "line.Day1.reading.073", "text": "Sylvia closes the paperback around her finger.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.074", "line_id": "line.Day1.reading.074", "text": "“What does she want?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.075", "line_id": "line.Day1.reading.075", "text": "“She\'s asking whether she\'s interrupting.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.076", "line_id": "line.Day1.reading.076", "text": "“And?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.077", "line_id": "line.Day1.reading.077", "text": "Only a few pages between her finger and the front cover.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.078", "line_id": "line.Day1.reading.078", "text": "“We haven\'t got very far.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.079", "line_id": "line.Day1.reading.079", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.080", "line_id": "line.Day1.reading.080", "text": "Sylvia puts the book down.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.081", "line_id": "line.Day1.reading.081", "text": "“Let me answer her,” she says. “Then you don\'t have to stop.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.082", "line_id": "line.Day1.reading.082", "text": "“What are you going to say?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.083", "line_id": "line.Day1.reading.083", "text": "“I\'ll show you before I send it.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.084", "line_id": "line.Day1.reading.084", "text": "The unlocked phone passes into her hand with the conversation open.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.085", "line_id": "line.Day1.reading.085", "text": "She types, then turns the screen toward me.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.086", "line_id": "line.Day1.reading.086", "text": "Unsent draft on Priscilla\'s phone: You\'re interrupting my date. Sylvia.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.087", "line_id": "line.Day1.reading.087", "text": "“Your date?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.088", "line_id": "line.Day1.reading.088", "text": "“You\'ve stayed. We\'ve taken a photograph. I\'ve read to you.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.089", "line_id": "line.Day1.reading.089", "text": "“Would you like me to leave?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.090", "line_id": "line.Day1.reading.090", "text": "“Not yet.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.091", "line_id": "line.Day1.reading.091", "text": "Her thumb rests below the message. She has not sent it.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.092", "line_id": "line.Day1.reading.092", "text": "Changing date to reading would still be a joke. It would be easier to explain.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.093", "line_id": "line.Day1.reading.093", "text": "“Send it.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.094", "line_id": "line.Day1.reading.094", "text": "Sylvia sends the message and gives the phone back.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.095", "line_id": "line.Day1.reading.095", "text": "It rests beside the drink. Neither hand reaches for the book.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.096", "line_id": "line.Day1.reading.096", "text": "Lavinia, message: Priscilla?", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.097", "line_id": "line.Day1.reading.097", "text": "Sylvia looks across the table.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.098", "line_id": "line.Day1.reading.098", "text": "“You should answer that one.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.099", "line_id": "line.Day1.reading.099", "text": "Two thumbs on the glass:", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.100", "line_id": "line.Day1.reading.100", "text": "Priscilla, message: I said she could send it.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.101", "line_id": "line.Day1.reading.101", "text": "Sent before anything else can follow it.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.102", "line_id": "line.Day1.reading.102", "text": "Sylvia opens the book and reads the first few words. The cue passes without a sound.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.103", "line_id": "line.Day1.reading.103", "text": "Lavinia, message: Then tell me yourself.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.104", "line_id": "line.Day1.reading.104", "text": "Across the table, Sylvia is still holding the page open.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.105", "line_id": "line.Day1.reading.105", "text": "“What did she say?” Sylvia asks.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.106", "line_id": "line.Day1.reading.106", "text": "Lavinia\'s last message is read aloud.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.107", "line_id": "line.Day1.reading.107", "text": "“Well?”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.108", "line_id": "line.Day1.reading.108", "text": "A sip from the cup.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.109", "line_id": "line.Day1.reading.109", "text": "“I\'m thinking.”", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.110", "line_id": "line.Day1.reading.110", "text": "Sylvia shifts the book so that a hand can reach it.", "revision": "1" }, { "beat_id": "beat.line.Day1.reading.111", "line_id": "line.Day1.reading.111", "text": "A voice message.", "revision": "1" }] }, { "entry_id": "Day1.result.A", "lines": [{ "beat_id": "beat.line.Day1.result.A.001", "line_id": "line.Day1.result.A.001", "text": "The message is recorded once.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.002", "line_id": "line.Day1.result.A.002", "text": "Priscilla, sent voice: I\'m having a very good time. I don\'t think I want to leave yet.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.003", "line_id": "line.Day1.result.A.003", "text": "Sylvia watches it go.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.004", "line_id": "line.Day1.result.A.004", "text": "“Was that my review?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.005", "line_id": "line.Day1.result.A.005", "text": "“You can put it on the cover.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.006", "line_id": "line.Day1.result.A.006", "text": "She turns the book over and considers the printed endorsements.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.007", "line_id": "line.Day1.result.A.007", "text": "The reply arrives.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.008", "line_id": "line.Day1.result.A.008", "text": "Lavinia, message: Then I\'ll leave you to it.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.009", "line_id": "line.Day1.result.A.009", "text": "Sylvia finds the page again.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.010", "line_id": "line.Day1.result.A.010", "text": "The phone stays in the hand a little longer.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.011", "line_id": "line.Day1.result.A.011", "text": "No question at the end.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.012", "line_id": "line.Day1.result.A.012", "text": "“Your part,” Sylvia says.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.013", "line_id": "line.Day1.result.A.013", "text": "The first line starts at the wrong row.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.014", "line_id": "line.Day1.result.A.014", "text": "“No. Above that.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.015", "line_id": "line.Day1.result.A.015", "text": "Before the speech is finished, the eyes drop to the phone again.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.016", "line_id": "line.Day1.result.A.016", "text": "Sylvia takes her finger out of the book.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.017", "line_id": "line.Day1.result.A.017", "text": "“Do you want to call her?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.018", "line_id": "line.Day1.result.A.018", "text": "“Why would I?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.019", "line_id": "line.Day1.result.A.019", "text": "“I don\'t know. You tell me.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.020", "line_id": "line.Day1.result.A.020", "text": "The phone goes face down on the wood.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.021", "line_id": "line.Day1.result.A.021", "text": "“One more page?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.022", "line_id": "line.Day1.result.A.022", "text": "Sylvia pushes the book across the table.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.023", "line_id": "line.Day1.result.A.023", "text": "“You read.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.024", "line_id": "line.Day1.result.A.024", "text": "The first sentence comes out too loud; she makes a small downward motion with her hand, and the voice drops back into place.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.025", "line_id": "line.Day1.result.A.025", "text": "At the last line she supplies the aunt\'s voice, almost under her breath.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.026", "line_id": "line.Day1.result.A.026", "text": "A laugh; Sylvia smiles, then closes the book.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.027", "line_id": "line.Day1.result.A.027", "text": "“That will do.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.028", "line_id": "line.Day1.result.A.028", "text": "She puts it in her bag. Outside the café, we walk together as far as the stairs. Sylvia turns there; the corridor ahead continues with the phone in my hand.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.029", "line_id": "line.Day1.result.A.029", "text": "Evening. Alone at the desk when the call goes through to Lavinia. There is no video.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.030", "line_id": "line.Day1.result.A.030", "text": "“Finished?” Lavinia asks.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.031", "line_id": "line.Day1.result.A.031", "text": "“Would I call if I hadn\'t?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.032", "line_id": "line.Day1.result.A.032", "text": "“I thought you were telling me to leave you alone.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.033", "line_id": "line.Day1.result.A.033", "text": "“I wasn\'t.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.A.034", "line_id": "line.Day1.result.A.034", "text": "“Good.”", "revision": "1" }] }, { "entry_id": "Day1.result.B", "lines": [{ "beat_id": "beat.line.Day1.result.B.001", "line_id": "line.Day1.result.B.001", "text": "The voice recorder opens, then closes without recording.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.002", "line_id": "line.Day1.result.B.002", "text": "“Not now.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.003", "line_id": "line.Day1.result.B.003", "text": "Thumbs type instead:", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.004", "line_id": "line.Day1.result.B.004", "text": "Priscilla, message: I\'ll answer you later.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.005", "line_id": "line.Day1.result.B.005", "text": "The phone goes face down on the table.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.006", "line_id": "line.Day1.result.B.006", "text": "Sylvia watches until the hand leaves it.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.007", "line_id": "line.Day1.result.B.007", "text": "“Finished?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.008", "line_id": "line.Day1.result.B.008", "text": "“For now.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.009", "line_id": "line.Day1.result.B.009", "text": "She turns the paperback around.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.010", "line_id": "line.Day1.result.B.010", "text": "“You can be the cousin.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.011", "line_id": "line.Day1.result.B.011", "text": "“Does she have a line, or only a grievance?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.012", "line_id": "line.Day1.result.B.012", "text": "“A whole speech.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.013", "line_id": "line.Day1.result.B.013", "text": "The cousin has brought the wrong eulogy. Sylvia points to its first sentence.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.014", "line_id": "line.Day1.result.B.014", "text": "“‘Beloved father of six,’” I read.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.015", "line_id": "line.Day1.result.B.015", "text": "Sylvia shuts her eyes.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.016", "line_id": "line.Day1.result.B.016", "text": "A laugh breaks the next word.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.017", "line_id": "line.Day1.result.B.017", "text": "“No,” she says. “There\'s an answer.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.018", "line_id": "line.Day1.result.B.018", "text": "Before the sentence can finish, Sylvia supplies the aunt\'s answer:", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.019", "line_id": "line.Day1.result.B.019", "text": "“‘Three,’ she said. ‘And I was their mother.’”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.020", "line_id": "line.Day1.result.B.020", "text": "We read to the end of the chapter. Once, the phone is turned over—no new message—and set down again.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.021", "line_id": "line.Day1.result.B.021", "text": "When Sylvia begins looking for the next chapter, a fingertip touches the edge of the page.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.022", "line_id": "line.Day1.result.B.022", "text": "“Shall we stop there?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.023", "line_id": "line.Day1.result.B.023", "text": "She checks the time.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.024", "line_id": "line.Day1.result.B.024", "text": "“We probably should.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.025", "line_id": "line.Day1.result.B.025", "text": "She folds the corner back along its old crease and puts the book in her bag. At the stairs she reminds me that the cousin has my voice now; doing the voice once more sends her down laughing.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.026", "line_id": "line.Day1.result.B.026", "text": "Evening. Alone at the desk when the call goes through to Lavinia. There is no video.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.027", "line_id": "line.Day1.result.B.027", "text": "“Later,” Lavinia says.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.028", "line_id": "line.Day1.result.B.028", "text": "“I said I\'d answer.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.029", "line_id": "line.Day1.result.B.029", "text": "“You did.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.030", "line_id": "line.Day1.result.B.030", "text": "“It was a good afternoon.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.031", "line_id": "line.Day1.result.B.031", "text": "“That took you a while.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.032", "line_id": "line.Day1.result.B.032", "text": "“I wanted to call.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.B.033", "line_id": "line.Day1.result.B.033", "text": "“All right. Talk to me.”", "revision": "1" }] }, { "entry_id": "Day1.result.C", "lines": [{ "beat_id": "beat.line.Day1.result.C.001", "line_id": "line.Day1.result.C.001", "text": "The phone moves closer.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.002", "line_id": "line.Day1.result.C.002", "text": "Priscilla, recording: I\'m enjoying my afternoon. I\'m also looking forward to seeing you tomorrow.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.003", "line_id": "line.Day1.result.C.003", "text": "The recording plays back once; the small breath between the sentences stays in place, and then it goes through.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.004", "line_id": "line.Day1.result.C.004", "text": "Sylvia waits.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.005", "line_id": "line.Day1.result.C.005", "text": "“Finished?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.006", "line_id": "line.Day1.result.C.006", "text": "“Yes.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.007", "line_id": "line.Day1.result.C.007", "text": "The book returns to the middle of the table.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.008", "line_id": "line.Day1.result.C.008", "text": "The reply comes before the place is found.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.009", "line_id": "line.Day1.result.C.009", "text": "Lavinia, message: Tomorrow, then. Finish your date.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.010", "line_id": "line.Day1.result.C.010", "text": "The phone goes face down.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.011", "line_id": "line.Day1.result.C.011", "text": "“What did she say?” Sylvia asks.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.012", "line_id": "line.Day1.result.C.012", "text": "“To finish.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.013", "line_id": "line.Day1.result.C.013", "text": "“Very sensible.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.014", "line_id": "line.Day1.result.C.014", "text": "Sylvia gives back the man\'s part. The man has been asked to read the eulogy.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.015", "line_id": "line.Day1.result.C.015", "text": "“With the flowers still in her lap?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.016", "line_id": "line.Day1.result.C.016", "text": "“Apparently.” Sylvia turns the page. “Wait. I want to hear this.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.017", "line_id": "line.Day1.result.C.017", "text": "She reaches across to point out a sentence and knocks the spoon onto the saucer; my hand moves the cup so that she can leave her wrist on the page.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.018", "line_id": "line.Day1.result.C.018", "text": "I missed this line before.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.019", "line_id": "line.Day1.result.C.019", "text": "“‘Her absence,’ I read, ‘will leave a silence—’”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.020", "line_id": "line.Day1.result.C.020", "text": "“‘Louder,’ said the aunt.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.021", "line_id": "line.Day1.result.C.021", "text": "We continue until Sylvia puts the book down of her own accord.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.022", "line_id": "line.Day1.result.C.022", "text": "“Enough?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.023", "line_id": "line.Day1.result.C.023", "text": "“One more.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.024", "line_id": "line.Day1.result.C.024", "text": "“One.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.025", "line_id": "line.Day1.result.C.025", "text": "She reads the woman\'s answer; my eyes stay on her until she has finished. At the stairs, Sylvia puts the paperback in her bag and says the man\'s voice is ruined for her now.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.026", "line_id": "line.Day1.result.C.026", "text": "“You can do him differently.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.027", "line_id": "line.Day1.result.C.027", "text": "“I don\'t want to now.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.028", "line_id": "line.Day1.result.C.028", "text": "She goes down before an answer can follow.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.029", "line_id": "line.Day1.result.C.029", "text": "Evening. Alone at the desk when the call goes through to Lavinia. There is no video.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.030", "line_id": "line.Day1.result.C.030", "text": "“You could have waited until tomorrow,” Lavinia says.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.031", "line_id": "line.Day1.result.C.031", "text": "“Would you rather I had?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.C.032", "line_id": "line.Day1.result.C.032", "text": "“No.” The chair tilts back from the desk.", "revision": "1" }] }, { "entry_id": "Day1.result.D", "lines": [{ "beat_id": "beat.line.Day1.result.D.001", "line_id": "line.Day1.result.D.001", "text": "“She wants a voice message.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.002", "line_id": "line.Day1.result.D.002", "text": "“Then use the man\'s voice,” Sylvia says, her finger still inside the paperback. “Tell her your cousin required the carriage.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.003", "line_id": "line.Day1.result.D.003", "text": "“She\'d hang up before the verb.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.004", "line_id": "line.Day1.result.D.004", "text": "“Not if you sound sufficiently tragic.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.005", "line_id": "line.Day1.result.D.005", "text": "The thumb presses the microphone icon on the screen.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.006", "line_id": "line.Day1.result.D.006", "text": "“I\'m having a very good time,” I say into the phone—in the suitor\'s appalling, half-dying voice.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.007", "line_id": "line.Day1.result.D.007", "text": "Across the saucers, Sylvia loses her composure completely. She bends over the book, one hand against her mouth.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.008", "line_id": "line.Day1.result.D.008", "text": "“Stop,” she says through the laugh. “You sound as though you\'re in the coffin. Give it here—‘I\'m having a very good time, and I don\'t think I want to leave yet.’”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.009", "line_id": "line.Day1.result.D.009", "text": "Her voice starts in prim demonstration and breaks into a warm, helpless laugh on the last word.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.010", "line_id": "line.Day1.result.D.010", "text": "The thumb lifts from the glass. The recording sits in the preview bar between our cups.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.011", "line_id": "line.Day1.result.D.011", "text": "Sylvia catches her breath and looks at the lit bar on the screen.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.012", "line_id": "line.Day1.result.D.012", "text": "“You were actually recording that?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.013", "line_id": "line.Day1.result.D.013", "text": "“It hasn\'t gone through.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.014", "line_id": "line.Day1.result.D.014", "text": "“Erase it,” she says, still half-smiling as she reaches for her tea. “We sound ridiculous.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.015", "line_id": "line.Day1.result.D.015", "text": "The preview runs once between the saucers: my absurd first line, the catch of her breath, and then her voice leaning close across the table—I\'m having a very good time, and I don\'t think I want to leave yet.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.016", "line_id": "line.Day1.result.D.016", "text": "She sounds as though she means it.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.017", "line_id": "line.Day1.result.D.017", "text": "The thumb taps Send.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.018", "line_id": "line.Day1.result.D.018", "text": "Sylvia\'s hand stops beside the book.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.019", "line_id": "line.Day1.result.D.019", "text": "“You sent it.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.020", "line_id": "line.Day1.result.D.020", "text": "“You sounded pleased.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.021", "line_id": "line.Day1.result.D.021", "text": "“That wasn\'t for her. I told you to erase it.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.022", "line_id": "line.Day1.result.D.022", "text": "“I heard you.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.023", "line_id": "line.Day1.result.D.023", "text": "Sylvia takes the paperback back to her side of the table. For a moment she holds it closed in both hands.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.024", "line_id": "line.Day1.result.D.024", "text": "“Then why?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.025", "line_id": "line.Day1.result.D.025", "text": "“It sounded better than mine would.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.026", "line_id": "line.Day1.result.D.026", "text": "She puts it in her bag.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.027", "line_id": "line.Day1.result.D.027", "text": "“Give me a moment,” I say.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.028", "line_id": "line.Day1.result.D.028", "text": "“You\'ve had one.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.029", "line_id": "line.Day1.result.D.029", "text": "She stands. Her chair catches against the table leg; she pulls it free without looking down, while my hand moves the cup out of her way.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.030", "line_id": "line.Day1.result.D.030", "text": "The phone lights on the table.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.031", "line_id": "line.Day1.result.D.031", "text": "Lavinia, message: Call me when you\'re alone.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.032", "line_id": "line.Day1.result.D.032", "text": "Sylvia looks once at the table, takes her own phone, and says, “Enjoy your call.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.033", "line_id": "line.Day1.result.D.033", "text": "Through the doorway, she has already passed out of sight.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.034", "line_id": "line.Day1.result.D.034", "text": "I can do that now.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.035", "line_id": "line.Day1.result.D.035", "text": "Still, the chair stays where it is long enough for the screen to go dark.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.036", "line_id": "line.Day1.result.D.036", "text": "Evening. Alone at the desk when the call goes through to Lavinia. There is no video.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.037", "line_id": "line.Day1.result.D.037", "text": "“You\'re alone?” Lavinia asks.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.038", "line_id": "line.Day1.result.D.038", "text": "“Yes.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.D.039", "line_id": "line.Day1.result.D.039", "text": "“Good.”", "revision": "1" }] }, { "entry_id": "Day1.result.E", "lines": [{ "beat_id": "beat.line.Day1.result.E.001", "line_id": "line.Day1.result.E.001", "text": "The phone moves closer.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.002", "line_id": "line.Day1.result.E.002", "text": "Priscilla, recording: I\'m enjoying my afternoon. I\'m also looking forward to seeing you tomorrow.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.003", "line_id": "line.Day1.result.E.003", "text": "The recording plays back once; the small breath between the sentences stays in place, and then it goes through.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.004", "line_id": "line.Day1.result.E.004", "text": "Sylvia waits.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.005", "line_id": "line.Day1.result.E.005", "text": "“Finished?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.006", "line_id": "line.Day1.result.E.006", "text": "“Yes.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.007", "line_id": "line.Day1.result.E.007", "text": "The book returns to the middle of the table.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.008", "line_id": "line.Day1.result.E.008", "text": "The reply comes before the place is found.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.009", "line_id": "line.Day1.result.E.009", "text": "Lavinia, message: Tomorrow, then. Finish your date.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.010", "line_id": "line.Day1.result.E.010", "text": "The phone goes face down.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.011", "line_id": "line.Day1.result.E.011", "text": "Someone is listening. I know it without knowing where to look.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.012", "line_id": "line.Day1.result.E.012", "text": "You can wait.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.013", "line_id": "line.Day1.result.E.013", "text": "“What did she say?” Sylvia asks.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.014", "line_id": "line.Day1.result.E.014", "text": "“To finish.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.015", "line_id": "line.Day1.result.E.015", "text": "“Very sensible.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.016", "line_id": "line.Day1.result.E.016", "text": "Sylvia gives back the man\'s part. The man has been asked to read the eulogy.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.017", "line_id": "line.Day1.result.E.017", "text": "“With the flowers still in her lap?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.018", "line_id": "line.Day1.result.E.018", "text": "“Apparently.” Sylvia turns the page. “Wait. I want to hear this.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.019", "line_id": "line.Day1.result.E.019", "text": "She reaches across to point out a sentence and knocks the spoon onto the saucer; my hand moves the cup so that she can leave her wrist on the page.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.020", "line_id": "line.Day1.result.E.020", "text": "I missed this line before.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.021", "line_id": "line.Day1.result.E.021", "text": "“‘Her absence,’ I read, ‘will leave a silence—’”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.022", "line_id": "line.Day1.result.E.022", "text": "“‘Louder,’ said the aunt.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.023", "line_id": "line.Day1.result.E.023", "text": "We continue until Sylvia puts the book down of her own accord.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.024", "line_id": "line.Day1.result.E.024", "text": "“Enough?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.025", "line_id": "line.Day1.result.E.025", "text": "“One more.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.026", "line_id": "line.Day1.result.E.026", "text": "“One.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.027", "line_id": "line.Day1.result.E.027", "text": "She reads the woman\'s answer; my eyes stay on her until she has finished. At the stairs, Sylvia puts the paperback in her bag and says the man\'s voice is ruined for her now.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.028", "line_id": "line.Day1.result.E.028", "text": "“You can do him differently.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.029", "line_id": "line.Day1.result.E.029", "text": "“I don\'t want to now.”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.030", "line_id": "line.Day1.result.E.030", "text": "She goes down before an answer can follow.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.031", "line_id": "line.Day1.result.E.031", "text": "Evening. Alone at the desk when the call goes through to Lavinia. There is no video.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.032", "line_id": "line.Day1.result.E.032", "text": "“You could have waited until tomorrow,” Lavinia says.", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.033", "line_id": "line.Day1.result.E.033", "text": "“Would you rather I had?”", "revision": "1" }, { "beat_id": "beat.line.Day1.result.E.034", "line_id": "line.Day1.result.E.034", "text": "“No.” The chair tilts back from the desk.", "revision": "1" }] }, { "entry_id": "Day2", "lines": [{ "beat_id": "beat.line.Day2.one", "line_id": "line.Day2.one", "text": "Lavinia closes the door on the music from the bar. Her coat goes over the back of the chair.", "revision": "1" }, { "beat_id": "beat.line.Day2.002", "line_id": "line.Day2.002", "text": "She sits at the corner of the table, close enough that one menu will do.", "revision": "1" }, { "beat_id": "beat.line.Day2.003", "line_id": "line.Day2.003", "text": "Her fingers brush the cuff of my right sleeve before she opens the card.", "revision": "1" }, { "beat_id": "beat.line.Day2.004", "line_id": "line.Day2.004", "text": "“Still damp.”", "revision": "1" }, { "beat_id": "beat.line.Day2.005", "line_id": "line.Day2.005", "text": "“A little.”", "revision": "1" }, { "beat_id": "beat.line.Day2.006", "line_id": "line.Day2.006", "text": "“You should have taken your coat off.”", "revision": "1" }, { "beat_id": "beat.line.Day2.007", "line_id": "line.Day2.007", "text": "“I\'m fine.”", "revision": "1" }, { "beat_id": "beat.line.Day2.008", "line_id": "line.Day2.008", "text": "She looks down at the menu.", "revision": "1" }, { "beat_id": "beat.line.Day2.009", "line_id": "line.Day2.009", "text": "“I thought you were only staying for a drink.”", "revision": "1" }, { "beat_id": "beat.line.Day2.010", "line_id": "line.Day2.010", "text": "“Have you eaten?”", "revision": "1" }, { "beat_id": "beat.line.Day2.011", "line_id": "line.Day2.011", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day2.012", "line_id": "line.Day2.012", "text": "“Then choose something.”", "revision": "1" }, { "beat_id": "beat.line.Day2.013", "line_id": "line.Day2.013", "text": "“Do you want dinner?”", "revision": "1" }, { "beat_id": "beat.line.Day2.014", "line_id": "line.Day2.014", "text": "“I was hoping to.”", "revision": "1" }, { "beat_id": "beat.line.Day2.015", "line_id": "line.Day2.015", "text": "“The mushroom tart.”", "revision": "1" }, { "beat_id": "beat.line.Day2.016", "line_id": "line.Day2.016", "text": "Lavinia turns the page.", "revision": "1" }, { "beat_id": "beat.line.Day2.017", "line_id": "line.Day2.017", "text": "“Or the chicken.”", "revision": "1" }, { "beat_id": "beat.line.Day2.018", "line_id": "line.Day2.018", "text": "The page comes back. Her finger finds the tart again.", "revision": "1" }, { "beat_id": "beat.line.Day2.019", "line_id": "line.Day2.019", "text": "“I\'ll have the chicken.”", "revision": "1" }, { "beat_id": "beat.line.Day2.020", "line_id": "line.Day2.020", "text": "“You don\'t have to.”", "revision": "1" }, { "beat_id": "beat.line.Day2.021", "line_id": "line.Day2.021", "text": "“I want to try it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.022", "line_id": "line.Day2.022", "text": "“So do I.”", "revision": "1" }, { "beat_id": "beat.line.Day2.023", "line_id": "line.Day2.023", "text": "“I noticed.”", "revision": "1" }, { "beat_id": "beat.line.Day2.024", "line_id": "line.Day2.024", "text": "After we order, she rests her elbows on the table.", "revision": "1" }, { "beat_id": "beat.line.Day2.025", "line_id": "line.Day2.025", "text": "“You can relax.”", "revision": "1" }, { "beat_id": "beat.line.Day2.026", "line_id": "line.Day2.026", "text": "The shoulders settle against the chair. A little farther down; the edge of the table rises toward the chin.", "revision": "1" }, { "beat_id": "beat.line.Day2.027", "line_id": "line.Day2.027", "text": "“Not that much.”", "revision": "1" }, { "beat_id": "beat.line.Day2.028", "line_id": "line.Day2.028", "text": "“You\'re difficult to please.”", "revision": "1" }, { "beat_id": "beat.line.Day2.029", "line_id": "line.Day2.029", "text": "“You haven\'t tried very hard.”", "revision": "1" }, { "beat_id": "beat.line.Day2.030", "line_id": "line.Day2.030", "text": "Another inch. The chair creaks.", "revision": "1" }, { "beat_id": "beat.line.Day2.031", "line_id": "line.Day2.031", "text": "Lavinia laughs and catches my wrist.", "revision": "1" }, { "beat_id": "beat.line.Day2.032", "line_id": "line.Day2.032", "text": "“Come back.”", "revision": "1" }, { "beat_id": "beat.line.Day2.033", "line_id": "line.Day2.033", "text": "I sit up. Her fingers remain around the wrist until the food arrives.", "revision": "1" }, { "beat_id": "beat.line.Day2.034", "line_id": "line.Day2.034", "text": "For a while, we eat. She pushes her plate toward me.", "revision": "1" }, { "beat_id": "beat.line.Day2.035", "line_id": "line.Day2.035", "text": "“Try that.”", "revision": "1" }, { "beat_id": "beat.line.Day2.036", "line_id": "line.Day2.036", "text": "I could ask her to feed me.", "revision": "1" }] }, { "entry_id": "Day2.answer", "lines": [{ "beat_id": "beat.line.Day2.answer.001", "line_id": "line.Day2.answer.001", "text": "Her elbow stays on the corner of the wood.", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.002", "line_id": "line.Day2.answer.002", "text": "“What?” I ask.", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.003", "line_id": "line.Day2.answer.003", "text": "“I told you yesterday not to look too pleased.”", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.004", "line_id": "line.Day2.answer.004", "text": "“This is my ordinary face.”", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.005", "line_id": "line.Day2.answer.005", "text": "“It isn\'t.”", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.006", "line_id": "line.Day2.answer.006", "text": "Her thumb touches the corner of my mouth, takes a flake of pastry from the skin, and returns to her glass.", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.007", "line_id": "line.Day2.answer.007", "text": "“I could take you out tomorrow.”", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.008", "line_id": "line.Day2.answer.008", "text": "“You could let me finish this.”", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.009", "line_id": "line.Day2.answer.009", "text": "“The day after, then.”", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.010", "line_id": "line.Day2.answer.010", "text": "Lavinia puts her fork down.", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.011", "line_id": "line.Day2.answer.011", "text": "“Who had all this while I was away?”", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.012", "line_id": "line.Day2.answer.012", "text": "“You aren\'t away now.”", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.013", "line_id": "line.Day2.answer.013", "text": "Her hand opens between the plates. I put mine into it.", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.014", "line_id": "line.Day2.answer.014", "text": "The thumb passes over one knuckle, then rests.", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.015", "line_id": "line.Day2.answer.015", "text": "“Did you want me to stay?”", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.016", "line_id": "line.Day2.answer.016", "text": "“You are staying.”", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.017", "line_id": "line.Day2.answer.017", "text": "“Before I went.”", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.018", "line_id": "line.Day2.answer.018", "text": "The edge of the plate against my wrist. Her hand still open beneath mine.", "revision": "1" }, { "beat_id": "beat.line.Day2.answer.019", "line_id": "line.Day2.answer.019", "text": "I could tell her I wanted her to stay.", "revision": "1" }] }, { "entry_id": "Day2.food.default", "lines": [{ "beat_id": "beat.line.Day2.food.default.001", "line_id": "line.Day2.food.default.001", "text": "“I should have ordered yours.”", "revision": "1" }, { "beat_id": "beat.line.Day2.food.default.002", "line_id": "line.Day2.food.default.002", "text": "“You\'re eating it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.food.default.003", "line_id": "line.Day2.food.default.003", "text": "I take another piece before she draws the plate back.", "revision": "1" }, { "beat_id": "beat.line.Day2.food.default.004", "line_id": "line.Day2.food.default.004", "text": "“Some of it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.food.default.005", "line_id": "line.Day2.food.default.005", "text": "She leaves it between us.", "revision": "1" }] }, { "entry_id": "Day2.food.yes", "lines": [{ "beat_id": "beat.line.Day2.food.yes.001", "line_id": "line.Day2.food.yes.001", "text": "“Give me a bite.”", "revision": "1" }, { "beat_id": "beat.line.Day2.food.yes.002", "line_id": "line.Day2.food.yes.002", "text": "“You have a fork.”", "revision": "1" }, { "beat_id": "beat.line.Day2.food.yes.003", "line_id": "line.Day2.food.yes.003", "text": "“I know.”", "revision": "1" }, { "beat_id": "beat.line.Day2.food.yes.004", "line_id": "line.Day2.food.yes.004", "text": "Lavinia cuts a smaller piece from the tart.", "revision": "1" }, { "beat_id": "beat.line.Day2.food.yes.005", "line_id": "line.Day2.food.yes.005", "text": "“Come here, then.”", "revision": "1" }, { "beat_id": "beat.line.Day2.food.yes.006", "line_id": "line.Day2.food.yes.006", "text": "I lean forward. She holds the fork still.", "revision": "1" }, { "beat_id": "beat.line.Day2.food.yes.007", "line_id": "line.Day2.food.yes.007", "text": "“Careful. It\'s hot.”", "revision": "1" }, { "beat_id": "beat.line.Day2.food.yes.008", "line_id": "line.Day2.food.yes.008", "text": "When I sit back, she pushes the plate into the space between us.", "revision": "1" }, { "beat_id": "beat.line.Day2.food.yes.009", "line_id": "line.Day2.food.yes.009", "text": "“Now eat your own.”", "revision": "1" }] }, { "entry_id": "Day2.result.A", "lines": [{ "beat_id": "beat.line.Day2.result.A.001", "line_id": "line.Day2.result.A.001", "text": "“Of course I did.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.002", "line_id": "line.Day2.result.A.002", "text": "“Then why do I have to ask?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.003", "line_id": "line.Day2.result.A.003", "text": "“I wanted you here, Lavinia.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.004", "line_id": "line.Day2.result.A.004", "text": "Her thumb passes over the knuckle once more.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.005", "line_id": "line.Day2.result.A.005", "text": "“I asked you to check the English.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.006", "line_id": "line.Day2.result.A.006", "text": "“You\'d left a line out.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.007", "line_id": "line.Day2.result.A.007", "text": "The hand slips out from under mine.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.008", "line_id": "line.Day2.result.A.008", "text": "“I\'m not giving you anything else to send.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.009", "line_id": "line.Day2.result.A.009", "text": "“I could still look at it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.010", "line_id": "line.Day2.result.A.010", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.011", "line_id": "line.Day2.result.A.011", "text": "“The wording wasn\'t—”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.012", "line_id": "line.Day2.result.A.012", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.013", "line_id": "line.Day2.result.A.013", "text": "I pick up my glass. She waits until I put it down.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.014", "line_id": "line.Day2.result.A.014", "text": "“All right.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.015", "line_id": "line.Day2.result.A.015", "text": "Lavinia returns to her food. For a while there is only the cutlery and the music through the door.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.016", "line_id": "line.Day2.result.A.016", "text": "I push my plate toward her.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.017", "line_id": "line.Day2.result.A.017", "text": "“Was that the last piece?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.018", "line_id": "line.Day2.result.A.018", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.019", "line_id": "line.Day2.result.A.019", "text": "She takes it.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.020", "line_id": "line.Day2.result.A.020", "text": "When she has finished, she puts her fork down beside the knife.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.021", "line_id": "line.Day2.result.A.021", "text": "“I should go.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.022", "line_id": "line.Day2.result.A.022", "text": "“I could walk with you.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.023", "line_id": "line.Day2.result.A.023", "text": "“I want to go on my own.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.024", "line_id": "line.Day2.result.A.024", "text": "I draw my chair in so she can get past.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.025", "line_id": "line.Day2.result.A.025", "text": "At the door she stops to put on her coat.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.026", "line_id": "line.Day2.result.A.026", "text": "“Tell me when you get home.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.027", "line_id": "line.Day2.result.A.027", "text": "“No. You\'ll ask whether I\'m going to bed.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.028", "line_id": "line.Day2.result.A.028", "text": "“Will you be?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.029", "line_id": "line.Day2.result.A.029", "text": "“There.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.030", "line_id": "line.Day2.result.A.030", "text": "She opens the door before I can answer.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.A.031", "line_id": "line.Day2.result.A.031", "text": "At my desk, I open the conversation. Good night. I add her name and send it. The lamp is still on when I put the phone down.", "revision": "1" }] }, { "entry_id": "Day2.result.B", "lines": [{ "beat_id": "beat.line.Day2.result.B.001", "line_id": "line.Day2.result.B.001", "text": "“I don\'t want to start that tonight.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.002", "line_id": "line.Day2.result.B.002", "text": "“I\'m asking about you.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.003", "line_id": "line.Day2.result.B.003", "text": "“I know.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.004", "line_id": "line.Day2.result.B.004", "text": "Her hand stays open beneath mine.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.005", "line_id": "line.Day2.result.B.005", "text": "“Then?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.006", "line_id": "line.Day2.result.B.006", "text": "I turn my hand over and set it beside the plate.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.007", "line_id": "line.Day2.result.B.007", "text": "Lavinia folds her fingers into her palm.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.008", "line_id": "line.Day2.result.B.008", "text": "The edge of the menu has gone soft where it touches the wet glass.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.009", "line_id": "line.Day2.result.B.009", "text": "“Stay until we\'ve finished eating.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.010", "line_id": "line.Day2.result.B.010", "text": "Lavinia draws her plate toward her.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.011", "line_id": "line.Day2.result.B.011", "text": "She eats the last piece without offering it. I take a drink.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.012", "line_id": "line.Day2.result.B.012", "text": "When I put the glass down, she has her coat over her arm.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.013", "line_id": "line.Day2.result.B.013", "text": "“Lavinia.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.014", "line_id": "line.Day2.result.B.014", "text": "She waits.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.015", "line_id": "line.Day2.result.B.015", "text": "The folded menu is still between the glasses.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.016", "line_id": "line.Day2.result.B.016", "text": "“Nothing.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.017", "line_id": "line.Day2.result.B.017", "text": "She leaves.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.B.018", "line_id": "line.Day2.result.B.018", "text": "The conversation is open at my desk. About what you asked. I leave the words there while I take off my watch. When I pick up the phone again, I remove them and close the conversation.", "revision": "1" }] }, { "entry_id": "Day2.result.C", "lines": [{ "beat_id": "beat.line.Day2.result.C.001", "line_id": "line.Day2.result.C.001", "text": "“Yes. I wanted you here.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.002", "line_id": "line.Day2.result.C.002", "text": "“And you decided I should be.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.003", "line_id": "line.Day2.result.C.003", "text": "“I wanted it to be possible.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.004", "line_id": "line.Day2.result.C.004", "text": "“You knew what I wanted.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.005", "line_id": "line.Day2.result.C.005", "text": "“Yes.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.006", "line_id": "line.Day2.result.C.006", "text": "Lavinia begins to draw her hand away. I open mine.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.007", "line_id": "line.Day2.result.C.007", "text": "She rests her hand beside the plate.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.008", "line_id": "line.Day2.result.C.008", "text": "“I\'m not giving you anything else to send.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.009", "line_id": "line.Day2.result.C.009", "text": "“All right.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.010", "line_id": "line.Day2.result.C.010", "text": "“You\'d still want to change it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.011", "line_id": "line.Day2.result.C.011", "text": "“Probably.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.012", "line_id": "line.Day2.result.C.012", "text": "“Priscilla.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.013", "line_id": "line.Day2.result.C.013", "text": "“I\'m not asking for it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.014", "line_id": "line.Day2.result.C.014", "text": "She turns her glass. I wait until she has taken a drink.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.015", "line_id": "line.Day2.result.C.015", "text": "Lavinia reaches behind her for the coat.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.016", "line_id": "line.Day2.result.C.016", "text": "“Stay a little longer.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.017", "line_id": "line.Day2.result.C.017", "text": "“Doing what?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.018", "line_id": "line.Day2.result.C.018", "text": "“Having dinner with me.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.019", "line_id": "line.Day2.result.C.019", "text": "“We\'ve been doing that.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.020", "line_id": "line.Day2.result.C.020", "text": "“I like it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.021", "line_id": "line.Day2.result.C.021", "text": "For a moment she holds the glass against her lower lip.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.022", "line_id": "line.Day2.result.C.022", "text": "Then she puts it down.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.023", "line_id": "line.Day2.result.C.023", "text": "“Until we finish.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.024", "line_id": "line.Day2.result.C.024", "text": "Her hand leaves the coat.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.025", "line_id": "line.Day2.result.C.025", "text": "I cut another piece of chicken.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.026", "line_id": "line.Day2.result.C.026", "text": "Lavinia watches the knife come down again.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.027", "line_id": "line.Day2.result.C.027", "text": "“That\'s small enough.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.028", "line_id": "line.Day2.result.C.028", "text": "“Is it?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.029", "line_id": "line.Day2.result.C.029", "text": "“Eat it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.030", "line_id": "line.Day2.result.C.030", "text": "I do. She moves her chair closer to reach my plate and takes the other piece.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.031", "line_id": "line.Day2.result.C.031", "text": "For a while, neither of us says anything.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.032", "line_id": "line.Day2.result.C.032", "text": "When the plates are empty, she reaches for her coat. I stay in my chair.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.033", "line_id": "line.Day2.result.C.033", "text": "“Tell me when you get home.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.034", "line_id": "line.Day2.result.C.034", "text": "“I will.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.035", "line_id": "line.Day2.result.C.035", "text": "She rests her hand on my shoulder while she puts her coat on. I turn toward it.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.036", "line_id": "line.Day2.result.C.036", "text": "The pressure lifts.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.037", "line_id": "line.Day2.result.C.037", "text": "“Good night, Priscilla.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.038", "line_id": "line.Day2.result.C.038", "text": "“Good night.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.039", "line_id": "line.Day2.result.C.039", "text": "At my desk, the phone lights.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.040", "line_id": "line.Day2.result.C.040", "text": "Lavinia, message: Home.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.041", "line_id": "line.Day2.result.C.041", "text": "Priscilla, message: Good night, Lavinia.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.C.042", "line_id": "line.Day2.result.C.042", "text": "I leave the conversation open while I turn off the lamp.", "revision": "1" }] }, { "entry_id": "Day2.result.D", "lines": [{ "beat_id": "beat.line.Day2.result.D.001", "line_id": "line.Day2.result.D.001", "text": "“Did you want me to stay?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.002", "line_id": "line.Day2.result.D.002", "text": "“Yes.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.003", "line_id": "line.Day2.result.D.003", "text": "Her thumb does not move.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.004", "line_id": "line.Day2.result.D.004", "text": "“I wanted you here.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.005", "line_id": "line.Day2.result.D.005", "text": "“I asked you to check the English.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.006", "line_id": "line.Day2.result.D.006", "text": "“You\'d left a line out.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.007", "line_id": "line.Day2.result.D.007", "text": "“On purpose.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.008", "line_id": "line.Day2.result.D.008", "text": "“I know.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.009", "line_id": "line.Day2.result.D.009", "text": "Lavinia takes her hand away.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.010", "line_id": "line.Day2.result.D.010", "text": "“Would you do it again?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.011", "line_id": "line.Day2.result.D.011", "text": "“I\'d show you first.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.012", "line_id": "line.Day2.result.D.012", "text": "“And if I told you not to send it?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.013", "line_id": "line.Day2.result.D.013", "text": "“Then I wouldn\'t send it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.014", "line_id": "line.Day2.result.D.014", "text": "“You mean that?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.015", "line_id": "line.Day2.result.D.015", "text": "“If you don\'t want me to.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.016", "line_id": "line.Day2.result.D.016", "text": "She turns the glass by its stem. A wet crescent remains on the table.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.017", "line_id": "line.Day2.result.D.017", "text": "“You\'d find something else.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.018", "line_id": "line.Day2.result.D.018", "text": "“You wouldn\'t have stopped on your own.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.019", "line_id": "line.Day2.result.D.019", "text": "“To keep me here.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.020", "line_id": "line.Day2.result.D.020", "text": "“That too.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.021", "line_id": "line.Day2.result.D.021", "text": "The glass stops.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.022", "line_id": "line.Day2.result.D.022", "text": "“Is that supposed to make me feel better?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.023", "line_id": "line.Day2.result.D.023", "text": "“You asked me.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.024", "line_id": "line.Day2.result.D.024", "text": "Lavinia gets up. She takes the coat from her chair and folds it over her arm.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.025", "line_id": "line.Day2.result.D.025", "text": "“I\'ll do it differently.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.026", "line_id": "line.Day2.result.D.026", "text": "“You\'re still talking about doing it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.027", "line_id": "line.Day2.result.D.027", "text": "“I\'d rather not have to.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.028", "line_id": "line.Day2.result.D.028", "text": "Her palm strikes my cheek.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.029", "line_id": "line.Day2.result.D.029", "text": "The hand is down again, open beside the coat.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.030", "line_id": "line.Day2.result.D.030", "text": "The cheek burns beneath my palm. Lavinia\'s eyes stay on my mouth.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.031", "line_id": "line.Day2.result.D.031", "text": "“Why are you smiling?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.032", "line_id": "line.Day2.result.D.032", "text": "Not indifferent, then.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.033", "line_id": "line.Day2.result.D.033", "text": "“I didn\'t know you were so angry.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.034", "line_id": "line.Day2.result.D.034", "text": "“Well, now you do.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.035", "line_id": "line.Day2.result.D.035", "text": "She turns toward the door.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.036", "line_id": "line.Day2.result.D.036", "text": "“Sit down.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.037", "line_id": "line.Day2.result.D.037", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.038", "line_id": "line.Day2.result.D.038", "text": "“We can stop arguing.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.039", "line_id": "line.Day2.result.D.039", "text": "“I\'m going.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.040", "line_id": "line.Day2.result.D.040", "text": "I stand in the gap between the table and the door.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.041", "line_id": "line.Day2.result.D.041", "text": "“Move.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.042", "line_id": "line.Day2.result.D.042", "text": "“Just give me a minute.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.043", "line_id": "line.Day2.result.D.043", "text": "“I have.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.044", "line_id": "line.Day2.result.D.044", "text": "The handle is behind my wrist.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.045", "line_id": "line.Day2.result.D.045", "text": "“I\'m not angry with you.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.046", "line_id": "line.Day2.result.D.046", "text": "“That isn\'t what I asked.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.047", "line_id": "line.Day2.result.D.047", "text": "I step away.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.D.048", "line_id": "line.Day2.result.D.048", "text": "Stay beside the door and wait for her hand.", "revision": "1" }] }, { "entry_id": "Day2.result.E", "lines": [{ "beat_id": "beat.line.Day2.result.E.001", "line_id": "line.Day2.result.E.001", "text": "“Yes. I wanted you here.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.002", "line_id": "line.Day2.result.E.002", "text": "Someone else is listening.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.003", "line_id": "line.Day2.result.E.003", "text": "“And you decided I should be.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.004", "line_id": "line.Day2.result.E.004", "text": "“I wanted it to be possible.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.005", "line_id": "line.Day2.result.E.005", "text": "“You knew what I wanted.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.006", "line_id": "line.Day2.result.E.006", "text": "“Yes.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.007", "line_id": "line.Day2.result.E.007", "text": "Lavinia begins to draw her hand away. I open mine.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.008", "line_id": "line.Day2.result.E.008", "text": "She rests her hand beside the plate.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.009", "line_id": "line.Day2.result.E.009", "text": "“I\'m not giving you anything else to send.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.010", "line_id": "line.Day2.result.E.010", "text": "“All right.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.011", "line_id": "line.Day2.result.E.011", "text": "“You\'d still want to change it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.012", "line_id": "line.Day2.result.E.012", "text": "“Probably.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.013", "line_id": "line.Day2.result.E.013", "text": "“Priscilla.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.014", "line_id": "line.Day2.result.E.014", "text": "“I\'m not asking for it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.015", "line_id": "line.Day2.result.E.015", "text": "She turns her glass. I wait until she has taken a drink.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.016", "line_id": "line.Day2.result.E.016", "text": "Lavinia reaches behind her for the coat.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.017", "line_id": "line.Day2.result.E.017", "text": "“Stay a little longer.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.018", "line_id": "line.Day2.result.E.018", "text": "“Doing what?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.019", "line_id": "line.Day2.result.E.019", "text": "“Having dinner with me.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.020", "line_id": "line.Day2.result.E.020", "text": "“We\'ve been doing that.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.021", "line_id": "line.Day2.result.E.021", "text": "“I like it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.022", "line_id": "line.Day2.result.E.022", "text": "For a moment she holds the glass against her lower lip.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.023", "line_id": "line.Day2.result.E.023", "text": "Then she puts it down.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.024", "line_id": "line.Day2.result.E.024", "text": "“Until we finish.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.025", "line_id": "line.Day2.result.E.025", "text": "Her hand leaves the coat.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.026", "line_id": "line.Day2.result.E.026", "text": "I cut another piece of chicken.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.027", "line_id": "line.Day2.result.E.027", "text": "Lavinia watches the knife come down again.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.028", "line_id": "line.Day2.result.E.028", "text": "“That\'s small enough.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.029", "line_id": "line.Day2.result.E.029", "text": "“Is it?”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.030", "line_id": "line.Day2.result.E.030", "text": "“Eat it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.031", "line_id": "line.Day2.result.E.031", "text": "I do. She moves her chair closer to reach my plate and takes the other piece.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.032", "line_id": "line.Day2.result.E.032", "text": "For a while, neither of us says anything.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.033", "line_id": "line.Day2.result.E.033", "text": "When the plates are empty, she reaches for her coat. I stay in my chair.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.034", "line_id": "line.Day2.result.E.034", "text": "“Tell me when you get home.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.035", "line_id": "line.Day2.result.E.035", "text": "“I will.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.036", "line_id": "line.Day2.result.E.036", "text": "She rests her hand on my shoulder while she puts her coat on. I turn toward it.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.037", "line_id": "line.Day2.result.E.037", "text": "The pressure lifts.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.038", "line_id": "line.Day2.result.E.038", "text": "“Good night, Priscilla.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.039", "line_id": "line.Day2.result.E.039", "text": "“Good night.”", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.040", "line_id": "line.Day2.result.E.040", "text": "At my desk, the phone lights.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.041", "line_id": "line.Day2.result.E.041", "text": "Lavinia, message: Home.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.042", "line_id": "line.Day2.result.E.042", "text": "Priscilla, message: Good night, Lavinia.", "revision": "1" }, { "beat_id": "beat.line.Day2.result.E.043", "line_id": "line.Day2.result.E.043", "text": "I leave the conversation open while I turn off the lamp.", "revision": "1" }] }, { "entry_id": "Day2.threshold.benchmark", "lines": [{ "beat_id": "beat.line.Day2.threshold.benchmark.001", "line_id": "line.Day2.threshold.benchmark.001", "text": "She does not immediately pass. Her hand comes up again.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.002", "line_id": "line.Day2.threshold.benchmark.002", "text": "I draw back.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.003", "line_id": "line.Day2.threshold.benchmark.003", "text": "The hand stops.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.004", "line_id": "line.Day2.threshold.benchmark.004", "text": "Then I lower my own and tip my head a little toward it.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.005", "line_id": "line.Day2.threshold.benchmark.005", "text": "Her fingers smooth the hair away from my forehead.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.006", "line_id": "line.Day2.threshold.benchmark.006", "text": "“There.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.007", "line_id": "line.Day2.threshold.benchmark.007", "text": "“Sit with me.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.008", "line_id": "line.Day2.threshold.benchmark.008", "text": "Her hand moves once more through my hair.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.009", "line_id": "line.Day2.threshold.benchmark.009", "text": "Then it falls away.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.010", "line_id": "line.Day2.threshold.benchmark.010", "text": "“I\'m still leaving.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.011", "line_id": "line.Day2.threshold.benchmark.011", "text": "“Then why did you do that?”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.012", "line_id": "line.Day2.threshold.benchmark.012", "text": "Lavinia does not answer. She puts on her coat.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.013", "line_id": "line.Day2.threshold.benchmark.013", "text": "Her chair is still pulled out. I turn toward the table.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.014", "line_id": "line.Day2.threshold.benchmark.014", "text": "The door opens behind me.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.015", "line_id": "line.Day2.threshold.benchmark.015", "text": "“Lavinia.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.016", "line_id": "line.Day2.threshold.benchmark.016", "text": "She remains in the doorway.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.017", "line_id": "line.Day2.threshold.benchmark.017", "text": "“Tell me when you get home.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.018", "line_id": "line.Day2.threshold.benchmark.018", "text": "“All right.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.019", "line_id": "line.Day2.threshold.benchmark.019", "text": "Then she leaves.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.020", "line_id": "line.Day2.threshold.benchmark.020", "text": "At my desk, the phone lights.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.021", "line_id": "line.Day2.threshold.benchmark.021", "text": "Lavinia, message: Home.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.022", "line_id": "line.Day2.threshold.benchmark.022", "text": "I open the conversation. Thank you for telling me. I read it, then remove it.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.023", "line_id": "line.Day2.threshold.benchmark.023", "text": "Priscilla, message: Good night, Lavinia.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.benchmark.024", "line_id": "line.Day2.threshold.benchmark.024", "text": "The message goes through. I turn off the lamp and leave the phone face up.", "revision": "1" }] }, { "entry_id": "Day2.threshold.cruel", "lines": [{ "beat_id": "beat.line.Day2.threshold.cruel.001", "line_id": "line.Day2.threshold.cruel.001", "text": "She does not immediately pass. Her hand comes up again.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.002", "line_id": "line.Day2.threshold.cruel.002", "text": "I draw back.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.003", "line_id": "line.Day2.threshold.cruel.003", "text": "The hand stops.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.004", "line_id": "line.Day2.threshold.cruel.004", "text": "Then I lower my own and tip my head toward it.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.005", "line_id": "line.Day2.threshold.cruel.005", "text": "Her fingers smooth the hair away from my forehead.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.006", "line_id": "line.Day2.threshold.cruel.006", "text": "“Still asking me to stay?”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.007", "line_id": "line.Day2.threshold.cruel.007", "text": "“Yes.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.008", "line_id": "line.Day2.threshold.cruel.008", "text": "Lavinia laughs once. Her fingers keep moving.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.009", "line_id": "line.Day2.threshold.cruel.009", "text": "“You deserved that, Priscilla.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.010", "line_id": "line.Day2.threshold.cruel.010", "text": "“I\'m still asking.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.011", "line_id": "line.Day2.threshold.cruel.011", "text": "Her fingers stop at my temple.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.012", "line_id": "line.Day2.threshold.cruel.012", "text": "A little longer.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.013", "line_id": "line.Day2.threshold.cruel.013", "text": "“Look at me.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.014", "line_id": "line.Day2.threshold.cruel.014", "text": "I turn toward her.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.015", "line_id": "line.Day2.threshold.cruel.015", "text": "The hand falls away.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.016", "line_id": "line.Day2.threshold.cruel.016", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.017", "line_id": "line.Day2.threshold.cruel.017", "text": "She puts on her coat and opens the door.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.018", "line_id": "line.Day2.threshold.cruel.018", "text": "“Lavinia.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.cruel.019", "line_id": "line.Day2.threshold.cruel.019", "text": "The door closes.", "revision": "1" }] }, { "entry_id": "Day2.threshold.stay", "lines": [{ "beat_id": "beat.line.Day2.threshold.stay.001", "line_id": "line.Day2.threshold.stay.001", "text": "The door opens. Music from the bar fills the pause. I go back to my chair.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.002", "line_id": "line.Day2.threshold.stay.002", "text": "Lavinia remains in the doorway.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.003", "line_id": "line.Day2.threshold.stay.003", "text": "“You\'re still smiling.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.004", "line_id": "line.Day2.threshold.stay.004", "text": "“I want you here.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.005", "line_id": "line.Day2.threshold.stay.005", "text": "“You deserved it.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.006", "line_id": "line.Day2.threshold.stay.006", "text": "“I wanted you here before that.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.007", "line_id": "line.Day2.threshold.stay.007", "text": "She puts one arm into her coat. The other sleeve hangs empty.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.008", "line_id": "line.Day2.threshold.stay.008", "text": "Then she closes the door, comes back to the table, and takes it off.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.009", "line_id": "line.Day2.threshold.stay.009", "text": "The coat goes over her chair again. She sits.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.010", "line_id": "line.Day2.threshold.stay.010", "text": "“Come here.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.011", "line_id": "line.Day2.threshold.stay.011", "text": "I draw my chair round the corner.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.012", "line_id": "line.Day2.threshold.stay.012", "text": "Her fingers gather the hair away from my cheek. For a moment, they hold it there.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.013", "line_id": "line.Day2.threshold.stay.013", "text": "I push the chicken toward her.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.014", "line_id": "line.Day2.threshold.stay.014", "text": "“It\'s cold,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.015", "line_id": "line.Day2.threshold.stay.015", "text": "“You were leaving.”", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.016", "line_id": "line.Day2.threshold.stay.016", "text": "She laughs and takes a piece anyway.", "revision": "1" }, { "beat_id": "beat.line.Day2.threshold.stay.017", "line_id": "line.Day2.threshold.stay.017", "text": "My cheek pulls when I smile.", "revision": "1" }] }, { "entry_id": "Day3", "lines": [{ "beat_id": "beat.line.Day3.one", "line_id": "line.Day3.one", "text": "The wool at the right shoulder of the coat has dried overnight, though the outer seam still holds a slight wave from the hanger—the price of letting someone else angle the handle for twenty minutes between the station and the hill.", "revision": "1" }, { "beat_id": "beat.line.Day3.002", "line_id": "line.Day3.002", "text": "Beside the door, the long black umbrella stands closed in the rack: curved wooden handle half an inch taller than the others, ferrule dry.", "revision": "1" }, { "beat_id": "beat.line.Day3.003", "line_id": "line.Day3.003", "text": "On the desk blotter, the screen lights.", "revision": "1" }, { "beat_id": "beat.line.Day3.004", "line_id": "line.Day3.004", "text": "Sylvia: Did you catch a cold yesterday?", "revision": "1" }, { "beat_id": "beat.line.Day3.005", "line_id": "line.Day3.005", "text": "Priscilla: No. Why?", "revision": "1" }, { "beat_id": "beat.line.Day3.006", "line_id": "line.Day3.006", "text": "Sylvia: The right sleeve was soaked through when you passed the library.", "revision": "1" }, { "beat_id": "beat.line.Day3.007", "line_id": "line.Day3.007", "text": "Priscilla: It was only a passing shower. There was an umbrella.", "revision": "1" }, { "beat_id": "beat.line.Day3.008", "line_id": "line.Day3.008", "text": "Three seconds pass before the next line appears—too short for her to have calculated a courtesy, long enough to mean she already knew the answer.", "revision": "1" }, { "beat_id": "beat.line.Day3.009", "line_id": "line.Day3.009", "text": "Sylvia: Yes. You were carrying it.", "revision": "1" }, { "beat_id": "beat.line.Day3.010", "line_id": "line.Day3.010", "text": "Only the right side.", "revision": "1" }, { "beat_id": "beat.line.Day3.011", "line_id": "line.Day3.011", "text": "Knuckles brush the curved wooden handle in the rack on the way to the door.", "revision": "1" }, { "beat_id": "beat.line.Day3.012", "line_id": "line.Day3.012", "text": "Glass doors sliding shut behind the station taxi stand. One black canopy open against the grey drizzle.", "revision": "1" }, { "beat_id": "beat.line.Day3.013", "line_id": "line.Day3.013", "text": "The handle stays in a left hand, tilted three inches toward the dry coat beside it—an ungenerous geometry that leaves half a shoulder outside the rim.", "revision": "1" }, { "beat_id": "beat.line.Day3.014", "line_id": "line.Day3.014", "text": "Rain darkens the outer seam of the right sleeve from shoulder to cuff.", "revision": "1" }, { "beat_id": "beat.line.Day3.015", "line_id": "line.Day3.015", "text": "On the left side, the heavier canvas travel bag swings against the knee at every curb.", "revision": "1" }, { "beat_id": "beat.line.Day3.016", "line_id": "line.Day3.016", "text": "A quick glance toward the wet wool, nothing said, the handle unshifted.", "revision": "1" }, { "beat_id": "beat.line.Day3.017", "line_id": "line.Day3.017", "text": "The corner of the mouth lifts anyway. Warmth stays along the dry left side all the way to the turn.", "revision": "1" }, { "beat_id": "beat.line.Day3.018", "line_id": "line.Day3.018", "text": "In the small back room of the student exhibition, the heavy door swings shut on its hydraulic arm; the rubber strip clicks against the threshold, cutting off the corridor air.", "revision": "1" }, { "beat_id": "beat.line.Day3.019", "line_id": "line.Day3.019", "text": "The room has no outer windows, and the high transom along the inner wall is latched shut—two coats of cream paint sealing the brass catch into its slot so not even a draft from the stairwell can enter. Under the yellow cone of the picture lamp, the dust hangs motionless.", "revision": "1" }, { "beat_id": "beat.line.Day3.020", "line_id": "line.Day3.020", "text": "On the wooden bench in the middle of the room, a folded scrap of paper sits on the empty right-hand seat beside Sylvia\'s hip.", "revision": "1" }, { "beat_id": "beat.line.Day3.021", "line_id": "line.Day3.021", "text": "Taken. Back in a minute.", "revision": "1" }, { "beat_id": "beat.line.Day3.022", "line_id": "line.Day3.022", "text": "The fold is pressed flat with the side of a thumbnail—her usual neat habit of turning a preference into a rule before anyone else can sit down.", "revision": "1" }, { "beat_id": "beat.line.Day3.023", "line_id": "line.Day3.023", "text": "“Did I say a minute?”", "revision": "1" }, { "beat_id": "beat.line.Day3.024", "line_id": "line.Day3.024", "text": "Sylvia looks up from the sketchbook open across her knees and lifts the folded scrap between two fingers.", "revision": "1" }, { "beat_id": "beat.line.Day3.025", "line_id": "line.Day3.025", "text": "“You\'re always late when you come from the library,” she says mildly. “Sit down before someone else takes it.”", "revision": "1" }, { "beat_id": "beat.line.Day3.026", "line_id": "line.Day3.026", "text": "As soon as the space beside her is occupied, she shifts the wool hem of her unbuttoned coat three inches to the right so it covers both laps. From the paper bag beside her thigh, her left hand produces half a peeled mandarin—the white pith already picked clean from the segments, the way she has prepared them since we were twelve—and places it directly into my palm.", "revision": "1" }, { "beat_id": "beat.line.Day3.027", "line_id": "line.Day3.027", "text": "Caught on the rib of her left cardigan cuff, half an inch from the mandarin, clings a tiny grey curl of kneaded rubber—fresh enough that it hasn\'t flattened into the wool, left over from erasing something she wanted off the page before the door opened.", "revision": "1" }, { "beat_id": "beat.line.Day3.028", "line_id": "line.Day3.028", "text": "“Your hands are cold,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day3.029", "line_id": "line.Day3.029", "text": "“It\'s windy on the steps.”", "revision": "1" }, { "beat_id": "beat.line.Day3.030", "line_id": "line.Day3.030", "text": "“Eat that first.”", "revision": "1" }, { "beat_id": "beat.line.Day3.031", "line_id": "line.Day3.031", "text": "The segment is sweet and warm from her fingers. Across the wall in front of us hangs a student painting of a harbour ferry in three shades of grey.", "revision": "1" }, { "beat_id": "beat.line.Day3.032", "line_id": "line.Day3.032", "text": "“He left out the pier,” I say, leaning a shoulder against hers.", "revision": "1" }, { "beat_id": "beat.line.Day3.033", "line_id": "line.Day3.033", "text": "“Perhaps it sank.”", "revision": "1" }, { "beat_id": "beat.line.Day3.034", "line_id": "line.Day3.034", "text": "“Then the passengers are remarkably calm.”", "revision": "1" }, { "beat_id": "beat.line.Day3.035", "line_id": "line.Day3.035", "text": "Sylvia laughs—a soft, unguarded sound that moves through her shoulder into mine. For ten seconds neither of us says anything; she peels another segment for herself, puts one more into my hand without looking, and touches the tip of her pencil to the open sketchbook on her lap.", "revision": "1" }, { "beat_id": "beat.line.Day3.036", "line_id": "line.Day3.036", "text": "Easy. With her, nothing has to be explained first.", "revision": "1" }, { "beat_id": "beat.line.Day3.037", "line_id": "line.Day3.037", "text": "Resting my chin lightly on the wool of her shoulder to see what she is drawing, I look down at the top page of the sketchbook.", "revision": "1" }, { "beat_id": "beat.line.Day3.038", "line_id": "line.Day3.038", "text": "On the upper sheet is a neat, harmless pencil sketch of the bench and the grey ferry frame in front of us. Beside the spine lies another folded slip she was lettering with my borrowed pen: An Improvement / Please do not touch.", "revision": "1" }, { "beat_id": "beat.line.Day3.039", "line_id": "line.Day3.039", "text": "“Another notice?” I murmur against her shoulder.", "revision": "1" }, { "beat_id": "beat.line.Day3.040", "line_id": "line.Day3.040", "text": "“For the corner of the frame.”", "revision": "1" }, { "beat_id": "beat.line.Day3.041", "line_id": "line.Day3.041", "text": "“There\'s rubber dust in the binding. You\'ve been drawing something else underneath.”", "revision": "1" }, { "beat_id": "beat.line.Day3.042", "line_id": "line.Day3.042", "text": "“No, I haven\'t.”", "revision": "1" }, { "beat_id": "beat.line.Day3.043", "line_id": "line.Day3.043", "text": "Above the picture frames, the painted-shut transom has not moved, and the door remains sealed on its rubber strip.", "revision": "1" }, { "beat_id": "beat.line.Day3.044", "line_id": "line.Day3.044", "text": "Even so, a sudden, narrow current of air crosses the bench from left to right—lifting the top sheet of the sketchbook right out from under Sylvia\'s wrist and folding it back against the binding.", "revision": "1" }, { "beat_id": "beat.line.Day3.045", "line_id": "line.Day3.045", "text": "Neither hand touched the paper.", "revision": "1" }, { "beat_id": "beat.line.Day3.046", "line_id": "line.Day3.046", "text": "Beneath the harmless sketch of the bench lies the page she was keeping covered.", "revision": "1" }, { "beat_id": "beat.line.Day3.047", "line_id": "line.Day3.047", "text": "The pencil lines there were not drawn today, and they were not drawn with a steady hand. It is a close study of a woman from the collarbone to the mouth—head tilted back against a bench, collar open at the hollow of the throat, one hand resting across the waist. Whoever drew it returned to the throat and the parted lips six or seven times with soft, dark 4B lead, shading over the pulse point until the paper grain roughened and lifted, and the upper half of the face was rubbed into a dark, unrecognizable blur where the heel of a palm dragged across the graphite.", "revision": "1" }, { "beat_id": "beat.line.Day3.048", "line_id": "line.Day3.048", "text": "On the side of Sylvia\'s right thumb—resting an inch from the page—sits the exact same grey smudge of soft lead.", "revision": "1" }, { "beat_id": "beat.line.Day3.049", "line_id": "line.Day3.049", "text": "My chin is still resting on her shoulder. Neither of us breathes for a full second.", "revision": "1" }, { "beat_id": "beat.line.Day3.050", "line_id": "line.Day3.050", "text": "Too many passes of the lead over the throat. The collar from Monday\'s café—or Lavinia\'s bodice at the barre.", "revision": "1" }, { "beat_id": "beat.line.Day3.051", "line_id": "line.Day3.051", "text": "Sylvia does not slam the sketchbook shut.", "revision": "1" }, { "beat_id": "beat.line.Day3.052", "line_id": "line.Day3.052", "text": "Instead, her left hand comes up, catches my wrist where it rests against her coat, and guides my own hand two inches to the right—placing my palm and cuff directly between the overhead lamp and the open page so my shadow falls straight across the roughened throat on the paper.", "revision": "1" }, { "beat_id": "beat.line.Day3.053", "line_id": "line.Day3.053", "text": "“Hold still,” she says softly.", "revision": "1" }, { "beat_id": "beat.line.Day3.054", "line_id": "line.Day3.054", "text": "“My hand is in your light.”", "revision": "1" }, { "beat_id": "beat.line.Day3.055", "line_id": "line.Day3.055", "text": "“It\'s meant to be.”", "revision": "1" }, { "beat_id": "beat.line.Day3.056", "line_id": "line.Day3.056", "text": "Her thumb slides under the edge of my cuff and presses against the inside of my wrist—directly over the tendon where the pencil shaded through the paper grain, her pulse fast and warm against mine.", "revision": "1" }, { "beat_id": "beat.line.Day3.057", "line_id": "line.Day3.057", "text": "“The paper is nearly worn through at the neck,” I say quietly, not pulling my wrist away. “Who is that meant to be?”", "revision": "1" }, { "beat_id": "beat.line.Day3.058", "line_id": "line.Day3.058", "text": "Against my skin, the pad of her thumb stops moving.", "revision": "1" }, { "beat_id": "beat.line.Day3.059", "line_id": "line.Day3.059", "text": "“It\'s only a figure study from the life class,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day3.060", "line_id": "line.Day3.060", "text": "“You don\'t take the life class.”", "revision": "1" }, { "beat_id": "beat.line.Day3.061", "line_id": "line.Day3.061", "text": "“Someone left the sheet on the bench, then.”", "revision": "1" }, { "beat_id": "beat.line.Day3.062", "line_id": "line.Day3.062", "text": "“It\'s sewn into the binding of your book.”", "revision": "1" }, { "beat_id": "beat.line.Day3.063", "line_id": "line.Day3.063", "text": "Sylvia looks down at the stitched spine without blinking, her voice retaining its mild, orderly decision-science calm.", "revision": "1" }, { "beat_id": "beat.line.Day3.064", "line_id": "line.Day3.064", "text": "“The university stationer must have bound a used sheet into the pad by mistake,” she says. “Their quality control has been slipping since September.”", "revision": "1" }, { "beat_id": "beat.line.Day3.065", "line_id": "line.Day3.065", "text": "“With your 4B lead still on the margin?”", "revision": "1" }, { "beat_id": "beat.line.Day3.066", "line_id": "line.Day3.066", "text": "“I was trying to repair the throat.”", "revision": "1" }, { "beat_id": "beat.line.Day3.067", "line_id": "line.Day3.067", "text": "“By rubbing the face out with your palm?”", "revision": "1" }, { "beat_id": "beat.line.Day3.068", "line_id": "line.Day3.068", "text": "“The proportions were distracting.”", "revision": "1" }, { "beat_id": "beat.line.Day3.069", "line_id": "line.Day3.069", "text": "She withdraws her thumb from my wrist, folds the top sheet neatly back over the drawing, and slides the Please do not touch slip between the pages like a bookmark before closing the cover.", "revision": "1" }, { "beat_id": "beat.line.Day3.070", "line_id": "line.Day3.070", "text": "“You could have asked me plainly,” she says, standing up from the bench.", "revision": "1" }, { "beat_id": "beat.line.Day3.071", "line_id": "line.Day3.071", "text": "“I did ask.”", "revision": "1" }, { "beat_id": "beat.line.Day3.072", "line_id": "line.Day3.072", "text": "“You asked whose neck it was. That isn\'t a plain question.”", "revision": "1" }, { "beat_id": "beat.line.Day3.073", "line_id": "line.Day3.073", "text": "Not an answer, either.", "revision": "1" }, { "beat_id": "beat.line.Day3.074", "line_id": "line.Day3.074", "text": "She pushes the cap onto the borrowed pen and holds it out between us. For a beat her fingers stay closed around the warm barrel until my fingers brush hers to take it.", "revision": "1" }, { "beat_id": "beat.line.Day3.075", "line_id": "line.Day3.075", "text": "“Your pen,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day3.076", "line_id": "line.Day3.076", "text": "Outside at the foot of the stairs, she pulls the folded An Improvement slip from the edge of the closed sketchbook, folds it once more in half, and drops it into the wire bin beside the rail.", "revision": "1" }, { "beat_id": "beat.line.Day3.077", "line_id": "line.Day3.077", "text": "“There,” she says quietly. “Now the stationer won\'t be blamed for it.”", "revision": "1" }, { "beat_id": "beat.line.Day3.078", "line_id": "line.Day3.078", "text": "At the bottom of the steps, the late-afternoon air off the harbour is cool.", "revision": "1" }, { "beat_id": "beat.line.Day3.079", "line_id": "line.Day3.079", "text": "Instead of stepping back, Sylvia reaches down, takes my right hand—the one still cool from the stair rail—and draws it inside the deep left pocket of her own wool coat, keeping her hand closed over mine in the dark lining.", "revision": "1" }, { "beat_id": "beat.line.Day3.080", "line_id": "line.Day3.080", "text": "“Come with me tonight,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day3.081", "line_id": "line.Day3.081", "text": "“Where?”", "revision": "1" }, { "beat_id": "beat.line.Day3.082", "line_id": "line.Day3.082", "text": "“There\'s an old cross-section house model in the north room on the hill. Someone left the interior bulbs on a timer, and nobody ever goes up there at six.”", "revision": "1" }, { "beat_id": "beat.line.Day3.083", "line_id": "line.Day3.083", "text": "“Lavinia is waiting outside the library at six. We\'re going for a walk.”", "revision": "1" }, { "beat_id": "beat.line.Day3.084", "line_id": "line.Day3.084", "text": "Inside the warm coat pocket, Sylvia\'s thumb passes once across the back of my knuckles.", "revision": "1" }, { "beat_id": "beat.line.Day3.085", "line_id": "line.Day3.085", "text": "“You were with her last night,” she says—not accusing, her voice low and steady against the wind. “And you\'ve been rehearsing what you\'re going to say to her since you sat down on that bench.”", "revision": "1" }, { "beat_id": "beat.line.Day3.086", "line_id": "line.Day3.086", "text": "“I haven\'t.”", "revision": "1" }, { "beat_id": "beat.line.Day3.087", "line_id": "line.Day3.087", "text": "“Your hand hasn\'t relaxed once until now.” Her fingers close gently around mine inside the wool pocket. “Come up the hill with me. You won\'t have to arrange a single sentence all evening. There\'s still time to tell her.”", "revision": "1" }, { "beat_id": "beat.line.Day3.088", "line_id": "line.Day3.088", "text": "Spend the evening with Sylvia instead.", "revision": "1" }] }, { "entry_id": "Day3.lavinia", "lines": [{ "beat_id": "beat.line.Day3.lavinia.001", "line_id": "line.Day3.lavinia.001", "text": "“Another evening?”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.002", "line_id": "line.Day3.lavinia.002", "text": "Inside the coat pocket, Sylvia\'s fingers stay over mine for one more second, then open and let my hand slip back into the cool air.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.003", "line_id": "line.Day3.lavinia.003", "text": "“Perhaps,” she says, and turns up the hill path with her sketchbook under her arm; the library quad lies the other way.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.004", "line_id": "line.Day3.lavinia.004", "text": "By six o\'clock, the florist paper around the white flowers has grown damp beneath the thumb.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.005", "line_id": "line.Day3.lavinia.005", "text": "Lavinia\'s fingers ease one creased petal out of the paper fold.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.006", "line_id": "line.Day3.lavinia.006", "text": "“You\'re bruising them.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.007", "line_id": "line.Day3.lavinia.007", "text": "“I was holding them out of the wind for you.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.008", "line_id": "line.Day3.lavinia.008", "text": "“By strangling the stems?”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.009", "line_id": "line.Day3.lavinia.009", "text": "“They survived the walk up the hill.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.010", "line_id": "line.Day3.lavinia.010", "text": "The wrapping slides through my fingers, though one small white blossom catches on a nail. Lavinia takes that one too, tucks the stem back into the center of the bunch, and looks up with the corner of her mouth lifting.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.011", "line_id": "line.Day3.lavinia.011", "text": "“There.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.012", "line_id": "line.Day3.lavinia.012", "text": "“You\'re welcome.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.013", "line_id": "line.Day3.lavinia.013", "text": "She buries her face in the white heads until her eyes are hidden behind the paper rim.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.014", "line_id": "line.Day3.lavinia.014", "text": "“Where are you taking me?”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.015", "line_id": "line.Day3.lavinia.015", "text": "“Left.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.016", "line_id": "line.Day3.lavinia.016", "text": "Past the corner of the library wall, she keeps the bouquet lifted under her nose while I pace half a step beside her right shoulder—slowing the cadence before the flagstones dip so her right ankle never has to take an uneven drop.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.017", "line_id": "line.Day3.lavinia.017", "text": "“Which way now?” she asks from behind the flowers.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.018", "line_id": "line.Day3.lavinia.018", "text": "A silent gesture toward the hedge path.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.019", "line_id": "line.Day3.lavinia.019", "text": "“Say it aloud. I can\'t see through your bribe.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.020", "line_id": "line.Day3.lavinia.020", "text": "“Right. Mind the curb.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.021", "line_id": "line.Day3.lavinia.021", "text": "“I know where the curb is.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.022", "line_id": "line.Day3.lavinia.022", "text": "“You walked into it in February.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.023", "line_id": "line.Day3.lavinia.023", "text": "“Because you were talking.” She lowers the paper an inch, laughing.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.024", "line_id": "line.Day3.lavinia.024", "text": "Directly ahead, the main library steps rise back into view from the opposite side.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.025", "line_id": "line.Day3.lavinia.025", "text": "“A remarkably short walk, Priscilla.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.026", "line_id": "line.Day3.lavinia.026", "text": "“The first lap is to make sure you\'re paying attention. I know a longer way.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.027", "line_id": "line.Day3.lavinia.027", "text": "“I\'m sure you do.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.028", "line_id": "line.Day3.lavinia.028", "text": "She shifts the flowers into the crook of her left arm and slips her right hand into mine—fingers warm, thumb settling over the back of my knuckle as if rewarding the first lap.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.029", "line_id": "line.Day3.lavinia.029", "text": "A little longer like this.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.030", "line_id": "line.Day3.lavinia.030", "text": "Beyond the side arch, the flagstones narrow. A parked bicycle leans across half the path. Turning sideways so her hip won\'t brush the wet hedge, Lavinia lets the white flower heads strike the metal bell; it gives a single, unfinished ring.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.031", "line_id": "line.Day3.lavinia.031", "text": "“Excuse us,” she tells the handlebars.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.032", "line_id": "line.Day3.lavinia.032", "text": "“There was room on the grass.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.033", "line_id": "line.Day3.lavinia.033", "text": "“It had no business parking in the middle.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.034", "line_id": "line.Day3.lavinia.034", "text": "Her hand stays laced in mine behind her hip until the path opens onto the iron gate.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.035", "line_id": "line.Day3.lavinia.035", "text": "Under the gate lamp, two figures stop mid-stride—a cardigan swinging from a wrist, two takeaway cups balanced in the other hand.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.036", "line_id": "line.Day3.lavinia.036", "text": "“We\'re walking down for coffee. Come with us for half an hour.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.037", "line_id": "line.Day3.lavinia.037", "text": "A glance toward Lavinia.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.038", "line_id": "line.Day3.lavinia.038", "text": "“If you like,” she says evenly.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.039", "line_id": "line.Day3.lavinia.039", "text": "“We could come for a little—”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.040", "line_id": "line.Day3.lavinia.040", "text": "Inside the joined hands, Lavinia\'s grip closes all at once—pressing the ring finger hard against the middle knuckle. When my hand instincts to ease back half an inch, she does not release it; she twists the wrist a fraction inward against the damp flower stems so my breath catches audibly in the middle of the word.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.041", "line_id": "line.Day3.lavinia.041", "text": "An extravagant way to train someone not to look toward the gate: she is creasing her own stems against my cuff to do it.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.042", "line_id": "line.Day3.lavinia.042", "text": "“One moment,” I say toward the lamp, and turn half a step inward.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.043", "line_id": "line.Day3.lavinia.043", "text": "“Let go.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.044", "line_id": "line.Day3.lavinia.044", "text": "Her fingers uncurl slowly. For half a beat the palms stay stuck together by the damp warmth of the skin; separating them hurts sharper than the grip did.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.045", "line_id": "line.Day3.lavinia.045", "text": "“That hurt.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.046", "line_id": "line.Day3.lavinia.046", "text": "“I wanted an evening with you.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.047", "line_id": "line.Day3.lavinia.047", "text": "Under the gate lamp, the figure with the cardigan waits for the answer.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.048", "line_id": "line.Day3.lavinia.048", "text": "Accept the invitation for both of us.", "revision": "1" }] }, { "entry_id": "Day3.lavinia.result.A", "lines": [{ "beat_id": "beat.line.Day3.lavinia.result.A.001", "line_id": "line.Day3.lavinia.result.A.001", "text": "“Another evening,” I say toward the gate. “Send a message tomorrow.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.A.002", "line_id": "line.Day3.lavinia.result.A.002", "text": "Footsteps recede down the hill; the cardigan sleeve swings out of the lamp light.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.A.003", "line_id": "line.Day3.lavinia.result.A.003", "text": "“You could have said that first,” Lavinia says.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.A.004", "line_id": "line.Day3.lavinia.result.A.004", "text": "“I could have said yes.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.A.005", "line_id": "line.Day3.lavinia.result.A.005", "text": "“You didn\'t.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.A.006", "line_id": "line.Day3.lavinia.result.A.006", "text": "“The message will still go out tomorrow.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.A.007", "line_id": "line.Day3.lavinia.result.A.007", "text": "“I heard.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.A.008", "line_id": "line.Day3.lavinia.result.A.008", "text": "Her empty hand opens between our coats.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.A.009", "line_id": "line.Day3.lavinia.result.A.009", "text": "“The other side,” I say.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.A.010", "line_id": "line.Day3.lavinia.result.A.010", "text": "Paper rustles as the bouquet shifts to her right arm; moving to her left side brings the unbruised hand into hers.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.A.011", "line_id": "line.Day3.lavinia.result.A.011", "text": "Another evening is not this one.", "revision": "1" }] }, { "entry_id": "Day3.lavinia.result.B", "lines": [{ "beat_id": "beat.line.Day3.lavinia.result.B.001", "line_id": "line.Day3.lavinia.result.B.001", "text": "“Not tonight, thank you.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.B.002", "line_id": "line.Day3.lavinia.result.B.002", "text": "The gate latch clicks shut behind the departing steps.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.B.003", "line_id": "line.Day3.lavinia.result.B.003", "text": "“Don\'t look so put out,” Lavinia says.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.B.004", "line_id": "line.Day3.lavinia.result.B.004", "text": "“Nothing was said.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.B.005", "line_id": "line.Day3.lavinia.result.B.005", "text": "“Your mouth changed.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.B.006", "line_id": "line.Day3.lavinia.result.B.006", "text": "“I\'m still walking with you.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.B.007", "line_id": "line.Day3.lavinia.result.B.007", "text": "A green leaf has caught beneath the torn fold of the florist paper; two fingers free it without touching her wrist.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.B.008", "line_id": "line.Day3.lavinia.result.B.008", "text": "Only the walk, then.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.B.009", "line_id": "line.Day3.lavinia.result.B.009", "text": "Our steps settle into the same cadence along the outer wall, the white bouquet carried between the two coats like a boundary marker.", "revision": "1" }] }, { "entry_id": "Day3.lavinia.result.C", "lines": [{ "beat_id": "beat.line.Day3.lavinia.result.C.001", "line_id": "line.Day3.lavinia.result.C.001", "text": "“Yes,” I say toward the gate, and then turn to Lavinia: “Will you come for one cup?”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.C.002", "line_id": "line.Day3.lavinia.result.C.002", "text": "“You asked for a walk.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.C.003", "line_id": "line.Day3.lavinia.result.C.003", "text": "“Both are possible.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.C.004", "line_id": "line.Day3.lavinia.result.C.004", "text": "“How long is one cup?”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.C.005", "line_id": "line.Day3.lavinia.result.C.005", "text": "“Until it cools.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.C.006", "line_id": "line.Day3.lavinia.result.C.006", "text": "She looks through the iron bars, then settles the flowers higher against her shoulder.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.C.007", "line_id": "line.Day3.lavinia.result.C.007", "text": "“One cup.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.C.008", "line_id": "line.Day3.lavinia.result.C.008", "text": "At the narrow café table, four chairs fit badly; Lavinia draws hers flush against mine and lays the white bouquet across her knees so the paper rim rises above the tabletop.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.C.009", "line_id": "line.Day3.lavinia.result.C.009", "text": "“You\'ll have to look around them,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.C.010", "line_id": "line.Day3.lavinia.result.C.010", "text": "“I have been.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.C.011", "line_id": "line.Day3.lavinia.result.C.011", "text": "A place beside me, even in company.", "revision": "1" }] }, { "entry_id": "Day3.lavinia.result.D", "lines": [{ "beat_id": "beat.line.Day3.lavinia.result.D.001", "line_id": "line.Day3.lavinia.result.D.001", "text": "“We\'ll come,” I say toward the gate. “Give her a moment. She\'ll come.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.002", "line_id": "line.Day3.lavinia.result.D.002", "text": "“I\'m not going,” Lavinia says.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.003", "line_id": "line.Day3.lavinia.result.D.003", "text": "“You aren\'t interrupting—”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.004", "line_id": "line.Day3.lavinia.result.D.004", "text": "Lavinia hurls the bouquet straight down between us; the heavy wet stems strike across my ankles before the paper splits open against the flagstones.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.005", "line_id": "line.Day3.lavinia.result.D.005", "text": "Two white heads snap cleanly from their stalks; another rolls into the mud beside the base of the iron rail.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.006", "line_id": "line.Day3.lavinia.result.D.006", "text": "Under the lamp, the voice at the gate cuts off mid-syllable. A knee bends as if to reach for the nearest flower.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.007", "line_id": "line.Day3.lavinia.result.D.007", "text": "“Leave them,” Lavinia says, her voice flat and exact.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.008", "line_id": "line.Day3.lavinia.result.D.008", "text": "The figure straightens. The gate latch catches once, misses, and clicks shut as both shadows hurry away down the hill.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.009", "line_id": "line.Day3.lavinia.result.D.009", "text": "“Go on,” Lavinia says, her hands empty at her sides, chest rising fast beneath her unbuttoned collar. “Smile at them. Catch up.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.010", "line_id": "line.Day3.lavinia.result.D.010", "text": "“They were for you.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.011", "line_id": "line.Day3.lavinia.result.D.011", "text": "“I know.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.012", "line_id": "line.Day3.lavinia.result.D.012", "text": "Both knees touch the damp paving stones right at her feet.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.013", "line_id": "line.Day3.lavinia.result.D.013", "text": "“I said leave them.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.014", "line_id": "line.Day3.lavinia.result.D.014", "text": "“No. The paper is only torn to the middle.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.015", "line_id": "line.Day3.lavinia.result.D.015", "text": "She threw her own gift into the mud just to clear the gate in ten seconds.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.016", "line_id": "line.Day3.lavinia.result.D.016", "text": "As fingers reach past her instep for the snapped stems, her right shoe slides half an inch backward—not retreating toward the gate, only lifting the hem of her coat so the wool won\'t brush my cuff in the dirt.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.017", "line_id": "line.Day3.lavinia.result.D.017", "text": "“That one won\'t stay,” she says, looking down at the broken white head by the rail.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.018", "line_id": "line.Day3.lavinia.result.D.018", "text": "“Hold this.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.019", "line_id": "line.Day3.lavinia.result.D.019", "text": "She does not touch the loose blossom. Instead, she bends from the waist and takes the two corners of the torn wrapping from my fingers, holding the paper open like a pocket while I lay the bruised stems back inside.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.020", "line_id": "line.Day3.lavinia.result.D.020", "text": "When we stand, she presses the ruined bunch between our coats with one forearm. Her other hand comes up to the back of my neck—fingers cool and damp from the torn florist paper—and pulls my head forward until her forehead rests hard against my shoulder.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.021", "line_id": "line.Day3.lavinia.result.D.021", "text": "Keep hold of me.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.022", "line_id": "line.Day3.lavinia.result.D.022", "text": "“Answer for me in front of people again,” she whispers into the wool of my shoulder, her fingers tightening at my nape, “and it won\'t be the flowers next time.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.023", "line_id": "line.Day3.lavinia.result.D.023", "text": "“You helped me pick them up.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.D.024", "line_id": "line.Day3.lavinia.result.D.024", "text": "She laughs once against my collarbone—a short, breathless sound—and does not let go of my neck as the torn paper crackles between our chests.", "revision": "1" }] }, { "entry_id": "Day3.lavinia.result.E", "lines": [{ "beat_id": "beat.line.Day3.lavinia.result.E.001", "line_id": "line.Day3.lavinia.result.E.001", "text": "“Yes,” I say toward the gate, and then turn to Lavinia: “Will you come for one cup?”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.002", "line_id": "line.Day3.lavinia.result.E.002", "text": "“You asked for a walk.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.003", "line_id": "line.Day3.lavinia.result.E.003", "text": "“Both are possible.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.004", "line_id": "line.Day3.lavinia.result.E.004", "text": "“How long is one cup?”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.005", "line_id": "line.Day3.lavinia.result.E.005", "text": "“Until it cools.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.006", "line_id": "line.Day3.lavinia.result.E.006", "text": "She looks through the iron bars, then settles the flowers higher against her shoulder.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.007", "line_id": "line.Day3.lavinia.result.E.007", "text": "“One cup.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.008", "line_id": "line.Day3.lavinia.result.E.008", "text": "At the narrow café table, four chairs fit badly; Lavinia draws hers flush against mine and lays the white bouquet across her knees so the paper rim rises above the tabletop.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.009", "line_id": "line.Day3.lavinia.result.E.009", "text": "“You\'ll have to look around them,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.010", "line_id": "line.Day3.lavinia.result.E.010", "text": "“I have been.”", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.011", "line_id": "line.Day3.lavinia.result.E.011", "text": "A place beside me, even in company.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.012", "line_id": "line.Day3.lavinia.result.E.012", "text": "Someone is listening.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.013", "line_id": "line.Day3.lavinia.result.E.013", "text": "None of the faces around this table. Somewhere the eyes cannot place.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.014", "line_id": "line.Day3.lavinia.result.E.014", "text": "You.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.015", "line_id": "line.Day3.lavinia.result.E.015", "text": "The wish to bring her here was mine. It remains mine.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.016", "line_id": "line.Day3.lavinia.result.E.016", "text": "The porcelain cup turns once beneath the fingertips.", "revision": "1" }, { "beat_id": "beat.line.Day3.lavinia.result.E.017", "line_id": "line.Day3.lavinia.result.E.017", "text": "What, exactly, have you been waiting to see?", "revision": "1" }] }, { "entry_id": "Day3.sylvia", "lines": [{ "beat_id": "beat.line.Day3.sylvia.001", "line_id": "line.Day3.sylvia.001", "text": "“I\'ll come with you.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.002", "line_id": "line.Day3.sylvia.002", "text": "“And Lavinia?”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.003", "line_id": "line.Day3.sylvia.003", "text": "“I\'ll tell her now.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.004", "line_id": "line.Day3.sylvia.004", "text": "With one hand still warm inside Sylvia\'s coat pocket, the other hand sends the message: I\'m spending the evening with Sylvia. I won\'t be at the library at six. Sorry for the late change.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.005", "line_id": "line.Day3.sylvia.005", "text": "Sylvia keeps my hand inside her pocket all the way up the hill stairs.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.006", "line_id": "line.Day3.sylvia.006", "text": "In the quiet north room, the overhead lights are off; only the glass display case in the center is lit. Inside sits the cross-section model of a pale three-storey house—every window dark except for a tiny amber bulb in the attic and a two-inch painted figure wedged between an upstairs sill and the drainpipe.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.007", "line_id": "line.Day3.sylvia.007", "text": "“All those rooms,” I say, “and it stays by the pipe.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.008", "line_id": "line.Day3.sylvia.008", "text": "“Perhaps it likes the view.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.009", "line_id": "line.Day3.sylvia.009", "text": "“The rent must be reasonable.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.010", "line_id": "line.Day3.sylvia.010", "text": "Sylvia laughs; our reflections overlap on the glass panel.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.011", "line_id": "line.Day3.sylvia.011", "text": "Along the front of the case runs a row of folding wooden viewing stools. Sylvia pulls the end stool down. Before she has slipped her coat off one shoulder, the wooden seat snaps back up with a hollow knock against the back of her knees.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.012", "line_id": "line.Day3.sylvia.012", "text": "“Help,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.013", "line_id": "line.Day3.sylvia.013", "text": "One hand holds the wooden seat flat while the other takes the coat from her shoulder.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.014", "line_id": "line.Day3.sylvia.014", "text": "“Thank you.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.015", "line_id": "line.Day3.sylvia.015", "text": "She sits, drawing the coat across both our laps the way she did on the gallery bench, her shoulder resting warm against mine.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.016", "line_id": "line.Day3.sylvia.016", "text": "Behind the glass in front of us, the cross-section house glows softly: miniature staircases, paper-thin doors, and in the ground-floor hall, a tiny open cupboard under the stairs where a second painted figure stands behind a half-shut door.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.017", "line_id": "line.Day3.sylvia.017", "text": "“A terrible place to hide,” I murmur.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.018", "line_id": "line.Day3.sylvia.018", "text": "“I\'d live in the cupboard,” Sylvia whispers.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.019", "line_id": "line.Day3.sylvia.019", "text": "“No one would find you.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.020", "line_id": "line.Day3.sylvia.020", "text": "“You wouldn\'t have to look very hard.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.021", "line_id": "line.Day3.sylvia.021", "text": "Under the shared coat across our knees, her hand finds mine, slides her fingers across the palm, and settles there.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.022", "line_id": "line.Day3.sylvia.022", "text": "Inside the miniature house, the tiny bulb on the landing brightens by a step, throwing a thread of yellow light across the painted cupboard door.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.023", "line_id": "line.Day3.sylvia.023", "text": "Sylvia leans half an inch closer to the glass. Her lips part slightly; her eyes follow the miniature staircase as if someone were about to come down it, her hand resting forgotten in mine.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.024", "line_id": "line.Day3.sylvia.024", "text": "A stool beside her in the dark. Anyone could have sat here.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.025", "line_id": "line.Day3.sylvia.025", "text": "“Sylvia.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.026", "line_id": "line.Day3.sylvia.026", "text": "“Mm?”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.027", "line_id": "line.Day3.sylvia.027", "text": "Step in front of the glass so she has to look at me instead.", "revision": "1" }] }, { "entry_id": "Day3.sylvia.result.A", "lines": [{ "beat_id": "beat.line.Day3.sylvia.result.A.001", "line_id": "line.Day3.sylvia.result.A.001", "text": "“Come out to the balcony for a minute. When the light cycle finishes.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.A.002", "line_id": "line.Day3.sylvia.result.A.002", "text": "“Let the attic bulb come on first.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.A.003", "line_id": "line.Day3.sylvia.result.A.003", "text": "The tiny landing light dims; three seconds later, the attic window goes dark. Sylvia lifts our joined hands.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.A.004", "line_id": "line.Day3.sylvia.result.A.004", "text": "“Now?”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.A.005", "line_id": "line.Day3.sylvia.result.A.005", "text": "“Now.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.A.006", "line_id": "line.Day3.sylvia.result.A.006", "text": "Outside in the cool corridor, she leans one shoulder against the wall.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.A.007", "line_id": "line.Day3.sylvia.result.A.007", "text": "“What did you want to show me?”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.A.008", "line_id": "line.Day3.sylvia.result.A.008", "text": "“Nothing in the case.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.A.009", "line_id": "line.Day3.sylvia.result.A.009", "text": "“I was comfortable on that stool.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.A.010", "line_id": "line.Day3.sylvia.result.A.010", "text": "“Only after I held it down.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.A.011", "line_id": "line.Day3.sylvia.result.A.011", "text": "She offers her arm; we step back inside before the miniature house lights begin their next cycle.", "revision": "1" }] }, { "entry_id": "Day3.sylvia.result.B", "lines": [{ "beat_id": "beat.line.Day3.sylvia.result.B.001", "line_id": "line.Day3.sylvia.result.B.001", "text": "“Nothing.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.B.002", "line_id": "line.Day3.sylvia.result.B.002", "text": "Sylvia glances sideways, then back at the lit cross-section house.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.B.003", "line_id": "line.Day3.sylvia.result.B.003", "text": "“You nearly made me miss the timer.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.B.004", "line_id": "line.Day3.sylvia.result.B.004", "text": "Her fingers tighten once around my palm, then relax. For ten minutes the tiny bulbs inside the miniature rooms switch on and off in sequence—attic, landing, under-stair cupboard—while her little finger stays hooked against mine under the shared coat.", "revision": "1" }] }, { "entry_id": "Day3.sylvia.result.C", "lines": [{ "beat_id": "beat.line.Day3.sylvia.result.C.001", "line_id": "line.Day3.sylvia.result.C.001", "text": "“Come out into the corridor with me for a minute.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.C.002", "line_id": "line.Day3.sylvia.result.C.002", "text": "“Why?”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.C.003", "line_id": "line.Day3.sylvia.result.C.003", "text": "“I\'d rather talk to you than look at a wooden house.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.C.004", "line_id": "line.Day3.sylvia.result.C.004", "text": "Sylvia looks from the lit miniature staircase to my mouth, then smiles.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.C.005", "line_id": "line.Day3.sylvia.result.C.005", "text": "“All right.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.C.006", "line_id": "line.Day3.sylvia.result.C.006", "text": "In the quiet corridor outside the door, she leans beside the window.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.C.007", "line_id": "line.Day3.sylvia.result.C.007", "text": "“Well?”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.C.008", "line_id": "line.Day3.sylvia.result.C.008", "text": "“I like being out with you.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.C.009", "line_id": "line.Day3.sylvia.result.C.009", "text": "“You cancelled a walk to tell me that in a hallway.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.C.010", "line_id": "line.Day3.sylvia.result.C.010", "text": "“The lighting is better out here.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.C.011", "line_id": "line.Day3.sylvia.result.C.011", "text": "She laughs softly and opens her palm beside mine.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.C.012", "line_id": "line.Day3.sylvia.result.C.012", "text": "“We can walk the long way back when the building closes,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.C.013", "line_id": "line.Day3.sylvia.result.C.013", "text": "After the building closes. There is an after.", "revision": "1" }] }, { "entry_id": "Day3.sylvia.result.D", "lines": [{ "beat_id": "beat.line.Day3.sylvia.result.D.001", "line_id": "line.Day3.sylvia.result.D.001", "text": "“Come outside with me.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.002", "line_id": "line.Day3.sylvia.result.D.002", "text": "“Wait until the landing light changes.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.003", "line_id": "line.Day3.sylvia.result.D.003", "text": "“Now.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.004", "line_id": "line.Day3.sylvia.result.D.004", "text": "The hand pulls free of hers. The folding stool snaps up behind the knees as two steps carry me into the narrow space directly between her stool and the illuminated glass case.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.005", "line_id": "line.Day3.sylvia.result.D.005", "text": "My coat blocks the cross-section house completely, throwing a dark rectangle across her knees and glasses.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.006", "line_id": "line.Day3.sylvia.result.D.006", "text": "Sylvia tilts her head back to look up.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.007", "line_id": "line.Day3.sylvia.result.D.007", "text": "“Sit down, Priscilla.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.008", "line_id": "line.Day3.sylvia.result.D.008", "text": "“I didn\'t cancel six o\'clock to watch you look at someone else.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.009", "line_id": "line.Day3.sylvia.result.D.009", "text": "Her eyes stay on my face for a full beat.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.010", "line_id": "line.Day3.sylvia.result.D.010", "text": "“The two-inch man in the cupboard?”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.011", "line_id": "line.Day3.sylvia.result.D.011", "text": "“Come outside.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.012", "line_id": "line.Day3.sylvia.result.D.012", "text": "The light from the miniature house behind my back catches the corner of Sylvia\'s mouth. She takes her coat, stands sideways off the stool, and walks out into the corridor.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.013", "line_id": "line.Day3.sylvia.result.D.013", "text": "As the door swings shut behind us, she turns and pushes her coat into my hands.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.014", "line_id": "line.Day3.sylvia.result.D.014", "text": "“Hold that.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.015", "line_id": "line.Day3.sylvia.result.D.015", "text": "She smooths her cardigan cuff—and then laughs, a short, clear sound against the quiet wall.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.016", "line_id": "line.Day3.sylvia.result.D.016", "text": "“What?”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.017", "line_id": "line.Day3.sylvia.result.D.017", "text": "“You stood in front of a wooden model.” She shakes her head, still smiling. “You looked ridiculous.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.018", "line_id": "line.Day3.sylvia.result.D.018", "text": "“You were looking at it.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.019", "line_id": "line.Day3.sylvia.result.D.019", "text": "“I couldn\'t see anything else with your coat in the way.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.020", "line_id": "line.Day3.sylvia.result.D.020", "text": "“Stay out here a minute.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.021", "line_id": "line.Day3.sylvia.result.D.021", "text": "The laugh stops. She takes her coat back slowly, without taking her eyes off mine.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.022", "line_id": "line.Day3.sylvia.result.D.022", "text": "“If you\'re going to interrupt the whole evening, Priscilla, you\'d better have something else prepared.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.023", "line_id": "line.Day3.sylvia.result.D.023", "text": "“I don\'t.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.024", "line_id": "line.Day3.sylvia.result.D.024", "text": "“Then you\'d better hold my attention.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.025", "line_id": "line.Day3.sylvia.result.D.025", "text": "“How?”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.026", "line_id": "line.Day3.sylvia.result.D.026", "text": "“Something better than the little house.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.027", "line_id": "line.Day3.sylvia.result.D.027", "text": "Nothing prepared.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.028", "line_id": "line.Day3.sylvia.result.D.028", "text": "Her smile widens. She steps under the corridor lamp and slides her right hand back into mine—palm to palm, her thumb pressing steadily against the inside of my wrist, leaving a faint grey trace of afternoon pencil lead directly over the pulse.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.029", "line_id": "line.Day3.sylvia.result.D.029", "text": "“There,” she says softly. “Now look.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.D.030", "line_id": "line.Day3.sylvia.result.D.030", "text": "Behind the closed door, the timer relay clicks and the miniature house resets in the dark. Her eyes do not leave mine.", "revision": "1" }] }, { "entry_id": "Day3.sylvia.result.E", "lines": [{ "beat_id": "beat.line.Day3.sylvia.result.E.001", "line_id": "line.Day3.sylvia.result.E.001", "text": "“Come out into the corridor with me for a minute.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.002", "line_id": "line.Day3.sylvia.result.E.002", "text": "“Why?”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.003", "line_id": "line.Day3.sylvia.result.E.003", "text": "“I\'d rather talk to you than look at a wooden house.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.004", "line_id": "line.Day3.sylvia.result.E.004", "text": "Sylvia looks from the lit miniature staircase to my mouth, then smiles.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.005", "line_id": "line.Day3.sylvia.result.E.005", "text": "“All right.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.006", "line_id": "line.Day3.sylvia.result.E.006", "text": "In the quiet corridor outside the door, she leans beside the window.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.007", "line_id": "line.Day3.sylvia.result.E.007", "text": "“Well?”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.008", "line_id": "line.Day3.sylvia.result.E.008", "text": "“I like being out with you.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.009", "line_id": "line.Day3.sylvia.result.E.009", "text": "“You cancelled a walk to tell me that in a hallway.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.010", "line_id": "line.Day3.sylvia.result.E.010", "text": "“The lighting is better out here.”", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.011", "line_id": "line.Day3.sylvia.result.E.011", "text": "She laughs softly and opens her palm beside mine.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.012", "line_id": "line.Day3.sylvia.result.E.012", "text": "“We can walk the long way back when the building closes,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.013", "line_id": "line.Day3.sylvia.result.E.013", "text": "After the building closes. There is an after.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.014", "line_id": "line.Day3.sylvia.result.E.014", "text": "Someone else is watching.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.015", "line_id": "line.Day3.sylvia.result.E.015", "text": "Not from the stairwell, and not from behind the glass. A certainty that belongs to no footstep in the building.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.016", "line_id": "line.Day3.sylvia.result.E.016", "text": "You.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.017", "line_id": "line.Day3.sylvia.result.E.017", "text": "You turned the page of her sketchbook in a room with no wind. You waited to see whether I would leave the library gate empty for this hill.", "revision": "1" }, { "beat_id": "beat.line.Day3.sylvia.result.E.018", "line_id": "line.Day3.sylvia.result.E.018", "text": "The glass panel gives back only two coats under the lamp.", "revision": "1" }] }, { "entry_id": "Day4", "lines": [{ "beat_id": "beat.line.Day4.one", "line_id": "line.Day4.one", "text": "In the rehearsal room next door, a practice piano plays a slow four-bar phrase, pauses to correct a chord, and begins the same four notes again.", "revision": "1" }, { "beat_id": "beat.line.Day4.002", "line_id": "line.Day4.002", "text": "Outside Studio B, the heavy door is ajar by less than an inch. Over the piano next door, two voices are talking near the wooden bench—unhurried, mid-conversation.", "revision": "1" }, { "beat_id": "beat.line.Day4.003", "line_id": "line.Day4.003", "text": "“...you\'ve made the chin too square.”", "revision": "1" }, { "beat_id": "beat.line.Day4.004", "line_id": "line.Day4.004", "text": "“Then stop moving your head when you talk.”", "revision": "1" }, { "beat_id": "beat.line.Day4.005", "line_id": "line.Day4.005", "text": "“I wasn\'t talking. I was breathing.”", "revision": "1" }, { "beat_id": "beat.line.Day4.006", "line_id": "line.Day4.006", "text": "“Do less of that for thirty seconds.”", "revision": "1" }, { "beat_id": "beat.line.Day4.007", "line_id": "line.Day4.007", "text": "A short, genuine laugh from the floorboards—Lavinia\'s—followed by the dry rustle of heavy paper closing.", "revision": "1" }, { "beat_id": "beat.line.Day4.008", "line_id": "line.Day4.008", "text": "“I\'ll bring the rest on Friday,” the other voice says quietly.", "revision": "1" }, { "beat_id": "beat.line.Day4.009", "line_id": "line.Day4.009", "text": "When the main door swings inward under the hand a moment later, the far side door by the dressing passage is just settling into its frame with a soft click.", "revision": "1" }, { "beat_id": "beat.line.Day4.010", "line_id": "line.Day4.010", "text": "On the narrow wooden ledge beside the bench stands a low glass jar of water. White flowers sit inside it, their heads just above the rim.", "revision": "1" }, { "beat_id": "beat.line.Day4.011", "line_id": "line.Day4.011", "text": "Lavinia sits on the rosin-warmed floorboards with her back resting against the front of the low wooden bench, both legs stretched out loosely in front of her.", "revision": "1" }, { "beat_id": "beat.line.Day4.012", "line_id": "line.Day4.012", "text": "When the space on the bench behind her is taken, she leans the back of her head directly against my knee and reaches up for the paper cup.", "revision": "1" }, { "beat_id": "beat.line.Day4.013", "line_id": "line.Day4.013", "text": "Her fingers close around the warm cardboard.", "revision": "1" }, { "beat_id": "beat.line.Day4.014", "line_id": "line.Day4.014", "text": "“That isn\'t iced.”", "revision": "1" }, { "beat_id": "beat.line.Day4.015", "line_id": "line.Day4.015", "text": "“The ice machine in the canteen was being cleaned.”", "revision": "1" }, { "beat_id": "beat.line.Day4.016", "line_id": "line.Day4.016", "text": "“In October.”", "revision": "1" }, { "beat_id": "beat.line.Day4.017", "line_id": "line.Day4.017", "text": "“They clean it on Thursdays.”", "revision": "1" }, { "beat_id": "beat.line.Day4.018", "line_id": "line.Day4.018", "text": "“You\'re a terrible liar when you don\'t need to be.”", "revision": "1" }, { "beat_id": "beat.line.Day4.019", "line_id": "line.Day4.019", "text": "“You\'re drinking it.”", "revision": "1" }, { "beat_id": "beat.line.Day4.020", "line_id": "line.Day4.020", "text": "“Because my hands are cold.” She takes a slow mouthful over the rim, her head still resting against the wool of my skirt, and glances sideways at the open canvas bag beside my shoe. A paperback protrudes from the top, a strip of paper marking the middle pages.", "revision": "1" }, { "beat_id": "beat.line.Day4.021", "line_id": "line.Day4.021", "text": "Without asking, her free hand reaches into the bag, draws the book out, and opens it to the marker.", "revision": "1" }, { "beat_id": "beat.line.Day4.022", "line_id": "line.Day4.022", "text": "“Page eighty,” she says, tilting the leaf toward the window light. “Read the part you underlined twice.”", "revision": "1" }, { "beat_id": "beat.line.Day4.023", "line_id": "line.Day4.023", "text": "“It\'s for tomorrow\'s seminar.”", "revision": "1" }, { "beat_id": "beat.line.Day4.024", "line_id": "line.Day4.024", "text": "“You underlined it twice because you were pleased with your own point. Start from the top.” She settles the back of her neck more comfortably against my knee and watches my reflection in the wall-length mirror across the floorboards.", "revision": "1" }, { "beat_id": "beat.line.Day4.025", "line_id": "line.Day4.025", "text": "Looking down at the page over her shoulder, I begin reading.", "revision": "1" }, { "beat_id": "beat.line.Day4.026", "line_id": "line.Day4.026", "text": "By the fourth sentence, the footnote at the bottom of the page is clearly wrong about the heroine\'s motive, and it takes three more sentences to explain why the author ruined the chapter by making her apologize too soon.", "revision": "1" }, { "beat_id": "beat.line.Day4.027", "line_id": "line.Day4.027", "text": "In the mirror across the room, Lavinia is no longer looking at the paperback; she is watching my mouth.", "revision": "1" }, { "beat_id": "beat.line.Day4.028", "line_id": "line.Day4.028", "text": "When I pause at the margin note, she reaches up without turning her head and takes my free hand, drawing my palm down until it rests against her collarbone above the wool cardigan.", "revision": "1" }, { "beat_id": "beat.line.Day4.029", "line_id": "line.Day4.029", "text": "“You still drop the end of the sentence,” she murmurs.", "revision": "1" }, { "beat_id": "beat.line.Day4.030", "line_id": "line.Day4.030", "text": "“You still lean back to hear it.”", "revision": "1" }, { "beat_id": "beat.line.Day4.031", "line_id": "line.Day4.031", "text": "“Before I went, I leaned in.”", "revision": "1" }, { "beat_id": "beat.line.Day4.032", "line_id": "line.Day4.032", "text": "“And now?”", "revision": "1" }, { "beat_id": "beat.line.Day4.033", "line_id": "line.Day4.033", "text": "Her thumb passes once across the knuckle of my index finger.", "revision": "1" }, { "beat_id": "beat.line.Day4.034", "line_id": "line.Day4.034", "text": "“Keep reading,” she says softly.", "revision": "1" }, { "beat_id": "beat.line.Day4.035", "line_id": "line.Day4.035", "text": "Her hand over mine. Not a word about Friday.", "revision": "1" }, { "beat_id": "beat.line.Day4.036", "line_id": "line.Day4.036", "text": "“It\'s warm in here,” Lavinia says, releasing my hand only to slip her wool cardigan off her shoulders.", "revision": "1" }, { "beat_id": "beat.line.Day4.037", "line_id": "line.Day4.037", "text": "As she shifts sideways to lay the cardigan on the bench, the late-afternoon light catches a dark shadow along the pale rib-seam of her practice bodice just above the left hip.", "revision": "1" }, { "beat_id": "beat.line.Day4.038", "line_id": "line.Day4.038", "text": "At first glance it looks like a streak of grey dust from the window sill or the underside of the bench.", "revision": "1" }, { "beat_id": "beat.line.Day4.039", "line_id": "line.Day4.039", "text": "Then she leans half an inch toward the mirror, and the shadow separates into four distinct marks.", "revision": "1" }, { "beat_id": "beat.line.Day4.040", "line_id": "line.Day4.040", "text": "A wider oval pressed into the wool in front; three narrower lines curving back toward the spine.", "revision": "1" }, { "beat_id": "beat.line.Day4.041", "line_id": "line.Day4.041", "text": "A left hand.", "revision": "1" }, { "beat_id": "beat.line.Day4.042", "line_id": "line.Day4.042", "text": "And set two inches higher on the ribcage than any dance partner places his hand for a lift—not at the hip bone where weight is taken, but high on the ribs, where someone standing directly in front of the bench would take a sitter\'s waist in her left hand to turn the shoulder toward the window light.", "revision": "1" }, { "beat_id": "beat.line.Day4.043", "line_id": "line.Day4.043", "text": "Before Lavinia can lean her head back against my knee, a folded linen handkerchief is already between my fingers, dampened against the warm condensation on the cup lid.", "revision": "1" }, { "beat_id": "beat.line.Day4.044", "line_id": "line.Day4.044", "text": "“Hold still,” I say.", "revision": "1" }, { "beat_id": "beat.line.Day4.045", "line_id": "line.Day4.045", "text": "“What are you doing?”", "revision": "1" }, { "beat_id": "beat.line.Day4.046", "line_id": "line.Day4.046", "text": "The damp linen presses against the front mark, expecting dry dust to lift off the wool.", "revision": "1" }, { "beat_id": "beat.line.Day4.047", "line_id": "line.Day4.047", "text": "It does not lift. Under the wet cloth, the grey mark smears darker—velvety, heavy, and slightly greasy against the pale weave.", "revision": "1" }, { "beat_id": "beat.line.Day4.048", "line_id": "line.Day4.048", "text": "Only one person in this building uses soft, unlacquered 4B woodless graphite sticks that coat the heel of the left palm and the inside of the fingers because she dislikes the noise of a pencil sharpener in quiet rooms. Yesterday afternoon in the exhibition room, that exact grey film sat along the side of her thumb when she handed me half a mandarin; twenty minutes ago on these floorboards, she didn\'t even wipe her left hand on her rag before putting her fingers around Lavinia\'s waist.", "revision": "1" }, { "beat_id": "beat.line.Day4.049", "line_id": "line.Day4.049", "text": "She held her ribs with the lead still on her skin.", "revision": "1" }, { "beat_id": "beat.line.Day4.050", "line_id": "line.Day4.050", "text": "Beneath the thin bodice, the muscle over Lavinia\'s ribs flinches once, then goes taut under the sudden force of my hand.", "revision": "1" }, { "beat_id": "beat.line.Day4.051", "line_id": "line.Day4.051", "text": "“There\'s pencil lead on your waist,” I say, my voice dropping half a tone.", "revision": "1" }, { "beat_id": "beat.line.Day4.052", "line_id": "line.Day4.052", "text": "“She was turning my shoulder toward the window.”", "revision": "1" }, { "beat_id": "beat.line.Day4.053", "line_id": "line.Day4.053", "text": "“With her bare hand on your ribs?”", "revision": "1" }, { "beat_id": "beat.line.Day4.054", "line_id": "line.Day4.054", "text": "“I kept moving when I breathed.” In the mirror across the floorboards, Lavinia watches the muscle in my jaw tighten—and the corner of her mouth lifts in a slow, deliberate provocation. “Her hands were warm. Unlike yours.”", "revision": "1" }, { "beat_id": "beat.line.Day4.055", "line_id": "line.Day4.055", "text": "The second pass of the damp linen scrubs hard enough to pull the seam of the bodice sideways against her skin. Because the 4B lead is soft and wax-heavy, the wet cloth only drives a faint grey shadow deeper into the pale wool.", "revision": "1" }, { "beat_id": "beat.line.Day4.056", "line_id": "line.Day4.056", "text": "Dropping the stained handkerchief onto the bench, I slip my bare right hand directly over the damp waistband of her bodice—pressing my palm flat and hard against her ribs, thumb over the front smudge, fingers spanning the three marks toward her spine, holding her waist still against my knee until my own heat goes all the way through the damp wool into her skin.", "revision": "1" }, { "beat_id": "beat.line.Day4.057", "line_id": "line.Day4.057", "text": "Above her collar, Lavinia\'s breath catches audibly.", "revision": "1" }, { "beat_id": "beat.line.Day4.058", "line_id": "line.Day4.058", "text": "“That\'s warm enough,” she whispers.", "revision": "1" }, { "beat_id": "beat.line.Day4.059", "line_id": "line.Day4.059", "text": "“It was still damp,” I say quietly, not taking my palm off her waist until her ribs rise twice against my hand.", "revision": "1" }, { "beat_id": "beat.line.Day4.060", "line_id": "line.Day4.060", "text": "Slowly, she pulls herself up from the floorboards and sits on the wooden bench beside me, leaving me kneeling on the boards by her feet. Her eyes in the mirror are wide and bright.", "revision": "1" }, { "beat_id": "beat.line.Day4.061", "line_id": "line.Day4.061", "text": "She reaches into her cardigan pocket, takes out a small tin of honey throat pastilles, and flicks the lid open with her thumb.", "revision": "1" }, { "beat_id": "beat.line.Day4.062", "line_id": "line.Day4.062", "text": "One amber square slips over the metal rim, strikes the pleat of her wrap skirt just above the knee, and stays lodged in the hollow of the wool.", "revision": "1" }, { "beat_id": "beat.line.Day4.063", "line_id": "line.Day4.063", "text": "Neither of us reaches for it with our fingers.", "revision": "1" }, { "beat_id": "beat.line.Day4.064", "line_id": "line.Day4.064", "text": "“You forgot lunch again, didn\'t you?” she says, her voice still slightly breathless.", "revision": "1" }, { "beat_id": "beat.line.Day4.065", "line_id": "line.Day4.065", "text": "“I had a biscuit.”", "revision": "1" }, { "beat_id": "beat.line.Day4.066", "line_id": "line.Day4.066", "text": "“That isn\'t lunch.” In the mirror behind her back, her reflected eyes stay locked on the crown of my head. “Go on, then.”", "revision": "1" }, { "beat_id": "beat.line.Day4.067", "line_id": "line.Day4.067", "text": "Take it from her skirt without using the hands.", "revision": "1" }] }, { "entry_id": "Day4.A", "lines": [{ "beat_id": "beat.line.Day4.A.001", "line_id": "line.Day4.A.001", "text": "Both hands rest flat on my knees without chasing the shoe under the bench.", "revision": "1" }, { "beat_id": "beat.line.Day4.A.002", "line_id": "line.Day4.A.002", "text": "“Did you ask her to tie it, or did you leave the door unlatched so I\'d think she did?”", "revision": "1" }, { "beat_id": "beat.line.Day4.A.003", "line_id": "line.Day4.A.003", "text": "“That isn\'t your business.”", "revision": "1" }, { "beat_id": "beat.line.Day4.A.004", "line_id": "line.Day4.A.004", "text": "“It will blister your tendon before Saturday.”", "revision": "1" }, { "beat_id": "beat.line.Day4.A.005", "line_id": "line.Day4.A.005", "text": "A beat of silence. Then her right foot slides back out from under the bench and stops an inch from my knee.", "revision": "1" }, { "beat_id": "beat.line.Day4.A.006", "line_id": "line.Day4.A.006", "text": "“Then tie it properly,” Lavinia says quietly. “Not too tight.”", "revision": "1" }, { "beat_id": "beat.line.Day4.A.007", "line_id": "line.Day4.A.007", "text": "The square knot comes undone; the satin crosses once, tucks flat behind the ankle bone where it belongs, and smooths down. When I sit back on the bench beside her, she leans her shoulder against mine and opens the paperback again.", "revision": "1" }, { "beat_id": "beat.line.Day4.A.008", "line_id": "line.Day4.A.008", "text": "“Read the rest of the page,” she says.", "revision": "1" }] }, { "entry_id": "Day4.B", "lines": [{ "beat_id": "beat.line.Day4.B.001", "line_id": "line.Day4.B.001", "text": "Fingertips brush the leather heel under the bench, then open and draw back before closing around the arch.", "revision": "1" }, { "beat_id": "beat.line.Day4.B.002", "line_id": "line.Day4.B.002", "text": "“If you want a square knot on your tendon, keep it.”", "revision": "1" }, { "beat_id": "beat.line.Day4.B.003", "line_id": "line.Day4.B.003", "text": "In the mirror, Lavinia\'s chin tilts slightly.", "revision": "1" }, { "beat_id": "beat.line.Day4.B.004", "line_id": "line.Day4.B.004", "text": "“Stopping there?”", "revision": "1" }, { "beat_id": "beat.line.Day4.B.005", "line_id": "line.Day4.B.005", "text": "“The foot keeps moving.”", "revision": "1" }, { "beat_id": "beat.line.Day4.B.006", "line_id": "line.Day4.B.006", "text": "“You weren\'t so patient with my waist.”", "revision": "1" }, { "beat_id": "beat.line.Day4.B.007", "line_id": "line.Day4.B.007", "text": "Lavinia looks down at the crooked knot for three seconds, then bends, jerks the square knot undone with her own fingers, and reties it flat while her shoulder brushes my knee without telling me to leave.", "revision": "1" }] }, { "entry_id": "Day4.C", "lines": [{ "beat_id": "beat.line.Day4.C.001", "line_id": "line.Day4.C.001", "text": "Instead of reaching into the shadow under the bench, my left palm stays open just above the floorboards where her shoe stood a moment ago.", "revision": "1" }, { "beat_id": "beat.line.Day4.C.002", "line_id": "line.Day4.C.002", "text": "“You always tie a square knot when you\'re in a hurry,” I say quietly. “Nobody else touched your shoe.”", "revision": "1" }, { "beat_id": "beat.line.Day4.C.003", "line_id": "line.Day4.C.003", "text": "“You sound very certain.”", "revision": "1" }, { "beat_id": "beat.line.Day4.C.004", "line_id": "line.Day4.C.004", "text": "“She ties left-over-right on her welfare packages. That knot is right-over-left.”", "revision": "1" }, { "beat_id": "beat.line.Day4.C.005", "line_id": "line.Day4.C.005", "text": "A short, reluctant breath leaves Lavinia\'s nose—half laugh, half sigh. Her heel slides forward out of the shadow and settles directly into my open palm.", "revision": "1" }, { "beat_id": "beat.line.Day4.C.006", "line_id": "line.Day4.C.006", "text": "The leather at the back of the shoe is warm.", "revision": "1" }, { "beat_id": "beat.line.Day4.C.007", "line_id": "line.Day4.C.007", "text": "“You\'re insufferable,” she mutters.", "revision": "1" }, { "beat_id": "beat.line.Day4.C.008", "line_id": "line.Day4.C.008", "text": "The heel stays cradled in my left palm while my right hand undoes the square knot and folds the satin flat behind the bone. When I lift my head, our eyes meet in the mirror glass behind her shoulder, and she draws me up onto the bench beside her.", "revision": "1" }] }, { "entry_id": "Day4.D", "lines": [{ "beat_id": "beat.line.Day4.D.001", "line_id": "line.Day4.D.001", "text": "Before her shoe can settle in the shadow under the bench, five fingers of my left hand lock around the arch and heel, draw her foot out from beneath the seat, and set her heel squarely on top of my own knee.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.002", "line_id": "line.Day4.D.002", "text": "In the mirror, Lavinia\'s breath catches; her fingers tighten on the edge of the wooden bench.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.003", "line_id": "line.Day4.D.003", "text": "“Let go.”", "revision": "1" }, { "beat_id": "beat.line.Day4.D.004", "line_id": "line.Day4.D.004", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day4.D.005", "line_id": "line.Day4.D.005", "text": "Instead of easing the square knot open, my right hand catches the loose satin end and pulls it once, cleanly—stripping the square knot undone with a dry hiss of ribbon across her skin.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.006", "line_id": "line.Day4.D.006", "text": "“She ties her welfare string like that so a parcel won\'t come undone in the post,” I say quietly, my thumb pressing into the warm hollow below her outer ankle bone so she cannot slide her foot a fraction of an inch back. “Leave a square knot over your tendon for ten minutes and it will bruise the skin before you even reach the barre.”", "revision": "1" }, { "beat_id": "beat.line.Day4.D.007", "line_id": "line.Day4.D.007", "text": "“It wasn\'t hurting me,” Lavinia whispers.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.008", "line_id": "line.Day4.D.008", "text": "“It was hurting my eyes.”", "revision": "1" }, { "beat_id": "beat.line.Day4.D.009", "line_id": "line.Day4.D.009", "text": "My left palm stays wrapped around the warm tendon above her heel while my right hand crosses the pale satin twice—drawing the ribbon taut against her ankle, half a degree tighter than her usual rehearsal tension so she will feel the pressure of my fingers every time she points her foot—and tucks the flat fold behind the bone where no one else\'s hand can reach it without undoing mine.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.010", "line_id": "line.Day4.D.010", "text": "Then, without taking my left hand off her ankle, I rise and plant my right knee directly on the wooden bench between her knees—leaning in until her shoulders meet the cool surface of the wall-length mirror and my right palm presses flat over the damp waistband of her bodice where the four pencil marks were.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.011", "line_id": "line.Day4.D.011", "text": "Above my collar, Lavinia does not push my shoulder back. Instead, her right hand comes up and closes against the side of my neck—her fingers curling behind my ear, the pad of her thumb pressing hard into the pulse point just below my jaw.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.012", "line_id": "line.Day4.D.012", "text": "In the glass behind her cheek, a small pale circle of condensation forms from her breath.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.013", "line_id": "line.Day4.D.013", "text": "“You tied it too tight,” she whispers, her thumb pressing firmer into my throat.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.014", "line_id": "line.Day4.D.014", "text": "“You\'ll remember who tied it,” I whisper against the corner of her mouth, my fingers tightening on her waist.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.015", "line_id": "line.Day4.D.015", "text": "“And my ribs?” Her eyes blaze two inches from mine. “Are you going to keep your hand there until Friday so she sees it?”", "revision": "1" }, { "beat_id": "beat.line.Day4.D.016", "line_id": "line.Day4.D.016", "text": "“If I have to.”", "revision": "1" }, { "beat_id": "beat.line.Day4.D.017", "line_id": "line.Day4.D.017", "text": "For three full seconds neither of us moves in the mirror—my palm over the erased pencil marks at her waist, my other hand holding her ankle on the bench, her thumb pressed into the pulse at my throat.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.018", "line_id": "line.Day4.D.018", "text": "“Ești nebună,” she breathes in Romanian, and then in English: “You\'re completely out of your mind.”", "revision": "1" }] }, { "entry_id": "Day4.D.default", "lines": [{ "beat_id": "beat.line.Day4.D.default.001", "line_id": "line.Day4.D.default.001", "text": "Lavinia\'s thumb slides from my pulse to the back of my jaw, tilting my chin half an inch until her lower lip brushes the corner of mine—warm, sharp with honey from the pastille, neither of us calling it a kiss—before she drops her forehead hard against my collarbone while the mirror holds us both.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.default.002", "line_id": "line.Day4.D.default.002", "text": "“Sit down properly before someone walks past the door,” she whispers into my collar, her fingers still twisted in my lapel.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.default.003", "line_id": "line.Day4.D.default.003", "text": "When I slide off my knee onto the bench beside her, she does not let go of my hand; she pulls the open paperback across both our laps and sets her finger under the line where we stopped.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.default.004", "line_id": "line.Day4.D.default.004", "text": "“Go on,” she says softly, her shoulder pressed flush against mine. “Read.”", "revision": "1" }] }, { "entry_id": "Day4.D.friday", "lines": [{ "beat_id": "beat.line.Day4.D.friday.001", "line_id": "line.Day4.D.friday.001", "text": "“When did she say she was bringing the rest on Friday?” I whisper, my thumb still resting on the turn axis at her waist.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.friday.002", "line_id": "line.Day4.D.friday.002", "text": "“Before rehearsal,” Lavinia whispers back, a sudden, dangerous smile curving her mouth two inches from mine.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.friday.003", "line_id": "line.Day4.D.friday.003", "text": "“Then I\'ll be here first.”", "revision": "1" }, { "beat_id": "beat.line.Day4.D.friday.004", "line_id": "line.Day4.D.friday.004", "text": "She laughs once against my mouth, her thumb sliding from my throat to my nape as she pulls me down onto the bench beside her.", "revision": "1" }] }, { "entry_id": "Day4.D.mirror", "lines": [{ "beat_id": "beat.line.Day4.D.mirror.001", "line_id": "line.Day4.D.mirror.001", "text": "“Turn your head,” I murmur against her temple, keeping my palm warm over the damp wool at her waist. “Look in the glass.”", "revision": "1" }, { "beat_id": "beat.line.Day4.D.mirror.002", "line_id": "line.Day4.D.mirror.002", "text": "Lavinia turns her cheek half an inch against the cool mirror until her eyes meet mine in the reflection behind us—where my coat blocks the rest of the room and only my hand on her ribs is visible.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.mirror.003", "line_id": "line.Day4.D.mirror.003", "text": "“Satisfied?” she whispers to the glass.", "revision": "1" }, { "beat_id": "beat.line.Day4.D.mirror.004", "line_id": "line.Day4.D.mirror.004", "text": "“Her hand isn\'t there now.”", "revision": "1" }, { "beat_id": "beat.line.Day4.D.mirror.005", "line_id": "line.Day4.D.mirror.005", "text": "Her thumb presses once more against my jaw before she pulls me down onto the bench beside her.", "revision": "1" }] }, { "entry_id": "Day4.E", "lines": [{ "beat_id": "beat.line.Day4.E.001", "line_id": "line.Day4.E.001", "text": "Instead of reaching into the shadow under the bench, my left palm stays open just above the floorboards where her shoe stood a moment ago.", "revision": "1" }, { "beat_id": "beat.line.Day4.E.002", "line_id": "line.Day4.E.002", "text": "“You always tie a square knot when you\'re in a hurry,” I say quietly. “Nobody else touched your shoe.”", "revision": "1" }, { "beat_id": "beat.line.Day4.E.003", "line_id": "line.Day4.E.003", "text": "“You sound very certain.”", "revision": "1" }, { "beat_id": "beat.line.Day4.E.004", "line_id": "line.Day4.E.004", "text": "“She ties left-over-right on her welfare packages. That knot is right-over-left.”", "revision": "1" }, { "beat_id": "beat.line.Day4.E.005", "line_id": "line.Day4.E.005", "text": "A short, reluctant breath leaves Lavinia\'s nose—half laugh, half sigh. Her heel slides forward out of the shadow and settles directly into my open palm.", "revision": "1" }, { "beat_id": "beat.line.Day4.E.006", "line_id": "line.Day4.E.006", "text": "The leather at the back of the shoe is warm.", "revision": "1" }, { "beat_id": "beat.line.Day4.E.007", "line_id": "line.Day4.E.007", "text": "“You\'re insufferable,” she mutters.", "revision": "1" }, { "beat_id": "beat.line.Day4.E.008", "line_id": "line.Day4.E.008", "text": "The heel stays cradled in my left palm while my right hand undoes the square knot and folds the satin flat behind the bone. When I lift my head, our eyes meet in the mirror glass behind her shoulder, and she draws me up onto the bench beside her.", "revision": "1" }, { "beat_id": "beat.line.Day4.E.009", "line_id": "line.Day4.E.009", "text": "In the mirror: the bench, the barre, the white flowers in the glass jar, and the narrow strip of corridor pane behind the door.", "revision": "1" }, { "beat_id": "beat.line.Day4.E.010", "line_id": "line.Day4.E.010", "text": "The piano in the next studio stopped minutes ago. Not one shadow has crossed the frosted glass.", "revision": "1" }, { "beat_id": "beat.line.Day4.E.011", "line_id": "line.Day4.E.011", "text": "Yet the main door was unlatched by the exact width of a voice when I reached the top of the stairs.", "revision": "1" }, { "beat_id": "beat.line.Day4.E.012", "line_id": "line.Day4.E.012", "text": "You.", "revision": "1" }, { "beat_id": "beat.line.Day4.E.013", "line_id": "line.Day4.E.013", "text": "Waiting to see whether I would open it early or listen first.", "revision": "1" }, { "beat_id": "beat.line.Day4.E.014", "line_id": "line.Day4.E.014", "text": "The paper cup is warm against the lip—the exact spot on the rim where Lavinia drank.", "revision": "1" }, { "beat_id": "beat.line.Day4.E.015", "line_id": "line.Day4.E.015", "text": "Stay behind the glass if you like. The pencil marks are already gone.", "revision": "1" }] }, { "entry_id": "Day4.impulse", "lines": [{ "beat_id": "beat.line.Day4.impulse.001", "line_id": "line.Day4.impulse.001", "text": "Below the edge of the bench, the pale satin ribbon around Lavinia\'s right ankle has come undone at the cross—tied in an unfamiliar square knot right over the tendon instead of folded flat behind the ankle bone where it belongs, one loose end trailing across the rosin.", "revision": "1" }, { "beat_id": "beat.line.Day4.impulse.002", "line_id": "line.Day4.impulse.002", "text": "Kneeling on the floorboards in front of her, I gather both satin ends to untie the square knot.", "revision": "1" }, { "beat_id": "beat.line.Day4.impulse.003", "line_id": "line.Day4.impulse.003", "text": "Just as my thumbs touch the cross, her heel slides half a step backward under the bench.", "revision": "1" }, { "beat_id": "beat.line.Day4.impulse.004", "line_id": "line.Day4.impulse.004", "text": "The satin slips free.", "revision": "1" }, { "beat_id": "beat.line.Day4.impulse.005", "line_id": "line.Day4.impulse.005", "text": "“Careful,” Lavinia says softly, watching the top of my head in the mirror. “You\'ll undo her knot.”", "revision": "1" }, { "beat_id": "beat.line.Day4.impulse.006", "line_id": "line.Day4.impulse.006", "text": "My hands stop dead above the floorboards.", "revision": "1" }, { "beat_id": "beat.line.Day4.impulse.007", "line_id": "line.Day4.impulse.007", "text": "In the wall-length glass behind the bench, Lavinia\'s eyes are fixed on my face—waiting to see what that sentence does to me.", "revision": "1" }, { "beat_id": "beat.line.Day4.impulse.008", "line_id": "line.Day4.impulse.008", "text": "“You tied this yourself,” I say.", "revision": "1" }, { "beat_id": "beat.line.Day4.impulse.009", "line_id": "line.Day4.impulse.009", "text": "“Did I?”", "revision": "1" }, { "beat_id": "beat.line.Day4.impulse.010", "line_id": "line.Day4.impulse.010", "text": "“She doesn\'t know how a ballet ribbon crosses the joint.”", "revision": "1" }, { "beat_id": "beat.line.Day4.impulse.011", "line_id": "line.Day4.impulse.011", "text": "“That\'s why it\'s a square knot,” Lavinia says smoothly, and as my fingers reach for her ankle a second time, she slides her heel another three inches back into the shadow beneath the bench—an awkward angle for her knee, baiting me to chase her foot under the seat. “Leave it. It holds well enough.”", "revision": "1" }, { "beat_id": "beat.line.Day4.impulse.012", "line_id": "line.Day4.impulse.012", "text": "A square knot over the tendon. On her ankle.", "revision": "1" }, { "beat_id": "beat.line.Day4.impulse.013", "line_id": "line.Day4.impulse.013", "text": "Hold the heel where it is.", "revision": "1" }] }, { "entry_id": "Day4.pastille.default", "lines": [{ "beat_id": "beat.line.Day4.pastille.default.001", "line_id": "line.Day4.pastille.default.001", "text": "Two fingers lift the amber square neatly from the pleat of the skirt and set it on the lid of her tin.", "revision": "1" }, { "beat_id": "beat.line.Day4.pastille.default.002", "line_id": "line.Day4.pastille.default.002", "text": "“It didn\'t touch the floor.”", "revision": "1" }, { "beat_id": "beat.line.Day4.pastille.default.003", "line_id": "line.Day4.pastille.default.003", "text": "Lavinia looks at the pastille on the metal lid, then down at my bare hand still resting near her hip.", "revision": "1" }, { "beat_id": "beat.line.Day4.pastille.default.004", "line_id": "line.Day4.pastille.default.004", "text": "“Ce păcat,” she says under her breath. “You weren\'t so polite when you had your hand on my ribs.”", "revision": "1" }] }, { "entry_id": "Day4.pastille.yes", "lines": [{ "beat_id": "beat.line.Day4.pastille.yes.001", "line_id": "line.Day4.pastille.yes.001", "text": "Both knees stay on the floorboards between the edge of the bench and her shoes.", "revision": "1" }, { "beat_id": "beat.line.Day4.pastille.yes.002", "line_id": "line.Day4.pastille.yes.002", "text": "Lavinia\'s fingers stop on the rim of the open tin.", "revision": "1" }, { "beat_id": "beat.line.Day4.pastille.yes.003", "line_id": "line.Day4.pastille.yes.003", "text": "Instead of lifting my hand from the bench, my chin lowers across the wool of the wrap skirt. Beneath the cloth, the tendon at her knee pulls taut for half a breath.", "revision": "1" }, { "beat_id": "beat.line.Day4.pastille.yes.004", "line_id": "line.Day4.pastille.yes.004", "text": "My lips brush the fold of the dark wool and take the amber square cleanly. Lemon and sharp honey.", "revision": "1" }, { "beat_id": "beat.line.Day4.pastille.yes.005", "line_id": "line.Day4.pastille.yes.005", "text": "Before my head can rise, Lavinia\'s free hand comes down—fingers tangling into the hair at the nape of my neck, holding my face an inch above her knee.", "revision": "1" }, { "beat_id": "beat.line.Day4.pastille.yes.006", "line_id": "line.Day4.pastille.yes.006", "text": "“Nu te saturi niciodată,” she murmurs in Romanian.", "revision": "1" }, { "beat_id": "beat.line.Day4.pastille.yes.007", "line_id": "line.Day4.pastille.yes.007", "text": "Then, in English, her thumb grazing my right cheekbone:", "revision": "1" }, { "beat_id": "beat.line.Day4.pastille.yes.008", "line_id": "line.Day4.pastille.yes.008", "text": "“All it takes is four marks of pencil on my waist.”", "revision": "1" }, { "beat_id": "beat.line.Day4.pastille.yes.009", "line_id": "line.Day4.pastille.yes.009", "text": "“They\'re gone now.”", "revision": "1" }, { "beat_id": "beat.line.Day4.pastille.yes.010", "line_id": "line.Day4.pastille.yes.010", "text": "“The grey is still on your handkerchief.”", "revision": "1" }] }, { "entry_id": "Day5", "lines": [{ "beat_id": "beat.line.Day5.one", "line_id": "line.Day5.one", "text": "Rain strikes the high louver glass near the ceiling of Room 2.17 in uneven gusts, turning the afternoon light the color of wet slate.", "revision": "1" }, { "beat_id": "beat.line.Day5.002", "line_id": "line.Day5.002", "text": "The room is six paces from wall to wall—no eye-level window, only the slanted ceiling louvers streaming with water above and the tall frosted glass pane of the corridor door. Above the doorframe, the metal louver of the ceiling vent hums softly, sending a cool draft across the terrazzo floor toward the door side of the table.", "revision": "1" }, { "beat_id": "beat.line.Day5.003", "line_id": "line.Day5.003", "text": "There are two chairs in the room: a curved-back wooden chair standing in the sheltered corner under the warm amber wall lamp, out of the vent draft, and a narrower flat-slat chair on the cold side of the table near the door.", "revision": "1" }, { "beat_id": "beat.line.Day5.004", "line_id": "line.Day5.004", "text": "I leave the curved-back chair in the sheltered corner empty and sit on the cold side of the table.", "revision": "1" }, { "beat_id": "beat.line.Day5.005", "line_id": "line.Day5.005", "text": "A moment later, the door swings inward. Lavinia steps across the threshold, shaking rain from the collar of her coat.", "revision": "1" }, { "beat_id": "beat.line.Day5.006", "line_id": "line.Day5.006", "text": "“You were waiting,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day5.007", "line_id": "line.Day5.007", "text": "“I came in early.”", "revision": "1" }, { "beat_id": "beat.line.Day5.008", "line_id": "line.Day5.008", "text": "Before the door latch has settled behind her back, a tall shadow slows outside in the corridor. Through the frosted glass panel, the blurred silhouette of a flat cardboard portfolio rests under a left arm.", "revision": "1" }, { "beat_id": "beat.line.Day5.009", "line_id": "line.Day5.009", "text": "No knock comes.", "revision": "1" }, { "beat_id": "beat.line.Day5.010", "line_id": "line.Day5.010", "text": "Instead, a left hand rises outside the pane, slips the slotted loop of a white card over the outer brass handle, and smooths the paper flat against the glass before footsteps recede quietly down the hall.", "revision": "1" }, { "beat_id": "beat.line.Day5.011", "line_id": "line.Day5.011", "text": "Through the frosted glass, the black lettering floats in reverse at the height of Lavinia\'s shoulder:", "revision": "1" }, { "beat_id": "beat.line.Day5.012", "line_id": "line.Day5.012", "text": "Quiet assessment in progress. Please do not disturb.", "revision": "1" }, { "beat_id": "beat.line.Day5.013", "line_id": "line.Day5.013", "text": "Lavinia glances once at the reversed letters on the glass, then looks down at the curved-back wooden chair standing in the warm corner under the wall lamp—and at the plain chair I took in the draft by the door.", "revision": "1" }, { "beat_id": "beat.line.Day5.014", "line_id": "line.Day5.014", "text": "Before she sits, two fingertips of her right hand rest for half a second on the top rail of the curved chair back.", "revision": "1" }, { "beat_id": "beat.line.Day5.015", "line_id": "line.Day5.015", "text": "Then both of her hands take the chair by its back, lift it clear of the floor, and set it down ninety degrees from the table—facing my chair directly.", "revision": "1" }, { "beat_id": "beat.line.Day5.016", "line_id": "line.Day5.016", "text": "When she sits, less than two inches remain between our knees.", "revision": "1" }, { "beat_id": "beat.line.Day5.017", "line_id": "line.Day5.017", "text": "“Is the chair comfortable?” I ask.", "revision": "1" }, { "beat_id": "beat.line.Day5.018", "line_id": "line.Day5.018", "text": "“It was facing the table.”", "revision": "1" }, { "beat_id": "beat.line.Day5.019", "line_id": "line.Day5.019", "text": "“You changed that.”", "revision": "1" }, { "beat_id": "beat.line.Day5.020", "line_id": "line.Day5.020", "text": "“Yes.”", "revision": "1" }, { "beat_id": "beat.line.Day5.021", "line_id": "line.Day5.021", "text": "From her chosen angle, the programme folder on the desk cannot be read without turning her head away from my face.", "revision": "1" }, { "beat_id": "beat.line.Day5.022", "line_id": "line.Day5.022", "text": "The chair stays where she set it; only the folder moves—lifted across the corner of the table into her direct line of sight.", "revision": "1" }, { "beat_id": "beat.line.Day5.023", "line_id": "line.Day5.023", "text": "“You move everything,” Lavinia says.", "revision": "1" }, { "beat_id": "beat.line.Day5.024", "line_id": "line.Day5.024", "text": "“Only the folder.”", "revision": "1" }, { "beat_id": "beat.line.Day5.025", "line_id": "line.Day5.025", "text": "Outside in the corridor, two sets of footsteps approach the door. Their tall, headless shadows stretch through the frosted glass across the ceiling and slide down the wall behind Lavinia\'s throat—slowing beside the reversed white card on the handle, dropping to a murmur, and passing on.", "revision": "1" }, { "beat_id": "beat.line.Day5.026", "line_id": "line.Day5.026", "text": "Inside the six-pace room, Lavinia picks up the red pencil. For a while the only sound under the rain is the turn of paper as we check the staging sequence—where my draft shortened the transition walk from the wings so she does not cross the full diagonal before the variation.", "revision": "1" }, { "beat_id": "beat.line.Day5.027", "line_id": "line.Day5.027", "text": "Lavinia\'s eyes linger on that shortened stage-cross note for a beat. She does not object to it. Instead, the tip of her red pencil stops two lines lower, beneath the sentence describing the performance for visitors.", "revision": "1" }, { "beat_id": "beat.line.Day5.028", "line_id": "line.Day5.028", "text": "“You wrote will,” she says, striking a single red line through the word.", "revision": "1" }, { "beat_id": "beat.line.Day5.029", "line_id": "line.Day5.029", "text": "“You crossed it out.”", "revision": "1" }, { "beat_id": "beat.line.Day5.030", "line_id": "line.Day5.030", "text": "“I noticed.”", "revision": "1" }, { "beat_id": "beat.line.Day5.031", "line_id": "line.Day5.031", "text": "“There are two more,” I say, touching a fingertip to the lower margin instead of taking the pencil from her hand.", "revision": "1" }, { "beat_id": "beat.line.Day5.032", "line_id": "line.Day5.032", "text": "Lavinia looks from my finger to my face, then draws two clean red lines through the remaining modal verbs. By the bottom of the sheet, the page holds a third version that neither of us would have written alone.", "revision": "1" }, { "beat_id": "beat.line.Day5.033", "line_id": "line.Day5.033", "text": "As Lavinia sets the red pencil down, the cuff of her cardigan brushes a black pen lying at the upper edge of the desk blotter.", "revision": "1" }, { "beat_id": "beat.line.Day5.034", "line_id": "line.Day5.034", "text": "Pinned beneath the barrel is a small square of yellow paper, folded once on a slight left-handed diagonal and pressed flat with the side of a thumbnail.", "revision": "1" }, { "beat_id": "beat.line.Day5.035", "line_id": "line.Day5.035", "text": "When Lavinia\'s sleeve shifts the pen, the yellow fold springs half-open against the wood.", "revision": "1" }, { "beat_id": "beat.line.Day5.036", "line_id": "line.Day5.036", "text": "Inside, in Sylvia\'s neat, upright hand, are two lines:", "revision": "1" }, { "beat_id": "beat.line.Day5.037", "line_id": "line.Day5.037", "text": "I moved the curved chair out of the vent draft. That corner stays warmer.", "revision": "1" }, { "beat_id": "beat.line.Day5.038", "line_id": "line.Day5.038", "text": "My hand stops on the edge of the folder.", "revision": "1" }, { "beat_id": "beat.line.Day5.039", "line_id": "line.Day5.039", "text": "Lavinia\'s fingers rest on the barrel of the black pen. She reads the two lines once, looks down at the curved wooden arm under her elbow, and then looks across at my chair in the cold draft by the door.", "revision": "1" }, { "beat_id": "beat.line.Day5.040", "line_id": "line.Day5.040", "text": "“You didn\'t move this chair,” she says quietly.", "revision": "1" }, { "beat_id": "beat.line.Day5.041", "line_id": "line.Day5.041", "text": "“It was there when I came in.”", "revision": "1" }, { "beat_id": "beat.line.Day5.042", "line_id": "line.Day5.042", "text": "“And you took the other one.”", "revision": "1" }, { "beat_id": "beat.line.Day5.043", "line_id": "line.Day5.043", "text": "Without lifting her eyes from mine, Lavinia\'s thumb nudges the black pen across the polished wood—pushing the folded yellow slip ahead of the barrel, half an inch, another inch—until both the pen and the yellow note slide over the far edge of the desk and drop into the wastepaper basket beside the table leg.", "revision": "1" }, { "beat_id": "beat.line.Day5.044", "line_id": "line.Day5.044", "text": "“The red pencil works better,” she says evenly.", "revision": "1" }, { "beat_id": "beat.line.Day5.045", "line_id": "line.Day5.045", "text": "Before my hand can move toward the basket, her other hand draws her phone from her coat pocket.", "revision": "1" }, { "beat_id": "beat.line.Day5.046", "line_id": "line.Day5.046", "text": "The camera shutter clicks once in the six-pace room.", "revision": "1" }, { "beat_id": "beat.line.Day5.047", "line_id": "line.Day5.047", "text": "“Don\'t.”", "revision": "1" }, { "beat_id": "beat.line.Day5.048", "line_id": "line.Day5.048", "text": "“You took mine on Monday\'s screen.”", "revision": "1" }, { "beat_id": "beat.line.Day5.049", "line_id": "line.Day5.049", "text": "“That was Sylvia\'s phone.”", "revision": "1" }, { "beat_id": "beat.line.Day5.050", "line_id": "line.Day5.050", "text": "“And this is mine.”", "revision": "1" }, { "beat_id": "beat.line.Day5.051", "line_id": "line.Day5.051", "text": "The small rectangle of light tilts toward her chin—reflected twice in the dark, rain-streaked louver panes near the ceiling.", "revision": "1" }, { "beat_id": "beat.line.Day5.052", "line_id": "line.Day5.052", "text": "“Delete it,” I say.", "revision": "1" }, { "beat_id": "beat.line.Day5.053", "line_id": "line.Day5.053", "text": "Lavinia looks down at the image on her glass, then up at me.", "revision": "1" }, { "beat_id": "beat.line.Day5.054", "line_id": "line.Day5.054", "text": "“May I keep it? Just for myself.”", "revision": "1" }, { "beat_id": "beat.line.Day5.055", "line_id": "line.Day5.055", "text": "“You knew I didn\'t want one taken.”", "revision": "1" }, { "beat_id": "beat.line.Day5.056", "line_id": "line.Day5.056", "text": "“I know.”", "revision": "1" }, { "beat_id": "beat.line.Day5.057", "line_id": "line.Day5.057", "text": "I lean forward across the two-inch gap between our chairs to see the screen.", "revision": "1" }, { "beat_id": "beat.line.Day5.058", "line_id": "line.Day5.058", "text": "In the photograph, my hand is still half-raised above the empty corner of the blotter where the yellow slip lay a second ago, my mouth unarranged.", "revision": "1" }] }, { "entry_id": "Day5.A", "lines": [{ "beat_id": "beat.line.Day5.A.001", "line_id": "line.Day5.A.001", "text": "“That one isn\'t due today. That is all.” The second folder stays closed on the wood. “Let me see the screen.”", "revision": "1" }, { "beat_id": "beat.line.Day5.A.002", "line_id": "line.Day5.A.002", "text": "Lavinia turns the phone around. In the frame: eyes looking straight into the lens, one hand half-raised above the blotter.", "revision": "1" }, { "beat_id": "beat.line.Day5.A.003", "line_id": "line.Day5.A.003", "text": "“This one,” I say quietly. “Don\'t send it to anyone.”", "revision": "1" }, { "beat_id": "beat.line.Day5.A.004", "line_id": "line.Day5.A.004", "text": "“I won\'t.”", "revision": "1" }, { "beat_id": "beat.line.Day5.A.005", "line_id": "line.Day5.A.005", "text": "She switches off the screen and slips the phone into her coat pocket. At the door, her hand pauses on the inner latch without turning the wooden chair back to the desk.", "revision": "1" }, { "beat_id": "beat.line.Day5.A.006", "line_id": "line.Day5.A.006", "text": "“Tomorrow evening,” she says. “My flat.”", "revision": "1" }] }, { "entry_id": "Day5.B", "lines": [{ "beat_id": "beat.line.Day5.B.001", "line_id": "line.Day5.B.001", "text": "Fingertips touch the cardboard cover of the second folder, then draw back.", "revision": "1" }, { "beat_id": "beat.line.Day5.B.002", "line_id": "line.Day5.B.002", "text": "“There is another folder, but it can wait,” I say. “Delete the picture first.”", "revision": "1" }, { "beat_id": "beat.line.Day5.B.003", "line_id": "line.Day5.B.003", "text": "Lavinia looks at my hand leaving the folder, then down at the phone in her lap.", "revision": "1" }, { "beat_id": "beat.line.Day5.B.004", "line_id": "line.Day5.B.004", "text": "“You\'re certain?”", "revision": "1" }, { "beat_id": "beat.line.Day5.B.005", "line_id": "line.Day5.B.005", "text": "“Yes.”", "revision": "1" }, { "beat_id": "beat.line.Day5.B.006", "line_id": "line.Day5.B.006", "text": "Two taps on the glass; she turns the empty camera roll toward the desk, stands, and leaves the wooden chair still facing mine. At the door, she takes the reversed white card off the outer handle and drops it onto my desk blotter.", "revision": "1" }, { "beat_id": "beat.line.Day5.B.007", "line_id": "line.Day5.B.007", "text": "“Tomorrow evening,” she says. “My flat.”", "revision": "1" }] }, { "entry_id": "Day5.C", "lines": [{ "beat_id": "beat.line.Day5.C.001", "line_id": "line.Day5.C.001", "text": "“The visitor notes are still inconsistent,” I say, resting a hand on the second folder.", "revision": "1" }, { "beat_id": "beat.line.Day5.C.002", "line_id": "line.Day5.C.002", "text": "“They are not due today.”", "revision": "1" }, { "beat_id": "beat.line.Day5.C.003", "line_id": "line.Day5.C.003", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day5.C.004", "line_id": "line.Day5.C.004", "text": "Lavinia glances at the frosted pane where the reversed notice hangs, then at the second folder.", "revision": "1" }, { "beat_id": "beat.line.Day5.C.005", "line_id": "line.Day5.C.005", "text": "“Show me,” she says. “And I\'m keeping the photograph.”", "revision": "1" }, { "beat_id": "beat.line.Day5.C.006", "line_id": "line.Day5.C.006", "text": "“Don\'t show it to anyone.”", "revision": "1" }, { "beat_id": "beat.line.Day5.C.007", "line_id": "line.Day5.C.007", "text": "“Who would I show it to?”", "revision": "1" }, { "beat_id": "beat.line.Day5.C.008", "line_id": "line.Day5.C.008", "text": "She pulls the second folder across the two-inch gap between the chairs and opens it across her knees. When we finish, she closes the folder.", "revision": "1" }, { "beat_id": "beat.line.Day5.C.009", "line_id": "line.Day5.C.009", "text": "“Tomorrow evening,” she says. “Come to the flat.”", "revision": "1" }] }, { "entry_id": "Day5.D", "lines": [{ "beat_id": "beat.line.Day5.D.001", "line_id": "line.Day5.D.001", "text": "The second folder slides across the edge of the desk until its first page overlaps her knee.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.002", "line_id": "line.Day5.D.002", "text": "“The visitor notes are still inconsistent,” I say.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.003", "line_id": "line.Day5.D.003", "text": "“They are not due today.”", "revision": "1" }, { "beat_id": "beat.line.Day5.D.004", "line_id": "line.Day5.D.004", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day5.D.005", "line_id": "line.Day5.D.005", "text": "“And if I don\'t feel like checking them?”", "revision": "1" }, { "beat_id": "beat.line.Day5.D.006", "line_id": "line.Day5.D.006", "text": "Four fingers of my left hand rest across the top edge of her phone—not taking it from her palm, only tilting the lit screen down against the dark wool of her skirt.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.007", "line_id": "line.Day5.D.007", "text": "“Then delete the photograph before you open the door,” I say softly. “Or stay until the second folder is finished, and you may keep it.”", "revision": "1" }, { "beat_id": "beat.line.Day5.D.008", "line_id": "line.Day5.D.008", "text": "In the slate-grey light of the six-pace room, Lavinia\'s eyes narrow.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.009", "line_id": "line.Day5.D.009", "text": "“You\'re bargaining with me.”", "revision": "1" }, { "beat_id": "beat.line.Day5.D.010", "line_id": "line.Day5.D.010", "text": "“You asked whether you could keep it.”", "revision": "1" }, { "beat_id": "beat.line.Day5.D.011", "line_id": "line.Day5.D.011", "text": "Three seconds of silence. Outside in the corridor, a distant bell rings and fades behind the notice on the glass.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.012", "line_id": "line.Day5.D.012", "text": "Lavinia clicks the phone screen dark and drops it into her coat pocket.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.013", "line_id": "line.Day5.D.013", "text": "Then she hooks the toe of her right shoe behind the front wooden leg of my chair and pulls it sharply forward—sliding my chair two inches closer until our knees lock together beneath the desk edge and my right thigh is caught squarely between hers.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.014", "line_id": "line.Day5.D.014", "text": "The force of dragging my chair slips the rain-wet leather heel of her loafer off her foot.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.015", "line_id": "line.Day5.D.015", "text": "Under the table, without looking down, she lifts her stockinged foot and presses the rain-soaked arch against the inside of my ankle—sliding the wet nylon slowly up my shin, wiping the cold rainwater from her heel onto my skin and hem until the clammy chill soaks through to the bone and her own foot warms against my calf.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.016", "line_id": "line.Day5.D.016", "text": "My leg shivers once; her knees close firmer around my thigh to hold my shin still against her wet sole.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.017", "line_id": "line.Day5.D.017", "text": "She picks up the red pencil and sets her free hand flat over my knee.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.018", "line_id": "line.Day5.D.018", "text": "“Your ankle was dry,” she says quietly.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.019", "line_id": "line.Day5.D.019", "text": "“Yours is wet.”", "revision": "1" }, { "beat_id": "beat.line.Day5.D.020", "line_id": "line.Day5.D.020", "text": "“Not anymore. Open page one.”", "revision": "1" }] }, { "entry_id": "Day5.D.arch", "lines": [{ "beat_id": "beat.line.Day5.D.arch.001", "line_id": "line.Day5.D.arch.001", "text": "Before opening the folder, my left hand slides down under the desk edge and closes directly around the damp arch of her stockinged foot—holding her heel against the wet patch on my shin until both the nylon and my palm are warm.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.arch.002", "line_id": "line.Day5.D.arch.002", "text": "Lavinia\'s fingers tighten on the red pencil.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.arch.003", "line_id": "line.Day5.D.arch.003", "text": "“Open page one,” she whispers, leaving her foot in my hand beneath the table.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.arch.004", "line_id": "line.Day5.D.arch.004", "text": "When the last page is turned, she slides her warmed foot back into her loafer, leaving my ankle damp and chilled.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.arch.005", "line_id": "line.Day5.D.arch.005", "text": "“Tomorrow night,” she says softly. “At my flat.”", "revision": "1" }] }, { "entry_id": "Day5.D.default", "lines": [{ "beat_id": "beat.line.Day5.D.default.001", "line_id": "line.Day5.D.default.001", "text": "With my thigh locked between her knees and the cold, damp streak from her stocking clinging to my shin beneath the desk, I open the first page of the visitor notes across both our laps.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.default.002", "line_id": "line.Day5.D.default.002", "text": "Neither of us moves the chairs apart; even after her foot warms against my calf, the damp patch she wiped onto my skin stays cold in the vent draft from the door.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.default.003", "line_id": "line.Day5.D.default.003", "text": "When the last page is turned, she slides her warmed foot back into her loafer, leaving my ankle damp and chilled.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.default.004", "line_id": "line.Day5.D.default.004", "text": "“Tomorrow night,” she says softly. “At my flat.”", "revision": "1" }] }, { "entry_id": "Day5.D.note", "lines": [{ "beat_id": "beat.line.Day5.D.note.001", "line_id": "line.Day5.D.note.001", "text": "Keeping my wet shin pressed against her foot, I reach down into the wastepaper basket beside the table leg, lift out only the folded yellow slip—leaving the black pen at the bottom—and tear the yellow paper cleanly in half across the desk blotter.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.note.002", "line_id": "line.Day5.D.note.002", "text": "Lavinia watches the two halves drop back into the bin, her foot pressing once more against the wet patch on my ankle.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.note.003", "line_id": "line.Day5.D.note.003", "text": "“Open page one,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.note.004", "line_id": "line.Day5.D.note.004", "text": "When the last page is turned, she slides her warmed foot back into her loafer, leaving my ankle damp and chilled.", "revision": "1" }, { "beat_id": "beat.line.Day5.D.note.005", "line_id": "line.Day5.D.note.005", "text": "“Tomorrow night,” she says softly. “At my flat.”", "revision": "1" }] }, { "entry_id": "Day5.E", "lines": [{ "beat_id": "beat.line.Day5.E.001", "line_id": "line.Day5.E.001", "text": "“The visitor notes are still inconsistent,” I say, resting a hand on the second folder.", "revision": "1" }, { "beat_id": "beat.line.Day5.E.002", "line_id": "line.Day5.E.002", "text": "“They are not due today.”", "revision": "1" }, { "beat_id": "beat.line.Day5.E.003", "line_id": "line.Day5.E.003", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day5.E.004", "line_id": "line.Day5.E.004", "text": "Lavinia glances at the frosted pane where the reversed notice hangs, then at the second folder.", "revision": "1" }, { "beat_id": "beat.line.Day5.E.005", "line_id": "line.Day5.E.005", "text": "“Show me,” she says. “And I\'m keeping the photograph.”", "revision": "1" }, { "beat_id": "beat.line.Day5.E.006", "line_id": "line.Day5.E.006", "text": "“Don\'t show it to anyone.”", "revision": "1" }, { "beat_id": "beat.line.Day5.E.007", "line_id": "line.Day5.E.007", "text": "“Who would I show it to?”", "revision": "1" }, { "beat_id": "beat.line.Day5.E.008", "line_id": "line.Day5.E.008", "text": "She pulls the second folder across the two-inch gap between the chairs and opens it across her knees.", "revision": "1" }, { "beat_id": "beat.line.Day5.E.009", "line_id": "line.Day5.E.009", "text": "Through the frosted door pane, the reversed black letters of the notice hang without moving.", "revision": "1" }, { "beat_id": "beat.line.Day5.E.010", "line_id": "line.Day5.E.010", "text": "Sylvia walked down this corridor with a drawing pad under her arm. Yet the yellow slip under the pen was written on paper from a pad that hasn\'t been stocked in this building since last winter.", "revision": "1" }, { "beat_id": "beat.line.Day5.E.011", "line_id": "line.Day5.E.011", "text": "And three different shadows have stopped outside the frosted glass, each one arriving at the exact second Lavinia\'s hand moved toward her coat pocket.", "revision": "1" }, { "beat_id": "beat.line.Day5.E.012", "line_id": "line.Day5.E.012", "text": "You.", "revision": "1" }, { "beat_id": "beat.line.Day5.E.013", "line_id": "line.Day5.E.013", "text": "You like small rooms, don\'t you?", "revision": "1" }, { "beat_id": "beat.line.Day5.E.014", "line_id": "line.Day5.E.014", "text": "Lavinia turns a page against my knee.", "revision": "1" }, { "beat_id": "beat.line.Day5.E.015", "line_id": "line.Day5.E.015", "text": "Leave the card on the handle a little longer. The second folder has twelve pages.", "revision": "1" }, { "beat_id": "beat.line.Day5.E.016", "line_id": "line.Day5.E.016", "text": "When we finish, she closes the folder.", "revision": "1" }, { "beat_id": "beat.line.Day5.E.017", "line_id": "line.Day5.E.017", "text": "“Tomorrow evening,” she says. “Come to the flat.”", "revision": "1" }] }, { "entry_id": "Day5.cheek", "lines": [{ "beat_id": "beat.line.Day5.cheek.001", "line_id": "line.Day5.cheek.001", "text": "At the corner of my mouth, a smile begins—and stops halfway as the muscle at the right cheekbone pulls slightly.", "revision": "1" }, { "beat_id": "beat.line.Day5.cheek.002", "line_id": "line.Day5.cheek.002", "text": "Lavinia\'s gaze leaves the lit screen and fixes on my right cheek.", "revision": "1" }, { "beat_id": "beat.line.Day5.cheek.003", "line_id": "line.Day5.cheek.003", "text": "“Does it still hurt?” she asks quietly.", "revision": "1" }, { "beat_id": "beat.line.Day5.cheek.004", "line_id": "line.Day5.cheek.004", "text": "Bring her hand to the cheek and say it doesn\'t hurt now.", "revision": "1" }] }, { "entry_id": "Day5.cheek.default", "lines": [{ "beat_id": "beat.line.Day5.cheek.default.001", "line_id": "line.Day5.cheek.default.001", "text": "“Only when someone makes me laugh too quickly.” Both of my hands stay flat on the margin of the folder.", "revision": "1" }, { "beat_id": "beat.line.Day5.cheek.default.002", "line_id": "line.Day5.cheek.default.002", "text": "Lavinia studies the cheekbone for a second, then lifts two fingers of her own accord and hooks a strand of hair behind my right ear.", "revision": "1" }, { "beat_id": "beat.line.Day5.cheek.default.003", "line_id": "line.Day5.cheek.default.003", "text": "“Then don\'t laugh,” she says softly.", "revision": "1" }, { "beat_id": "beat.line.Day5.cheek.default.004", "line_id": "line.Day5.cheek.default.004", "text": "Her knuckle grazes the mark once before her hand covers the phone screen again.", "revision": "1" }] }, { "entry_id": "Day5.cheek.yes", "lines": [{ "beat_id": "beat.line.Day5.cheek.yes.001", "line_id": "line.Day5.cheek.yes.001", "text": "My fingers close lightly around Lavinia\'s free wrist and guide her palm flat against my right cheek.", "revision": "1" }, { "beat_id": "beat.line.Day5.cheek.yes.002", "line_id": "line.Day5.cheek.yes.002", "text": "“Not now.”", "revision": "1" }, { "beat_id": "beat.line.Day5.cheek.yes.003", "line_id": "line.Day5.cheek.yes.003", "text": "The skin of her palm is cool from the rain outside. For a second her fingers lie still over the cheekbone.", "revision": "1" }, { "beat_id": "beat.line.Day5.cheek.yes.004", "line_id": "line.Day5.cheek.yes.004", "text": "“Let go of my hand,” she says softly.", "revision": "1" }, { "beat_id": "beat.line.Day5.cheek.yes.005", "line_id": "line.Day5.cheek.yes.005", "text": "My fingers open and release her wrist.", "revision": "1" }, { "beat_id": "beat.line.Day5.cheek.yes.006", "line_id": "line.Day5.cheek.yes.006", "text": "Lavinia\'s hand does not leave my face. It stays there for a beat—and then the pad of her thumb presses firmer into the cheekbone, steady and deliberate, until the back of my head touches the wooden upright of the chair.", "revision": "1" }, { "beat_id": "beat.line.Day5.cheek.yes.007", "line_id": "line.Day5.cheek.yes.007", "text": "Outside the frosted glass, a tall shadow pauses in the corridor, reads the reversed card on the handle, and glides past.", "revision": "1" }, { "beat_id": "beat.line.Day5.cheek.yes.008", "line_id": "line.Day5.cheek.yes.008", "text": "I do not turn my head away from her thumb. My eyes stay open on hers until the pressure eases and her hand returns to her lap.", "revision": "1" }] }, { "entry_id": "Day5.impulse", "lines": [{ "beat_id": "beat.line.Day5.impulse.001", "line_id": "line.Day5.impulse.001", "text": "Lavinia\'s thumb rests on the side button of her phone, the portrait still open on the glass.", "revision": "1" }, { "beat_id": "beat.line.Day5.impulse.002", "line_id": "line.Day5.impulse.002", "text": "Beside her elbow on the corner of the desk lies a second folder—visitor notes, real work, not due today.", "revision": "1" }, { "beat_id": "beat.line.Day5.impulse.003", "line_id": "line.Day5.impulse.003", "text": "Rain thickens against the high louver window. On the outer handle, the reversed white card keeps the hallway empty.", "revision": "1" }, { "beat_id": "beat.line.Day5.impulse.004", "line_id": "line.Day5.impulse.004", "text": "“Are we finished for today?” Lavinia asks, her eyes dropping to the second folder beside her sleeve.", "revision": "1" }, { "beat_id": "beat.line.Day5.impulse.005", "line_id": "line.Day5.impulse.005", "text": "Open the second folder and make her pay for the photograph with another hour.", "revision": "1" }] }, { "entry_id": "Day6", "lines": [{ "beat_id": "beat.line.Day6.one", "line_id": "line.Day6.one", "text": "At the top of the stairs, my right hand rises to knock on the flat door; my left hand holds the closed long black umbrella.", "revision": "1" }, { "beat_id": "beat.line.Day6.002", "line_id": "line.Day6.002", "text": "Just before my knuckles reach the wood, the door swings inward.", "revision": "1" }, { "beat_id": "beat.line.Day6.003", "line_id": "line.Day6.003", "text": "Lavinia stands on the threshold in her stockinged feet. Without a word, her hand takes the closed long umbrella from my left hand and sets it inside the hallway stand.", "revision": "1" }, { "beat_id": "beat.line.Day6.004", "line_id": "line.Day6.004", "text": "My raised right hand stays arrested in the air for half a beat—then redirects two inches to the wooden doorjamb and completes one light, exact knock against the frame.", "revision": "1" }, { "beat_id": "beat.line.Day6.005", "line_id": "line.Day6.005", "text": "Lavinia watches the knuckles finish the knock against the wood before she steps back to let me cross the threshold.", "revision": "1" }, { "beat_id": "beat.line.Day6.006", "line_id": "line.Day6.006", "text": "In the narrow kitchen off the hall, the kettle switch clicks down on the first press.", "revision": "1" }, { "beat_id": "beat.line.Day6.007", "line_id": "line.Day6.007", "text": "No need to look for the light switch; the pale strip under the upper cabinet is already on.", "revision": "1" }, { "beat_id": "beat.line.Day6.008", "line_id": "line.Day6.008", "text": "Right hand to the second cupboard from the window: two thin porcelain cups on the lower shelf, the one with the hairline chip turned toward the wall so only my own fingers will take it. Left hand to the tin behind the flour jar: loose black tea, then the small square honey pot.", "revision": "1" }, { "beat_id": "beat.line.Day6.009", "line_id": "line.Day6.009", "text": "Beside the sink, on the wire drying rack, sits a third mug—heavy blue stoneware, not part of the flat\'s set. Three clear drops of water still cling to the inner rim, and the handle is turned to the left.", "revision": "1" }, { "beat_id": "beat.line.Day6.010", "line_id": "line.Day6.010", "text": "On the threshold behind the counter, Lavinia\'s stockinged feet come to a stop.", "revision": "1" }, { "beat_id": "beat.line.Day6.011", "line_id": "line.Day6.011", "text": "In the dark glass of the kitchen window above the sink, her reflection leans one shoulder against the doorframe, arms folded over her cardigan, watching my hands at the counter.", "revision": "1" }, { "beat_id": "beat.line.Day6.012", "line_id": "line.Day6.012", "text": "“You still remember where the honey is,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day6.013", "line_id": "line.Day6.013", "text": "“It hasn\'t moved.”", "revision": "1" }, { "beat_id": "beat.line.Day6.014", "line_id": "line.Day6.014", "text": "“The cups moved.”", "revision": "1" }, { "beat_id": "beat.line.Day6.015", "line_id": "line.Day6.015", "text": "“Only to the left side of the shelf.”", "revision": "1" }, { "beat_id": "beat.line.Day6.016", "line_id": "line.Day6.016", "text": "My fingers lift the heavy blue stoneware mug from the wire rack, dry its base once with the dish towel, and place it on the highest shelf above the refrigerator—behind the glass salad bowl, out of sight from the doorway.", "revision": "1" }, { "beat_id": "beat.line.Day6.017", "line_id": "line.Day6.017", "text": "In the window glass above the sink, the corner of Lavinia\'s mouth curves.", "revision": "1" }, { "beat_id": "beat.line.Day6.018", "line_id": "line.Day6.018", "text": "“She brought soup on Wednesday,” Lavinia says calmly. “After the exhibition.”", "revision": "1" }, { "beat_id": "beat.line.Day6.019", "line_id": "line.Day6.019", "text": "“How thoughtful of her,” I say, opening the tea tin. “She always likes to leave a container she has to come back for.”", "revision": "1" }, { "beat_id": "beat.line.Day6.020", "line_id": "line.Day6.020", "text": "Lavinia steps out of the doorway and comes up beside my elbow at the counter, close enough that her sleeve brushes mine as I measure one spoonful of loose leaves into the warmed pot.", "revision": "1" }, { "beat_id": "beat.line.Day6.021", "line_id": "line.Day6.021", "text": "“A little more,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day6.022", "line_id": "line.Day6.022", "text": "I pause with the spoon above the tin. “You used to say a second spoonful made it bitter.”", "revision": "1" }, { "beat_id": "beat.line.Day6.023", "line_id": "line.Day6.023", "text": "“I tried it your way,” she says, looking down into the dark leaves. “I like it stronger now.”", "revision": "1" }, { "beat_id": "beat.line.Day6.024", "line_id": "line.Day6.024", "text": "Half a spoonful more drops into the pot.", "revision": "1" }, { "beat_id": "beat.line.Day6.025", "line_id": "line.Day6.025", "text": "“Like that?”", "revision": "1" }, { "beat_id": "beat.line.Day6.026", "line_id": "line.Day6.026", "text": "“Yes.”", "revision": "1" }, { "beat_id": "beat.line.Day6.027", "line_id": "line.Day6.027", "text": "Boiling water fills the porcelain pot, and we carry the tray into the living room.", "revision": "1" }, { "beat_id": "beat.line.Day6.028", "line_id": "line.Day6.028", "text": "As I set the tray on the low table, my hand goes to the wall switch beside the bookcase and clicks off the overhead bulb—leaving only the low amber shade in the corner and the pale blue square of the television across the rug.", "revision": "1" }, { "beat_id": "beat.line.Day6.029", "line_id": "line.Day6.029", "text": "Lavinia does not look up from the sofa cushion as the ceiling light goes out.", "revision": "1" }, { "beat_id": "beat.line.Day6.030", "line_id": "line.Day6.030", "text": "“The glare?” she asks.", "revision": "1" }, { "beat_id": "beat.line.Day6.031", "line_id": "line.Day6.031", "text": "“It reflects in the screen.”", "revision": "1" }, { "beat_id": "beat.line.Day6.032", "line_id": "line.Day6.032", "text": "“It never bothered you before.”", "revision": "1" }, { "beat_id": "beat.line.Day6.033", "line_id": "line.Day6.033", "text": "Rain streaking the dark window pane above the sofa.", "revision": "1" }, { "beat_id": "beat.line.Day6.034", "line_id": "line.Day6.034", "text": "On the rug beside the low table, a practice skirt still damp at the hem, her head resting back against the wool cushion under the white ceiling bulb.", "revision": "1" }, { "beat_id": "beat.line.Day6.035", "line_id": "line.Day6.035", "text": "Laying the back of a cool wrist across her closed eyelids to block the glare; her eyelashes brushing once against the skin before the hand rises to click the wall switch down.", "revision": "1" }, { "beat_id": "beat.line.Day6.036", "line_id": "line.Day6.036", "text": "From the corner of the sofa, Lavinia looks toward the television.", "revision": "1" }, { "beat_id": "beat.line.Day6.037", "line_id": "line.Day6.037", "text": "“They\'ve been in that corridor for ten minutes,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day6.038", "line_id": "line.Day6.038", "text": "“Nine,” I say.", "revision": "1" }, { "beat_id": "beat.line.Day6.039", "line_id": "line.Day6.039", "text": "“That isn\'t better.”", "revision": "1" }, { "beat_id": "beat.line.Day6.040", "line_id": "line.Day6.040", "text": "“No. He\'s opened the same door four times without once checking the latch first.” My fingers tap once against the rim of the saucer. “If he wanted to be inside the room, he\'d have taken the key by now.”", "revision": "1" }, { "beat_id": "beat.line.Day6.041", "line_id": "line.Day6.041", "text": "On the screen, the man in the wet raincoat opens a heavy mahogany door, steps through the frame, and finds himself walking down the exact same carpeted corridor from the opposite end.", "revision": "1" }, { "beat_id": "beat.line.Day6.042", "line_id": "line.Day6.042", "text": "“We could stop it,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day6.043", "line_id": "line.Day6.043", "text": "“I\'d like to see whether he ever reaches a room.”", "revision": "1" }, { "beat_id": "beat.line.Day6.044", "line_id": "line.Day6.044", "text": "Lavinia settles back against the cushion. The pale blue light from the television moves across the hollow of her throat and the corner of her mouth.", "revision": "1" }, { "beat_id": "beat.line.Day6.045", "line_id": "line.Day6.045", "text": "Without turning her head toward my chair, she asks: “What did he just take out of his pocket?”", "revision": "1" }, { "beat_id": "beat.line.Day6.046", "line_id": "line.Day6.046", "text": "Silence for a beat.", "revision": "1" }, { "beat_id": "beat.line.Day6.047", "line_id": "line.Day6.047", "text": "“A key?” I say.", "revision": "1" }, { "beat_id": "beat.line.Day6.048", "line_id": "line.Day6.048", "text": "“He didn\'t put his hand in his pocket.” Lavinia turns her head on the cushion and catches my eyes on the side of her face instead of the television. “Watch the film, not me.”", "revision": "1" }, { "beat_id": "beat.line.Day6.049", "line_id": "line.Day6.049", "text": "Beside her saucer on the low table, her phone plays a slow piano recording at low volume. With her teacup resting against her knee, she hums a short four-note phrase—coming in half a beat before the piano reaches it, while our voices cover the middle bars of the track.", "revision": "1" }, { "beat_id": "beat.line.Day6.050", "line_id": "line.Day6.050", "text": "“You\'re early,” I say.", "revision": "1" }, { "beat_id": "beat.line.Day6.051", "line_id": "line.Day6.051", "text": "“Not on the other recording.”", "revision": "1" }, { "beat_id": "beat.line.Day6.052", "line_id": "line.Day6.052", "text": "When the track changes, I look toward her phone beside the teapot. “What was the one before this? We talked through half of it.”", "revision": "1" }, { "beat_id": "beat.line.Day6.053", "line_id": "line.Day6.053", "text": "“You were answering me.”", "revision": "1" }, { "beat_id": "beat.line.Day6.054", "line_id": "line.Day6.054", "text": "“I won\'t this time.”", "revision": "1" }, { "beat_id": "beat.line.Day6.055", "line_id": "line.Day6.055", "text": "Lavinia restarts the piano track—and before she settles back, I set my cup down on the saucer and tip my head toward the narrow strip of rug between the low table and the television.", "revision": "1" }, { "beat_id": "beat.line.Day6.056", "line_id": "line.Day6.056", "text": "“Shall we?”", "revision": "1" }, { "beat_id": "beat.line.Day6.057", "line_id": "line.Day6.057", "text": "Lavinia looks at my offered hand, then at the phone.", "revision": "1" }, { "beat_id": "beat.line.Day6.058", "line_id": "line.Day6.058", "text": "“Not to this. Wait.”", "revision": "1" }, { "beat_id": "beat.line.Day6.059", "line_id": "line.Day6.059", "text": "She picks up her phone from beside the teapot, scrolls through two lines, and starts the other recording. After listening to its opening bars, she sets the phone down on the wood.", "revision": "1" }, { "beat_id": "beat.line.Day6.060", "line_id": "line.Day6.060", "text": "“This one.”", "revision": "1" }, { "beat_id": "beat.line.Day6.061", "line_id": "line.Day6.061", "text": "I stand and offer my hand.", "revision": "1" }, { "beat_id": "beat.line.Day6.062", "line_id": "line.Day6.062", "text": "Lavinia takes it. When we step into the narrow space beside the table, she lays her left hand on my shoulder; I step closer and rest my right palm at the small of her back.", "revision": "1" }, { "beat_id": "beat.line.Day6.063", "line_id": "line.Day6.063", "text": "As we begin, my gaze drops once toward the edge of the rug.", "revision": "1" }, { "beat_id": "beat.line.Day6.064", "line_id": "line.Day6.064", "text": "Lavinia immediately makes her next step smaller.", "revision": "1" }, { "beat_id": "beat.line.Day6.065", "line_id": "line.Day6.065", "text": "“You\'re still watching your feet,” she says softly.", "revision": "1" }, { "beat_id": "beat.line.Day6.066", "line_id": "line.Day6.066", "text": "“This is an improvement.”", "revision": "1" }, { "beat_id": "beat.line.Day6.067", "line_id": "line.Day6.067", "text": "She laughs.", "revision": "1" }, { "beat_id": "beat.line.Day6.068", "line_id": "line.Day6.068", "text": "We do not move far. Lavinia begins a slow turn and feels me follow; on the next bar, I change direction first, and she adjusts her weight without saying anything. The low table passes out of her line of sight, then returns.", "revision": "1" }, { "beat_id": "beat.line.Day6.069", "line_id": "line.Day6.069", "text": "When the song finishes, I glance toward the phone on the table. “Another?”", "revision": "1" }, { "beat_id": "beat.line.Day6.070", "line_id": "line.Day6.070", "text": "“Not yet.”", "revision": "1" }, { "beat_id": "beat.line.Day6.071", "line_id": "line.Day6.071", "text": "Lavinia keeps her hand in mine. Without any music in the room—only the faint hum of the television and the man on screen opening another door onto the same hallway—she takes one more slow step across the rug, and I move with her for three silent turns.", "revision": "1" }, { "beat_id": "beat.line.Day6.072", "line_id": "line.Day6.072", "text": "Finally she stops.", "revision": "1" }, { "beat_id": "beat.line.Day6.073", "line_id": "line.Day6.073", "text": "“I want my tea,” she murmurs.", "revision": "1" }, { "beat_id": "beat.line.Day6.074", "line_id": "line.Day6.074", "text": "My hand opens from hers, and we return to our seats.", "revision": "1" }, { "beat_id": "beat.line.Day6.075", "line_id": "line.Day6.075", "text": "Lavinia picks up her cup and takes a sip of the stronger tea.", "revision": "1" }, { "beat_id": "beat.line.Day6.076", "line_id": "line.Day6.076", "text": "“In the story we read before I went,” she says quietly over the rim, “you said the woman at the end was right to send her away.”", "revision": "1" }, { "beat_id": "beat.line.Day6.077", "line_id": "line.Day6.077", "text": "“I changed my mind the next day,” I say.", "revision": "1" }, { "beat_id": "beat.line.Day6.078", "line_id": "line.Day6.078", "text": "“You wrote it down.”", "revision": "1" }, { "beat_id": "beat.line.Day6.079", "line_id": "line.Day6.079", "text": "Her hand reaches to the low shelf beside the sofa and lifts a dark-green linen notebook—but instead of opening it, she holds it closed against her chest, her fingers pressing into the linen cover.", "revision": "1" }, { "beat_id": "beat.line.Day6.080", "line_id": "line.Day6.080", "text": "“May I see it?” I ask.", "revision": "1" }, { "beat_id": "beat.line.Day6.081", "line_id": "line.Day6.081", "text": "Lavinia does not open the cover. In the blue light from the television, her eyes stay on mine—quieter now, without the teasing edge.", "revision": "1" }, { "beat_id": "beat.line.Day6.082", "line_id": "line.Day6.082", "text": "“Say it first,” she whispers.", "revision": "1" }, { "beat_id": "beat.line.Day6.083", "line_id": "line.Day6.083", "text": "“You already have the note in your hand.”", "revision": "1" }, { "beat_id": "beat.line.Day6.084", "line_id": "line.Day6.084", "text": "“I know what the paper says. I\'ve had the paper for months.” Her fingers tighten slightly on the green cover. “I want to hear you say it before you see it.”", "revision": "1" }, { "beat_id": "beat.line.Day6.085", "line_id": "line.Day6.085", "text": "On the screen, the corridor door swings shut in silence.", "revision": "1" }, { "beat_id": "beat.line.Day6.086", "line_id": "line.Day6.086", "text": "“You were right about the ending,” I say softly. “She shouldn\'t have let her go.”", "revision": "1" }, { "beat_id": "beat.line.Day6.087", "line_id": "line.Day6.087", "text": "For a second Lavinia\'s throat moves as she swallows. Then she opens the green cover to a marked page and passes it across the low table into my hands.", "revision": "1" }, { "beat_id": "beat.line.Day6.088", "line_id": "line.Day6.088", "text": "Fixed to the upper margin of the page with a strip of yellowed tape is a small square of paper in my handwriting:", "revision": "1" }, { "beat_id": "beat.line.Day6.089", "line_id": "line.Day6.089", "text": "You were right about the ending.", "revision": "1" }, { "beat_id": "beat.line.Day6.090", "line_id": "line.Day6.090", "text": "“Just that page,” she murmurs.", "revision": "1" }, { "beat_id": "beat.line.Day6.091", "line_id": "line.Day6.091", "text": "“I still disliked the last chapter.”", "revision": "1" }, { "beat_id": "beat.line.Day6.092", "line_id": "line.Day6.092", "text": "“You didn\'t put that in the note.”", "revision": "1" }, { "beat_id": "beat.line.Day6.093", "line_id": "line.Day6.093", "text": "When the next track on her phone ends in a soft click, Lavinia turns half-sideways on the sofa to look through her recordings.", "revision": "1" }, { "beat_id": "beat.line.Day6.094", "line_id": "line.Day6.094", "text": "The green notebook lies open across my knees.", "revision": "1" }, { "beat_id": "beat.line.Day6.095", "line_id": "line.Day6.095", "text": "Beneath the bottom edge of my taped note, the lower half of the page is covered in Lavinia\'s slanted dark ink—two lines in Romanian at the top, and below them an exchange in English laid out like a play script.", "revision": "1" }, { "beat_id": "beat.line.Day6.096", "line_id": "line.Day6.096", "text": "In the second line, she had written the milder word leave first, struck it through twice with a heavy nib, and rewritten it harder above the line:", "revision": "1" }, { "beat_id": "beat.line.Day6.097", "line_id": "line.Day6.097", "text": "P: I\'d do it again if you limped.", "revision": "1" }, { "beat_id": "beat.line.Day6.098", "line_id": "line.Day6.098", "text": "L: Even if I told you to l̶e̶a̶v̶e̶ get out?", "revision": "1" }, { "beat_id": "beat.line.Day6.099", "line_id": "line.Day6.099", "text": "P: Don\'t tell me to get out when you\'ve already taken my coat.", "revision": "1" }, { "beat_id": "beat.line.Day6.100", "line_id": "line.Day6.100", "text": "And at the very bottom margin of the page, underlined twice in the same dark ink:", "revision": "1" }, { "beat_id": "beat.line.Day6.101", "line_id": "line.Day6.101", "text": "Don\'t ask her to stay.", "revision": "1" }, { "beat_id": "beat.line.Day6.102", "line_id": "line.Day6.102", "text": "Lavinia looks back from her phone before starting the track.", "revision": "1" }, { "beat_id": "beat.line.Day6.103", "line_id": "line.Day6.103", "text": "Her eyes drop immediately to my thumb holding the lower corner of the taped note up from the page.", "revision": "1" }, { "beat_id": "beat.line.Day6.104", "line_id": "line.Day6.104", "text": "“Not that page,” she says, extending her hand palm-up between us.", "revision": "1" }, { "beat_id": "beat.line.Day6.105", "line_id": "line.Day6.105", "text": "The notebook stays open across my knees.", "revision": "1" }, { "beat_id": "beat.line.Day6.106", "line_id": "line.Day6.106", "text": "“You wrote my part,” I say quietly.", "revision": "1" }, { "beat_id": "beat.line.Day6.107", "line_id": "line.Day6.107", "text": "“Give it back.”", "revision": "1" }, { "beat_id": "beat.line.Day6.108", "line_id": "line.Day6.108", "text": "“Do I sound like that to you?”", "revision": "1" }, { "beat_id": "beat.line.Day6.109", "line_id": "line.Day6.109", "text": "Slowly, Lavinia lowers her extended hand to her knee. In the blue flicker from the television—where the man in the raincoat is opening another identical door—her eyes sharpen.", "revision": "1" }, { "beat_id": "beat.line.Day6.110", "line_id": "line.Day6.110", "text": "“A minute ago you had to say it before you saw it,” she says, her English suddenly crisp and stripped of play. “Now that you\'ve seen this one without asking, let\'s hear you say it aloud.”", "revision": "1" }, { "beat_id": "beat.line.Day6.111", "line_id": "line.Day6.111", "text": "“Lavinia—”", "revision": "1" }, { "beat_id": "beat.line.Day6.112", "line_id": "line.Day6.112", "text": "“Go on. The first line. Let\'s hear whether I got your voice right.”", "revision": "1" }, { "beat_id": "beat.line.Day6.113", "line_id": "line.Day6.113", "text": "My eyes drop to the slanted ink on the page.", "revision": "1" }, { "beat_id": "beat.line.Day6.114", "line_id": "line.Day6.114", "text": "“I would be concerned if the pain returned.”", "revision": "1" }, { "beat_id": "beat.line.Day6.115", "line_id": "line.Day6.115", "text": "“Stop.” Lavinia leans forward on the sofa, her palm striking the wool cushion beside her hip. “That isn\'t what is written on the page. Don\'t polish it. You usually only amend my documents when I\'m in another room.”", "revision": "1" }, { "beat_id": "beat.line.Day6.116", "line_id": "line.Day6.116", "text": "“Read what is written, Priscilla,” she says softly, her eyes gleaming in the blue light. “From the top. Without improving me.”", "revision": "1" }, { "beat_id": "beat.line.Day6.117", "line_id": "line.Day6.117", "text": "Stand up and read the next line right between her knees.", "revision": "1" }] }, { "entry_id": "Day6.A", "lines": [{ "beat_id": "beat.line.Day6.A.001", "line_id": "line.Day6.A.001", "text": "“I\'m asking about tonight,” I say quietly, not reaching for the notebook. “I\'d like to stay longer.”", "revision": "1" }, { "beat_id": "beat.line.Day6.A.002", "line_id": "line.Day6.A.002", "text": "Lavinia looks at me for a long beat, then sets the green notebook on the shelf behind her head.", "revision": "1" }, { "beat_id": "beat.line.Day6.A.003", "line_id": "line.Day6.A.003", "text": "“Then stay.”", "revision": "1" }, { "beat_id": "beat.line.Day6.A.004", "line_id": "line.Day6.A.004", "text": "I set my cup down on the saucer. Lavinia picks up her phone and looks at the first piano track.", "revision": "1" }, { "beat_id": "beat.line.Day6.A.005", "line_id": "line.Day6.A.005", "text": "“I preferred the first time we heard that song,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day6.A.006", "line_id": "line.Day6.A.006", "text": "“We talked through part of it.”", "revision": "1" }, { "beat_id": "beat.line.Day6.A.007", "line_id": "line.Day6.A.007", "text": "“I know. I preferred it that way.”", "revision": "1" }, { "beat_id": "beat.line.Day6.A.008", "line_id": "line.Day6.A.008", "text": "As I begin to ask whether the man on the television has reached the stairs yet, Lavinia returns the earlier track not to its beginning, but directly to the middle passage our voices covered before—letting my sentence and her answer cover the exact same bars of music a second time.", "revision": "1" }] }, { "entry_id": "Day6.B", "lines": [{ "beat_id": "beat.line.Day6.B.001", "line_id": "line.Day6.B.001", "text": "My fingers touch the linen corner of the notebook on her lap, then draw back.", "revision": "1" }, { "beat_id": "beat.line.Day6.B.002", "line_id": "line.Day6.B.002", "text": "“You have morning call tomorrow. I shouldn\'t keep you up if you want the room to yourself.”", "revision": "1" }, { "beat_id": "beat.line.Day6.B.003", "line_id": "line.Day6.B.003", "text": "Lavinia watches me from the corner of the sofa.", "revision": "1" }, { "beat_id": "beat.line.Day6.B.004", "line_id": "line.Day6.B.004", "text": "“You hide her mug above my refrigerator, read my private page, and now you\'re offering to go home?”", "revision": "1" }, { "beat_id": "beat.line.Day6.B.005", "line_id": "line.Day6.B.005", "text": "“Unless you ask me to stay.”", "revision": "1" }, { "beat_id": "beat.line.Day6.B.006", "line_id": "line.Day6.B.006", "text": "“I invited you.”", "revision": "1" }, { "beat_id": "beat.line.Day6.B.007", "line_id": "line.Day6.B.007", "text": "Neither of us moves closer; the stronger tea cools in the two porcelain cups while the corridor tape runs on.", "revision": "1" }] }, { "entry_id": "Day6.C", "lines": [{ "beat_id": "beat.line.Day6.C.001", "line_id": "line.Day6.C.001", "text": "“You wrote both parts,” I say quietly. “Did you write what happens after she says that?”", "revision": "1" }, { "beat_id": "beat.line.Day6.C.002", "line_id": "line.Day6.C.002", "text": "“No. The page ended.”", "revision": "1" }, { "beat_id": "beat.line.Day6.C.003", "line_id": "line.Day6.C.003", "text": "“May I sit with you first?”", "revision": "1" }, { "beat_id": "beat.line.Day6.C.004", "line_id": "line.Day6.C.004", "text": "“Before what?”", "revision": "1" }, { "beat_id": "beat.line.Day6.C.005", "line_id": "line.Day6.C.005", "text": "“Before you decide whether to tell me to get out.”", "revision": "1" }, { "beat_id": "beat.line.Day6.C.006", "line_id": "line.Day6.C.006", "text": "Lavinia looks down at the cushion beside her thigh, then lifts her phone and the green notebook onto the shelf to clear the wool.", "revision": "1" }, { "beat_id": "beat.line.Day6.C.007", "line_id": "line.Day6.C.007", "text": "“Sit down,” she says. “And watch the film, not me.”", "revision": "1" }, { "beat_id": "beat.line.Day6.C.008", "line_id": "line.Day6.C.008", "text": "On the sofa, less than an inch separates our shoulders. While I point out that the man on the screen is wearing a different raincoat in the next doorway, Lavinia reaches for her phone and returns the first piano track directly to the middle passage our voices covered earlier—letting our ongoing conversation cover the music again as her shoulder settles against mine.", "revision": "1" }] }, { "entry_id": "Day6.D", "lines": [{ "beat_id": "beat.line.Day6.D.001", "line_id": "line.Day6.D.001", "text": "One hand reaches down, takes the closed green notebook from her lap, and opens it back to the marked page.", "revision": "1" }, { "beat_id": "beat.line.Day6.D.002", "line_id": "line.Day6.D.002", "text": "Before Lavinia can catch my wrist, two fingers pinch the bottom margin—where Don\'t ask her to stay is underlined twice—and tear the narrow strip of paper cleanly along the crease.", "revision": "1" }, { "beat_id": "beat.line.Day6.D.003", "line_id": "line.Day6.D.003", "text": "Lavinia\'s breath catches in her throat.", "revision": "1" }, { "beat_id": "beat.line.Day6.D.004", "line_id": "line.Day6.D.004", "text": "“What are you doing?”", "revision": "1" }, { "beat_id": "beat.line.Day6.D.005", "line_id": "line.Day6.D.005", "text": "The torn strip of paper folds once and slips into my pocket. The notebook goes onto the low table.", "revision": "1" }, { "beat_id": "beat.line.Day6.D.006", "line_id": "line.Day6.D.006", "text": "“Amending the ending,” I say softly. “You left a contradiction at the bottom.”", "revision": "1" }, { "beat_id": "beat.line.Day6.D.007", "line_id": "line.Day6.D.007", "text": "“Get out.”", "revision": "1" }, { "beat_id": "beat.line.Day6.D.008", "line_id": "line.Day6.D.008", "text": "“Tell me without holding my sleeve.”", "revision": "1" }, { "beat_id": "beat.line.Day6.D.009", "line_id": "line.Day6.D.009", "text": "In the blue flicker of the television screen, Lavinia looks down: her left hand has caught the cuff of my shirt and is twisting the linen tight around my wrist.", "revision": "1" }, { "beat_id": "beat.line.Day6.D.010", "line_id": "line.Day6.D.010", "text": "She does not let go. Instead, she pulls my cuff hard enough to bring my knee down onto the sofa cushion right between her hip and the armrest.", "revision": "1" }, { "beat_id": "beat.line.Day6.D.011", "line_id": "line.Day6.D.011", "text": "“You\'re insufferable,” she whispers against my mouth, her free hand tangling into the hair behind my ear and drawing my head down until our foreheads strike lightly together. “You think everything in this flat belongs to you.”", "revision": "1" }, { "beat_id": "beat.line.Day6.D.012", "line_id": "line.Day6.D.012", "text": "“Only the cup with the chip,” I murmur, and slide my right arm around her waist—my palm settling flat over the thin wool at her ribs—until her back presses into the sofa cushions beneath me.", "revision": "1" }] }, { "entry_id": "Day6.D.dark", "lines": [{ "beat_id": "beat.line.Day6.D.dark.001", "line_id": "line.Day6.D.dark.001", "text": "Without lifting my weight from her waist, my left hand reaches blindly behind the sofa arm and presses the power switch on the television set.", "revision": "1" }, { "beat_id": "beat.line.Day6.D.dark.002", "line_id": "line.Day6.D.dark.002", "text": "The blue corridor collapses into a single white pinpoint and vanishes, leaving only the corner lamp and Lavinia\'s hands pulling me down by the collar.", "revision": "1" }] }, { "entry_id": "Day6.D.default", "lines": [{ "beat_id": "beat.line.Day6.D.default.001", "line_id": "line.Day6.D.default.001", "text": "Beneath me on the cushion, Lavinia\'s fingers uncurl from my twisted cuff only to slide up inside my sleeve, holding my forearm against her ribs while her mouth parts against mine—warm and bitter-sweet with the stronger tea.", "revision": "1" }, { "beat_id": "beat.line.Day6.D.default.002", "line_id": "line.Day6.D.default.002", "text": "“I told you to watch the film,” she whispers against my lips without opening her eyes.", "revision": "1" }, { "beat_id": "beat.line.Day6.D.default.003", "line_id": "line.Day6.D.default.003", "text": "“I\'m watching,” I murmur against her throat.", "revision": "1" }, { "beat_id": "beat.line.Day6.D.default.004", "line_id": "line.Day6.D.default.004", "text": "On the television screen behind our shoulders, the man in the raincoat opens another door onto the exact same corridor. Neither of us turns to look.", "revision": "1" }] }, { "entry_id": "Day6.D.word", "lines": [{ "beat_id": "beat.line.Day6.D.word.001", "line_id": "line.Day6.D.word.001", "text": "“You wrote leave first,” I whisper against her lips, my thumb tracing the rib seam beneath her cardigan. “Why did you cross it out?”", "revision": "1" }, { "beat_id": "beat.line.Day6.D.word.002", "line_id": "line.Day6.D.word.002", "text": "“Because you never listen to leave,” she breathes, pulling my mouth down to hers as the screen flickers blue across the rug.", "revision": "1" }] }, { "entry_id": "Day6.E", "lines": [{ "beat_id": "beat.line.Day6.E.001", "line_id": "line.Day6.E.001", "text": "“You wrote both parts,” I say quietly. “Did you write what happens after she says that?”", "revision": "1" }, { "beat_id": "beat.line.Day6.E.002", "line_id": "line.Day6.E.002", "text": "“No. The page ended.”", "revision": "1" }, { "beat_id": "beat.line.Day6.E.003", "line_id": "line.Day6.E.003", "text": "“May I sit with you first?”", "revision": "1" }, { "beat_id": "beat.line.Day6.E.004", "line_id": "line.Day6.E.004", "text": "“Before what?”", "revision": "1" }, { "beat_id": "beat.line.Day6.E.005", "line_id": "line.Day6.E.005", "text": "“Before you decide whether to tell me to get out.”", "revision": "1" }, { "beat_id": "beat.line.Day6.E.006", "line_id": "line.Day6.E.006", "text": "Lavinia looks down at the cushion beside her thigh, then lifts her phone and the green notebook onto the shelf to clear the wool.", "revision": "1" }, { "beat_id": "beat.line.Day6.E.007", "line_id": "line.Day6.E.007", "text": "“Sit down,” she says. “And watch the film, not me.”", "revision": "1" }, { "beat_id": "beat.line.Day6.E.008", "line_id": "line.Day6.E.008", "text": "On the sofa, less than an inch separates our shoulders. While I point out that the man on the screen is wearing a different raincoat in the next doorway, Lavinia reaches for her phone and returns the first piano track directly to the middle passage our voices covered earlier—letting our ongoing conversation cover the music again as her shoulder settles against mine.", "revision": "1" }, { "beat_id": "beat.line.Day6.E.009", "line_id": "line.Day6.E.009", "text": "On the screen, the same brass door handle turns again. Same shadow across the carpet. Same white scratch on the lower left frame of the film.", "revision": "1" }, { "beat_id": "beat.line.Day6.E.010", "line_id": "line.Day6.E.010", "text": "A tape does not repeat the exact same scratch fourteen times without a splice.", "revision": "1" }, { "beat_id": "beat.line.Day6.E.011", "line_id": "line.Day6.E.011", "text": "And when the cupboard door opened in the kitchen, the chipped porcelain cup was already sitting at the very front edge of the shelf—next to a honey jar whose lid had already been loosened.", "revision": "1" }, { "beat_id": "beat.line.Day6.E.012", "line_id": "line.Day6.E.012", "text": "You.", "revision": "1" }, { "beat_id": "beat.line.Day6.E.013", "line_id": "line.Day6.E.013", "text": "You keep opening the same corridor until the two of us walk into the room you want.", "revision": "1" }, { "beat_id": "beat.line.Day6.E.014", "line_id": "line.Day6.E.014", "text": "Lavinia\'s shoulder rises and falls warmly against my chest.", "revision": "1" }, { "beat_id": "beat.line.Day6.E.015", "line_id": "line.Day6.E.015", "text": "Let the tape run all night if you like. The door is already shut behind us.", "revision": "1" }] }, { "entry_id": "Day6.impulse", "lines": [{ "beat_id": "beat.line.Day6.impulse.001", "line_id": "line.Day6.impulse.001", "text": "On the television screen, the corridor door clicks shut without a word of dialogue.", "revision": "1" }, { "beat_id": "beat.line.Day6.impulse.002", "line_id": "line.Day6.impulse.002", "text": "Lavinia holds the closed green notebook against her lap.", "revision": "1" }, { "beat_id": "beat.line.Day6.impulse.003", "line_id": "line.Day6.impulse.003", "text": "“That line at the bottom wasn\'t written for you,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day6.impulse.004", "line_id": "line.Day6.impulse.004", "text": "“I know.”", "revision": "1" }, { "beat_id": "beat.line.Day6.impulse.005", "line_id": "line.Day6.impulse.005", "text": "“You don\'t know when I wrote it.”", "revision": "1" }, { "beat_id": "beat.line.Day6.impulse.006", "line_id": "line.Day6.impulse.006", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day6.impulse.007", "line_id": "line.Day6.impulse.007", "text": "Take the line at the bottom off the page and stay the night.", "revision": "1" }] }, { "entry_id": "Day6.rehearsal.default", "lines": [{ "beat_id": "beat.line.Day6.rehearsal.default.001", "line_id": "line.Day6.rehearsal.default.001", "text": "From the chair across the low table, my gaze stays on her mouth instead of the paper.", "revision": "1" }, { "beat_id": "beat.line.Day6.rehearsal.default.002", "line_id": "line.Day6.rehearsal.default.002", "text": "“I\'d do it again if you limped.”", "revision": "1" }, { "beat_id": "beat.line.Day6.rehearsal.default.003", "line_id": "line.Day6.rehearsal.default.003", "text": "“A little flat,” Lavinia says, resting her chin on her knuckles. “You were much more convincing before I went away. Read the next one.”", "revision": "1" }, { "beat_id": "beat.line.Day6.rehearsal.default.004", "line_id": "line.Day6.rehearsal.default.004", "text": "“Don\'t tell me to get out when you\'ve already taken my coat.”", "revision": "1" }, { "beat_id": "beat.line.Day6.rehearsal.default.005", "line_id": "line.Day6.rehearsal.default.005", "text": "Lavinia reaches across the low table, draws the green notebook from between my fingers, and closes it across her lap.", "revision": "1" }, { "beat_id": "beat.line.Day6.rehearsal.default.006", "line_id": "line.Day6.rehearsal.default.006", "text": "“You see?” she says softly. “You didn\'t need to edit a single word.”", "revision": "1" }] }, { "entry_id": "Day6.rehearsal.yes", "lines": [{ "beat_id": "beat.line.Day6.rehearsal.yes.001", "line_id": "line.Day6.rehearsal.yes.001", "text": "My chair slides back an inch on the rug. Two unhurried paces close the gap between the low table and the sofa until my shins brush the hem of her skirt right between her knees.", "revision": "1" }, { "beat_id": "beat.line.Day6.rehearsal.yes.002", "line_id": "line.Day6.rehearsal.yes.002", "text": "Lavinia does not lean back, though she has to tilt her chin up to keep my face in view.", "revision": "1" }, { "beat_id": "beat.line.Day6.rehearsal.yes.003", "line_id": "line.Day6.rehearsal.yes.003", "text": "“I\'d do it again if you limped,” I read, low and level.", "revision": "1" }, { "beat_id": "beat.line.Day6.rehearsal.yes.004", "line_id": "line.Day6.rehearsal.yes.004", "text": "“Still too polite,” she whispers, though her fingers tighten on the edge of the sofa cushion. “You were much more ruthless when you altered the form before I left. Read the next one.”", "revision": "1" }, { "beat_id": "beat.line.Day6.rehearsal.yes.005", "line_id": "line.Day6.rehearsal.yes.005", "text": "I let the open notebook close against my thigh, no longer looking at the ink, and brace my free hand on the back cushion of the sofa an inch from her bare collarbone.", "revision": "1" }, { "beat_id": "beat.line.Day6.rehearsal.yes.006", "line_id": "line.Day6.rehearsal.yes.006", "text": "“Don\'t tell me to get out when you\'ve already taken my coat.”", "revision": "1" }, { "beat_id": "beat.line.Day6.rehearsal.yes.007", "line_id": "line.Day6.rehearsal.yes.007", "text": "Lavinia\'s hand rises and closes hard around my wrist braced beside her neck—her nails pressing into the pulse point, holding my arm against her collarbone instead of pushing it away.", "revision": "1" }, { "beat_id": "beat.line.Day6.rehearsal.yes.008", "line_id": "line.Day6.rehearsal.yes.008", "text": "When her hand loosens around my wrist, I give the closed notebook back to her.", "revision": "1" }] }, { "entry_id": "Day7", "lines": [{ "beat_id": "beat.line.Day7.one", "line_id": "line.Day7.one", "text": "Outside the studio, visitors crowd the corridor with damp programmes.", "revision": "1" }, { "beat_id": "beat.line.Day7.002", "line_id": "line.Day7.002", "text": "Inside the narrow warm-up room behind the stage, the crowd noise drops to a muffled hum through the double acoustic doors.", "revision": "1" }, { "beat_id": "beat.line.Day7.003", "line_id": "line.Day7.003", "text": "Beside the dressing counter, Lavinia stands with her weight settled into her left hip. Her right heel stays half an inch clear of the floorboards—the exact guarded transfer from before she went away, when she insisted to the department that nothing was wrong.", "revision": "1" }, { "beat_id": "beat.line.Day7.004", "line_id": "line.Day7.004", "text": "She holds her left wrist out between us. A thin gold chain hangs open across the bone, the tiny spring ring slipping from her thumb.", "revision": "1" }, { "beat_id": "beat.line.Day7.005", "line_id": "line.Day7.005", "text": "“My hands are cold,” she says without looking up. “Do the clasp.”", "revision": "1" }, { "beat_id": "beat.line.Day7.006", "line_id": "line.Day7.006", "text": "Two fingers take the gold link. Beneath my thumb, the skin on the inside of her wrist is warm, not cold at all; the pulse beats fast and shallow just beneath the tendon before she has even stepped back onto the floor.", "revision": "1" }, { "beat_id": "beat.line.Day7.007", "line_id": "line.Day7.007", "text": "The spring ring clicks shut.", "revision": "1" }, { "beat_id": "beat.line.Day7.008", "line_id": "line.Day7.008", "text": "Instead of letting go, my thumb passes once over the closed gold clasp and rests in the hollow of her wrist.", "revision": "1" }, { "beat_id": "beat.line.Day7.009", "line_id": "line.Day7.009", "text": "Lavinia does not draw her arm back.", "revision": "1" }, { "beat_id": "beat.line.Day7.010", "line_id": "line.Day7.010", "text": "“You\'re taking a long time over one catch,” she says softly.", "revision": "1" }, { "beat_id": "beat.line.Day7.011", "line_id": "line.Day7.011", "text": "“It\'s small.”", "revision": "1" }, { "beat_id": "beat.line.Day7.012", "line_id": "line.Day7.012", "text": "“Your hands aren\'t shaking.”", "revision": "1" }, { "beat_id": "beat.line.Day7.013", "line_id": "line.Day7.013", "text": "“Yours aren\'t cold.”", "revision": "1" }, { "beat_id": "beat.line.Day7.014", "line_id": "line.Day7.014", "text": "Her fingers curl once around the back of my wrist—holding my thumb against her pulse for the length of a breath—before she lets her arm fall to her side.", "revision": "1" }, { "beat_id": "beat.line.Day7.015", "line_id": "line.Day7.015", "text": "On the dressing counter beside the rosin box lies a folded white card in Sylvia\'s neat, left-handed diagonal crease:", "revision": "1" }, { "beat_id": "beat.line.Day7.016", "line_id": "line.Day7.016", "text": "Quiet rest room reserved downstairs. Key at the desk if you want to leave by the lower gate.", "revision": "1" }, { "beat_id": "beat.line.Day7.017", "line_id": "line.Day7.017", "text": "Lavinia sees where my gaze has stopped.", "revision": "1" }, { "beat_id": "beat.line.Day7.018", "line_id": "line.Day7.018", "text": "“She left that before the first piece,” Lavinia says. “And the visitors in the front row asked for the second variation.”", "revision": "1" }, { "beat_id": "beat.line.Day7.019", "line_id": "line.Day7.019", "text": "“The programme only promised one.”", "revision": "1" }, { "beat_id": "beat.line.Day7.020", "line_id": "line.Day7.020", "text": "“I told the rehearsal director I\'d do the second.”", "revision": "1" }, { "beat_id": "beat.line.Day7.021", "line_id": "line.Day7.021", "text": "“With your right heel off the floor?”", "revision": "1" }, { "beat_id": "beat.line.Day7.022", "line_id": "line.Day7.022", "text": "“It won\'t take long.”", "revision": "1" }, { "beat_id": "beat.line.Day7.023", "line_id": "line.Day7.023", "text": "She bends toward the rosin box. Before her fingers reach the wood, her right knee gives a small, silent tremor under the skirt; her palm catches the edge of the counter and stays there a beat longer than the reach requires.", "revision": "1" }, { "beat_id": "beat.line.Day7.024", "line_id": "line.Day7.024", "text": "“Don\'t say a word,” she says.", "revision": "1" }, { "beat_id": "beat.line.Day7.025", "line_id": "line.Day7.025", "text": "“Nothing has been said.”", "revision": "1" }, { "beat_id": "beat.line.Day7.026", "line_id": "line.Day7.026", "text": "She straightens and looks toward the rear exit glass, where rain is streaking the courtyard light.", "revision": "1" }, { "beat_id": "beat.line.Day7.027", "line_id": "line.Day7.027", "text": "“After the second piece,” she says, her English flat and clear, “I\'m taking the lower gate by myself. Not the bar. Not the flat. I want one evening where nobody is writing my schedule.”", "revision": "1" }, { "beat_id": "beat.line.Day7.028", "line_id": "line.Day7.028", "text": "Cross the second piece off the stage-door board while her back is turned.", "revision": "1" }] }, { "entry_id": "Day7.A", "lines": [{ "beat_id": "beat.line.Day7.A.001", "line_id": "line.Day7.A.001", "text": "“If you go back out on that floor,” I say quietly, “I\'ll bring a chair onto the stage for you in the middle of the piece.”", "revision": "1" }, { "beat_id": "beat.line.Day7.A.002", "line_id": "line.Day7.A.002", "text": "Lavinia\'s hand stops an inch from the brass push-bar.", "revision": "1" }, { "beat_id": "beat.line.Day7.A.003", "line_id": "line.Day7.A.003", "text": "“You wouldn\'t dare.”", "revision": "1" }, { "beat_id": "beat.line.Day7.A.004", "line_id": "line.Day7.A.004", "text": "“The form is on the counter. It only takes one signature.”", "revision": "1" }, { "beat_id": "beat.line.Day7.A.005", "line_id": "line.Day7.A.005", "text": "Lavinia turns slowly. Her chest rises fast; her eyes are bright and furious in the dressing-room light.", "revision": "1" }, { "beat_id": "beat.line.Day7.A.006", "line_id": "line.Day7.A.006", "text": "“You really can\'t leave a single thing alone, can you?”", "revision": "1" }, { "beat_id": "beat.line.Day7.A.007", "line_id": "line.Day7.A.007", "text": "“Not when it\'s you.”", "revision": "1" }, { "beat_id": "beat.line.Day7.A.008", "line_id": "line.Day7.A.008", "text": "Beyond the wall, the stage manager announces that the session has concluded. Chairs scrape back; footsteps move toward the main hall. Lavinia lowers her hand from the brass bar and reaches for her street coat.", "revision": "1" }] }, { "entry_id": "Day7.B", "lines": [{ "beat_id": "beat.line.Day7.B.001", "line_id": "line.Day7.B.001", "text": "My hand lifts toward her sleeve, then stops in the six inches of air between us without touching the wool.", "revision": "1" }, { "beat_id": "beat.line.Day7.B.002", "line_id": "line.Day7.B.002", "text": "“Go on, then. Push the door open.”", "revision": "1" }, { "beat_id": "beat.line.Day7.B.003", "line_id": "line.Day7.B.003", "text": "Lavinia looks at my stopped hand, then at the heavy acoustic door.", "revision": "1" }, { "beat_id": "beat.line.Day7.B.004", "line_id": "line.Day7.B.004", "text": "To depress the bar and swing the soundproof panel outward, she has to plant her right foot flat and drive her weight through the ankle. She shifts her stance once—and stops.", "revision": "1" }, { "beat_id": "beat.line.Day7.B.005", "line_id": "line.Day7.B.005", "text": "In the narrow wire-glass strip of the door, her reflection watches mine.", "revision": "1" }, { "beat_id": "beat.line.Day7.B.006", "line_id": "line.Day7.B.006", "text": "Through the wall, the stage manager thanks the visitors for attending and directs them toward the foyer. The window for the second piece closes while neither of us moves.", "revision": "1" }, { "beat_id": "beat.line.Day7.B.007", "line_id": "line.Day7.B.007", "text": "Lavinia lets out a short, quiet breath that sounds almost like a laugh.", "revision": "1" }, { "beat_id": "beat.line.Day7.B.008", "line_id": "line.Day7.B.008", "text": "“You knew I\'d wait a second too long,” she says, and reaches for her coat.", "revision": "1" }] }, { "entry_id": "Day7.C", "lines": [{ "beat_id": "beat.line.Day7.C.001", "line_id": "line.Day7.C.001", "text": "“Don\'t open it,” I say quietly. “It wasn\'t only because of your leg.”", "revision": "1" }, { "beat_id": "beat.line.Day7.C.002", "line_id": "line.Day7.C.002", "text": "Lavinia\'s fingers stop on the brass push-bar. She does not turn around right away.", "revision": "1" }, { "beat_id": "beat.line.Day7.C.003", "line_id": "line.Day7.C.003", "text": "“What did you say?”", "revision": "1" }, { "beat_id": "beat.line.Day7.C.004", "line_id": "line.Day7.C.004", "text": "“Before you went away. I told myself it was for your leg, and I told the department it was for your leg. But I sent the amendment without showing you because I knew that if you read it first, you would still get on the plane and leave me behind.”", "revision": "1" }, { "beat_id": "beat.line.Day7.C.005", "line_id": "line.Day7.C.005", "text": "Slowly, Lavinia turns her back to the acoustic door. Through the thick wood behind her shoulder, the stage manager announces that the session has ended. Neither of us looks toward the hall.", "revision": "1" }, { "beat_id": "beat.line.Day7.C.006", "line_id": "line.Day7.C.006", "text": "“You made me wait four months to hear you say that without an excuse,” she whispers.", "revision": "1" }, { "beat_id": "beat.line.Day7.C.007", "line_id": "line.Day7.C.007", "text": "“I\'m saying it now. Sit down and let me take your ribbons off.”", "revision": "1" }, { "beat_id": "beat.line.Day7.C.008", "line_id": "line.Day7.C.008", "text": "She sinks onto the wooden bench and reaches down with unsteady fingers; I kneel on the floorboards in front of her, untie the pale satin from her right ankle, and slip her street shoe onto her foot before we walk out to the rear door.", "revision": "1" }] }, { "entry_id": "Day7.D.default", "lines": [{ "beat_id": "beat.line.Day7.D.default.001", "line_id": "line.Day7.D.default.001", "text": "“Sit down,” I say gently, smoothing the hair back from her temple as if nothing had happened at the door. “Put your street shoes on before your ankle stiffens.”", "revision": "1" }, { "beat_id": "beat.line.Day7.D.default.002", "line_id": "line.Day7.D.default.002", "text": "Lavinia sinks onto the wooden bench, her chest still rising fast, her eyes never leaving my face as I kneel at her feet, untie the rehearsal ribbons from her ankles, and slip both of her street shoes on for her. Before we step toward the rear passage, my hand lifts Sylvia\'s white lower-gate card from the counter and drops it into the bin beside the rosin box.", "revision": "1" }] }, { "entry_id": "Day7.D.pocket", "lines": [{ "beat_id": "beat.line.Day7.D.pocket.001", "line_id": "line.Day7.D.pocket.001", "text": "While I button her street coat up to her chin, I take Sylvia\'s white lower-gate card from the counter, fold it once, and slip it into Lavinia\'s outer pocket before sliding my own hand in after it.", "revision": "1" }, { "beat_id": "beat.line.Day7.D.pocket.002", "line_id": "line.Day7.D.pocket.002", "text": "“Keep the souvenir if you like,” I murmur against her ear. “We\'re taking the hill path.”", "revision": "1" }, { "beat_id": "beat.line.Day7.D.pocket.003", "line_id": "line.Day7.D.pocket.003", "text": "Lavinia laughs once—breathless and dark—before I kneel to slip her street shoes onto her feet.", "revision": "1" }] }, { "entry_id": "Day7.E", "lines": [{ "beat_id": "beat.line.Day7.E.001", "line_id": "line.Day7.E.001", "text": "“Don\'t open it,” I say quietly. “It wasn\'t only because of your leg.”", "revision": "1" }, { "beat_id": "beat.line.Day7.E.002", "line_id": "line.Day7.E.002", "text": "Lavinia\'s fingers stop on the brass push-bar. She does not turn around right away.", "revision": "1" }, { "beat_id": "beat.line.Day7.E.003", "line_id": "line.Day7.E.003", "text": "“What did you say?”", "revision": "1" }, { "beat_id": "beat.line.Day7.E.004", "line_id": "line.Day7.E.004", "text": "“Before you went away. I told myself it was for your leg, and I told the department it was for your leg. But I sent the amendment without showing you because I knew that if you read it first, you would still get on the plane and leave me behind.”", "revision": "1" }, { "beat_id": "beat.line.Day7.E.005", "line_id": "line.Day7.E.005", "text": "Slowly, Lavinia turns her back to the acoustic door. Through the thick wood behind her shoulder, the stage manager announces that the session has ended. Neither of us looks toward the hall.", "revision": "1" }, { "beat_id": "beat.line.Day7.E.006", "line_id": "line.Day7.E.006", "text": "“You made me wait four months to hear you say that without an excuse,” she whispers.", "revision": "1" }, { "beat_id": "beat.line.Day7.E.007", "line_id": "line.Day7.E.007", "text": "“I\'m saying it now. Sit down and let me take your ribbons off.”", "revision": "1" }, { "beat_id": "beat.line.Day7.E.008", "line_id": "line.Day7.E.008", "text": "She sinks onto the wooden bench and reaches down with unsteady fingers; I kneel on the floorboards in front of her, untie the pale satin from her right ankle, and slip her street shoe onto her foot before we walk out to the rear door.", "revision": "1" }, { "beat_id": "beat.line.Day7.E.009", "line_id": "line.Day7.E.009", "text": "The stage manager knocked three minutes early.", "revision": "1" }, { "beat_id": "beat.line.Day7.E.010", "line_id": "line.Day7.E.010", "text": "And through the frosted glass of the rear passage, the downstairs welfare desk—where Sylvia was scheduled to sit with the lower-gate key—is already dark, its chair folded against the wall, leaving only one unlocked exit to the courtyard.", "revision": "1" }, { "beat_id": "beat.line.Day7.E.011", "line_id": "line.Day7.E.011", "text": "You.", "revision": "1" }, { "beat_id": "beat.line.Day7.E.012", "line_id": "line.Day7.E.012", "text": "Seven days of mistimed clocks, rain showers, and reversed door cards, all narrowing like a corridor in a film to this bench.", "revision": "1" }, { "beat_id": "beat.line.Day7.E.013", "line_id": "line.Day7.E.013", "text": "You wanted to see what remains when every other door is locked.", "revision": "1" }, { "beat_id": "beat.line.Day7.E.014", "line_id": "line.Day7.E.014", "text": "Look closely, then.", "revision": "1" }] }, { "entry_id": "Day7.clipboard.default", "lines": [{ "beat_id": "beat.line.Day7.clipboard.default.001", "line_id": "line.Day7.clipboard.default.001", "text": "The clipboard stays untouched on the hook; two steps place my shoulder directly between Lavinia and the inner studio door.", "revision": "1" }, { "beat_id": "beat.line.Day7.clipboard.default.002", "line_id": "line.Day7.clipboard.default.002", "text": "“The stage manager already moved the next slot to the main hall,” I say.", "revision": "1" }, { "beat_id": "beat.line.Day7.clipboard.default.003", "line_id": "line.Day7.clipboard.default.003", "text": "“He didn\'t tell me.”", "revision": "1" }, { "beat_id": "beat.line.Day7.clipboard.default.004", "line_id": "line.Day7.clipboard.default.004", "text": "“He asked me to tell you.”", "revision": "1" }, { "beat_id": "beat.line.Day7.clipboard.default.005", "line_id": "line.Day7.clipboard.default.005", "text": "Lavinia looks down at my empty hands, then up at my mouth.", "revision": "1" }, { "beat_id": "beat.line.Day7.clipboard.default.006", "line_id": "line.Day7.clipboard.default.006", "text": "“You\'re lying.”", "revision": "1" }, { "beat_id": "beat.line.Day7.clipboard.default.007", "line_id": "line.Day7.clipboard.default.007", "text": "“Go out and ask him. You\'ll have to walk across the floor on that right leg in front of twenty-four people to do it.”", "revision": "1" }] }, { "entry_id": "Day7.clipboard.yes", "lines": [{ "beat_id": "beat.line.Day7.clipboard.yes.001", "line_id": "line.Day7.clipboard.yes.001", "text": "While Lavinia adjusts the cardigan over her shoulders, two silent steps reach the clipboard hanging beside the inner studio door.", "revision": "1" }, { "beat_id": "beat.line.Day7.clipboard.yes.002", "line_id": "line.Day7.clipboard.yes.002", "text": "In the Second Variation / Floor Q&A row, one clean stroke of the pen crosses out Second Variation and writes beside it:", "revision": "1" }, { "beat_id": "beat.line.Day7.clipboard.yes.003", "line_id": "line.Day7.clipboard.yes.003", "text": "Session concluded. Clear hall.", "revision": "1" }, { "beat_id": "beat.line.Day7.clipboard.yes.004", "line_id": "line.Day7.clipboard.yes.004", "text": "Behind her back, the pen cap clicks shut.", "revision": "1" }, { "beat_id": "beat.line.Day7.clipboard.yes.005", "line_id": "line.Day7.clipboard.yes.005", "text": "“What did you just write?” Lavinia asks, turning around.", "revision": "1" }, { "beat_id": "beat.line.Day7.clipboard.yes.006", "line_id": "line.Day7.clipboard.yes.006", "text": "“The visitor count exceeded the room limit. They have to clear the studio after the interlude.”", "revision": "1" }, { "beat_id": "beat.line.Day7.clipboard.yes.007", "line_id": "line.Day7.clipboard.yes.007", "text": "“There are twenty people out there.”", "revision": "1" }, { "beat_id": "beat.line.Day7.clipboard.yes.008", "line_id": "line.Day7.clipboard.yes.008", "text": "“Twenty-four. The fire notice says twenty.”", "revision": "1" }] }, { "entry_id": "Day7.crossed.D", "lines": [{ "beat_id": "beat.line.Day7.crossed.D.001", "line_id": "line.Day7.crossed.D.001", "text": "Before her fingertips touch the brass push-bar, my right hand closes around her left wrist—directly over the thin gold bracelet clasp—and draws her arm down from the door. My left palm plants flat against the heavy acoustic panel beside her cheek, holding the door shut with my weight.", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.002", "line_id": "line.Day7.crossed.D.002", "text": "Lavinia\'s breath catches hard.", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.003", "line_id": "line.Day7.crossed.D.003", "text": "“Let go.”", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.004", "line_id": "line.Day7.crossed.D.004", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.005", "line_id": "line.Day7.crossed.D.005", "text": "“Tell me right now that you sent that form for my leg,” she whispers fiercely against my mouth, her free hand twisting into the wool at my lapel. “Go on. Use your committee voice one more time.”", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.006", "line_id": "line.Day7.crossed.D.006", "text": "“It wasn\'t for your leg,” I whisper against her lips, every trace of polish gone, my voice softer than in the library and completely still. “You could have danced on it for another month. I altered the form because I couldn\'t bear the thought of someone else watching you in another city while I stayed here.”", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.007", "line_id": "line.Day7.crossed.D.007", "text": "Against the heavy wood, Lavinia\'s shoulders go rigid; her eyes widen an inch from mine.", "revision": "1" }] }, { "entry_id": "Day7.crossed.D.board", "lines": [{ "beat_id": "beat.line.Day7.crossed.D.board.001", "line_id": "line.Day7.crossed.D.board.001", "text": "After I kneel to tie her street shoes and draw her coat over her shoulders, I pause for half a second beside the inner door where my black line strikes through Second Variation on the hanging clipboard.", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.board.002", "line_id": "line.Day7.crossed.D.board.002", "text": "Lavinia looks at my handwriting on the board, then up at my mouth, her fingers tightening around mine as we turn toward the rear courtyard door.", "revision": "1" }] }, { "entry_id": "Day7.crossed.D.no_recording", "lines": [{ "beat_id": "beat.line.Day7.crossed.D.no_recording.001", "line_id": "line.Day7.crossed.D.no_recording.001", "text": "“That\'s all?” she breathes.", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.no_recording.002", "line_id": "line.Day7.crossed.D.no_recording.002", "text": "“No,” I whisper, sliding my right hand from her gold bracelet to lace tightly between her fingers and pressing our joined hands flat against the door panel beside her hip. “Two minutes ago I crossed your second piece off the stage manager\'s board behind your back.”", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.no_recording.003", "line_id": "line.Day7.crossed.D.no_recording.003", "text": "Through the thick soundproof panel two inches behind her head, the stage manager\'s voice announces to the crowd that the performance has concluded. Chairs scrape back; twenty-four pairs of footsteps file out into the corridor and fade away.", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.no_recording.004", "line_id": "line.Day7.crossed.D.no_recording.004", "text": "The second piece is gone.", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.no_recording.005", "line_id": "line.Day7.crossed.D.no_recording.005", "text": "Lavinia does not call out through the door, and she does not let go of my lapel. Instead, her free hand slides up from my collar into the hair at the back of my neck, her fingers locking hard at my nape as she pulls my mouth down to hers—her breath hot, trembling, and electric against my lips.", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.no_recording.006", "line_id": "line.Day7.crossed.D.no_recording.006", "text": "“Ești un monstru,” she breathes against my mouth—and then in English, her forehead dropping hard against my collarbone: “You\'re completely monstrous.”", "revision": "1" }] }, { "entry_id": "Day7.crossed.D.recording", "lines": [{ "beat_id": "beat.line.Day7.crossed.D.recording.001", "line_id": "line.Day7.crossed.D.recording.001", "text": "“That\'s all?” she breathes.", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.recording.002", "line_id": "line.Day7.crossed.D.recording.002", "text": "“No,” I whisper, sliding my right hand from her gold bracelet to lace tightly between her fingers and pressing our joined hands flat against the door panel beside her hip. “When you asked for an answer on Monday, I recorded Sylvia reading a line out of her novel and sent it to your phone so you wouldn\'t hear how badly I wanted you back. And two minutes ago I crossed your second piece off the stage manager\'s board behind your back.”", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.recording.003", "line_id": "line.Day7.crossed.D.recording.003", "text": "Through the thick soundproof panel two inches behind her head, the stage manager\'s voice announces to the crowd that the performance has concluded. Chairs scrape back; twenty-four pairs of footsteps file out into the corridor and fade away.", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.recording.004", "line_id": "line.Day7.crossed.D.recording.004", "text": "The second piece is gone.", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.recording.005", "line_id": "line.Day7.crossed.D.recording.005", "text": "Lavinia does not call out through the door, and she does not let go of my lapel. Instead, her free hand slides up from my collar into the hair at the back of my neck, her fingers locking hard at my nape as she pulls my mouth down to hers—her breath hot, trembling, and electric against my lips.", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.D.recording.006", "line_id": "line.Day7.crossed.D.recording.006", "text": "“Ești un monstru,” she breathes against my mouth—and then in English, her forehead dropping hard against my collarbone: “You\'re completely monstrous.”", "revision": "1" }] }, { "entry_id": "Day7.crossed.impulse", "lines": [{ "beat_id": "beat.line.Day7.crossed.impulse.001", "line_id": "line.Day7.crossed.impulse.001", "text": "Through the double acoustic panel, applause rises and thins as the pianist finishes the interlude. In a moment the stage manager will check the door.", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.impulse.002", "line_id": "line.Day7.crossed.impulse.002", "text": "Lavinia takes one step toward the brass push-bar. Her right heel touches the floorboards, hesitates for a fraction of a second, and takes her weight anyway.", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.impulse.003", "line_id": "line.Day7.crossed.impulse.003", "text": "“Move, Priscilla,” she says. “I\'m doing the second piece, and then I\'m going home alone.”", "revision": "1" }, { "beat_id": "beat.line.Day7.crossed.impulse.004", "line_id": "line.Day7.crossed.impulse.004", "text": "Hold the door shut and give her the truth she\'s been trying to tear out of me all week.", "revision": "1" }] }, { "entry_id": "Day7.untouched.D", "lines": [{ "beat_id": "beat.line.Day7.untouched.D.001", "line_id": "line.Day7.untouched.D.001", "text": "Before her fingertips touch the brass push-bar, my right hand closes around her left wrist—directly over the thin gold bracelet clasp—and draws her arm down from the door. My left palm plants flat against the heavy acoustic panel beside her cheek, holding the door shut with my weight.", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.002", "line_id": "line.Day7.untouched.D.002", "text": "Lavinia\'s breath catches hard.", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.003", "line_id": "line.Day7.untouched.D.003", "text": "“Let go.”", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.004", "line_id": "line.Day7.untouched.D.004", "text": "“No.”", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.005", "line_id": "line.Day7.untouched.D.005", "text": "“Tell me right now that you sent that form for my leg,” she whispers fiercely against my mouth, her free hand twisting into the wool at my lapel. “Go on. Use your committee voice one more time.”", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.006", "line_id": "line.Day7.untouched.D.006", "text": "“It wasn\'t for your leg,” I whisper against her lips, every trace of polish gone, my voice softer than in the library and completely still. “You could have danced on it for another month. I altered the form because I couldn\'t bear the thought of someone else watching you in another city while I stayed here.”", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.007", "line_id": "line.Day7.untouched.D.007", "text": "Against the heavy wood, Lavinia\'s shoulders go rigid; her eyes widen an inch from mine.", "revision": "1" }] }, { "entry_id": "Day7.untouched.D.board", "lines": [{ "beat_id": "beat.line.Day7.untouched.D.board.001", "line_id": "line.Day7.untouched.D.board.001", "text": "After I kneel to tie her street shoes and draw her coat over her shoulders, I pause for half a second beside the inner door where Second Variation remains untouched on the hanging clipboard.", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.board.002", "line_id": "line.Day7.untouched.D.board.002", "text": "Lavinia looks at the unchanged row on the board, then up at my mouth, her fingers tightening around mine as we turn toward the rear courtyard door.", "revision": "1" }] }, { "entry_id": "Day7.untouched.D.no_recording", "lines": [{ "beat_id": "beat.line.Day7.untouched.D.no_recording.001", "line_id": "line.Day7.untouched.D.no_recording.001", "text": "Through the thick soundproof panel two inches behind her head, the stage manager\'s voice announces to the crowd that the performance has concluded. Chairs scrape back; twenty-four pairs of footsteps file out into the corridor and fade away.", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.no_recording.002", "line_id": "line.Day7.untouched.D.no_recording.002", "text": "The second piece is gone.", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.no_recording.003", "line_id": "line.Day7.untouched.D.no_recording.003", "text": "Lavinia does not call out through the door, and she does not let go of my lapel. Instead, her free hand slides up from my collar into the hair at the back of my neck, her fingers locking hard at my nape as she pulls my mouth down to hers—her breath hot, trembling, and electric against my lips.", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.no_recording.004", "line_id": "line.Day7.untouched.D.no_recording.004", "text": "“Ești un monstru,” she breathes against my mouth—and then in English, her forehead dropping hard against my collarbone: “You\'re completely monstrous.”", "revision": "1" }] }, { "entry_id": "Day7.untouched.D.recording", "lines": [{ "beat_id": "beat.line.Day7.untouched.D.recording.001", "line_id": "line.Day7.untouched.D.recording.001", "text": "“That\'s all?” she breathes.", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.recording.002", "line_id": "line.Day7.untouched.D.recording.002", "text": "“No,” I whisper, sliding my right hand from her gold bracelet to lace tightly between her fingers and pressing our joined hands flat against the door panel beside her hip. “When you asked for an answer on Monday, I recorded Sylvia reading a line out of her novel and sent it to your phone so you wouldn\'t hear how badly I wanted you back.”", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.recording.003", "line_id": "line.Day7.untouched.D.recording.003", "text": "Through the thick soundproof panel two inches behind her head, the stage manager\'s voice announces to the crowd that the performance has concluded. Chairs scrape back; twenty-four pairs of footsteps file out into the corridor and fade away.", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.recording.004", "line_id": "line.Day7.untouched.D.recording.004", "text": "The second piece is gone.", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.recording.005", "line_id": "line.Day7.untouched.D.recording.005", "text": "Lavinia does not call out through the door, and she does not let go of my lapel. Instead, her free hand slides up from my collar into the hair at the back of my neck, her fingers locking hard at my nape as she pulls my mouth down to hers—her breath hot, trembling, and electric against my lips.", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.D.recording.006", "line_id": "line.Day7.untouched.D.recording.006", "text": "“Ești un monstru,” she breathes against my mouth—and then in English, her forehead dropping hard against my collarbone: “You\'re completely monstrous.”", "revision": "1" }] }, { "entry_id": "Day7.untouched.impulse", "lines": [{ "beat_id": "beat.line.Day7.untouched.impulse.001", "line_id": "line.Day7.untouched.impulse.001", "text": "Through the double acoustic panel, applause rises and thins as the pianist finishes the interlude. In a moment the stage manager will check the door.", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.impulse.002", "line_id": "line.Day7.untouched.impulse.002", "text": "Lavinia takes one step toward the brass push-bar. Her right heel touches the floorboards, hesitates for a fraction of a second, and takes her weight anyway.", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.impulse.003", "line_id": "line.Day7.untouched.impulse.003", "text": "“Move, Priscilla,” she says. “I\'m doing the second piece, and then I\'m going home alone.”", "revision": "1" }, { "beat_id": "beat.line.Day7.untouched.impulse.004", "line_id": "line.Day7.untouched.impulse.004", "text": "Hold the door shut and give her the truth she\'s been trying to tear out of me all week.", "revision": "1" }] }, { "entry_id": "ending.alone.normal", "lines": [{ "beat_id": "beat.line.ending.alone.normal.001", "line_id": "line.ending.alone.normal.001", "text": "At the rear doors of the building, the evening rain falls straight down through the courtyard lamp light.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.002", "line_id": "line.ending.alone.normal.002", "text": "The long black umbrella stands in the rack beside the threshold.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.003", "line_id": "line.ending.alone.normal.003", "text": "My right hand takes the curved wooden handle; my shoulder pushes the heavy door outward, and my thumb presses the catch.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.004", "line_id": "line.ending.alone.normal.004", "text": "The black canopy opens with a soft thrum against the wet air.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.005", "line_id": "line.ending.alone.normal.005", "text": "On the stone threshold, Lavinia buttons her coat to the chin. The heavy canvas bag hangs from her right shoulder.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.006", "line_id": "line.ending.alone.normal.006", "text": "Without asking, my left hand slips the canvas strap off her shoulder and settles it over my own arm.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.007", "line_id": "line.ending.alone.normal.007", "text": "Then I extend the umbrella over the top step—the wooden handle held in my right hand, tilting the canopy three inches toward my own side.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.008", "line_id": "line.ending.alone.normal.008", "text": "On the wet stone, the dry circle is barely wide enough for two pairs of shoes.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.009", "line_id": "line.ending.alone.normal.009", "text": "Lavinia looks at the rain falling past the black rim, then at the narrow dry space flush against my dry coat.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.010", "line_id": "line.ending.alone.normal.010", "text": "“That isn\'t very wide,” she says.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.011", "line_id": "line.ending.alone.normal.011", "text": "“It\'s the same umbrella as Tuesday.”", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.012", "line_id": "line.ending.alone.normal.012", "text": "“You\'re holding it differently.”", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.013", "line_id": "line.ending.alone.normal.013", "text": "“Come here.”", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.014", "line_id": "line.ending.alone.normal.014", "text": "For a second she stands under the stone lintel.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.015", "line_id": "line.ending.alone.normal.015", "text": "Then she steps out under the canopy—close enough that her left arm presses the full length of my coat from shoulder to hip, her right foot taking the first step down with no weight on the turn.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.016", "line_id": "line.ending.alone.normal.016", "text": "At the bottom of the walk, where the hillside path divides toward the station and the flats, she does not look toward the station.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.017", "line_id": "line.ending.alone.normal.017", "text": "Her left hand slips inside the pocket of my coat, where five fingers are already waiting to close around hers.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.018", "line_id": "line.ending.alone.normal.018", "text": "“What time are you coming tomorrow?” she asks.", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.019", "line_id": "line.ending.alone.normal.019", "text": "“Whenever you wake up.”", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.020", "line_id": "line.ending.alone.normal.020", "text": "“That isn\'t a time.”", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.021", "line_id": "line.ending.alone.normal.021", "text": "“Before then.”", "revision": "1" }, { "beat_id": "beat.line.ending.alone.normal.022", "line_id": "line.ending.alone.normal.022", "text": "Lavinia laughs once under her breath, rests her temple against my shoulder beneath the black canopy, and lets the turn take us up the hill.", "revision": "1" }] }] }, "scene_programme": { "kind": "scene_programme", "schema_version": 1, "entries": [{ "entry_id": "Day1", "content_version": 1, "content_sha256": "f1ad4a12b8169af55f9848158ddce3c04412e5fe104c40e5d283c49b3b0e2fb2", "program_sha256": "d0f5c07e41d1430a20f8c62b39ffc20f273ec756cfc725bc8035a41bc42deca4", "markers": [{ "marker_id": "Day1.thought", "label": "Day1.thought", "after_line_id": "line.Day1.031", "kind": "thought.pass", "payload": { "opportunity_id": "Day1.photo", "yes_target_id": "target.Day1.photo.yes", "pass_target_id": "target.Day1.photo.default" } }] }, { "entry_id": "Day1.coda", "content_version": 1, "content_sha256": "f1ad4a12b8169af55f9848158ddce3c04412e5fe104c40e5d283c49b3b0e2fb2", "program_sha256": "eb62b7ecf26d2f7061401d4bbf8b311bd7847c86eaeeac345cffef9ac28560b9", "markers": [{ "marker_id": "Day1.c