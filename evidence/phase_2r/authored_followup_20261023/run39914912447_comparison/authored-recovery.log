 "Day5.C", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day5.D", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day5.D.arch", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day5.D.default", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day5.D.note", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day5.E", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day5.cheek", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day5.cheek.default", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day5.cheek.yes", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day5.impulse", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day6", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day6.A", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day6.B", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day6.C", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day6.D", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day6.D.dark", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day6.D.default", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day6.D.word", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day6.E", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day6.impulse", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day6.rehearsal.default", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day6.rehearsal.yes", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.A", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.B", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.C", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.D.default", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.D.pocket", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.E", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.clipboard.default", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.clipboard.yes", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.crossed.D", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.crossed.D.board", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.crossed.D.no_recording", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.crossed.D.recording", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.crossed.impulse", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.untouched.D", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.untouched.D.board", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.untouched.D.no_recording", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.untouched.D.recording", "plan_id": "template.shared.music.plan" }, { "entry_id": "Day7.untouched.impulse", "plan_id": "template.shared.music.plan" }, { "entry_id": "ending.alone.normal", "plan_id": "template.shared.music.plan" }], "kind": "scene_audio_catalogue", "plans": [{ "ambience_asset_id": <null>, "authorial": true, "cues": [], "entrance_ms": 0, "essential": false, "load_anchor_id": "template.music.start", "load_anchor_ms": 0, "missing_media": "silence", "music": "template.shared.music", "plan_id": "template.shared.music.plan", "revision": 1, "variant_id": "base" }], "schema_version": 2 }, "board_profiles": [{ "base_mine_count": 36, "board_kind": "solo_challenge", "board_profile_id": "week.canonical_solo", "capability_policy_id": "owned_inventory_v1", "difficulty_id": "canonical_solo", "generator_version": "dwm_generator_v1", "height": 18, "verifier_version": "visible_deduction_v1", "width": 18 }], "caption_registry": { "entries": [{ "entry_id": "Day1", "lines": [{ "beat_id": "beat.line.Day1.one", "line_id": "line.Day1.one", "revision": "1", "text": "Sylvia slides the fuller teacup onto my mat and keeps the one with the small chip on the rim for herself." }, { "beat_id": "beat.line.Day1.002", "line_id": "line.Day1.002", "revision": "1", "text": "“The tables by the door are in a draught,” she says. “You always complain about your throat when you sit under the vent.”" }, { "beat_id": "beat.line.Day1.003", "line_id": "line.Day1.003", "revision": "1", "text": "“And the window light happens to be behind your chair.”" }, { "beat_id": "beat.line.Day1.004", "line_id": "line.Day1.004", "revision": "1", "text": "“Someone had to face the glare.”" }, { "beat_id": "beat.line.Day1.005", "line_id": "line.Day1.005", "revision": "1", "text": "She holds her phone out at arm\'s length, then lowers it half an inch without taking the shot." }, { "beat_id": "beat.line.Day1.006", "line_id": "line.Day1.006", "revision": "1", "text": "“Wait. Your left collar is turned under,” she says. “Don\'t move.”" }, { "beat_id": "beat.line.Day1.007", "line_id": "line.Day1.007", "revision": "1", "text": "Her free hand reaches across the corner of the table. Two cool fingers slip beneath the lapel of my blouse, smooth the linen flat against the collarbone, and withdraw before the cloth can warm them." }, { "beat_id": "beat.line.Day1.008", "line_id": "line.Day1.008", "revision": "1", "text": "The chair legs scrape half an inch closer until both faces fit inside the screen." }, { "beat_id": "beat.line.Day1.009", "line_id": "line.Day1.009", "revision": "1", "text": "“Not that expression,” she says." }, { "beat_id": "beat.line.Day1.010", "line_id": "line.Day1.010", "revision": "1", "text": "“It\'s my expression.”" }, { "beat_id": "beat.line.Day1.011", "line_id": "line.Day1.011", "revision": "1", "text": "“It\'s the one you save for university circulars.”" }, { "beat_id": "beat.line.Day1.012", "line_id": "line.Day1.012", "revision": "1", "text": "A slight widening of the mouth." }, { "beat_id": "beat.line.Day1.013", "line_id": "line.Day1.013", "revision": "1", "text": "“Worse.”" }, { "beat_id": "beat.line.Day1.014", "line_id": "line.Day1.014", "revision": "1", "text": "On the table between the saucers, my own phone sounds." }, { "beat_id": "beat.line.Day1.015", "line_id": "line.Day1.015", "revision": "1", "text": "Lavinia, message: Try not to look too pleased when you see me tomorrow." }, { "beat_id": "beat.line.Day1.016", "line_id": "line.Day1.016", "revision": "1", "text": "Eleven words. No greeting, and tomorrow at the end." }, { "beat_id": "beat.line.Day1.017", "line_id": "line.Day1.017", "revision": "1", "text": "Above the keyboard bar, a small grey line appears: Lavinia is recording an audio message..." }, { "beat_id": "beat.line.Day1.018", "line_id": "line.Day1.018", "revision": "1", "text": "The three dots pulse between the cups for a few seconds, then vanish without sending, leaving the bar blank." }, { "beat_id": "beat.line.Day1.019", "line_id": "line.Day1.019", "revision": "1", "text": "Sylvia takes the photograph." }, { "beat_id": "beat.line.Day1.020", "line_id": "line.Day1.020", "revision": "1", "text": "“Oh,” she says, lowering the phone. “You were looking down. Shall I delete that one for you?”" }, { "beat_id": "beat.line.Day1.021", "line_id": "line.Day1.021", "revision": "1", "text": "“Let me see it first.”" }, { "beat_id": "beat.line.Day1.022", "line_id": "line.Day1.022", "revision": "1", "text": "She brings her phone between us. In the picture, the gaze is dropped slightly below the lens—still toward the table where the message lit—while Sylvia has caught herself watching the side of my face." }, { "beat_id": "beat.line.Day1.023", "line_id": "line.Day1.023", "revision": "1", "text": "“Who was it?”" }, { "beat_id": "beat.line.Day1.024", "line_id": "line.Day1.024", "revision": "1", "text": "“Lavinia.”" }, { "beat_id": "beat.line.Day1.025", "line_id": "line.Day1.025", "revision": "1", "text": "“I should have asked her to help earlier.”" }, { "beat_id": "beat.line.Day1.026", "line_id": "line.Day1.026", "revision": "1", "text": "Two fingers spread across the glass to enlarge the picture. Sylvia leans against my arm to see what is being inspected." }, { "beat_id": "beat.line.Day1.027", "line_id": "line.Day1.027", "revision": "1", "text": "“Don\'t inspect it that closely.”" }, { "beat_id": "beat.line.Day1.028", "line_id": "line.Day1.028", "revision": "1", "text": "“I like it.”" }, { "beat_id": "beat.line.Day1.029", "line_id": "line.Day1.029", "revision": "1", "text": "“That isn\'t usually why you zoom in.”" }, { "beat_id": "beat.line.Day1.030", "line_id": "line.Day1.030", "revision": "1", "text": "Her face in this one, too." }, { "beat_id": "beat.line.Day1.031", "line_id": "line.Day1.031", "revision": "1", "text": "Ask for another photograph." }] }, { "entry_id": "Day1.coda", "lines": [{ "beat_id": "beat.line.Day1.coda.001", "line_id": "line.Day1.coda.001", "revision": "1", "text": "A zip runs close to Lavinia\'s microphone." }, { "beat_id": "beat.line.Day1.coda.002", "line_id": "line.Day1.coda.002", "revision": "1", "text": "“Hold on.”" }, { "beat_id": "beat.line.Day1.coda.003", "line_id": "line.Day1.coda.003", "revision": "1", "text": "Something scrapes. She breathes out sharply." }, { "beat_id": "beat.line.Day1.coda.004", "line_id": "line.Day1.coda.004", "revision": "1", "text": "“Too much?” I ask." }, { "beat_id": "beat.line.Day1.coda.005", "line_id": "line.Day1.coda.005", "revision": "1", "text": "“For the case.”" }, { "beat_id": "beat.line.Day1.coda.006", "line_id": "line.Day1.coda.006", "revision": "1", "text": "“Take something out.”" }, { "beat_id": "beat.line.Day1.coda.007", "line_id": "line.Day1.coda.007", "revision": "1", "text": "“I want it.”" }, { "beat_id": "beat.line.Day1.coda.008", "line_id": "line.Day1.coda.008", "revision": "1", "text": "A corner of the mouth lifts in the quiet room." }, { "beat_id": "beat.line.Day1.coda.009", "line_id": "line.Day1.coda.009", "revision": "1", "text": "She tries the zip again." }, { "beat_id": "beat.line.Day1.coda.010", "line_id": "line.Day1.coda.010", "revision": "1", "text": "“What are you taking?”" }, { "beat_id": "beat.line.Day1.coda.011", "line_id": "line.Day1.coda.011", "revision": "1", "text": "“I haven\'t decided what I\'m leaving.”" }, { "beat_id": "beat.line.Day1.coda.012", "line_id": "line.Day1.coda.012", "revision": "1", "text": "“That\'s going well.”" }, { "beat_id": "beat.line.Day1.coda.013", "line_id": "line.Day1.coda.013", "revision": "1", "text": "“Very.”" }, { "beat_id": "beat.line.Day1.coda.014", "line_id": "line.Day1.coda.014", "revision": "1", "text": "For a while the line carries only the sound of her moving things. Once she laughs at something unseen." }, { "beat_id": "beat.line.Day1.coda.015", "line_id": "line.Day1.coda.015", "revision": "1", "text": "“What?”" }, { "beat_id": "beat.line.Day1.coda.016", "line_id": "line.Day1.coda.016", "revision": "1", "text": "“Nothing.”" }, { "beat_id": "beat.line.Day1.coda.017", "line_id": "line.Day1.coda.017", "revision": "1", "text": "“That was a laugh.”" }, { "beat_id": "beat.line.Day1.coda.018", "line_id": "line.Day1.coda.018", "revision": "1", "text": "“Yes.”" }, { "beat_id": "beat.line.Day1.coda.019", "line_id": "line.Day1.coda.019", "revision": "1", "text": "Silence waits for her to continue." }, { "beat_id": "beat.line.Day1.coda.020", "line_id": "line.Day1.coda.020", "revision": "1", "text": "“You\'ll see tomorrow,” she says." }, { "beat_id": "beat.line.Day1.coda.021", "line_id": "line.Day1.coda.021", "revision": "1", "text": "After a moment, the zip closes." }, { "beat_id": "beat.line.Day1.coda.022", "line_id": "line.Day1.coda.022", "revision": "1", "text": "“There.”" }, { "beat_id": "beat.line.Day1.coda.023", "line_id": "line.Day1.coda.023", "revision": "1", "text": "The chair turns back toward the desk." }, { "beat_id": "beat.line.Day1.coda.024", "line_id": "line.Day1.coda.024", "revision": "1", "text": "“Stay on the call.”" }, { "beat_id": "beat.line.Day1.coda.025", "line_id": "line.Day1.coda.025", "revision": "1", "text": "“I\'ve finished.”" }, { "beat_id": "beat.line.Day1.coda.026", "line_id": "line.Day1.coda.026", "revision": "1", "text": "“I know.”" }, { "beat_id": "beat.line.Day1.coda.027", "line_id": "line.Day1.coda.027", "revision": "1", "text": "A faint knock comes through the phone." }, { "beat_id": "beat.line.Day1.coda.028", "line_id": "line.Day1.coda.028", "revision": "1", "text": "“Priscilla.”" }, { "beat_id": "beat.line.Day1.coda.029", "line_id": "line.Day1.coda.029", "revision": "1", "text": "“Yes?”" }, { "beat_id": "beat.line.Day1.coda.030", "line_id": "line.Day1.coda.030", "revision": "1", "text": "“You don\'t have to stay.”" }, { "beat_id": "beat.line.Day1.coda.031", "line_id": "line.Day1.coda.031", "revision": "1", "text": "“Would you like me to go?”" }, { "beat_id": "beat.line.Day1.coda.032", "line_id": "line.Day1.coda.032", "revision": "1", "text": "“I asked if you wanted to.”" }, { "beat_id": "beat.line.Day1.coda.033", "line_id": "line.Day1.coda.033", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day1.coda.034", "line_id": "line.Day1.coda.034", "revision": "1", "text": "“All right.”" }, { "beat_id": "beat.line.Day1.coda.035", "line_id": "line.Day1.coda.035", "revision": "1", "text": "The phone comes a little closer to the chin; something brushes against the microphone." }, { "beat_id": "beat.line.Day1.coda.036", "line_id": "line.Day1.coda.036", "revision": "1", "text": "“Put it down,” Lavinia says. “I can hear you moving it.”" }, { "beat_id": "beat.line.Day1.coda.037", "line_id": "line.Day1.coda.037", "revision": "1", "text": "It settles flat beside the lamp." }, { "beat_id": "beat.line.Day1.coda.038", "line_id": "line.Day1.coda.038", "revision": "1", "text": "“Like that?”" }, { "beat_id": "beat.line.Day1.coda.039", "line_id": "line.Day1.coda.039", "revision": "1", "text": "“Yes.”" }, { "beat_id": "beat.line.Day1.coda.040", "line_id": "line.Day1.coda.040", "revision": "1", "text": "The desk is lit in a small circle; the rest of the room is dark." }, { "beat_id": "beat.line.Day1.coda.041", "line_id": "line.Day1.coda.041", "revision": "1", "text": "“Don\'t hang up when I stop talking,” Lavinia says." }, { "beat_id": "beat.line.Day1.coda.042", "line_id": "line.Day1.coda.042", "revision": "1", "text": "“I wasn\'t going to.”" }, { "beat_id": "beat.line.Day1.coda.043", "line_id": "line.Day1.coda.043", "revision": "1", "text": "She asks what was so funny about the book." }, { "beat_id": "beat.line.Day1.coda.044", "line_id": "line.Day1.coda.044", "revision": "1", "text": "“She keeps stopping her own funeral.”" }, { "beat_id": "beat.line.Day1.coda.045", "line_id": "line.Day1.coda.045", "revision": "1", "text": "“Is she dead?”" }, { "beat_id": "beat.line.Day1.coda.046", "line_id": "line.Day1.coda.046", "revision": "1", "text": "“She\'s practising.”" }, { "beat_id": "beat.line.Day1.coda.047", "line_id": "line.Day1.coda.047", "revision": "1", "text": "Into the quiet room, in the aunt\'s voice: “‘Again. You sound relieved.’”" }, { "beat_id": "beat.line.Day1.coda.048", "line_id": "line.Day1.coda.048", "revision": "1", "text": "The laugh comes through the phone, then a rustle." }, { "beat_id": "beat.line.Day1.coda.049", "line_id": "line.Day1.coda.049", "revision": "1", "text": "When she becomes quiet, the phone stays where it is." }] }, { "entry_id": "Day1.photo.default", "lines": [{ "beat_id": "beat.line.Day1.photo.default.001", "line_id": "line.Day1.photo.default.001", "revision": "1", "text": "“Send it to me.”" }, { "beat_id": "beat.line.Day1.photo.default.002", "line_id": "line.Day1.photo.default.002", "revision": "1", "text": "“Without making me take six more?”" }, { "beat_id": "beat.line.Day1.photo.default.003", "line_id": "line.Day1.photo.default.003", "revision": "1", "text": "“Before you change your mind.”" }, { "beat_id": "beat.line.Day1.photo.default.004", "line_id": "line.Day1.photo.default.004", "revision": "1", "text": "Sylvia sends the photograph, then checks it once herself." }, { "beat_id": "beat.line.Day1.photo.default.005", "line_id": "line.Day1.photo.default.005", "revision": "1", "text": "“You can have one more later. If necessary.”" }] }, { "entry_id": "Day1.photo.yes", "lines": [{ "beat_id": "beat.line.Day1.photo.yes.001", "line_id": "line.Day1.photo.yes.001", "revision": "1", "text": "“Wait. One more.”" }, { "beat_id": "beat.line.Day1.photo.yes.002", "line_id": "line.Day1.photo.yes.002", "revision": "1", "text": "“We have a good one.”" }, { "beat_id": "beat.line.Day1.photo.yes.003", "line_id": "line.Day1.photo.yes.003", "revision": "1", "text": "“You aren\'t looking at the camera.”" }, { "beat_id": "beat.line.Day1.photo.yes.004", "line_id": "line.Day1.photo.yes.004", "revision": "1", "text": "“I was supervising.”" }, { "beat_id": "beat.line.Day1.photo.yes.005", "line_id": "line.Day1.photo.yes.005", "revision": "1", "text": "The chair pulls closer; this time the eyes stay on the screen instead of my phone." }, { "beat_id": "beat.line.Day1.photo.yes.006", "line_id": "line.Day1.photo.yes.006", "revision": "1", "text": "Sylvia tries to arrange her mouth, looks across the screen, and laughs before she takes the picture." }, { "beat_id": "beat.line.Day1.photo.yes.007", "line_id": "line.Day1.photo.yes.007", "revision": "1", "text": "“Now you aren\'t looking at the camera either,” she says." }, { "beat_id": "beat.line.Day1.photo.yes.008", "line_id": "line.Day1.photo.yes.008", "revision": "1", "text": "“Send me both.”" }, { "beat_id": "beat.line.Day1.photo.yes.009", "line_id": "line.Day1.photo.yes.009", "revision": "1", "text": "She does." }] }, { "entry_id": "Day1.reading", "lines": [{ "beat_id": "beat.line.Day1.reading.001", "line_id": "line.Day1.reading.001", "revision": "1", "text": "Sylvia puts her phone away and moves her chair to the other side of the table." }, { "beat_id": "beat.line.Day1.reading.002", "line_id": "line.Day1.reading.002", "revision": "1", "text": "The paperback beneath Sylvia\'s bag has a bent cover. She smooths it with her palm." }, { "beat_id": "beat.line.Day1.reading.003", "line_id": "line.Day1.reading.003", "revision": "1", "text": "The Funeral Rehearsal." }, { "beat_id": "beat.line.Day1.reading.004", "line_id": "line.Day1.reading.004", "revision": "1", "text": "“She insists on attending,” Sylvia says." }, { "beat_id": "beat.line.Day1.reading.005", "line_id": "line.Day1.reading.005", "revision": "1", "text": "“Her own?”" }, { "beat_id": "beat.line.Day1.reading.006", "line_id": "line.Day1.reading.006", "revision": "1", "text": "“Listen.”" }, { "beat_id": "beat.line.Day1.reading.007", "line_id": "line.Day1.reading.007", "revision": "1", "text": "She opens it near the beginning." }, { "beat_id": "beat.line.Day1.reading.008", "line_id": "line.Day1.reading.008", "revision": "1", "text": "“‘The eulogy was excellent. She asked whether it could be about her.’”" }, { "beat_id": "beat.line.Day1.reading.009", "line_id": "line.Day1.reading.009", "revision": "1", "text": "A laugh escapes before the cup reaches the saucer. Sylvia\'s finger stays beneath the sentence." }, { "beat_id": "beat.line.Day1.reading.010", "line_id": "line.Day1.reading.010", "revision": "1", "text": "“I read that standing in the shop.”" }, { "beat_id": "beat.line.Day1.reading.011", "line_id": "line.Day1.reading.011", "revision": "1", "text": "“You bought a whole novel for one line?”" }, { "beat_id": "beat.line.Day1.reading.012", "line_id": "line.Day1.reading.012", "revision": "1", "text": "“I wanted to know what she\'d object to next.”" }, { "beat_id": "beat.line.Day1.reading.013", "line_id": "line.Day1.reading.013", "revision": "1", "text": "The corner of the next page lifts under her thumb." }, { "beat_id": "beat.line.Day1.reading.014", "line_id": "line.Day1.reading.014", "revision": "1", "text": "Sylvia lowers her voice." }, { "beat_id": "beat.line.Day1.reading.015", "line_id": "line.Day1.reading.015", "revision": "1", "text": "“‘Again,’ said the aunt. ‘You sound relieved.’”" }, { "beat_id": "beat.line.Day1.reading.016", "line_id": "line.Day1.reading.016", "revision": "1", "text": "“Is she in the coffin?”" }, { "beat_id": "beat.line.Day1.reading.017", "line_id": "line.Day1.reading.017", "revision": "1", "text": "“An armchair.”" }, { "beat_id": "beat.line.Day1.reading.018", "line_id": "line.Day1.reading.018", "revision": "1", "text": "“More convenient for supervising.”" }, { "beat_id": "beat.line.Day1.reading.019", "line_id": "line.Day1.reading.019", "revision": "1", "text": "Sylvia finds the next speech." }, { "beat_id": "beat.line.Day1.reading.020", "line_id": "line.Day1.reading.020", "revision": "1", "text": "“There\'s a man at the door. He says he\'s come about a carriage.”" }, { "beat_id": "beat.line.Day1.reading.021", "line_id": "line.Day1.reading.021", "revision": "1", "text": "Sylvia puts one hand against her chest." }, { "beat_id": "beat.line.Day1.reading.022", "line_id": "line.Day1.reading.022", "revision": "1", "text": "“‘My cousin required the carriage.’”" }, { "beat_id": "beat.line.Day1.reading.023", "line_id": "line.Day1.reading.023", "revision": "1", "text": "A laugh catches before she has finished the last word." }, { "beat_id": "beat.line.Day1.reading.024", "line_id": "line.Day1.reading.024", "revision": "1", "text": "“What?”" }, { "beat_id": "beat.line.Day1.reading.025", "line_id": "line.Day1.reading.025", "revision": "1", "text": "“The voice.”" }, { "beat_id": "beat.line.Day1.reading.026", "line_id": "line.Day1.reading.026", "revision": "1", "text": "“He\'s in love.”" }, { "beat_id": "beat.line.Day1.reading.027", "line_id": "line.Day1.reading.027", "revision": "1", "text": "“Give me his part.”" }, { "beat_id": "beat.line.Day1.reading.028", "line_id": "line.Day1.reading.028", "revision": "1", "text": "She turns the book toward me, keeping a finger beneath the line. I read his next speech in the same voice." }, { "beat_id": "beat.line.Day1.reading.029", "line_id": "line.Day1.reading.029", "revision": "1", "text": "Sylvia bends over the table. A moment passes before she can stop laughing." }, { "beat_id": "beat.line.Day1.reading.030", "line_id": "line.Day1.reading.030", "revision": "1", "text": "“Too pleased with himself,” she says. “He thinks this is working.”" }, { "beat_id": "beat.line.Day1.reading.031", "line_id": "line.Day1.reading.031", "revision": "1", "text": "The line repeats without the flourish on the last word." }, { "beat_id": "beat.line.Day1.reading.032", "line_id": "line.Day1.reading.032", "revision": "1", "text": "“Yes. Like that.”" }, { "beat_id": "beat.line.Day1.reading.033", "line_id": "line.Day1.reading.033", "revision": "1", "text": "She takes the book back." }, { "beat_id": "beat.line.Day1.reading.034", "line_id": "line.Day1.reading.034", "revision": "1", "text": "For a while, we read in turns. Sylvia gives the aunt the careful, carrying voice of someone repeating a reasonable request. When I try to do her as well, Sylvia kicks the leg of my chair." }, { "beat_id": "beat.line.Day1.reading.035", "line_id": "line.Day1.reading.035", "revision": "1", "text": "“Mine.”" }, { "beat_id": "beat.line.Day1.reading.036", "line_id": "line.Day1.reading.036", "revision": "1", "text": "“All right.”" }, { "beat_id": "beat.line.Day1.reading.037", "line_id": "line.Day1.reading.037", "revision": "1", "text": "The aunt again. Before he can finish." }, { "beat_id": "beat.line.Day1.reading.038", "line_id": "line.Day1.reading.038", "revision": "1", "text": "The phone lights up on the table." }, { "beat_id": "beat.line.Day1.reading.039", "line_id": "line.Day1.reading.039", "revision": "1", "text": "Lavinia, message: Are you busy?" }, { "beat_id": "beat.line.Day1.reading.040", "line_id": "line.Day1.reading.040", "revision": "1", "text": "Priscilla, message: Reading with Sylvia." }, { "beat_id": "beat.line.Day1.reading.041", "line_id": "line.Day1.reading.041", "revision": "1", "text": "Lavinia, message: Anything good?" }, { "beat_id": "beat.line.Day1.reading.042", "line_id": "line.Day1.reading.042", "revision": "1", "text": "Priscilla, message: She\'s making it better." }, { "beat_id": "beat.line.Day1.reading.043", "line_id": "line.Day1.reading.043", "revision": "1", "text": "“Should I send it to you?” Sylvia asks." }, { "beat_id": "beat.line.Day1.reading.044", "line_id": "line.Day1.reading.044", "revision": "1", "text": "“What?”" }, { "beat_id": "beat.line.Day1.reading.045", "line_id": "line.Day1.reading.045", "revision": "1", "text": "“My part. You\'re answering those quite quickly.”" }, { "beat_id": "beat.line.Day1.reading.046", "line_id": "line.Day1.reading.046", "revision": "1", "text": "The message goes through; the phone returns to the wood." }, { "beat_id": "beat.line.Day1.reading.047", "line_id": "line.Day1.reading.047", "revision": "1", "text": "“Sorry. Where are we?”" }, { "beat_id": "beat.line.Day1.reading.048", "line_id": "line.Day1.reading.048", "revision": "1", "text": "She puts her finger beneath the line." }, { "beat_id": "beat.line.Day1.reading.049", "line_id": "line.Day1.reading.049", "revision": "1", "text": "One exchange, then another, before a hand stops her at the margin." }, { "beat_id": "beat.line.Day1.reading.050", "line_id": "line.Day1.reading.050", "revision": "1", "text": "“He says the flowers are for the funeral.”" }, { "beat_id": "beat.line.Day1.reading.051", "line_id": "line.Day1.reading.051", "revision": "1", "text": "“They are now.”" }, { "beat_id": "beat.line.Day1.reading.052", "line_id": "line.Day1.reading.052", "revision": "1", "text": "“They\'ve got the niece\'s name on them.”" }, { "beat_id": "beat.line.Day1.reading.053", "line_id": "line.Day1.reading.053", "revision": "1", "text": "“The aunt has taken the ribbon off.”" }, { "beat_id": "beat.line.Day1.reading.054", "line_id": "line.Day1.reading.054", "revision": "1", "text": "“He could say he wanted to see her.”" }, { "beat_id": "beat.line.Day1.reading.055", "line_id": "line.Day1.reading.055", "revision": "1", "text": "Sylvia offers the book across the saucers." }, { "beat_id": "beat.line.Day1.reading.056", "line_id": "line.Day1.reading.056", "revision": "1", "text": "“Then say it.”" }, { "beat_id": "beat.line.Day1.reading.057", "line_id": "line.Day1.reading.057", "revision": "1", "text": "“I wanted to see you.”" }, { "beat_id": "beat.line.Day1.reading.058", "line_id": "line.Day1.reading.058", "revision": "1", "text": "She looks down at the page; her finger stays still for half a beat." }, { "beat_id": "beat.line.Day1.reading.059", "line_id": "line.Day1.reading.059", "revision": "1", "text": "“Much shorter.”" }, { "beat_id": "beat.line.Day1.reading.060", "line_id": "line.Day1.reading.060", "revision": "1", "text": "“They could have saved paper.”" }, { "beat_id": "beat.line.Day1.reading.061", "line_id": "line.Day1.reading.061", "revision": "1", "text": "Sylvia begins the woman\'s answer without the voice. Halfway through, she remembers it, and the place on the page is lost in laughing." }, { "beat_id": "beat.line.Day1.reading.062", "line_id": "line.Day1.reading.062", "revision": "1", "text": "The aunt invites everyone back for another rehearsal." }, { "beat_id": "beat.line.Day1.reading.063", "line_id": "line.Day1.reading.063", "revision": "1", "text": "“‘Tomorrow, do try to look a little less pleased,’” Sylvia reads." }, { "beat_id": "beat.line.Day1.reading.064", "line_id": "line.Day1.reading.064", "revision": "1", "text": "“Let me see.”" }, { "beat_id": "beat.line.Day1.reading.065", "line_id": "line.Day1.reading.065", "revision": "1", "text": "Sylvia turns the book toward me." }, { "beat_id": "beat.line.Day1.reading.066", "line_id": "line.Day1.reading.066", "revision": "1", "text": "Tomorrow. At the beginning, this time." }, { "beat_id": "beat.line.Day1.reading.067", "line_id": "line.Day1.reading.067", "revision": "1", "text": "“Have you read this part before?”" }, { "beat_id": "beat.line.Day1.reading.068", "line_id": "line.Day1.reading.068", "revision": "1", "text": "“No. Why?”" }, { "beat_id": "beat.line.Day1.reading.069", "line_id": "line.Day1.reading.069", "revision": "1", "text": "“Keep going.”" }, { "beat_id": "beat.line.Day1.reading.070", "line_id": "line.Day1.reading.070", "revision": "1", "text": "She waits. The corner of the page is still between my fingers." }, { "beat_id": "beat.line.Day1.reading.071", "line_id": "line.Day1.reading.071", "revision": "1", "text": "The fingers open; she draws the book back." }, { "beat_id": "beat.line.Day1.reading.072", "line_id": "line.Day1.reading.072", "revision": "1", "text": "The phone lights again." }, { "beat_id": "beat.line.Day1.reading.073", "line_id": "line.Day1.reading.073", "revision": "1", "text": "Sylvia closes the paperback around her finger." }, { "beat_id": "beat.line.Day1.reading.074", "line_id": "line.Day1.reading.074", "revision": "1", "text": "“What does she want?”" }, { "beat_id": "beat.line.Day1.reading.075", "line_id": "line.Day1.reading.075", "revision": "1", "text": "“She\'s asking whether she\'s interrupting.”" }, { "beat_id": "beat.line.Day1.reading.076", "line_id": "line.Day1.reading.076", "revision": "1", "text": "“And?”" }, { "beat_id": "beat.line.Day1.reading.077", "line_id": "line.Day1.reading.077", "revision": "1", "text": "Only a few pages between her finger and the front cover." }, { "beat_id": "beat.line.Day1.reading.078", "line_id": "line.Day1.reading.078", "revision": "1", "text": "“We haven\'t got very far.”" }, { "beat_id": "beat.line.Day1.reading.079", "line_id": "line.Day1.reading.079", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day1.reading.080", "line_id": "line.Day1.reading.080", "revision": "1", "text": "Sylvia puts the book down." }, { "beat_id": "beat.line.Day1.reading.081", "line_id": "line.Day1.reading.081", "revision": "1", "text": "“Let me answer her,” she says. “Then you don\'t have to stop.”" }, { "beat_id": "beat.line.Day1.reading.082", "line_id": "line.Day1.reading.082", "revision": "1", "text": "“What are you going to say?”" }, { "beat_id": "beat.line.Day1.reading.083", "line_id": "line.Day1.reading.083", "revision": "1", "text": "“I\'ll show you before I send it.”" }, { "beat_id": "beat.line.Day1.reading.084", "line_id": "line.Day1.reading.084", "revision": "1", "text": "The unlocked phone passes into her hand with the conversation open." }, { "beat_id": "beat.line.Day1.reading.085", "line_id": "line.Day1.reading.085", "revision": "1", "text": "She types, then turns the screen toward me." }, { "beat_id": "beat.line.Day1.reading.086", "line_id": "line.Day1.reading.086", "revision": "1", "text": "Unsent draft on Priscilla\'s phone: You\'re interrupting my date. Sylvia." }, { "beat_id": "beat.line.Day1.reading.087", "line_id": "line.Day1.reading.087", "revision": "1", "text": "“Your date?”" }, { "beat_id": "beat.line.Day1.reading.088", "line_id": "line.Day1.reading.088", "revision": "1", "text": "“You\'ve stayed. We\'ve taken a photograph. I\'ve read to you.”" }, { "beat_id": "beat.line.Day1.reading.089", "line_id": "line.Day1.reading.089", "revision": "1", "text": "“Would you like me to leave?”" }, { "beat_id": "beat.line.Day1.reading.090", "line_id": "line.Day1.reading.090", "revision": "1", "text": "“Not yet.”" }, { "beat_id": "beat.line.Day1.reading.091", "line_id": "line.Day1.reading.091", "revision": "1", "text": "Her thumb rests below the message. She has not sent it." }, { "beat_id": "beat.line.Day1.reading.092", "line_id": "line.Day1.reading.092", "revision": "1", "text": "Changing date to reading would still be a joke. It would be easier to explain." }, { "beat_id": "beat.line.Day1.reading.093", "line_id": "line.Day1.reading.093", "revision": "1", "text": "“Send it.”" }, { "beat_id": "beat.line.Day1.reading.094", "line_id": "line.Day1.reading.094", "revision": "1", "text": "Sylvia sends the message and gives the phone back." }, { "beat_id": "beat.line.Day1.reading.095", "line_id": "line.Day1.reading.095", "revision": "1", "text": "It rests beside the drink. Neither hand reaches for the book." }, { "beat_id": "beat.line.Day1.reading.096", "line_id": "line.Day1.reading.096", "revision": "1", "text": "Lavinia, message: Priscilla?" }, { "beat_id": "beat.line.Day1.reading.097", "line_id": "line.Day1.reading.097", "revision": "1", "text": "Sylvia looks across the table." }, { "beat_id": "beat.line.Day1.reading.098", "line_id": "line.Day1.reading.098", "revision": "1", "text": "“You should answer that one.”" }, { "beat_id": "beat.line.Day1.reading.099", "line_id": "line.Day1.reading.099", "revision": "1", "text": "Two thumbs on the glass:" }, { "beat_id": "beat.line.Day1.reading.100", "line_id": "line.Day1.reading.100", "revision": "1", "text": "Priscilla, message: I said she could send it." }, { "beat_id": "beat.line.Day1.reading.101", "line_id": "line.Day1.reading.101", "revision": "1", "text": "Sent before anything else can follow it." }, { "beat_id": "beat.line.Day1.reading.102", "line_id": "line.Day1.reading.102", "revision": "1", "text": "Sylvia opens the book and reads the first few words. The cue passes without a sound." }, { "beat_id": "beat.line.Day1.reading.103", "line_id": "line.Day1.reading.103", "revision": "1", "text": "Lavinia, message: Then tell me yourself." }, { "beat_id": "beat.line.Day1.reading.104", "line_id": "line.Day1.reading.104", "revision": "1", "text": "Across the table, Sylvia is still holding the page open." }, { "beat_id": "beat.line.Day1.reading.105", "line_id": "line.Day1.reading.105", "revision": "1", "text": "“What did she say?” Sylvia asks." }, { "beat_id": "beat.line.Day1.reading.106", "line_id": "line.Day1.reading.106", "revision": "1", "text": "Lavinia\'s last message is read aloud." }, { "beat_id": "beat.line.Day1.reading.107", "line_id": "line.Day1.reading.107", "revision": "1", "text": "“Well?”" }, { "beat_id": "beat.line.Day1.reading.108", "line_id": "line.Day1.reading.108", "revision": "1", "text": "A sip from the cup." }, { "beat_id": "beat.line.Day1.reading.109", "line_id": "line.Day1.reading.109", "revision": "1", "text": "“I\'m thinking.”" }, { "beat_id": "beat.line.Day1.reading.110", "line_id": "line.Day1.reading.110", "revision": "1", "text": "Sylvia shifts the book so that a hand can reach it." }, { "beat_id": "beat.line.Day1.reading.111", "line_id": "line.Day1.reading.111", "revision": "1", "text": "A voice message." }] }, { "entry_id": "Day1.result.A", "lines": [{ "beat_id": "beat.line.Day1.result.A.001", "line_id": "line.Day1.result.A.001", "revision": "1", "text": "The message is recorded once." }, { "beat_id": "beat.line.Day1.result.A.002", "line_id": "line.Day1.result.A.002", "revision": "1", "text": "Priscilla, sent voice: I\'m having a very good time. I don\'t think I want to leave yet." }, { "beat_id": "beat.line.Day1.result.A.003", "line_id": "line.Day1.result.A.003", "revision": "1", "text": "Sylvia watches it go." }, { "beat_id": "beat.line.Day1.result.A.004", "line_id": "line.Day1.result.A.004", "revision": "1", "text": "“Was that my review?”" }, { "beat_id": "beat.line.Day1.result.A.005", "line_id": "line.Day1.result.A.005", "revision": "1", "text": "“You can put it on the cover.”" }, { "beat_id": "beat.line.Day1.result.A.006", "line_id": "line.Day1.result.A.006", "revision": "1", "text": "She turns the book over and considers the printed endorsements." }, { "beat_id": "beat.line.Day1.result.A.007", "line_id": "line.Day1.result.A.007", "revision": "1", "text": "The reply arrives." }, { "beat_id": "beat.line.Day1.result.A.008", "line_id": "line.Day1.result.A.008", "revision": "1", "text": "Lavinia, message: Then I\'ll leave you to it." }, { "beat_id": "beat.line.Day1.result.A.009", "line_id": "line.Day1.result.A.009", "revision": "1", "text": "Sylvia finds the page again." }, { "beat_id": "beat.line.Day1.result.A.010", "line_id": "line.Day1.result.A.010", "revision": "1", "text": "The phone stays in the hand a little longer." }, { "beat_id": "beat.line.Day1.result.A.011", "line_id": "line.Day1.result.A.011", "revision": "1", "text": "No question at the end." }, { "beat_id": "beat.line.Day1.result.A.012", "line_id": "line.Day1.result.A.012", "revision": "1", "text": "“Your part,” Sylvia says." }, { "beat_id": "beat.line.Day1.result.A.013", "line_id": "line.Day1.result.A.013", "revision": "1", "text": "The first line starts at the wrong row." }, { "beat_id": "beat.line.Day1.result.A.014", "line_id": "line.Day1.result.A.014", "revision": "1", "text": "“No. Above that.”" }, { "beat_id": "beat.line.Day1.result.A.015", "line_id": "line.Day1.result.A.015", "revision": "1", "text": "Before the speech is finished, the eyes drop to the phone again." }, { "beat_id": "beat.line.Day1.result.A.016", "line_id": "line.Day1.result.A.016", "revision": "1", "text": "Sylvia takes her finger out of the book." }, { "beat_id": "beat.line.Day1.result.A.017", "line_id": "line.Day1.result.A.017", "revision": "1", "text": "“Do you want to call her?”" }, { "beat_id": "beat.line.Day1.result.A.018", "line_id": "line.Day1.result.A.018", "revision": "1", "text": "“Why would I?”" }, { "beat_id": "beat.line.Day1.result.A.019", "line_id": "line.Day1.result.A.019", "revision": "1", "text": "“I don\'t know. You tell me.”" }, { "beat_id": "beat.line.Day1.result.A.020", "line_id": "line.Day1.result.A.020", "revision": "1", "text": "The phone goes face down on the wood." }, { "beat_id": "beat.line.Day1.result.A.021", "line_id": "line.Day1.result.A.021", "revision": "1", "text": "“One more page?”" }, { "beat_id": "beat.line.Day1.result.A.022", "line_id": "line.Day1.result.A.022", "revision": "1", "text": "Sylvia pushes the book across the table." }, { "beat_id": "beat.line.Day1.result.A.023", "line_id": "line.Day1.result.A.023", "revision": "1", "text": "“You read.”" }, { "beat_id": "beat.line.Day1.result.A.024", "line_id": "line.Day1.result.A.024", "revision": "1", "text": "The first sentence comes out too loud; she makes a small downward motion with her hand, and the voice drops back into place." }, { "beat_id": "beat.line.Day1.result.A.025", "line_id": "line.Day1.result.A.025", "revision": "1", "text": "At the last line she supplies the aunt\'s voice, almost under her breath." }, { "beat_id": "beat.line.Day1.result.A.026", "line_id": "line.Day1.result.A.026", "revision": "1", "text": "A laugh; Sylvia smiles, then closes the book." }, { "beat_id": "beat.line.Day1.result.A.027", "line_id": "line.Day1.result.A.027", "revision": "1", "text": "“That will do.”" }, { "beat_id": "beat.line.Day1.result.A.028", "line_id": "line.Day1.result.A.028", "revision": "1", "text": "She puts it in her bag. Outside the café, we walk together as far as the stairs. Sylvia turns there; the corridor ahead continues with the phone in my hand." }, { "beat_id": "beat.line.Day1.result.A.029", "line_id": "line.Day1.result.A.029", "revision": "1", "text": "Evening. Alone at the desk when the call goes through to Lavinia. There is no video." }, { "beat_id": "beat.line.Day1.result.A.030", "line_id": "line.Day1.result.A.030", "revision": "1", "text": "“Finished?” Lavinia asks." }, { "beat_id": "beat.line.Day1.result.A.031", "line_id": "line.Day1.result.A.031", "revision": "1", "text": "“Would I call if I hadn\'t?”" }, { "beat_id": "beat.line.Day1.result.A.032", "line_id": "line.Day1.result.A.032", "revision": "1", "text": "“I thought you were telling me to leave you alone.”" }, { "beat_id": "beat.line.Day1.result.A.033", "line_id": "line.Day1.result.A.033", "revision": "1", "text": "“I wasn\'t.”" }, { "beat_id": "beat.line.Day1.result.A.034", "line_id": "line.Day1.result.A.034", "revision": "1", "text": "“Good.”" }] }, { "entry_id": "Day1.result.B", "lines": [{ "beat_id": "beat.line.Day1.result.B.001", "line_id": "line.Day1.result.B.001", "revision": "1", "text": "The voice recorder opens, then closes without recording." }, { "beat_id": "beat.line.Day1.result.B.002", "line_id": "line.Day1.result.B.002", "revision": "1", "text": "“Not now.”" }, { "beat_id": "beat.line.Day1.result.B.003", "line_id": "line.Day1.result.B.003", "revision": "1", "text": "Thumbs type instead:" }, { "beat_id": "beat.line.Day1.result.B.004", "line_id": "line.Day1.result.B.004", "revision": "1", "text": "Priscilla, message: I\'ll answer you later." }, { "beat_id": "beat.line.Day1.result.B.005", "line_id": "line.Day1.result.B.005", "revision": "1", "text": "The phone goes face down on the table." }, { "beat_id": "beat.line.Day1.result.B.006", "line_id": "line.Day1.result.B.006", "revision": "1", "text": "Sylvia watches until the hand leaves it." }, { "beat_id": "beat.line.Day1.result.B.007", "line_id": "line.Day1.result.B.007", "revision": "1", "text": "“Finished?”" }, { "beat_id": "beat.line.Day1.result.B.008", "line_id": "line.Day1.result.B.008", "revision": "1", "text": "“For now.”" }, { "beat_id": "beat.line.Day1.result.B.009", "line_id": "line.Day1.result.B.009", "revision": "1", "text": "She turns the paperback around." }, { "beat_id": "beat.line.Day1.result.B.010", "line_id": "line.Day1.result.B.010", "revision": "1", "text": "“You can be the cousin.”" }, { "beat_id": "beat.line.Day1.result.B.011", "line_id": "line.Day1.result.B.011", "revision": "1", "text": "“Does she have a line, or only a grievance?”" }, { "beat_id": "beat.line.Day1.result.B.012", "line_id": "line.Day1.result.B.012", "revision": "1", "text": "“A whole speech.”" }, { "beat_id": "beat.line.Day1.result.B.013", "line_id": "line.Day1.result.B.013", "revision": "1", "text": "The cousin has brought the wrong eulogy. Sylvia points to its first sentence." }, { "beat_id": "beat.line.Day1.result.B.014", "line_id": "line.Day1.result.B.014", "revision": "1", "text": "“‘Beloved father of six,’” I read." }, { "beat_id": "beat.line.Day1.result.B.015", "line_id": "line.Day1.result.B.015", "revision": "1", "text": "Sylvia shuts her eyes." }, { "beat_id": "beat.line.Day1.result.B.016", "line_id": "line.Day1.result.B.016", "revision": "1", "text": "A laugh breaks the next word." }, { "beat_id": "beat.line.Day1.result.B.017", "line_id": "line.Day1.result.B.017", "revision": "1", "text": "“No,” she says. “There\'s an answer.”" }, { "beat_id": "beat.line.Day1.result.B.018", "line_id": "line.Day1.result.B.018", "revision": "1", "text": "Before the sentence can finish, Sylvia supplies the aunt\'s answer:" }, { "beat_id": "beat.line.Day1.result.B.019", "line_id": "line.Day1.result.B.019", "revision": "1", "text": "“‘Three,’ she said. ‘And I was their mother.’”" }, { "beat_id": "beat.line.Day1.result.B.020", "line_id": "line.Day1.result.B.020", "revision": "1", "text": "We read to the end of the chapter. Once, the phone is turned over—no new message—and set down again." }, { "beat_id": "beat.line.Day1.result.B.021", "line_id": "line.Day1.result.B.021", "revision": "1", "text": "When Sylvia begins looking for the next chapter, a fingertip touches the edge of the page." }, { "beat_id": "beat.line.Day1.result.B.022", "line_id": "line.Day1.result.B.022", "revision": "1", "text": "“Shall we stop there?”" }, { "beat_id": "beat.line.Day1.result.B.023", "line_id": "line.Day1.result.B.023", "revision": "1", "text": "She checks the time." }, { "beat_id": "beat.line.Day1.result.B.024", "line_id": "line.Day1.result.B.024", "revision": "1", "text": "“We probably should.”" }, { "beat_id": "beat.line.Day1.result.B.025", "line_id": "line.Day1.result.B.025", "revision": "1", "text": "She folds the corner back along its old crease and puts the book in her bag. At the stairs she reminds me that the cousin has my voice now; doing the voice once more sends her down laughing." }, { "beat_id": "beat.line.Day1.result.B.026", "line_id": "line.Day1.result.B.026", "revision": "1", "text": "Evening. Alone at the desk when the call goes through to Lavinia. There is no video." }, { "beat_id": "beat.line.Day1.result.B.027", "line_id": "line.Day1.result.B.027", "revision": "1", "text": "“Later,” Lavinia says." }, { "beat_id": "beat.line.Day1.result.B.028", "line_id": "line.Day1.result.B.028", "revision": "1", "text": "“I said I\'d answer.”" }, { "beat_id": "beat.line.Day1.result.B.029", "line_id": "line.Day1.result.B.029", "revision": "1", "text": "“You did.”" }, { "beat_id": "beat.line.Day1.result.B.030", "line_id": "line.Day1.result.B.030", "revision": "1", "text": "“It was a good afternoon.”" }, { "beat_id": "beat.line.Day1.result.B.031", "line_id": "line.Day1.result.B.031", "revision": "1", "text": "“That took you a while.”" }, { "beat_id": "beat.line.Day1.result.B.032", "line_id": "line.Day1.result.B.032", "revision": "1", "text": "“I wanted to call.”" }, { "beat_id": "beat.line.Day1.result.B.033", "line_id": "line.Day1.result.B.033", "revision": "1", "text": "“All right. Talk to me.”" }] }, { "entry_id": "Day1.result.C", "lines": [{ "beat_id": "beat.line.Day1.result.C.001", "line_id": "line.Day1.result.C.001", "revision": "1", "text": "The phone moves closer." }, { "beat_id": "beat.line.Day1.result.C.002", "line_id": "line.Day1.result.C.002", "revision": "1", "text": "Priscilla, recording: I\'m enjoying my afternoon. I\'m also looking forward to seeing you tomorrow." }, { "beat_id": "beat.line.Day1.result.C.003", "line_id": "line.Day1.result.C.003", "revision": "1", "text": "The recording plays back once; the small breath between the sentences stays in place, and then it goes through." }, { "beat_id": "beat.line.Day1.result.C.004", "line_id": "line.Day1.result.C.004", "revision": "1", "text": "Sylvia waits." }, { "beat_id": "beat.line.Day1.result.C.005", "line_id": "line.Day1.result.C.005", "revision": "1", "text": "“Finished?”" }, { "beat_id": "beat.line.Day1.result.C.006", "line_id": "line.Day1.result.C.006", "revision": "1", "text": "“Yes.”" }, { "beat_id": "beat.line.Day1.result.C.007", "line_id": "line.Day1.result.C.007", "revision": "1", "text": "The book returns to the middle of the table." }, { "beat_id": "beat.line.Day1.result.C.008", "line_id": "line.Day1.result.C.008", "revision": "1", "text": "The reply comes before the place is found." }, { "beat_id": "beat.line.Day1.result.C.009", "line_id": "line.Day1.result.C.009", "revision": "1", "text": "Lavinia, message: Tomorrow, then. Finish your date." }, { "beat_id": "beat.line.Day1.result.C.010", "line_id": "line.Day1.result.C.010", "revision": "1", "text": "The phone goes face down." }, { "beat_id": "beat.line.Day1.result.C.011", "line_id": "line.Day1.result.C.011", "revision": "1", "text": "“What did she say?” Sylvia asks." }, { "beat_id": "beat.line.Day1.result.C.012", "line_id": "line.Day1.result.C.012", "revision": "1", "text": "“To finish.”" }, { "beat_id": "beat.line.Day1.result.C.013", "line_id": "line.Day1.result.C.013", "revision": "1", "text": "“Very sensible.”" }, { "beat_id": "beat.line.Day1.result.C.014", "line_id": "line.Day1.result.C.014", "revision": "1", "text": "Sylvia gives back the man\'s part. The man has been asked to read the eulogy." }, { "beat_id": "beat.line.Day1.result.C.015", "line_id": "line.Day1.result.C.015", "revision": "1", "text": "“With the flowers still in her lap?”" }, { "beat_id": "beat.line.Day1.result.C.016", "line_id": "line.Day1.result.C.016", "revision": "1", "text": "“Apparently.” Sylvia turns the page. “Wait. I want to hear this.”" }, { "beat_id": "beat.line.Day1.result.C.017", "line_id": "line.Day1.result.C.017", "revision": "1", "text": "She reaches across to point out a sentence and knocks the spoon onto the saucer; my hand moves the cup so that she can leave her wrist on the page." }, { "beat_id": "beat.line.Day1.result.C.018", "line_id": "line.Day1.result.C.018", "revision": "1", "text": "I missed this line before." }, { "beat_id": "beat.line.Day1.result.C.019", "line_id": "line.Day1.result.C.019", "revision": "1", "text": "“‘Her absence,’ I read, ‘will leave a silence—’”" }, { "beat_id": "beat.line.Day1.result.C.020", "line_id": "line.Day1.result.C.020", "revision": "1", "text": "“‘Louder,’ said the aunt.”" }, { "beat_id": "beat.line.Day1.result.C.021", "line_id": "line.Day1.result.C.021", "revision": "1", "text": "We continue until Sylvia puts the book down of her own accord." }, { "beat_id": "beat.line.Day1.result.C.022", "line_id": "line.Day1.result.C.022", "revision": "1", "text": "“Enough?”" }, { "beat_id": "beat.line.Day1.result.C.023", "line_id": "line.Day1.result.C.023", "revision": "1", "text": "“One more.”" }, { "beat_id": "beat.line.Day1.result.C.024", "line_id": "line.Day1.result.C.024", "revision": "1", "text": "“One.”" }, { "beat_id": "beat.line.Day1.result.C.025", "line_id": "line.Day1.result.C.025", "revision": "1", "text": "She reads the woman\'s answer; my eyes stay on her until she has finished. At the stairs, Sylvia puts the paperback in her bag and says the man\'s voice is ruined for her now." }, { "beat_id": "beat.line.Day1.result.C.026", "line_id": "line.Day1.result.C.026", "revision": "1", "text": "“You can do him differently.”" }, { "beat_id": "beat.line.Day1.result.C.027", "line_id": "line.Day1.result.C.027", "revision": "1", "text": "“I don\'t want to now.”" }, { "beat_id": "beat.line.Day1.result.C.028", "line_id": "line.Day1.result.C.028", "revision": "1", "text": "She goes down before an answer can follow." }, { "beat_id": "beat.line.Day1.result.C.029", "line_id": "line.Day1.result.C.029", "revision": "1", "text": "Evening. Alone at the desk when the call goes through to Lavinia. There is no video." }, { "beat_id": "beat.line.Day1.result.C.030", "line_id": "line.Day1.result.C.030", "revision": "1", "text": "“You could have waited until tomorrow,” Lavinia says." }, { "beat_id": "beat.line.Day1.result.C.031", "line_id": "line.Day1.result.C.031", "revision": "1", "text": "“Would you rather I had?”" }, { "beat_id": "beat.line.Day1.result.C.032", "line_id": "line.Day1.result.C.032", "revision": "1", "text": "“No.” The chair tilts back from the desk." }] }, { "entry_id": "Day1.result.D", "lines": [{ "beat_id": "beat.line.Day1.result.D.001", "line_id": "line.Day1.result.D.001", "revision": "1", "text": "“She wants a voice message.”" }, { "beat_id": "beat.line.Day1.result.D.002", "line_id": "line.Day1.result.D.002", "revision": "1", "text": "“Then use the man\'s voice,” Sylvia says, her finger still inside the paperback. “Tell her your cousin required the carriage.”" }, { "beat_id": "beat.line.Day1.result.D.003", "line_id": "line.Day1.result.D.003", "revision": "1", "text": "“She\'d hang up before the verb.”" }, { "beat_id": "beat.line.Day1.result.D.004", "line_id": "line.Day1.result.D.004", "revision": "1", "text": "“Not if you sound sufficiently tragic.”" }, { "beat_id": "beat.line.Day1.result.D.005", "line_id": "line.Day1.result.D.005", "revision": "1", "text": "The thumb presses the microphone icon on the screen." }, { "beat_id": "beat.line.Day1.result.D.006", "line_id": "line.Day1.result.D.006", "revision": "1", "text": "“I\'m having a very good time,” I say into the phone—in the suitor\'s appalling, half-dying voice." }, { "beat_id": "beat.line.Day1.result.D.007", "line_id": "line.Day1.result.D.007", "revision": "1", "text": "Across the saucers, Sylvia loses her composure completely. She bends over the book, one hand against her mouth." }, { "beat_id": "beat.line.Day1.result.D.008", "line_id": "line.Day1.result.D.008", "revision": "1", "text": "“Stop,” she says through the laugh. “You sound as though you\'re in the coffin. Give it here—‘I\'m having a very good time, and I don\'t think I want to leave yet.’”" }, { "beat_id": "beat.line.Day1.result.D.009", "line_id": "line.Day1.result.D.009", "revision": "1", "text": "Her voice starts in prim demonstration and breaks into a warm, helpless laugh on the last word." }, { "beat_id": "beat.line.Day1.result.D.010", "line_id": "line.Day1.result.D.010", "revision": "1", "text": "The thumb lifts from the glass. The recording sits in the preview bar between our cups." }, { "beat_id": "beat.line.Day1.result.D.011", "line_id": "line.Day1.result.D.011", "revision": "1", "text": "Sylvia catches her breath and looks at the lit bar on the screen." }, { "beat_id": "beat.line.Day1.result.D.012", "line_id": "line.Day1.result.D.012", "revision": "1", "text": "“You were actually recording that?”" }, { "beat_id": "beat.line.Day1.result.D.013", "line_id": "line.Day1.result.D.013", "revision": "1", "text": "“It hasn\'t gone through.”" }, { "beat_id": "beat.line.Day1.result.D.014", "line_id": "line.Day1.result.D.014", "revision": "1", "text": "“Erase it,” she says, still half-smiling as she reaches for her tea. “We sound ridiculous.”" }, { "beat_id": "beat.line.Day1.result.D.015", "line_id": "line.Day1.result.D.015", "revision": "1", "text": "The preview runs once between the saucers: my absurd first line, the catch of her breath, and then her voice leaning close across the table—I\'m having a very good time, and I don\'t think I want to leave yet." }, { "beat_id": "beat.line.Day1.result.D.016", "line_id": "line.Day1.result.D.016", "revision": "1", "text": "She sounds as though she means it." }, { "beat_id": "beat.line.Day1.result.D.017", "line_id": "line.Day1.result.D.017", "revision": "1", "text": "The thumb taps Send." }, { "beat_id": "beat.line.Day1.result.D.018", "line_id": "line.Day1.result.D.018", "revision": "1", "text": "Sylvia\'s hand stops beside the book." }, { "beat_id": "beat.line.Day1.result.D.019", "line_id": "line.Day1.result.D.019", "revision": "1", "text": "“You sent it.”" }, { "beat_id": "beat.line.Day1.result.D.020", "line_id": "line.Day1.result.D.020", "revision": "1", "text": "“You sounded pleased.”" }, { "beat_id": "beat.line.Day1.result.D.021", "line_id": "line.Day1.result.D.021", "revision": "1", "text": "“That wasn\'t for her. I told you to erase it.”" }, { "beat_id": "beat.line.Day1.result.D.022", "line_id": "line.Day1.result.D.022", "revision": "1", "text": "“I heard you.”" }, { "beat_id": "beat.line.Day1.result.D.023", "line_id": "line.Day1.result.D.023", "revision": "1", "text": "Sylvia takes the paperback back to her side of the table. For a moment she holds it closed in both hands." }, { "beat_id": "beat.line.Day1.result.D.024", "line_id": "line.Day1.result.D.024", "revision": "1", "text": "“Then why?”" }, { "beat_id": "beat.line.Day1.result.D.025", "line_id": "line.Day1.result.D.025", "revision": "1", "text": "“It sounded better than mine would.”" }, { "beat_id": "beat.line.Day1.result.D.026", "line_id": "line.Day1.result.D.026", "revision": "1", "text": "She puts it in her bag." }, { "beat_id": "beat.line.Day1.result.D.027", "line_id": "line.Day1.result.D.027", "revision": "1", "text": "“Give me a moment,” I say." }, { "beat_id": "beat.line.Day1.result.D.028", "line_id": "line.Day1.result.D.028", "revision": "1", "text": "“You\'ve had one.”" }, { "beat_id": "beat.line.Day1.result.D.029", "line_id": "line.Day1.result.D.029", "revision": "1", "text": "She stands. Her chair catches against the table leg; she pulls it free without looking down, while my hand moves the cup out of her way." }, { "beat_id": "beat.line.Day1.result.D.030", "line_id": "line.Day1.result.D.030", "revision": "1", "text": "The phone lights on the table." }, { "beat_id": "beat.line.Day1.result.D.031", "line_id": "line.Day1.result.D.031", "revision": "1", "text": "Lavinia, message: Call me when you\'re alone." }, { "beat_id": "beat.line.Day1.result.D.032", "line_id": "line.Day1.result.D.032", "revision": "1", "text": "Sylvia looks once at the table, takes her own phone, and says, “Enjoy your call.”" }, { "beat_id": "beat.line.Day1.result.D.033", "line_id": "line.Day1.result.D.033", "revision": "1", "text": "Through the doorway, she has already passed out of sight." }, { "beat_id": "beat.line.Day1.result.D.034", "line_id": "line.Day1.result.D.034", "revision": "1", "text": "I can do that now." }, { "beat_id": "beat.line.Day1.result.D.035", "line_id": "line.Day1.result.D.035", "revision": "1", "text": "Still, the chair stays where it is long enough for the screen to go dark." }, { "beat_id": "beat.line.Day1.result.D.036", "line_id": "line.Day1.result.D.036", "revision": "1", "text": "Evening. Alone at the desk when the call goes through to Lavinia. There is no video." }, { "beat_id": "beat.line.Day1.result.D.037", "line_id": "line.Day1.result.D.037", "revision": "1", "text": "“You\'re alone?” Lavinia asks." }, { "beat_id": "beat.line.Day1.result.D.038", "line_id": "line.Day1.result.D.038", "revision": "1", "text": "“Yes.”" }, { "beat_id": "beat.line.Day1.result.D.039", "line_id": "line.Day1.result.D.039", "revision": "1", "text": "“Good.”" }] }, { "entry_id": "Day1.result.E", "lines": [{ "beat_id": "beat.line.Day1.result.E.001", "line_id": "line.Day1.result.E.001", "revision": "1", "text": "The phone moves closer." }, { "beat_id": "beat.line.Day1.result.E.002", "line_id": "line.Day1.result.E.002", "revision": "1", "text": "Priscilla, recording: I\'m enjoying my afternoon. I\'m also looking forward to seeing you tomorrow." }, { "beat_id": "beat.line.Day1.result.E.003", "line_id": "line.Day1.result.E.003", "revision": "1", "text": "The recording plays back once; the small breath between the sentences stays in place, and then it goes through." }, { "beat_id": "beat.line.Day1.result.E.004", "line_id": "line.Day1.result.E.004", "revision": "1", "text": "Sylvia waits." }, { "beat_id": "beat.line.Day1.result.E.005", "line_id": "line.Day1.result.E.005", "revision": "1", "text": "“Finished?”" }, { "beat_id": "beat.line.Day1.result.E.006", "line_id": "line.Day1.result.E.006", "revision": "1", "text": "“Yes.”" }, { "beat_id": "beat.line.Day1.result.E.007", "line_id": "line.Day1.result.E.007", "revision": "1", "text": "The book returns to the middle of the table." }, { "beat_id": "beat.line.Day1.result.E.008", "line_id": "line.Day1.result.E.008", "revision": "1", "text": "The reply comes before the place is found." }, { "beat_id": "beat.line.Day1.result.E.009", "line_id": "line.Day1.result.E.009", "revision": "1", "text": "Lavinia, message: Tomorrow, then. Finish your date." }, { "beat_id": "beat.line.Day1.result.E.010", "line_id": "line.Day1.result.E.010", "revision": "1", "text": "The phone goes face down." }, { "beat_id": "beat.line.Day1.result.E.011", "line_id": "line.Day1.result.E.011", "revision": "1", "text": "Someone is listening. I know it without knowing where to look." }, { "beat_id": "beat.line.Day1.result.E.012", "line_id": "line.Day1.result.E.012", "revision": "1", "text": "You can wait." }, { "beat_id": "beat.line.Day1.result.E.013", "line_id": "line.Day1.result.E.013", "revision": "1", "text": "“What did she say?” Sylvia asks." }, { "beat_id": "beat.line.Day1.result.E.014", "line_id": "line.Day1.result.E.014", "revision": "1", "text": "“To finish.”" }, { "beat_id": "beat.line.Day1.result.E.015", "line_id": "line.Day1.result.E.015", "revision": "1", "text": "“Very sensible.”" }, { "beat_id": "beat.line.Day1.result.E.016", "line_id": "line.Day1.result.E.016", "revision": "1", "text": "Sylvia gives back the man\'s part. The man has been asked to read the eulogy." }, { "beat_id": "beat.line.Day1.result.E.017", "line_id": "line.Day1.result.E.017", "revision": "1", "text": "“With the flowers still in her lap?”" }, { "beat_id": "beat.line.Day1.result.E.018", "line_id": "line.Day1.result.E.018", "revision": "1", "text": "“Apparently.” Sylvia turns the page. “Wait. I want to hear this.”" }, { "beat_id": "beat.line.Day1.result.E.019", "line_id": "line.Day1.result.E.019", "revision": "1", "text": "She reaches across to point out a sentence and knocks the spoon onto the saucer; my hand moves the cup so that she can leave her wrist on the page." }, { "beat_id": "beat.line.Day1.result.E.020", "line_id": "line.Day1.result.E.020", "revision": "1", "text": "I missed this line before." }, { "beat_id": "beat.line.Day1.result.E.021", "line_id": "line.Day1.result.E.021", "revision": "1", "text": "“‘Her absence,’ I read, ‘will leave a silence—’”" }, { "beat_id": "beat.line.Day1.result.E.022", "line_id": "line.Day1.result.E.022", "revision": "1", "text": "“‘Louder,’ said the aunt.”" }, { "beat_id": "beat.line.Day1.result.E.023", "line_id": "line.Day1.result.E.023", "revision": "1", "text": "We continue until Sylvia puts the book down of her own accord." }, { "beat_id": "beat.line.Day1.result.E.024", "line_id": "line.Day1.result.E.024", "revision": "1", "text": "“Enough?”" }, { "beat_id": "beat.line.Day1.result.E.025", "line_id": "line.Day1.result.E.025", "revision": "1", "text": "“One more.”" }, { "beat_id": "beat.line.Day1.result.E.026", "line_id": "line.Day1.result.E.026", "revision": "1", "text": "“One.”" }, { "beat_id": "beat.line.Day1.result.E.027", "line_id": "line.Day1.result.E.027", "revision": "1", "text": "She reads the woman\'s answer; my eyes stay on her until she has finished. At the stairs, Sylvia puts the paperback in her bag and says the man\'s voice is ruined for her now." }, { "beat_id": "beat.line.Day1.result.E.028", "line_id": "line.Day1.result.E.028", "revision": "1", "text": "“You can do him differently.”" }, { "beat_id": "beat.line.Day1.result.E.029", "line_id": "line.Day1.result.E.029", "revision": "1", "text": "“I don\'t want to now.”" }, { "beat_id": "beat.line.Day1.result.E.030", "line_id": "line.Day1.result.E.030", "revision": "1", "text": "She goes down before an answer can follow." }, { "beat_id": "beat.line.Day1.result.E.031", "line_id": "line.Day1.result.E.031", "revision": "1", "text": "Evening. Alone at the desk when the call goes through to Lavinia. There is no video." }, { "beat_id": "beat.line.Day1.result.E.032", "line_id": "line.Day1.result.E.032", "revision": "1", "text": "“You could have waited until tomorrow,” Lavinia says." }, { "beat_id": "beat.line.Day1.result.E.033", "line_id": "line.Day1.result.E.033", "revision": "1", "text": "“Would you rather I had?”" }, { "beat_id": "beat.line.Day1.result.E.034", "line_id": "line.Day1.result.E.034", "revision": "1", "text": "“No.” The chair tilts back from the desk." }] }, { "entry_id": "Day2", "lines": [{ "beat_id": "beat.line.Day2.one", "line_id": "line.Day2.one", "revision": "1", "text": "Lavinia closes the door on the music from the bar. Her coat goes over the back of the chair." }, { "beat_id": "beat.line.Day2.002", "line_id": "line.Day2.002", "revision": "1", "text": "She sits at the corner of the table, close enough that one menu will do." }, { "beat_id": "beat.line.Day2.003", "line_id": "line.Day2.003", "revision": "1", "text": "Her fingers brush the cuff of my right sleeve before she opens the card." }, { "beat_id": "beat.line.Day2.004", "line_id": "line.Day2.004", "revision": "1", "text": "“Still damp.”" }, { "beat_id": "beat.line.Day2.005", "line_id": "line.Day2.005", "revision": "1", "text": "“A little.”" }, { "beat_id": "beat.line.Day2.006", "line_id": "line.Day2.006", "revision": "1", "text": "“You should have taken your coat off.”" }, { "beat_id": "beat.line.Day2.007", "line_id": "line.Day2.007", "revision": "1", "text": "“I\'m fine.”" }, { "beat_id": "beat.line.Day2.008", "line_id": "line.Day2.008", "revision": "1", "text": "She looks down at the menu." }, { "beat_id": "beat.line.Day2.009", "line_id": "line.Day2.009", "revision": "1", "text": "“I thought you were only staying for a drink.”" }, { "beat_id": "beat.line.Day2.010", "line_id": "line.Day2.010", "revision": "1", "text": "“Have you eaten?”" }, { "beat_id": "beat.line.Day2.011", "line_id": "line.Day2.011", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day2.012", "line_id": "line.Day2.012", "revision": "1", "text": "“Then choose something.”" }, { "beat_id": "beat.line.Day2.013", "line_id": "line.Day2.013", "revision": "1", "text": "“Do you want dinner?”" }, { "beat_id": "beat.line.Day2.014", "line_id": "line.Day2.014", "revision": "1", "text": "“I was hoping to.”" }, { "beat_id": "beat.line.Day2.015", "line_id": "line.Day2.015", "revision": "1", "text": "“The mushroom tart.”" }, { "beat_id": "beat.line.Day2.016", "line_id": "line.Day2.016", "revision": "1", "text": "Lavinia turns the page." }, { "beat_id": "beat.line.Day2.017", "line_id": "line.Day2.017", "revision": "1", "text": "“Or the chicken.”" }, { "beat_id": "beat.line.Day2.018", "line_id": "line.Day2.018", "revision": "1", "text": "The page comes back. Her finger finds the tart again." }, { "beat_id": "beat.line.Day2.019", "line_id": "line.Day2.019", "revision": "1", "text": "“I\'ll have the chicken.”" }, { "beat_id": "beat.line.Day2.020", "line_id": "line.Day2.020", "revision": "1", "text": "“You don\'t have to.”" }, { "beat_id": "beat.line.Day2.021", "line_id": "line.Day2.021", "revision": "1", "text": "“I want to try it.”" }, { "beat_id": "beat.line.Day2.022", "line_id": "line.Day2.022", "revision": "1", "text": "“So do I.”" }, { "beat_id": "beat.line.Day2.023", "line_id": "line.Day2.023", "revision": "1", "text": "“I noticed.”" }, { "beat_id": "beat.line.Day2.024", "line_id": "line.Day2.024", "revision": "1", "text": "After we order, she rests her elbows on the table." }, { "beat_id": "beat.line.Day2.025", "line_id": "line.Day2.025", "revision": "1", "text": "“You can relax.”" }, { "beat_id": "beat.line.Day2.026", "line_id": "line.Day2.026", "revision": "1", "text": "The shoulders settle against the chair. A little farther down; the edge of the table rises toward the chin." }, { "beat_id": "beat.line.Day2.027", "line_id": "line.Day2.027", "revision": "1", "text": "“Not that much.”" }, { "beat_id": "beat.line.Day2.028", "line_id": "line.Day2.028", "revision": "1", "text": "“You\'re difficult to please.”" }, { "beat_id": "beat.line.Day2.029", "line_id": "line.Day2.029", "revision": "1", "text": "“You haven\'t tried very hard.”" }, { "beat_id": "beat.line.Day2.030", "line_id": "line.Day2.030", "revision": "1", "text": "Another inch. The chair creaks." }, { "beat_id": "beat.line.Day2.031", "line_id": "line.Day2.031", "revision": "1", "text": "Lavinia laughs and catches my wrist." }, { "beat_id": "beat.line.Day2.032", "line_id": "line.Day2.032", "revision": "1", "text": "“Come back.”" }, { "beat_id": "beat.line.Day2.033", "line_id": "line.Day2.033", "revision": "1", "text": "I sit up. Her fingers remain around the wrist until the food arrives." }, { "beat_id": "beat.line.Day2.034", "line_id": "line.Day2.034", "revision": "1", "text": "For a while, we eat. She pushes her plate toward me." }, { "beat_id": "beat.line.Day2.035", "line_id": "line.Day2.035", "revision": "1", "text": "“Try that.”" }, { "beat_id": "beat.line.Day2.036", "line_id": "line.Day2.036", "revision": "1", "text": "I could ask her to feed me." }] }, { "entry_id": "Day2.answer", "lines": [{ "beat_id": "beat.line.Day2.answer.001", "line_id": "line.Day2.answer.001", "revision": "1", "text": "Her elbow stays on the corner of the wood." }, { "beat_id": "beat.line.Day2.answer.002", "line_id": "line.Day2.answer.002", "revision": "1", "text": "“What?” I ask." }, { "beat_id": "beat.line.Day2.answer.003", "line_id": "line.Day2.answer.003", "revision": "1", "text": "“I told you yesterday not to look too pleased.”" }, { "beat_id": "beat.line.Day2.answer.004", "line_id": "line.Day2.answer.004", "revision": "1", "text": "“This is my ordinary face.”" }, { "beat_id": "beat.line.Day2.answer.005", "line_id": "line.Day2.answer.005", "revision": "1", "text": "“It isn\'t.”" }, { "beat_id": "beat.line.Day2.answer.006", "line_id": "line.Day2.answer.006", "revision": "1", "text": "Her thumb touches the corner of my mouth, takes a flake of pastry from the skin, and returns to her glass." }, { "beat_id": "beat.line.Day2.answer.007", "line_id": "line.Day2.answer.007", "revision": "1", "text": "“I could take you out tomorrow.”" }, { "beat_id": "beat.line.Day2.answer.008", "line_id": "line.Day2.answer.008", "revision": "1", "text": "“You could let me finish this.”" }, { "beat_id": "beat.line.Day2.answer.009", "line_id": "line.Day2.answer.009", "revision": "1", "text": "“The day after, then.”" }, { "beat_id": "beat.line.Day2.answer.010", "line_id": "line.Day2.answer.010", "revision": "1", "text": "Lavinia puts her fork down." }, { "beat_id": "beat.line.Day2.answer.011", "line_id": "line.Day2.answer.011", "revision": "1", "text": "“Who had all this while I was away?”" }, { "beat_id": "beat.line.Day2.answer.012", "line_id": "line.Day2.answer.012", "revision": "1", "text": "“You aren\'t away now.”" }, { "beat_id": "beat.line.Day2.answer.013", "line_id": "line.Day2.answer.013", "revision": "1", "text": "Her hand opens between the plates. I put mine into it." }, { "beat_id": "beat.line.Day2.answer.014", "line_id": "line.Day2.answer.014", "revision": "1", "text": "The thumb passes over one knuckle, then rests." }, { "beat_id": "beat.line.Day2.answer.015", "line_id": "line.Day2.answer.015", "revision": "1", "text": "“Did you want me to stay?”" }, { "beat_id": "beat.line.Day2.answer.016", "line_id": "line.Day2.answer.016", "revision": "1", "text": "“You are staying.”" }, { "beat_id": "beat.line.Day2.answer.017", "line_id": "line.Day2.answer.017", "revision": "1", "text": "“Before I went.”" }, { "beat_id": "beat.line.Day2.answer.018", "line_id": "line.Day2.answer.018", "revision": "1", "text": "The edge of the plate against my wrist. Her hand still open beneath mine." }, { "beat_id": "beat.line.Day2.answer.019", "line_id": "line.Day2.answer.019", "revision": "1", "text": "I could tell her I wanted her to stay." }] }, { "entry_id": "Day2.food.default", "lines": [{ "beat_id": "beat.line.Day2.food.default.001", "line_id": "line.Day2.food.default.001", "revision": "1", "text": "“I should have ordered yours.”" }, { "beat_id": "beat.line.Day2.food.default.002", "line_id": "line.Day2.food.default.002", "revision": "1", "text": "“You\'re eating it.”" }, { "beat_id": "beat.line.Day2.food.default.003", "line_id": "line.Day2.food.default.003", "revision": "1", "text": "I take another piece before she draws the plate back." }, { "beat_id": "beat.line.Day2.food.default.004", "line_id": "line.Day2.food.default.004", "revision": "1", "text": "“Some of it.”" }, { "beat_id": "beat.line.Day2.food.default.005", "line_id": "line.Day2.food.default.005", "revision": "1", "text": "She leaves it between us." }] }, { "entry_id": "Day2.food.yes", "lines": [{ "beat_id": "beat.line.Day2.food.yes.001", "line_id": "line.Day2.food.yes.001", "revision": "1", "text": "“Give me a bite.”" }, { "beat_id": "beat.line.Day2.food.yes.002", "line_id": "line.Day2.food.yes.002", "revision": "1", "text": "“You have a fork.”" }, { "beat_id": "beat.line.Day2.food.yes.003", "line_id": "line.Day2.food.yes.003", "revision": "1", "text": "“I know.”" }, { "beat_id": "beat.line.Day2.food.yes.004", "line_id": "line.Day2.food.yes.004", "revision": "1", "text": "Lavinia cuts a smaller piece from the tart." }, { "beat_id": "beat.line.Day2.food.yes.005", "line_id": "line.Day2.food.yes.005", "revision": "1", "text": "“Come here, then.”" }, { "beat_id": "beat.line.Day2.food.yes.006", "line_id": "line.Day2.food.yes.006", "revision": "1", "text": "I lean forward. She holds the fork still." }, { "beat_id": "beat.line.Day2.food.yes.007", "line_id": "line.Day2.food.yes.007", "revision": "1", "text": "“Careful. It\'s hot.”" }, { "beat_id": "beat.line.Day2.food.yes.008", "line_id": "line.Day2.food.yes.008", "revision": "1", "text": "When I sit back, she pushes the plate into the space between us." }, { "beat_id": "beat.line.Day2.food.yes.009", "line_id": "line.Day2.food.yes.009", "revision": "1", "text": "“Now eat your own.”" }] }, { "entry_id": "Day2.result.A", "lines": [{ "beat_id": "beat.line.Day2.result.A.001", "line_id": "line.Day2.result.A.001", "revision": "1", "text": "“Of course I did.”" }, { "beat_id": "beat.line.Day2.result.A.002", "line_id": "line.Day2.result.A.002", "revision": "1", "text": "“Then why do I have to ask?”" }, { "beat_id": "beat.line.Day2.result.A.003", "line_id": "line.Day2.result.A.003", "revision": "1", "text": "“I wanted you here, Lavinia.”" }, { "beat_id": "beat.line.Day2.result.A.004", "line_id": "line.Day2.result.A.004", "revision": "1", "text": "Her thumb passes over the knuckle once more." }, { "beat_id": "beat.line.Day2.result.A.005", "line_id": "line.Day2.result.A.005", "revision": "1", "text": "“I asked you to check the English.”" }, { "beat_id": "beat.line.Day2.result.A.006", "line_id": "line.Day2.result.A.006", "revision": "1", "text": "“You\'d left a line out.”" }, { "beat_id": "beat.line.Day2.result.A.007", "line_id": "line.Day2.result.A.007", "revision": "1", "text": "The hand slips out from under mine." }, { "beat_id": "beat.line.Day2.result.A.008", "line_id": "line.Day2.result.A.008", "revision": "1", "text": "“I\'m not giving you anything else to send.”" }, { "beat_id": "beat.line.Day2.result.A.009", "line_id": "line.Day2.result.A.009", "revision": "1", "text": "“I could still look at it.”" }, { "beat_id": "beat.line.Day2.result.A.010", "line_id": "line.Day2.result.A.010", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day2.result.A.011", "line_id": "line.Day2.result.A.011", "revision": "1", "text": "“The wording wasn\'t—”" }, { "beat_id": "beat.line.Day2.result.A.012", "line_id": "line.Day2.result.A.012", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day2.result.A.013", "line_id": "line.Day2.result.A.013", "revision": "1", "text": "I pick up my glass. She waits until I put it down." }, { "beat_id": "beat.line.Day2.result.A.014", "line_id": "line.Day2.result.A.014", "revision": "1", "text": "“All right.”" }, { "beat_id": "beat.line.Day2.result.A.015", "line_id": "line.Day2.result.A.015", "revision": "1", "text": "Lavinia returns to her food. For a while there is only the cutlery and the music through the door." }, { "beat_id": "beat.line.Day2.result.A.016", "line_id": "line.Day2.result.A.016", "revision": "1", "text": "I push my plate toward her." }, { "beat_id": "beat.line.Day2.result.A.017", "line_id": "line.Day2.result.A.017", "revision": "1", "text": "“Was that the last piece?”" }, { "beat_id": "beat.line.Day2.result.A.018", "line_id": "line.Day2.result.A.018", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day2.result.A.019", "line_id": "line.Day2.result.A.019", "revision": "1", "text": "She takes it." }, { "beat_id": "beat.line.Day2.result.A.020", "line_id": "line.Day2.result.A.020", "revision": "1", "text": "When she has finished, she puts her fork down beside the knife." }, { "beat_id": "beat.line.Day2.result.A.021", "line_id": "line.Day2.result.A.021", "revision": "1", "text": "“I should go.”" }, { "beat_id": "beat.line.Day2.result.A.022", "line_id": "line.Day2.result.A.022", "revision": "1", "text": "“I could walk with you.”" }, { "beat_id": "beat.line.Day2.result.A.023", "line_id": "line.Day2.result.A.023", "revision": "1", "text": "“I want to go on my own.”" }, { "beat_id": "beat.line.Day2.result.A.024", "line_id": "line.Day2.result.A.024", "revision": "1", "text": "I draw my chair in so she can get past." }, { "beat_id": "beat.line.Day2.result.A.025", "line_id": "line.Day2.result.A.025", "revision": "1", "text": "At the door she stops to put on her coat." }, { "beat_id": "beat.line.Day2.result.A.026", "line_id": "line.Day2.result.A.026", "revision": "1", "text": "“Tell me when you get home.”" }, { "beat_id": "beat.line.Day2.result.A.027", "line_id": "line.Day2.result.A.027", "revision": "1", "text": "“No. You\'ll ask whether I\'m going to bed.”" }, { "beat_id": "beat.line.Day2.result.A.028", "line_id": "line.Day2.result.A.028", "revision": "1", "text": "“Will you be?”" }, { "beat_id": "beat.line.Day2.result.A.029", "line_id": "line.Day2.result.A.029", "revision": "1", "text": "“There.”" }, { "beat_id": "beat.line.Day2.result.A.030", "line_id": "line.Day2.result.A.030", "revision": "1", "text": "She opens the door before I can answer." }, { "beat_id": "beat.line.Day2.result.A.031", "line_id": "line.Day2.result.A.031", "revision": "1", "text": "At my desk, I open the conversation. Good night. I add her name and send it. The lamp is still on when I put the phone down." }] }, { "entry_id": "Day2.result.B", "lines": [{ "beat_id": "beat.line.Day2.result.B.001", "line_id": "line.Day2.result.B.001", "revision": "1", "text": "“I don\'t want to start that tonight.”" }, { "beat_id": "beat.line.Day2.result.B.002", "line_id": "line.Day2.result.B.002", "revision": "1", "text": "“I\'m asking about you.”" }, { "beat_id": "beat.line.Day2.result.B.003", "line_id": "line.Day2.result.B.003", "revision": "1", "text": "“I know.”" }, { "beat_id": "beat.line.Day2.result.B.004", "line_id": "line.Day2.result.B.004", "revision": "1", "text": "Her hand stays open beneath mine." }, { "beat_id": "beat.line.Day2.result.B.005", "line_id": "line.Day2.result.B.005", "revision": "1", "text": "“Then?”" }, { "beat_id": "beat.line.Day2.result.B.006", "line_id": "line.Day2.result.B.006", "revision": "1", "text": "I turn my hand over and set it beside the plate." }, { "beat_id": "beat.line.Day2.result.B.007", "line_id": "line.Day2.result.B.007", "revision": "1", "text": "Lavinia folds her fingers into her palm." }, { "beat_id": "beat.line.Day2.result.B.008", "line_id": "line.Day2.result.B.008", "revision": "1", "text": "The edge of the menu has gone soft where it touches the wet glass." }, { "beat_id": "beat.line.Day2.result.B.009", "line_id": "line.Day2.result.B.009", "revision": "1", "text": "“Stay until we\'ve finished eating.”" }, { "beat_id": "beat.line.Day2.result.B.010", "line_id": "line.Day2.result.B.010", "revision": "1", "text": "Lavinia draws her plate toward her." }, { "beat_id": "beat.line.Day2.result.B.011", "line_id": "line.Day2.result.B.011", "revision": "1", "text": "She eats the last piece without offering it. I take a drink." }, { "beat_id": "beat.line.Day2.result.B.012", "line_id": "line.Day2.result.B.012", "revision": "1", "text": "When I put the glass down, she has her coat over her arm." }, { "beat_id": "beat.line.Day2.result.B.013", "line_id": "line.Day2.result.B.013", "revision": "1", "text": "“Lavinia.”" }, { "beat_id": "beat.line.Day2.result.B.014", "line_id": "line.Day2.result.B.014", "revision": "1", "text": "She waits." }, { "beat_id": "beat.line.Day2.result.B.015", "line_id": "line.Day2.result.B.015", "revision": "1", "text": "The folded menu is still between the glasses." }, { "beat_id": "beat.line.Day2.result.B.016", "line_id": "line.Day2.result.B.016", "revision": "1", "text": "“Nothing.”" }, { "beat_id": "beat.line.Day2.result.B.017", "line_id": "line.Day2.result.B.017", "revision": "1", "text": "She leaves." }, { "beat_id": "beat.line.Day2.result.B.018", "line_id": "line.Day2.result.B.018", "revision": "1", "text": "The conversation is open at my desk. About what you asked. I leave the words there while I take off my watch. When I pick up the phone again, I remove them and close the conversation." }] }, { "entry_id": "Day2.result.C", "lines": [{ "beat_id": "beat.line.Day2.result.C.001", "line_id": "line.Day2.result.C.001", "revision": "1", "text": "“Yes. I wanted you here.”" }, { "beat_id": "beat.line.Day2.result.C.002", "line_id": "line.Day2.result.C.002", "revision": "1", "text": "“And you decided I should be.”" }, { "beat_id": "beat.line.Day2.result.C.003", "line_id": "line.Day2.result.C.003", "revision": "1", "text": "“I wanted it to be possible.”" }, { "beat_id": "beat.line.Day2.result.C.004", "line_id": "line.Day2.result.C.004", "revision": "1", "text": "“You knew what I wanted.”" }, { "beat_id": "beat.line.Day2.result.C.005", "line_id": "line.Day2.result.C.005", "revision": "1", "text": "“Yes.”" }, { "beat_id": "beat.line.Day2.result.C.006", "line_id": "line.Day2.result.C.006", "revision": "1", "text": "Lavinia begins to draw her hand away. I open mine." }, { "beat_id": "beat.line.Day2.result.C.007", "line_id": "line.Day2.result.C.007", "revision": "1", "text": "She rests her hand beside the plate." }, { "beat_id": "beat.line.Day2.result.C.008", "line_id": "line.Day2.result.C.008", "revision": "1", "text": "“I\'m not giving you anything else to send.”" }, { "beat_id": "beat.line.Day2.result.C.009", "line_id": "line.Day2.result.C.009", "revision": "1", "text": "“All right.”" }, { "beat_id": "beat.line.Day2.result.C.010", "line_id": "line.Day2.result.C.010", "revision": "1", "text": "“You\'d still want to change it.”" }, { "beat_id": "beat.line.Day2.result.C.011", "line_id": "line.Day2.result.C.011", "revision": "1", "text": "“Probably.”" }, { "beat_id": "beat.line.Day2.result.C.012", "line_id": "line.Day2.result.C.012", "revision": "1", "text": "“Priscilla.”" }, { "beat_id": "beat.line.Day2.result.C.013", "line_id": "line.Day2.result.C.013", "revision": "1", "text": "“I\'m not asking for it.”" }, { "beat_id": "beat.line.Day2.result.C.014", "line_id": "line.Day2.result.C.014", "revision": "1", "text": "She turns her glass. I wait until she has taken a drink." }, { "beat_id": "beat.line.Day2.result.C.015", "line_id": "line.Day2.result.C.015", "revision": "1", "text": "Lavinia reaches behind her for the coat." }, { "beat_id": "beat.line.Day2.result.C.016", "line_id": "line.Day2.result.C.016", "revision": "1", "text": "“Stay a little longer.”" }, { "beat_id": "beat.line.Day2.result.C.017", "line_id": "line.Day2.result.C.017", "revision": "1", "text": "“Doing what?”" }, { "beat_id": "beat.line.Day2.result.C.018", "line_id": "line.Day2.result.C.018", "revision": "1", "text": "“Having dinner with me.”" }, { "beat_id": "beat.line.Day2.result.C.019", "line_id": "line.Day2.result.C.019", "revision": "1", "text": "“We\'ve been doing that.”" }, { "beat_id": "beat.line.Day2.result.C.020", "line_id": "line.Day2.result.C.020", "revision": "1", "text": "“I like it.”" }, { "beat_id": "beat.line.Day2.result.C.021", "line_id": "line.Day2.result.C.021", "revision": "1", "text": "For a moment she holds the glass against her lower lip." }, { "beat_id": "beat.line.Day2.result.C.022", "line_id": "line.Day2.result.C.022", "revision": "1", "text": "Then she puts it down." }, { "beat_id": "beat.line.Day2.result.C.023", "line_id": "line.Day2.result.C.023", "revision": "1", "text": "“Until we finish.”" }, { "beat_id": "beat.line.Day2.result.C.024", "line_id": "line.Day2.result.C.024", "revision": "1", "text": "Her hand leaves the coat." }, { "beat_id": "beat.line.Day2.result.C.025", "line_id": "line.Day2.result.C.025", "revision": "1", "text": "I cut another piece of chicken." }, { "beat_id": "beat.line.Day2.result.C.026", "line_id": "line.Day2.result.C.026", "revision": "1", "text": "Lavinia watches the knife come down again." }, { "beat_id": "beat.line.Day2.result.C.027", "line_id": "line.Day2.result.C.027", "revision": "1", "text": "“That\'s small enough.”" }, { "beat_id": "beat.line.Day2.result.C.028", "line_id": "line.Day2.result.C.028", "revision": "1", "text": "“Is it?”" }, { "beat_id": "beat.line.Day2.result.C.029", "line_id": "line.Day2.result.C.029", "revision": "1", "text": "“Eat it.”" }, { "beat_id": "beat.line.Day2.result.C.030", "line_id": "line.Day2.result.C.030", "revision": "1", "text": "I do. She moves her chair closer to reach my plate and takes the other piece." }, { "beat_id": "beat.line.Day2.result.C.031", "line_id": "line.Day2.result.C.031", "revision": "1", "text": "For a while, neither of us says anything." }, { "beat_id": "beat.line.Day2.result.C.032", "line_id": "line.Day2.result.C.032", "revision": "1", "text": "When the plates are empty, she reaches for her coat. I stay in my chair." }, { "beat_id": "beat.line.Day2.result.C.033", "line_id": "line.Day2.result.C.033", "revision": "1", "text": "“Tell me when you get home.”" }, { "beat_id": "beat.line.Day2.result.C.034", "line_id": "line.Day2.result.C.034", "revision": "1", "text": "“I will.”" }, { "beat_id": "beat.line.Day2.result.C.035", "line_id": "line.Day2.result.C.035", "revision": "1", "text": "She rests her hand on my shoulder while she puts her coat on. I turn toward it." }, { "beat_id": "beat.line.Day2.result.C.036", "line_id": "line.Day2.result.C.036", "revision": "1", "text": "The pressure lifts." }, { "beat_id": "beat.line.Day2.result.C.037", "line_id": "line.Day2.result.C.037", "revision": "1", "text": "“Good night, Priscilla.”" }, { "beat_id": "beat.line.Day2.result.C.038", "line_id": "line.Day2.result.C.038", "revision": "1", "text": "“Good night.”" }, { "beat_id": "beat.line.Day2.result.C.039", "line_id": "line.Day2.result.C.039", "revision": "1", "text": "At my desk, the phone lights." }, { "beat_id": "beat.line.Day2.result.C.040", "line_id": "line.Day2.result.C.040", "revision": "1", "text": "Lavinia, message: Home." }, { "beat_id": "beat.line.Day2.result.C.041", "line_id": "line.Day2.result.C.041", "revision": "1", "text": "Priscilla, message: Good night, Lavinia." }, { "beat_id": "beat.line.Day2.result.C.042", "line_id": "line.Day2.result.C.042", "revision": "1", "text": "I leave the conversation open while I turn off the lamp." }] }, { "entry_id": "Day2.result.D", "lines": [{ "beat_id": "beat.line.Day2.result.D.001", "line_id": "line.Day2.result.D.001", "revision": "1", "text": "“Did you want me to stay?”" }, { "beat_id": "beat.line.Day2.result.D.002", "line_id": "line.Day2.result.D.002", "revision": "1", "text": "“Yes.”" }, { "beat_id": "beat.line.Day2.result.D.003", "line_id": "line.Day2.result.D.003", "revision": "1", "text": "Her thumb does not move." }, { "beat_id": "beat.line.Day2.result.D.004", "line_id": "line.Day2.result.D.004", "revision": "1", "text": "“I wanted you here.”" }, { "beat_id": "beat.line.Day2.result.D.005", "line_id": "line.Day2.result.D.005", "revision": "1", "text": "“I asked you to check the English.”" }, { "beat_id": "beat.line.Day2.result.D.006", "line_id": "line.Day2.result.D.006", "revision": "1", "text": "“You\'d left a line out.”" }, { "beat_id": "beat.line.Day2.result.D.007", "line_id": "line.Day2.result.D.007", "revision": "1", "text": "“On purpose.”" }, { "beat_id": "beat.line.Day2.result.D.008", "line_id": "line.Day2.result.D.008", "revision": "1", "text": "“I know.”" }, { "beat_id": "beat.line.Day2.result.D.009", "line_id": "line.Day2.result.D.009", "revision": "1", "text": "Lavinia takes her hand away." }, { "beat_id": "beat.line.Day2.result.D.010", "line_id": "line.Day2.result.D.010", "revision": "1", "text": "“Would you do it again?”" }, { "beat_id": "beat.line.Day2.result.D.011", "line_id": "line.Day2.result.D.011", "revision": "1", "text": "“I\'d show you first.”" }, { "beat_id": "beat.line.Day2.result.D.012", "line_id": "line.Day2.result.D.012", "revision": "1", "text": "“And if I told you not to send it?”" }, { "beat_id": "beat.line.Day2.result.D.013", "line_id": "line.Day2.result.D.013", "revision": "1", "text": "“Then I wouldn\'t send it.”" }, { "beat_id": "beat.line.Day2.result.D.014", "line_id": "line.Day2.result.D.014", "revision": "1", "text": "“You mean that?”" }, { "beat_id": "beat.line.Day2.result.D.015", "line_id": "line.Day2.result.D.015", "revision": "1", "text": "“If you don\'t want me to.”" }, { "beat_id": "beat.line.Day2.result.D.016", "line_id": "line.Day2.result.D.016", "revision": "1", "text": "She turns the glass by its stem. A wet crescent remains on the table." }, { "beat_id": "beat.line.Day2.result.D.017", "line_id": "line.Day2.result.D.017", "revision": "1", "text": "“You\'d find something else.”" }, { "beat_id": "beat.line.Day2.result.D.018", "line_id": "line.Day2.result.D.018", "revision": "1", "text": "“You wouldn\'t have stopped on your own.”" }, { "beat_id": "beat.line.Day2.result.D.019", "line_id": "line.Day2.result.D.019", "revision": "1", "text": "“To keep me here.”" }, { "beat_id": "beat.line.Day2.result.D.020", "line_id": "line.Day2.result.D.020", "revision": "1", "text": "“That too.”" }, { "beat_id": "beat.line.Day2.result.D.021", "line_id": "line.Day2.result.D.021", "revision": "1", "text": "The glass stops." }, { "beat_id": "beat.line.Day2.result.D.022", "line_id": "line.Day2.result.D.022", "revision": "1", "text": "“Is that supposed to make me feel better?”" }, { "beat_id": "beat.line.Day2.result.D.023", "line_id": "line.Day2.result.D.023", "revision": "1", "text": "“You asked me.”" }, { "beat_id": "beat.line.Day2.result.D.024", "line_id": "line.Day2.result.D.024", "revision": "1", "text": "Lavinia gets up. She takes the coat from her chair and folds it over her arm." }, { "beat_id": "beat.line.Day2.result.D.025", "line_id": "line.Day2.result.D.025", "revision": "1", "text": "“I\'ll do it differently.”" }, { "beat_id": "beat.line.Day2.result.D.026", "line_id": "line.Day2.result.D.026", "revision": "1", "text": "“You\'re still talking about doing it.”" }, { "beat_id": "beat.line.Day2.result.D.027", "line_id": "line.Day2.result.D.027", "revision": "1", "text": "“I\'d rather not have to.”" }, { "beat_id": "beat.line.Day2.result.D.028", "line_id": "line.Day2.result.D.028", "revision": "1", "text": "Her palm strikes my cheek." }, { "beat_id": "beat.line.Day2.result.D.029", "line_id": "line.Day2.result.D.029", "revision": "1", "text": "The hand is down again, open beside the coat." }, { "beat_id": "beat.line.Day2.result.D.030", "line_id": "line.Day2.result.D.030", "revision": "1", "text": "The cheek burns beneath my palm. Lavinia\'s eyes stay on my mouth." }, { "beat_id": "beat.line.Day2.result.D.031", "line_id": "line.Day2.result.D.031", "revision": "1", "text": "“Why are you smiling?”" }, { "beat_id": "beat.line.Day2.result.D.032", "line_id": "line.Day2.result.D.032", "revision": "1", "text": "Not indifferent, then." }, { "beat_id": "beat.line.Day2.result.D.033", "line_id": "line.Day2.result.D.033", "revision": "1", "text": "“I didn\'t know you were so angry.”" }, { "beat_id": "beat.line.Day2.result.D.034", "line_id": "line.Day2.result.D.034", "revision": "1", "text": "“Well, now you do.”" }, { "beat_id": "beat.line.Day2.result.D.035", "line_id": "line.Day2.result.D.035", "revision": "1", "text": "She turns toward the door." }, { "beat_id": "beat.line.Day2.result.D.036", "line_id": "line.Day2.result.D.036", "revision": "1", "text": "“Sit down.”" }, { "beat_id": "beat.line.Day2.result.D.037", "line_id": "line.Day2.result.D.037", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day2.result.D.038", "line_id": "line.Day2.result.D.038", "revision": "1", "text": "“We can stop arguing.”" }, { "beat_id": "beat.line.Day2.result.D.039", "line_id": "line.Day2.result.D.039", "revision": "1", "text": "“I\'m going.”" }, { "beat_id": "beat.line.Day2.result.D.040", "line_id": "line.Day2.result.D.040", "revision": "1", "text": "I stand in the gap between the table and the door." }, { "beat_id": "beat.line.Day2.result.D.041", "line_id": "line.Day2.result.D.041", "revision": "1", "text": "“Move.”" }, { "beat_id": "beat.line.Day2.result.D.042", "line_id": "line.Day2.result.D.042", "revision": "1", "text": "“Just give me a minute.”" }, { "beat_id": "beat.line.Day2.result.D.043", "line_id": "line.Day2.result.D.043", "revision": "1", "text": "“I have.”" }, { "beat_id": "beat.line.Day2.result.D.044", "line_id": "line.Day2.result.D.044", "revision": "1", "text": "The handle is behind my wrist." }, { "beat_id": "beat.line.Day2.result.D.045", "line_id": "line.Day2.result.D.045", "revision": "1", "text": "“I\'m not angry with you.”" }, { "beat_id": "beat.line.Day2.result.D.046", "line_id": "line.Day2.result.D.046", "revision": "1", "text": "“That isn\'t what I asked.”" }, { "beat_id": "beat.line.Day2.result.D.047", "line_id": "line.Day2.result.D.047", "revision": "1", "text": "I step away." }, { "beat_id": "beat.line.Day2.result.D.048", "line_id": "line.Day2.result.D.048", "revision": "1", "text": "Stay beside the door and wait for her hand." }] }, { "entry_id": "Day2.result.E", "lines": [{ "beat_id": "beat.line.Day2.result.E.001", "line_id": "line.Day2.result.E.001", "revision": "1", "text": "“Yes. I wanted you here.”" }, { "beat_id": "beat.line.Day2.result.E.002", "line_id": "line.Day2.result.E.002", "revision": "1", "text": "Someone else is listening." }, { "beat_id": "beat.line.Day2.result.E.003", "line_id": "line.Day2.result.E.003", "revision": "1", "text": "“And you decided I should be.”" }, { "beat_id": "beat.line.Day2.result.E.004", "line_id": "line.Day2.result.E.004", "revision": "1", "text": "“I wanted it to be possible.”" }, { "beat_id": "beat.line.Day2.result.E.005", "line_id": "line.Day2.result.E.005", "revision": "1", "text": "“You knew what I wanted.”" }, { "beat_id": "beat.line.Day2.result.E.006", "line_id": "line.Day2.result.E.006", "revision": "1", "text": "“Yes.”" }, { "beat_id": "beat.line.Day2.result.E.007", "line_id": "line.Day2.result.E.007", "revision": "1", "text": "Lavinia begins to draw her hand away. I open mine." }, { "beat_id": "beat.line.Day2.result.E.008", "line_id": "line.Day2.result.E.008", "revision": "1", "text": "She rests her hand beside the plate." }, { "beat_id": "beat.line.Day2.result.E.009", "line_id": "line.Day2.result.E.009", "revision": "1", "text": "“I\'m not giving you anything else to send.”" }, { "beat_id": "beat.line.Day2.result.E.010", "line_id": "line.Day2.result.E.010", "revision": "1", "text": "“All right.”" }, { "beat_id": "beat.line.Day2.result.E.011", "line_id": "line.Day2.result.E.011", "revision": "1", "text": "“You\'d still want to change it.”" }, { "beat_id": "beat.line.Day2.result.E.012", "line_id": "line.Day2.result.E.012", "revision": "1", "text": "“Probably.”" }, { "beat_id": "beat.line.Day2.result.E.013", "line_id": "line.Day2.result.E.013", "revision": "1", "text": "“Priscilla.”" }, { "beat_id": "beat.line.Day2.result.E.014", "line_id": "line.Day2.result.E.014", "revision": "1", "text": "“I\'m not asking for it.”" }, { "beat_id": "beat.line.Day2.result.E.015", "line_id": "line.Day2.result.E.015", "revision": "1", "text": "She turns her glass. I wait until she has taken a drink." }, { "beat_id": "beat.line.Day2.result.E.016", "line_id": "line.Day2.result.E.016", "revision": "1", "text": "Lavinia reaches behind her for the coat." }, { "beat_id": "beat.line.Day2.result.E.017", "line_id": "line.Day2.result.E.017", "revision": "1", "text": "“Stay a little longer.”" }, { "beat_id": "beat.line.Day2.result.E.018", "line_id": "line.Day2.result.E.018", "revision": "1", "text": "“Doing what?”" }, { "beat_id": "beat.line.Day2.result.E.019", "line_id": "line.Day2.result.E.019", "revision": "1", "text": "“Having dinner with me.”" }, { "beat_id": "beat.line.Day2.result.E.020", "line_id": "line.Day2.result.E.020", "revision": "1", "text": "“We\'ve been doing that.”" }, { "beat_id": "beat.line.Day2.result.E.021", "line_id": "line.Day2.result.E.021", "revision": "1", "text": "“I like it.”" }, { "beat_id": "beat.line.Day2.result.E.022", "line_id": "line.Day2.result.E.022", "revision": "1", "text": "For a moment she holds the glass against her lower lip." }, { "beat_id": "beat.line.Day2.result.E.023", "line_id": "line.Day2.result.E.023", "revision": "1", "text": "Then she puts it down." }, { "beat_id": "beat.line.Day2.result.E.024", "line_id": "line.Day2.result.E.024", "revision": "1", "text": "“Until we finish.”" }, { "beat_id": "beat.line.Day2.result.E.025", "line_id": "line.Day2.result.E.025", "revision": "1", "text": "Her hand leaves the coat." }, { "beat_id": "beat.line.Day2.result.E.026", "line_id": "line.Day2.result.E.026", "revision": "1", "text": "I cut another piece of chicken." }, { "beat_id": "beat.line.Day2.result.E.027", "line_id": "line.Day2.result.E.027", "revision": "1", "text": "Lavinia watches the knife come down again." }, { "beat_id": "beat.line.Day2.result.E.028", "line_id": "line.Day2.result.E.028", "revision": "1", "text": "“That\'s small enough.”" }, { "beat_id": "beat.line.Day2.result.E.029", "line_id": "line.Day2.result.E.029", "revision": "1", "text": "“Is it?”" }, { "beat_id": "beat.line.Day2.result.E.030", "line_id": "line.Day2.result.E.030", "revision": "1", "text": "“Eat it.”" }, { "beat_id": "beat.line.Day2.result.E.031", "line_id": "line.Day2.result.E.031", "revision": "1", "text": "I do. She moves her chair closer to reach my plate and takes the other piece." }, { "beat_id": "beat.line.Day2.result.E.032", "line_id": "line.Day2.result.E.032", "revision": "1", "text": "For a while, neither of us says anything." }, { "beat_id": "beat.line.Day2.result.E.033", "line_id": "line.Day2.result.E.033", "revision": "1", "text": "When the plates are empty, she reaches for her coat. I stay in my chair." }, { "beat_id": "beat.line.Day2.result.E.034", "line_id": "line.Day2.result.E.034", "revision": "1", "text": "“Tell me when you get home.”" }, { "beat_id": "beat.line.Day2.result.E.035", "line_id": "line.Day2.result.E.035", "revision": "1", "text": "“I will.”" }, { "beat_id": "beat.line.Day2.result.E.036", "line_id": "line.Day2.result.E.036", "revision": "1", "text": "She rests her hand on my shoulder while she puts her coat on. I turn toward it." }, { "beat_id": "beat.line.Day2.result.E.037", "line_id": "line.Day2.result.E.037", "revision": "1", "text": "The pressure lifts." }, { "beat_id": "beat.line.Day2.result.E.038", "line_id": "line.Day2.result.E.038", "revision": "1", "text": "“Good night, Priscilla.”" }, { "beat_id": "beat.line.Day2.result.E.039", "line_id": "line.Day2.result.E.039", "revision": "1", "text": "“Good night.”" }, { "beat_id": "beat.line.Day2.result.E.040", "line_id": "line.Day2.result.E.040", "revision": "1", "text": "At my desk, the phone lights." }, { "beat_id": "beat.line.Day2.result.E.041", "line_id": "line.Day2.result.E.041", "revision": "1", "text": "Lavinia, message: Home." }, { "beat_id": "beat.line.Day2.result.E.042", "line_id": "line.Day2.result.E.042", "revision": "1", "text": "Priscilla, message: Good night, Lavinia." }, { "beat_id": "beat.line.Day2.result.E.043", "line_id": "line.Day2.result.E.043", "revision": "1", "text": "I leave the conversation open while I turn off the lamp." }] }, { "entry_id": "Day2.threshold.benchmark", "lines": [{ "beat_id": "beat.line.Day2.threshold.benchmark.001", "line_id": "line.Day2.threshold.benchmark.001", "revision": "1", "text": "She does not immediately pass. Her hand comes up again." }, { "beat_id": "beat.line.Day2.threshold.benchmark.002", "line_id": "line.Day2.threshold.benchmark.002", "revision": "1", "text": "I draw back." }, { "beat_id": "beat.line.Day2.threshold.benchmark.003", "line_id": "line.Day2.threshold.benchmark.003", "revision": "1", "text": "The hand stops." }, { "beat_id": "beat.line.Day2.threshold.benchmark.004", "line_id": "line.Day2.threshold.benchmark.004", "revision": "1", "text": "Then I lower my own and tip my head a little toward it." }, { "beat_id": "beat.line.Day2.threshold.benchmark.005", "line_id": "line.Day2.threshold.benchmark.005", "revision": "1", "text": "Her fingers smooth the hair away from my forehead." }, { "beat_id": "beat.line.Day2.threshold.benchmark.006", "line_id": "line.Day2.threshold.benchmark.006", "revision": "1", "text": "“There.”" }, { "beat_id": "beat.line.Day2.threshold.benchmark.007", "line_id": "line.Day2.threshold.benchmark.007", "revision": "1", "text": "“Sit with me.”" }, { "beat_id": "beat.line.Day2.threshold.benchmark.008", "line_id": "line.Day2.threshold.benchmark.008", "revision": "1", "text": "Her hand moves once more through my hair." }, { "beat_id": "beat.line.Day2.threshold.benchmark.009", "line_id": "line.Day2.threshold.benchmark.009", "revision": "1", "text": "Then it falls away." }, { "beat_id": "beat.line.Day2.threshold.benchmark.010", "line_id": "line.Day2.threshold.benchmark.010", "revision": "1", "text": "“I\'m still leaving.”" }, { "beat_id": "beat.line.Day2.threshold.benchmark.011", "line_id": "line.Day2.threshold.benchmark.011", "revision": "1", "text": "“Then why did you do that?”" }, { "beat_id": "beat.line.Day2.threshold.benchmark.012", "line_id": "line.Day2.threshold.benchmark.012", "revision": "1", "text": "Lavinia does not answer. She puts on her coat." }, { "beat_id": "beat.line.Day2.threshold.benchmark.013", "line_id": "line.Day2.threshold.benchmark.013", "revision": "1", "text": "Her chair is still pulled out. I turn toward the table." }, { "beat_id": "beat.line.Day2.threshold.benchmark.014", "line_id": "line.Day2.threshold.benchmark.014", "revision": "1", "text": "The door opens behind me." }, { "beat_id": "beat.line.Day2.threshold.benchmark.015", "line_id": "line.Day2.threshold.benchmark.015", "revision": "1", "text": "“Lavinia.”" }, { "beat_id": "beat.line.Day2.threshold.benchmark.016", "line_id": "line.Day2.threshold.benchmark.016", "revision": "1", "text": "She remains in the doorway." }, { "beat_id": "beat.line.Day2.threshold.benchmark.017", "line_id": "line.Day2.threshold.benchmark.017", "revision": "1", "text": "“Tell me when you get home.”" }, { "beat_id": "beat.line.Day2.threshold.benchmark.018", "line_id": "line.Day2.threshold.benchmark.018", "revision": "1", "text": "“All right.”" }, { "beat_id": "beat.line.Day2.threshold.benchmark.019", "line_id": "line.Day2.threshold.benchmark.019", "revision": "1", "text": "Then she leaves." }, { "beat_id": "beat.line.Day2.threshold.benchmark.020", "line_id": "line.Day2.threshold.benchmark.020", "revision": "1", "text": "At my desk, the phone lights." }, { "beat_id": "beat.line.Day2.threshold.benchmark.021", "line_id": "line.Day2.threshold.benchmark.021", "revision": "1", "text": "Lavinia, message: Home." }, { "beat_id": "beat.line.Day2.threshold.benchmark.022", "line_id": "line.Day2.threshold.benchmark.022", "revision": "1", "text": "I open the conversation. Thank you for telling me. I read it, then remove it." }, { "beat_id": "beat.line.Day2.threshold.benchmark.023", "line_id": "line.Day2.threshold.benchmark.023", "revision": "1", "text": "Priscilla, message: Good night, Lavinia." }, { "beat_id": "beat.line.Day2.threshold.benchmark.024", "line_id": "line.Day2.threshold.benchmark.024", "revision": "1", "text": "The message goes through. I turn off the lamp and leave the phone face up." }] }, { "entry_id": "Day2.threshold.cruel", "lines": [{ "beat_id": "beat.line.Day2.threshold.cruel.001", "line_id": "line.Day2.threshold.cruel.001", "revision": "1", "text": "She does not immediately pass. Her hand comes up again." }, { "beat_id": "beat.line.Day2.threshold.cruel.002", "line_id": "line.Day2.threshold.cruel.002", "revision": "1", "text": "I draw back." }, { "beat_id": "beat.line.Day2.threshold.cruel.003", "line_id": "line.Day2.threshold.cruel.003", "revision": "1", "text": "The hand stops." }, { "beat_id": "beat.line.Day2.threshold.cruel.004", "line_id": "line.Day2.threshold.cruel.004", "revision": "1", "text": "Then I lower my own and tip my head toward it." }, { "beat_id": "beat.line.Day2.threshold.cruel.005", "line_id": "line.Day2.threshold.cruel.005", "revision": "1", "text": "Her fingers smooth the hair away from my forehead." }, { "beat_id": "beat.line.Day2.threshold.cruel.006", "line_id": "line.Day2.threshold.cruel.006", "revision": "1", "text": "“Still asking me to stay?”" }, { "beat_id": "beat.line.Day2.threshold.cruel.007", "line_id": "line.Day2.threshold.cruel.007", "revision": "1", "text": "“Yes.”" }, { "beat_id": "beat.line.Day2.threshold.cruel.008", "line_id": "line.Day2.threshold.cruel.008", "revision": "1", "text": "Lavinia laughs once. Her fingers keep moving." }, { "beat_id": "beat.line.Day2.threshold.cruel.009", "line_id": "line.Day2.threshold.cruel.009", "revision": "1", "text": "“You deserved that, Priscilla.”" }, { "beat_id": "beat.line.Day2.threshold.cruel.010", "line_id": "line.Day2.threshold.cruel.010", "revision": "1", "text": "“I\'m still asking.”" }, { "beat_id": "beat.line.Day2.threshold.cruel.011", "line_id": "line.Day2.threshold.cruel.011", "revision": "1", "text": "Her fingers stop at my temple." }, { "beat_id": "beat.line.Day2.threshold.cruel.012", "line_id": "line.Day2.threshold.cruel.012", "revision": "1", "text": "A little longer." }, { "beat_id": "beat.line.Day2.threshold.cruel.013", "line_id": "line.Day2.threshold.cruel.013", "revision": "1", "text": "“Look at me.”" }, { "beat_id": "beat.line.Day2.threshold.cruel.014", "line_id": "line.Day2.threshold.cruel.014", "revision": "1", "text": "I turn toward her." }, { "beat_id": "beat.line.Day2.threshold.cruel.015", "line_id": "line.Day2.threshold.cruel.015", "revision": "1", "text": "The hand falls away." }, { "beat_id": "beat.line.Day2.threshold.cruel.016", "line_id": "line.Day2.threshold.cruel.016", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day2.threshold.cruel.017", "line_id": "line.Day2.threshold.cruel.017", "revision": "1", "text": "She puts on her coat and opens the door." }, { "beat_id": "beat.line.Day2.threshold.cruel.018", "line_id": "line.Day2.threshold.cruel.018", "revision": "1", "text": "“Lavinia.”" }, { "beat_id": "beat.line.Day2.threshold.cruel.019", "line_id": "line.Day2.threshold.cruel.019", "revision": "1", "text": "The door closes." }] }, { "entry_id": "Day2.threshold.stay", "lines": [{ "beat_id": "beat.line.Day2.threshold.stay.001", "line_id": "line.Day2.threshold.stay.001", "revision": "1", "text": "The door opens. Music from the bar fills the pause. I go back to my chair." }, { "beat_id": "beat.line.Day2.threshold.stay.002", "line_id": "line.Day2.threshold.stay.002", "revision": "1", "text": "Lavinia remains in the doorway." }, { "beat_id": "beat.line.Day2.threshold.stay.003", "line_id": "line.Day2.threshold.stay.003", "revision": "1", "text": "“You\'re still smiling.”" }, { "beat_id": "beat.line.Day2.threshold.stay.004", "line_id": "line.Day2.threshold.stay.004", "revision": "1", "text": "“I want you here.”" }, { "beat_id": "beat.line.Day2.threshold.stay.005", "line_id": "line.Day2.threshold.stay.005", "revision": "1", "text": "“You deserved it.”" }, { "beat_id": "beat.line.Day2.threshold.stay.006", "line_id": "line.Day2.threshold.stay.006", "revision": "1", "text": "“I wanted you here before that.”" }, { "beat_id": "beat.line.Day2.threshold.stay.007", "line_id": "line.Day2.threshold.stay.007", "revision": "1", "text": "She puts one arm into her coat. The other sleeve hangs empty." }, { "beat_id": "beat.line.Day2.threshold.stay.008", "line_id": "line.Day2.threshold.stay.008", "revision": "1", "text": "Then she closes the door, comes back to the table, and takes it off." }, { "beat_id": "beat.line.Day2.threshold.stay.009", "line_id": "line.Day2.threshold.stay.009", "revision": "1", "text": "The coat goes over her chair again. She sits." }, { "beat_id": "beat.line.Day2.threshold.stay.010", "line_id": "line.Day2.threshold.stay.010", "revision": "1", "text": "“Come here.”" }, { "beat_id": "beat.line.Day2.threshold.stay.011", "line_id": "line.Day2.threshold.stay.011", "revision": "1", "text": "I draw my chair round the corner." }, { "beat_id": "beat.line.Day2.threshold.stay.012", "line_id": "line.Day2.threshold.stay.012", "revision": "1", "text": "Her fingers gather the hair away from my cheek. For a moment, they hold it there." }, { "beat_id": "beat.line.Day2.threshold.stay.013", "line_id": "line.Day2.threshold.stay.013", "revision": "1", "text": "I push the chicken toward her." }, { "beat_id": "beat.line.Day2.threshold.stay.014", "line_id": "line.Day2.threshold.stay.014", "revision": "1", "text": "“It\'s cold,” she says." }, { "beat_id": "beat.line.Day2.threshold.stay.015", "line_id": "line.Day2.threshold.stay.015", "revision": "1", "text": "“You were leaving.”" }, { "beat_id": "beat.line.Day2.threshold.stay.016", "line_id": "line.Day2.threshold.stay.016", "revision": "1", "text": "She laughs and takes a piece anyway." }, { "beat_id": "beat.line.Day2.threshold.stay.017", "line_id": "line.Day2.threshold.stay.017", "revision": "1", "text": "My cheek pulls when I smile." }] }, { "entry_id": "Day3", "lines": [{ "beat_id": "beat.line.Day3.one", "line_id": "line.Day3.one", "revision": "1", "text": "The wool at the right shoulder of the coat has dried overnight, though the outer seam still holds a slight wave from the hanger—the price of letting someone else angle the handle for twenty minutes between the station and the hill." }, { "beat_id": "beat.line.Day3.002", "line_id": "line.Day3.002", "revision": "1", "text": "Beside the door, the long black umbrella stands closed in the rack: curved wooden handle half an inch taller than the others, ferrule dry." }, { "beat_id": "beat.line.Day3.003", "line_id": "line.Day3.003", "revision": "1", "text": "On the desk blotter, the screen lights." }, { "beat_id": "beat.line.Day3.004", "line_id": "line.Day3.004", "revision": "1", "text": "Sylvia: Did you catch a cold yesterday?" }, { "beat_id": "beat.line.Day3.005", "line_id": "line.Day3.005", "revision": "1", "text": "Priscilla: No. Why?" }, { "beat_id": "beat.line.Day3.006", "line_id": "line.Day3.006", "revision": "1", "text": "Sylvia: The right sleeve was soaked through when you passed the library." }, { "beat_id": "beat.line.Day3.007", "line_id": "line.Day3.007", "revision": "1", "text": "Priscilla: It was only a passing shower. There was an umbrella." }, { "beat_id": "beat.line.Day3.008", "line_id": "line.Day3.008", "revision": "1", "text": "Three seconds pass before the next line appears—too short for her to have calculated a courtesy, long enough to mean she already knew the answer." }, { "beat_id": "beat.line.Day3.009", "line_id": "line.Day3.009", "revision": "1", "text": "Sylvia: Yes. You were carrying it." }, { "beat_id": "beat.line.Day3.010", "line_id": "line.Day3.010", "revision": "1", "text": "Only the right side." }, { "beat_id": "beat.line.Day3.011", "line_id": "line.Day3.011", "revision": "1", "text": "Knuckles brush the curved wooden handle in the rack on the way to the door." }, { "beat_id": "beat.line.Day3.012", "line_id": "line.Day3.012", "revision": "1", "text": "Glass doors sliding shut behind the station taxi stand. One black canopy open against the grey drizzle." }, { "beat_id": "beat.line.Day3.013", "line_id": "line.Day3.013", "revision": "1", "text": "The handle stays in a left hand, tilted three inches toward the dry coat beside it—an ungenerous geometry that leaves half a shoulder outside the rim." }, { "beat_id": "beat.line.Day3.014", "line_id": "line.Day3.014", "revision": "1", "text": "Rain darkens the outer seam of the right sleeve from shoulder to cuff." }, { "beat_id": "beat.line.Day3.015", "line_id": "line.Day3.015", "revision": "1", "text": "On the left side, the heavier canvas travel bag swings against the knee at every curb." }, { "beat_id": "beat.line.Day3.016", "line_id": "line.Day3.016", "revision": "1", "text": "A quick glance toward the wet wool, nothing said, the handle unshifted." }, { "beat_id": "beat.line.Day3.017", "line_id": "line.Day3.017", "revision": "1", "text": "The corner of the mouth lifts anyway. Warmth stays along the dry left side all the way to the turn." }, { "beat_id": "beat.line.Day3.018", "line_id": "line.Day3.018", "revision": "1", "text": "In the small back room of the student exhibition, the heavy door swings shut on its hydraulic arm; the rubber strip clicks against the threshold, cutting off the corridor air." }, { "beat_id": "beat.line.Day3.019", "line_id": "line.Day3.019", "revision": "1", "text": "The room has no outer windows, and the high transom along the inner wall is latched shut—two coats of cream paint sealing the brass catch into its slot so not even a draft from the stairwell can enter. Under the yellow cone of the picture lamp, the dust hangs motionless." }, { "beat_id": "beat.line.Day3.020", "line_id": "line.Day3.020", "revision": "1", "text": "On the wooden bench in the middle of the room, a folded scrap of paper sits on the empty right-hand seat beside Sylvia\'s hip." }, { "beat_id": "beat.line.Day3.021", "line_id": "line.Day3.021", "revision": "1", "text": "Taken. Back in a minute." }, { "beat_id": "beat.line.Day3.022", "line_id": "line.Day3.022", "revision": "1", "text": "The fold is pressed flat with the side of a thumbnail—her usual neat habit of turning a preference into a rule before anyone else can sit down." }, { "beat_id": "beat.line.Day3.023", "line_id": "line.Day3.023", "revision": "1", "text": "“Did I say a minute?”" }, { "beat_id": "beat.line.Day3.024", "line_id": "line.Day3.024", "revision": "1", "text": "Sylvia looks up from the sketchbook open across her knees and lifts the folded scrap between two fingers." }, { "beat_id": "beat.line.Day3.025", "line_id": "line.Day3.025", "revision": "1", "text": "“You\'re always late when you come from the library,” she says mildly. “Sit down before someone else takes it.”" }, { "beat_id": "beat.line.Day3.026", "line_id": "line.Day3.026", "revision": "1", "text": "As soon as the space beside her is occupied, she shifts the wool hem of her unbuttoned coat three inches to the right so it covers both laps. From the paper bag beside her thigh, her left hand produces half a peeled mandarin—the white pith already picked clean from the segments, the way she has prepared them since we were twelve—and places it directly into my palm." }, { "beat_id": "beat.line.Day3.027", "line_id": "line.Day3.027", "revision": "1", "text": "Caught on the rib of her left cardigan cuff, half an inch from the mandarin, clings a tiny grey curl of kneaded rubber—fresh enough that it hasn\'t flattened into the wool, left over from erasing something she wanted off the page before the door opened." }, { "beat_id": "beat.line.Day3.028", "line_id": "line.Day3.028", "revision": "1", "text": "“Your hands are cold,” she says." }, { "beat_id": "beat.line.Day3.029", "line_id": "line.Day3.029", "revision": "1", "text": "“It\'s windy on the steps.”" }, { "beat_id": "beat.line.Day3.030", "line_id": "line.Day3.030", "revision": "1", "text": "“Eat that first.”" }, { "beat_id": "beat.line.Day3.031", "line_id": "line.Day3.031", "revision": "1", "text": "The segment is sweet and warm from her fingers. Across the wall in front of us hangs a student painting of a harbour ferry in three shades of grey." }, { "beat_id": "beat.line.Day3.032", "line_id": "line.Day3.032", "revision": "1", "text": "“He left out the pier,” I say, leaning a shoulder against hers." }, { "beat_id": "beat.line.Day3.033", "line_id": "line.Day3.033", "revision": "1", "text": "“Perhaps it sank.”" }, { "beat_id": "beat.line.Day3.034", "line_id": "line.Day3.034", "revision": "1", "text": "“Then the passengers are remarkably calm.”" }, { "beat_id": "beat.line.Day3.035", "line_id": "line.Day3.035", "revision": "1", "text": "Sylvia laughs—a soft, unguarded sound that moves through her shoulder into mine. For ten seconds neither of us says anything; she peels another segment for herself, puts one more into my hand without looking, and touches the tip of her pencil to the open sketchbook on her lap." }, { "beat_id": "beat.line.Day3.036", "line_id": "line.Day3.036", "revision": "1", "text": "Easy. With her, nothing has to be explained first." }, { "beat_id": "beat.line.Day3.037", "line_id": "line.Day3.037", "revision": "1", "text": "Resting my chin lightly on the wool of her shoulder to see what she is drawing, I look down at the top page of the sketchbook." }, { "beat_id": "beat.line.Day3.038", "line_id": "line.Day3.038", "revision": "1", "text": "On the upper sheet is a neat, harmless pencil sketch of the bench and the grey ferry frame in front of us. Beside the spine lies another folded slip she was lettering with my borrowed pen: An Improvement / Please do not touch." }, { "beat_id": "beat.line.Day3.039", "line_id": "line.Day3.039", "revision": "1", "text": "“Another notice?” I murmur against her shoulder." }, { "beat_id": "beat.line.Day3.040", "line_id": "line.Day3.040", "revision": "1", "text": "“For the corner of the frame.”" }, { "beat_id": "beat.line.Day3.041", "line_id": "line.Day3.041", "revision": "1", "text": "“There\'s rubber dust in the binding. You\'ve been drawing something else underneath.”" }, { "beat_id": "beat.line.Day3.042", "line_id": "line.Day3.042", "revision": "1", "text": "“No, I haven\'t.”" }, { "beat_id": "beat.line.Day3.043", "line_id": "line.Day3.043", "revision": "1", "text": "Above the picture frames, the painted-shut transom has not moved, and the door remains sealed on its rubber strip." }, { "beat_id": "beat.line.Day3.044", "line_id": "line.Day3.044", "revision": "1", "text": "Even so, a sudden, narrow current of air crosses the bench from left to right—lifting the top sheet of the sketchbook right out from under Sylvia\'s wrist and folding it back against the binding." }, { "beat_id": "beat.line.Day3.045", "line_id": "line.Day3.045", "revision": "1", "text": "Neither hand touched the paper." }, { "beat_id": "beat.line.Day3.046", "line_id": "line.Day3.046", "revision": "1", "text": "Beneath the harmless sketch of the bench lies the page she was keeping covered." }, { "beat_id": "beat.line.Day3.047", "line_id": "line.Day3.047", "revision": "1", "text": "The pencil lines there were not drawn today, and they were not drawn with a steady hand. It is a close study of a woman from the collarbone to the mouth—head tilted back against a bench, collar open at the hollow of the throat, one hand resting across the waist. Whoever drew it returned to the throat and the parted lips six or seven times with soft, dark 4B lead, shading over the pulse point until the paper grain roughened and lifted, and the upper half of the face was rubbed into a dark, unrecognizable blur where the heel of a palm dragged across the graphite." }, { "beat_id": "beat.line.Day3.048", "line_id": "line.Day3.048", "revision": "1", "text": "On the side of Sylvia\'s right thumb—resting an inch from the page—sits the exact same grey smudge of soft lead." }, { "beat_id": "beat.line.Day3.049", "line_id": "line.Day3.049", "revision": "1", "text": "My chin is still resting on her shoulder. Neither of us breathes for a full second." }, { "beat_id": "beat.line.Day3.050", "line_id": "line.Day3.050", "revision": "1", "text": "Too many passes of the lead over the throat. The collar from Monday\'s café—or Lavinia\'s bodice at the barre." }, { "beat_id": "beat.line.Day3.051", "line_id": "line.Day3.051", "revision": "1", "text": "Sylvia does not slam the sketchbook shut." }, { "beat_id": "beat.line.Day3.052", "line_id": "line.Day3.052", "revision": "1", "text": "Instead, her left hand comes up, catches my wrist where it rests against her coat, and guides my own hand two inches to the right—placing my palm and cuff directly between the overhead lamp and the open page so my shadow falls straight across the roughened throat on the paper." }, { "beat_id": "beat.line.Day3.053", "line_id": "line.Day3.053", "revision": "1", "text": "“Hold still,” she says softly." }, { "beat_id": "beat.line.Day3.054", "line_id": "line.Day3.054", "revision": "1", "text": "“My hand is in your light.”" }, { "beat_id": "beat.line.Day3.055", "line_id": "line.Day3.055", "revision": "1", "text": "“It\'s meant to be.”" }, { "beat_id": "beat.line.Day3.056", "line_id": "line.Day3.056", "revision": "1", "text": "Her thumb slides under the edge of my cuff and presses against the inside of my wrist—directly over the tendon where the pencil shaded through the paper grain, her pulse fast and warm against mine." }, { "beat_id": "beat.line.Day3.057", "line_id": "line.Day3.057", "revision": "1", "text": "“The paper is nearly worn through at the neck,” I say quietly, not pulling my wrist away. “Who is that meant to be?”" }, { "beat_id": "beat.line.Day3.058", "line_id": "line.Day3.058", "revision": "1", "text": "Against my skin, the pad of her thumb stops moving." }, { "beat_id": "beat.line.Day3.059", "line_id": "line.Day3.059", "revision": "1", "text": "“It\'s only a figure study from the life class,” she says." }, { "beat_id": "beat.line.Day3.060", "line_id": "line.Day3.060", "revision": "1", "text": "“You don\'t take the life class.”" }, { "beat_id": "beat.line.Day3.061", "line_id": "line.Day3.061", "revision": "1", "text": "“Someone left the sheet on the bench, then.”" }, { "beat_id": "beat.line.Day3.062", "line_id": "line.Day3.062", "revision": "1", "text": "“It\'s sewn into the binding of your book.”" }, { "beat_id": "beat.line.Day3.063", "line_id": "line.Day3.063", "revision": "1", "text": "Sylvia looks down at the stitched spine without blinking, her voice retaining its mild, orderly decision-science calm." }, { "beat_id": "beat.line.Day3.064", "line_id": "line.Day3.064", "revision": "1", "text": "“The university stationer must have bound a used sheet into the pad by mistake,” she says. “Their quality control has been slipping since September.”" }, { "beat_id": "beat.line.Day3.065", "line_id": "line.Day3.065", "revision": "1", "text": "“With your 4B lead still on the margin?”" }, { "beat_id": "beat.line.Day3.066", "line_id": "line.Day3.066", "revision": "1", "text": "“I was trying to repair the throat.”" }, { "beat_id": "beat.line.Day3.067", "line_id": "line.Day3.067", "revision": "1", "text": "“By rubbing the face out with your palm?”" }, { "beat_id": "beat.line.Day3.068", "line_id": "line.Day3.068", "revision": "1", "text": "“The proportions were distracting.”" }, { "beat_id": "beat.line.Day3.069", "line_id": "line.Day3.069", "revision": "1", "text": "She withdraws her thumb from my wrist, folds the top sheet neatly back over the drawing, and slides the Please do not touch slip between the pages like a bookmark before closing the cover." }, { "beat_id": "beat.line.Day3.070", "line_id": "line.Day3.070", "revision": "1", "text": "“You could have asked me plainly,” she says, standing up from the bench." }, { "beat_id": "beat.line.Day3.071", "line_id": "line.Day3.071", "revision": "1", "text": "“I did ask.”" }, { "beat_id": "beat.line.Day3.072", "line_id": "line.Day3.072", "revision": "1", "text": "“You asked whose neck it was. That isn\'t a plain question.”" }, { "beat_id": "beat.line.Day3.073", "line_id": "line.Day3.073", "revision": "1", "text": "Not an answer, either." }, { "beat_id": "beat.line.Day3.074", "line_id": "line.Day3.074", "revision": "1", "text": "She pushes the cap onto the borrowed pen and holds it out between us. For a beat her fingers stay closed around the warm barrel until my fingers brush hers to take it." }, { "beat_id": "beat.line.Day3.075", "line_id": "line.Day3.075", "revision": "1", "text": "“Your pen,” she says." }, { "beat_id": "beat.line.Day3.076", "line_id": "line.Day3.076", "revision": "1", "text": "Outside at the foot of the stairs, she pulls the folded An Improvement slip from the edge of the closed sketchbook, folds it once more in half, and drops it into the wire bin beside the rail." }, { "beat_id": "beat.line.Day3.077", "line_id": "line.Day3.077", "revision": "1", "text": "“There,” she says quietly. “Now the stationer won\'t be blamed for it.”" }, { "beat_id": "beat.line.Day3.078", "line_id": "line.Day3.078", "revision": "1", "text": "At the bottom of the steps, the late-afternoon air off the harbour is cool." }, { "beat_id": "beat.line.Day3.079", "line_id": "line.Day3.079", "revision": "1", "text": "Instead of stepping back, Sylvia reaches down, takes my right hand—the one still cool from the stair rail—and draws it inside the deep left pocket of her own wool coat, keeping her hand closed over mine in the dark lining." }, { "beat_id": "beat.line.Day3.080", "line_id": "line.Day3.080", "revision": "1", "text": "“Come with me tonight,” she says." }, { "beat_id": "beat.line.Day3.081", "line_id": "line.Day3.081", "revision": "1", "text": "“Where?”" }, { "beat_id": "beat.line.Day3.082", "line_id": "line.Day3.082", "revision": "1", "text": "“There\'s an old cross-section house model in the north room on the hill. Someone left the interior bulbs on a timer, and nobody ever goes up there at six.”" }, { "beat_id": "beat.line.Day3.083", "line_id": "line.Day3.083", "revision": "1", "text": "“Lavinia is waiting outside the library at six. We\'re going for a walk.”" }, { "beat_id": "beat.line.Day3.084", "line_id": "line.Day3.084", "revision": "1", "text": "Inside the warm coat pocket, Sylvia\'s thumb passes once across the back of my knuckles." }, { "beat_id": "beat.line.Day3.085", "line_id": "line.Day3.085", "revision": "1", "text": "“You were with her last night,” she says—not accusing, her voice low and steady against the wind. “And you\'ve been rehearsing what you\'re going to say to her since you sat down on that bench.”" }, { "beat_id": "beat.line.Day3.086", "line_id": "line.Day3.086", "revision": "1", "text": "“I haven\'t.”" }, { "beat_id": "beat.line.Day3.087", "line_id": "line.Day3.087", "revision": "1", "text": "“Your hand hasn\'t relaxed once until now.” Her fingers close gently around mine inside the wool pocket. “Come up the hill with me. You won\'t have to arrange a single sentence all evening. There\'s still time to tell her.”" }, { "beat_id": "beat.line.Day3.088", "line_id": "line.Day3.088", "revision": "1", "text": "Spend the evening with Sylvia instead." }] }, { "entry_id": "Day3.lavinia", "lines": [{ "beat_id": "beat.line.Day3.lavinia.001", "line_id": "line.Day3.lavinia.001", "revision": "1", "text": "“Another evening?”" }, { "beat_id": "beat.line.Day3.lavinia.002", "line_id": "line.Day3.lavinia.002", "revision": "1", "text": "Inside the coat pocket, Sylvia\'s fingers stay over mine for one more second, then open and let my hand slip back into the cool air." }, { "beat_id": "beat.line.Day3.lavinia.003", "line_id": "line.Day3.lavinia.003", "revision": "1", "text": "“Perhaps,” she says, and turns up the hill path with her sketchbook under her arm; the library quad lies the other way." }, { "beat_id": "beat.line.Day3.lavinia.004", "line_id": "line.Day3.lavinia.004", "revision": "1", "text": "By six o\'clock, the florist paper around the white flowers has grown damp beneath the thumb." }, { "beat_id": "beat.line.Day3.lavinia.005", "line_id": "line.Day3.lavinia.005", "revision": "1", "text": "Lavinia\'s fingers ease one creased petal out of the paper fold." }, { "beat_id": "beat.line.Day3.lavinia.006", "line_id": "line.Day3.lavinia.006", "revision": "1", "text": "“You\'re bruising them.”" }, { "beat_id": "beat.line.Day3.lavinia.007", "line_id": "line.Day3.lavinia.007", "revision": "1", "text": "“I was holding them out of the wind for you.”" }, { "beat_id": "beat.line.Day3.lavinia.008", "line_id": "line.Day3.lavinia.008", "revision": "1", "text": "“By strangling the stems?”" }, { "beat_id": "beat.line.Day3.lavinia.009", "line_id": "line.Day3.lavinia.009", "revision": "1", "text": "“They survived the walk up the hill.”" }, { "beat_id": "beat.line.Day3.lavinia.010", "line_id": "line.Day3.lavinia.010", "revision": "1", "text": "The wrapping slides through my fingers, though one small white blossom catches on a nail. Lavinia takes that one too, tucks the stem back into the center of the bunch, and looks up with the corner of her mouth lifting." }, { "beat_id": "beat.line.Day3.lavinia.011", "line_id": "line.Day3.lavinia.011", "revision": "1", "text": "“There.”" }, { "beat_id": "beat.line.Day3.lavinia.012", "line_id": "line.Day3.lavinia.012", "revision": "1", "text": "“You\'re welcome.”" }, { "beat_id": "beat.line.Day3.lavinia.013", "line_id": "line.Day3.lavinia.013", "revision": "1", "text": "She buries her face in the white heads until her eyes are hidden behind the paper rim." }, { "beat_id": "beat.line.Day3.lavinia.014", "line_id": "line.Day3.lavinia.014", "revision": "1", "text": "“Where are you taking me?”" }, { "beat_id": "beat.line.Day3.lavinia.015", "line_id": "line.Day3.lavinia.015", "revision": "1", "text": "“Left.”" }, { "beat_id": "beat.line.Day3.lavinia.016", "line_id": "line.Day3.lavinia.016", "revision": "1", "text": "Past the corner of the library wall, she keeps the bouquet lifted under her nose while I pace half a step beside her right shoulder—slowing the cadence before the flagstones dip so her right ankle never has to take an uneven drop." }, { "beat_id": "beat.line.Day3.lavinia.017", "line_id": "line.Day3.lavinia.017", "revision": "1", "text": "“Which way now?” she asks from behind the flowers." }, { "beat_id": "beat.line.Day3.lavinia.018", "line_id": "line.Day3.lavinia.018", "revision": "1", "text": "A silent gesture toward the hedge path." }, { "beat_id": "beat.line.Day3.lavinia.019", "line_id": "line.Day3.lavinia.019", "revision": "1", "text": "“Say it aloud. I can\'t see through your bribe.”" }, { "beat_id": "beat.line.Day3.lavinia.020", "line_id": "line.Day3.lavinia.020", "revision": "1", "text": "“Right. Mind the curb.”" }, { "beat_id": "beat.line.Day3.lavinia.021", "line_id": "line.Day3.lavinia.021", "revision": "1", "text": "“I know where the curb is.”" }, { "beat_id": "beat.line.Day3.lavinia.022", "line_id": "line.Day3.lavinia.022", "revision": "1", "text": "“You walked into it in February.”" }, { "beat_id": "beat.line.Day3.lavinia.023", "line_id": "line.Day3.lavinia.023", "revision": "1", "text": "“Because you were talking.” She lowers the paper an inch, laughing." }, { "beat_id": "beat.line.Day3.lavinia.024", "line_id": "line.Day3.lavinia.024", "revision": "1", "text": "Directly ahead, the main library steps rise back into view from the opposite side." }, { "beat_id": "beat.line.Day3.lavinia.025", "line_id": "line.Day3.lavinia.025", "revision": "1", "text": "“A remarkably short walk, Priscilla.”" }, { "beat_id": "beat.line.Day3.lavinia.026", "line_id": "line.Day3.lavinia.026", "revision": "1", "text": "“The first lap is to make sure you\'re paying attention. I know a longer way.”" }, { "beat_id": "beat.line.Day3.lavinia.027", "line_id": "line.Day3.lavinia.027", "revision": "1", "text": "“I\'m sure you do.”" }, { "beat_id": "beat.line.Day3.lavinia.028", "line_id": "line.Day3.lavinia.028", "revision": "1", "text": "She shifts the flowers into the crook of her left arm and slips her right hand into mine—fingers warm, thumb settling over the back of my knuckle as if rewarding the first lap." }, { "beat_id": "beat.line.Day3.lavinia.029", "line_id": "line.Day3.lavinia.029", "revision": "1", "text": "A little longer like this." }, { "beat_id": "beat.line.Day3.lavinia.030", "line_id": "line.Day3.lavinia.030", "revision": "1", "text": "Beyond the side arch, the flagstones narrow. A parked bicycle leans across half the path. Turning sideways so her hip won\'t brush the wet hedge, Lavinia lets the white flower heads strike the metal bell; it gives a single, unfinished ring." }, { "beat_id": "beat.line.Day3.lavinia.031", "line_id": "line.Day3.lavinia.031", "revision": "1", "text": "“Excuse us,” she tells the handlebars." }, { "beat_id": "beat.line.Day3.lavinia.032", "line_id": "line.Day3.lavinia.032", "revision": "1", "text": "“There was room on the grass.”" }, { "beat_id": "beat.line.Day3.lavinia.033", "line_id": "line.Day3.lavinia.033", "revision": "1", "text": "“It had no business parking in the middle.”" }, { "beat_id": "beat.line.Day3.lavinia.034", "line_id": "line.Day3.lavinia.034", "revision": "1", "text": "Her hand stays laced in mine behind her hip until the path opens onto the iron gate." }, { "beat_id": "beat.line.Day3.lavinia.035", "line_id": "line.Day3.lavinia.035", "revision": "1", "text": "Under the gate lamp, two figures stop mid-stride—a cardigan swinging from a wrist, two takeaway cups balanced in the other hand." }, { "beat_id": "beat.line.Day3.lavinia.036", "line_id": "line.Day3.lavinia.036", "revision": "1", "text": "“We\'re walking down for coffee. Come with us for half an hour.”" }, { "beat_id": "beat.line.Day3.lavinia.037", "line_id": "line.Day3.lavinia.037", "revision": "1", "text": "A glance toward Lavinia." }, { "beat_id": "beat.line.Day3.lavinia.038", "line_id": "line.Day3.lavinia.038", "revision": "1", "text": "“If you like,” she says evenly." }, { "beat_id": "beat.line.Day3.lavinia.039", "line_id": "line.Day3.lavinia.039", "revision": "1", "text": "“We could come for a little—”" }, { "beat_id": "beat.line.Day3.lavinia.040", "line_id": "line.Day3.lavinia.040", "revision": "1", "text": "Inside the joined hands, Lavinia\'s grip closes all at once—pressing the ring finger hard against the middle knuckle. When my hand instincts to ease back half an inch, she does not release it; she twists the wrist a fraction inward against the damp flower stems so my breath catches audibly in the middle of the word." }, { "beat_id": "beat.line.Day3.lavinia.041", "line_id": "line.Day3.lavinia.041", "revision": "1", "text": "An extravagant way to train someone not to look toward the gate: she is creasing her own stems against my cuff to do it." }, { "beat_id": "beat.line.Day3.lavinia.042", "line_id": "line.Day3.lavinia.042", "revision": "1", "text": "“One moment,” I say toward the lamp, and turn half a step inward." }, { "beat_id": "beat.line.Day3.lavinia.043", "line_id": "line.Day3.lavinia.043", "revision": "1", "text": "“Let go.”" }, { "beat_id": "beat.line.Day3.lavinia.044", "line_id": "line.Day3.lavinia.044", "revision": "1", "text": "Her fingers uncurl slowly. For half a beat the palms stay stuck together by the damp warmth of the skin; separating them hurts sharper than the grip did." }, { "beat_id": "beat.line.Day3.lavinia.045", "line_id": "line.Day3.lavinia.045", "revision": "1", "text": "“That hurt.”" }, { "beat_id": "beat.line.Day3.lavinia.046", "line_id": "line.Day3.lavinia.046", "revision": "1", "text": "“I wanted an evening with you.”" }, { "beat_id": "beat.line.Day3.lavinia.047", "line_id": "line.Day3.lavinia.047", "revision": "1", "text": "Under the gate lamp, the figure with the cardigan waits for the answer." }, { "beat_id": "beat.line.Day3.lavinia.048", "line_id": "line.Day3.lavinia.048", "revision": "1", "text": "Accept the invitation for both of us." }] }, { "entry_id": "Day3.lavinia.result.A", "lines": [{ "beat_id": "beat.line.Day3.lavinia.result.A.001", "line_id": "line.Day3.lavinia.result.A.001", "revision": "1", "text": "“Another evening,” I say toward the gate. “Send a message tomorrow.”" }, { "beat_id": "beat.line.Day3.lavinia.result.A.002", "line_id": "line.Day3.lavinia.result.A.002", "revision": "1", "text": "Footsteps recede down the hill; the cardigan sleeve swings out of the lamp light." }, { "beat_id": "beat.line.Day3.lavinia.result.A.003", "line_id": "line.Day3.lavinia.result.A.003", "revision": "1", "text": "“You could have said that first,” Lavinia says." }, { "beat_id": "beat.line.Day3.lavinia.result.A.004", "line_id": "line.Day3.lavinia.result.A.004", "revision": "1", "text": "“I could have said yes.”" }, { "beat_id": "beat.line.Day3.lavinia.result.A.005", "line_id": "line.Day3.lavinia.result.A.005", "revision": "1", "text": "“You didn\'t.”" }, { "beat_id": "beat.line.Day3.lavinia.result.A.006", "line_id": "line.Day3.lavinia.result.A.006", "revision": "1", "text": "“The message will still go out tomorrow.”" }, { "beat_id": "beat.line.Day3.lavinia.result.A.007", "line_id": "line.Day3.lavinia.result.A.007", "revision": "1", "text": "“I heard.”" }, { "beat_id": "beat.line.Day3.lavinia.result.A.008", "line_id": "line.Day3.lavinia.result.A.008", "revision": "1", "text": "Her empty hand opens between our coats." }, { "beat_id": "beat.line.Day3.lavinia.result.A.009", "line_id": "line.Day3.lavinia.result.A.009", "revision": "1", "text": "“The other side,” I say." }, { "beat_id": "beat.line.Day3.lavinia.result.A.010", "line_id": "line.Day3.lavinia.result.A.010", "revision": "1", "text": "Paper rustles as the bouquet shifts to her right arm; moving to her left side brings the unbruised hand into hers." }, { "beat_id": "beat.line.Day3.lavinia.result.A.011", "line_id": "line.Day3.lavinia.result.A.011", "revision": "1", "text": "Another evening is not this one." }] }, { "entry_id": "Day3.lavinia.result.B", "lines": [{ "beat_id": "beat.line.Day3.lavinia.result.B.001", "line_id": "line.Day3.lavinia.result.B.001", "revision": "1", "text": "“Not tonight, thank you.”" }, { "beat_id": "beat.line.Day3.lavinia.result.B.002", "line_id": "line.Day3.lavinia.result.B.002", "revision": "1", "text": "The gate latch clicks shut behind the departing steps." }, { "beat_id": "beat.line.Day3.lavinia.result.B.003", "line_id": "line.Day3.lavinia.result.B.003", "revision": "1", "text": "“Don\'t look so put out,” Lavinia says." }, { "beat_id": "beat.line.Day3.lavinia.result.B.004", "line_id": "line.Day3.lavinia.result.B.004", "revision": "1", "text": "“Nothing was said.”" }, { "beat_id": "beat.line.Day3.lavinia.result.B.005", "line_id": "line.Day3.lavinia.result.B.005", "revision": "1", "text": "“Your mouth changed.”" }, { "beat_id": "beat.line.Day3.lavinia.result.B.006", "line_id": "line.Day3.lavinia.result.B.006", "revision": "1", "text": "“I\'m still walking with you.”" }, { "beat_id": "beat.line.Day3.lavinia.result.B.007", "line_id": "line.Day3.lavinia.result.B.007", "revision": "1", "text": "A green leaf has caught beneath the torn fold of the florist paper; two fingers free it without touching her wrist." }, { "beat_id": "beat.line.Day3.lavinia.result.B.008", "line_id": "line.Day3.lavinia.result.B.008", "revision": "1", "text": "Only the walk, then." }, { "beat_id": "beat.line.Day3.lavinia.result.B.009", "line_id": "line.Day3.lavinia.result.B.009", "revision": "1", "text": "Our steps settle into the same cadence along the outer wall, the white bouquet carried between the two coats like a boundary marker." }] }, { "entry_id": "Day3.lavinia.result.C", "lines": [{ "beat_id": "beat.line.Day3.lavinia.result.C.001", "line_id": "line.Day3.lavinia.result.C.001", "revision": "1", "text": "“Yes,” I say toward the gate, and then turn to Lavinia: “Will you come for one cup?”" }, { "beat_id": "beat.line.Day3.lavinia.result.C.002", "line_id": "line.Day3.lavinia.result.C.002", "revision": "1", "text": "“You asked for a walk.”" }, { "beat_id": "beat.line.Day3.lavinia.result.C.003", "line_id": "line.Day3.lavinia.result.C.003", "revision": "1", "text": "“Both are possible.”" }, { "beat_id": "beat.line.Day3.lavinia.result.C.004", "line_id": "line.Day3.lavinia.result.C.004", "revision": "1", "text": "“How long is one cup?”" }, { "beat_id": "beat.line.Day3.lavinia.result.C.005", "line_id": "line.Day3.lavinia.result.C.005", "revision": "1", "text": "“Until it cools.”" }, { "beat_id": "beat.line.Day3.lavinia.result.C.006", "line_id": "line.Day3.lavinia.result.C.006", "revision": "1", "text": "She looks through the iron bars, then settles the flowers higher against her shoulder." }, { "beat_id": "beat.line.Day3.lavinia.result.C.007", "line_id": "line.Day3.lavinia.result.C.007", "revision": "1", "text": "“One cup.”" }, { "beat_id": "beat.line.Day3.lavinia.result.C.008", "line_id": "line.Day3.lavinia.result.C.008", "revision": "1", "text": "At the narrow café table, four chairs fit badly; Lavinia draws hers flush against mine and lays the white bouquet across her knees so the paper rim rises above the tabletop." }, { "beat_id": "beat.line.Day3.lavinia.result.C.009", "line_id": "line.Day3.lavinia.result.C.009", "revision": "1", "text": "“You\'ll have to look around them,” she says." }, { "beat_id": "beat.line.Day3.lavinia.result.C.010", "line_id": "line.Day3.lavinia.result.C.010", "revision": "1", "text": "“I have been.”" }, { "beat_id": "beat.line.Day3.lavinia.result.C.011", "line_id": "line.Day3.lavinia.result.C.011", "revision": "1", "text": "A place beside me, even in company." }] }, { "entry_id": "Day3.lavinia.result.D", "lines": [{ "beat_id": "beat.line.Day3.lavinia.result.D.001", "line_id": "line.Day3.lavinia.result.D.001", "revision": "1", "text": "“We\'ll come,” I say toward the gate. “Give her a moment. She\'ll come.”" }, { "beat_id": "beat.line.Day3.lavinia.result.D.002", "line_id": "line.Day3.lavinia.result.D.002", "revision": "1", "text": "“I\'m not going,” Lavinia says." }, { "beat_id": "beat.line.Day3.lavinia.result.D.003", "line_id": "line.Day3.lavinia.result.D.003", "revision": "1", "text": "“You aren\'t interrupting—”" }, { "beat_id": "beat.line.Day3.lavinia.result.D.004", "line_id": "line.Day3.lavinia.result.D.004", "revision": "1", "text": "Lavinia hurls the bouquet straight down between us; the heavy wet stems strike across my ankles before the paper splits open against the flagstones." }, { "beat_id": "beat.line.Day3.lavinia.result.D.005", "line_id": "line.Day3.lavinia.result.D.005", "revision": "1", "text": "Two white heads snap cleanly from their stalks; another rolls into the mud beside the base of the iron rail." }, { "beat_id": "beat.line.Day3.lavinia.result.D.006", "line_id": "line.Day3.lavinia.result.D.006", "revision": "1", "text": "Under the lamp, the voice at the gate cuts off mid-syllable. A knee bends as if to reach for the nearest flower." }, { "beat_id": "beat.line.Day3.lavinia.result.D.007", "line_id": "line.Day3.lavinia.result.D.007", "revision": "1", "text": "“Leave them,” Lavinia says, her voice flat and exact." }, { "beat_id": "beat.line.Day3.lavinia.result.D.008", "line_id": "line.Day3.lavinia.result.D.008", "revision": "1", "text": "The figure straightens. The gate latch catches once, misses, and clicks shut as both shadows hurry away down the hill." }, { "beat_id": "beat.line.Day3.lavinia.result.D.009", "line_id": "line.Day3.lavinia.result.D.009", "revision": "1", "text": "“Go on,” Lavinia says, her hands empty at her sides, chest rising fast beneath her unbuttoned collar. “Smile at them. Catch up.”" }, { "beat_id": "beat.line.Day3.lavinia.result.D.010", "line_id": "line.Day3.lavinia.result.D.010", "revision": "1", "text": "“They were for you.”" }, { "beat_id": "beat.line.Day3.lavinia.result.D.011", "line_id": "line.Day3.lavinia.result.D.011", "revision": "1", "text": "“I know.”" }, { "beat_id": "beat.line.Day3.lavinia.result.D.012", "line_id": "line.Day3.lavinia.result.D.012", "revision": "1", "text": "Both knees touch the damp paving stones right at her feet." }, { "beat_id": "beat.line.Day3.lavinia.result.D.013", "line_id": "line.Day3.lavinia.result.D.013", "revision": "1", "text": "“I said leave them.”" }, { "beat_id": "beat.line.Day3.lavinia.result.D.014", "line_id": "line.Day3.lavinia.result.D.014", "revision": "1", "text": "“No. The paper is only torn to the middle.”" }, { "beat_id": "beat.line.Day3.lavinia.result.D.015", "line_id": "line.Day3.lavinia.result.D.015", "revision": "1", "text": "She threw her own gift into the mud just to clear the gate in ten seconds." }, { "beat_id": "beat.line.Day3.lavinia.result.D.016", "line_id": "line.Day3.lavinia.result.D.016", "revision": "1", "text": "As fingers reach past her instep for the snapped stems, her right shoe slides half an inch backward—not retreating toward the gate, only lifting the hem of her coat so the wool won\'t brush my cuff in the dirt." }, { "beat_id": "beat.line.Day3.lavinia.result.D.017", "line_id": "line.Day3.lavinia.result.D.017", "revision": "1", "text": "“That one won\'t stay,” she says, looking down at the broken white head by the rail." }, { "beat_id": "beat.line.Day3.lavinia.result.D.018", "line_id": "line.Day3.lavinia.result.D.018", "revision": "1", "text": "“Hold this.”" }, { "beat_id": "beat.line.Day3.lavinia.result.D.019", "line_id": "line.Day3.lavinia.result.D.019", "revision": "1", "text": "She does not touch the loose blossom. Instead, she bends from the waist and takes the two corners of the torn wrapping from my fingers, holding the paper open like a pocket while I lay the bruised stems back inside." }, { "beat_id": "beat.line.Day3.lavinia.result.D.020", "line_id": "line.Day3.lavinia.result.D.020", "revision": "1", "text": "When we stand, she presses the ruined bunch between our coats with one forearm. Her other hand comes up to the back of my neck—fingers cool and damp from the torn florist paper—and pulls my head forward until her forehead rests hard against my shoulder." }, { "beat_id": "beat.line.Day3.lavinia.result.D.021", "line_id": "line.Day3.lavinia.result.D.021", "revision": "1", "text": "Keep hold of me." }, { "beat_id": "beat.line.Day3.lavinia.result.D.022", "line_id": "line.Day3.lavinia.result.D.022", "revision": "1", "text": "“Answer for me in front of people again,” she whispers into the wool of my shoulder, her fingers tightening at my nape, “and it won\'t be the flowers next time.”" }, { "beat_id": "beat.line.Day3.lavinia.result.D.023", "line_id": "line.Day3.lavinia.result.D.023", "revision": "1", "text": "“You helped me pick them up.”" }, { "beat_id": "beat.line.Day3.lavinia.result.D.024", "line_id": "line.Day3.lavinia.result.D.024", "revision": "1", "text": "She laughs once against my collarbone—a short, breathless sound—and does not let go of my neck as the torn paper crackles between our chests." }] }, { "entry_id": "Day3.lavinia.result.E", "lines": [{ "beat_id": "beat.line.Day3.lavinia.result.E.001", "line_id": "line.Day3.lavinia.result.E.001", "revision": "1", "text": "“Yes,” I say toward the gate, and then turn to Lavinia: “Will you come for one cup?”" }, { "beat_id": "beat.line.Day3.lavinia.result.E.002", "line_id": "line.Day3.lavinia.result.E.002", "revision": "1", "text": "“You asked for a walk.”" }, { "beat_id": "beat.line.Day3.lavinia.result.E.003", "line_id": "line.Day3.lavinia.result.E.003", "revision": "1", "text": "“Both are possible.”" }, { "beat_id": "beat.line.Day3.lavinia.result.E.004", "line_id": "line.Day3.lavinia.result.E.004", "revision": "1", "text": "“How long is one cup?”" }, { "beat_id": "beat.line.Day3.lavinia.result.E.005", "line_id": "line.Day3.lavinia.result.E.005", "revision": "1", "text": "“Until it cools.”" }, { "beat_id": "beat.line.Day3.lavinia.result.E.006", "line_id": "line.Day3.lavinia.result.E.006", "revision": "1", "text": "She looks through the iron bars, then settles the flowers higher against her shoulder." }, { "beat_id": "beat.line.Day3.lavinia.result.E.007", "line_id": "line.Day3.lavinia.result.E.007", "revision": "1", "text": "“One cup.”" }, { "beat_id": "beat.line.Day3.lavinia.result.E.008", "line_id": "line.Day3.lavinia.result.E.008", "revision": "1", "text": "At the narrow café table, four chairs fit badly; Lavinia draws hers flush against mine and lays the white bouquet across her knees so the paper rim rises above the tabletop." }, { "beat_id": "beat.line.Day3.lavinia.result.E.009", "line_id": "line.Day3.lavinia.result.E.009", "revision": "1", "text": "“You\'ll have to look around them,” she says." }, { "beat_id": "beat.line.Day3.lavinia.result.E.010", "line_id": "line.Day3.lavinia.result.E.010", "revision": "1", "text": "“I have been.”" }, { "beat_id": "beat.line.Day3.lavinia.result.E.011", "line_id": "line.Day3.lavinia.result.E.011", "revision": "1", "text": "A place beside me, even in company." }, { "beat_id": "beat.line.Day3.lavinia.result.E.012", "line_id": "line.Day3.lavinia.result.E.012", "revision": "1", "text": "Someone is listening." }, { "beat_id": "beat.line.Day3.lavinia.result.E.013", "line_id": "line.Day3.lavinia.result.E.013", "revision": "1", "text": "None of the faces around this table. Somewhere the eyes cannot place." }, { "beat_id": "beat.line.Day3.lavinia.result.E.014", "line_id": "line.Day3.lavinia.result.E.014", "revision": "1", "text": "You." }, { "beat_id": "beat.line.Day3.lavinia.result.E.015", "line_id": "line.Day3.lavinia.result.E.015", "revision": "1", "text": "The wish to bring her here was mine. It remains mine." }, { "beat_id": "beat.line.Day3.lavinia.result.E.016", "line_id": "line.Day3.lavinia.result.E.016", "revision": "1", "text": "The porcelain cup turns once beneath the fingertips." }, { "beat_id": "beat.line.Day3.lavinia.result.E.017", "line_id": "line.Day3.lavinia.result.E.017", "revision": "1", "text": "What, exactly, have you been waiting to see?" }] }, { "entry_id": "Day3.sylvia", "lines": [{ "beat_id": "beat.line.Day3.sylvia.001", "line_id": "line.Day3.sylvia.001", "revision": "1", "text": "“I\'ll come with you.”" }, { "beat_id": "beat.line.Day3.sylvia.002", "line_id": "line.Day3.sylvia.002", "revision": "1", "text": "“And Lavinia?”" }, { "beat_id": "beat.line.Day3.sylvia.003", "line_id": "line.Day3.sylvia.003", "revision": "1", "text": "“I\'ll tell her now.”" }, { "beat_id": "beat.line.Day3.sylvia.004", "line_id": "line.Day3.sylvia.004", "revision": "1", "text": "With one hand still warm inside Sylvia\'s coat pocket, the other hand sends the message: I\'m spending the evening with Sylvia. I won\'t be at the library at six. Sorry for the late change." }, { "beat_id": "beat.line.Day3.sylvia.005", "line_id": "line.Day3.sylvia.005", "revision": "1", "text": "Sylvia keeps my hand inside her pocket all the way up the hill stairs." }, { "beat_id": "beat.line.Day3.sylvia.006", "line_id": "line.Day3.sylvia.006", "revision": "1", "text": "In the quiet north room, the overhead lights are off; only the glass display case in the center is lit. Inside sits the cross-section model of a pale three-storey house—every window dark except for a tiny amber bulb in the attic and a two-inch painted figure wedged between an upstairs sill and the drainpipe." }, { "beat_id": "beat.line.Day3.sylvia.007", "line_id": "line.Day3.sylvia.007", "revision": "1", "text": "“All those rooms,” I say, “and it stays by the pipe.”" }, { "beat_id": "beat.line.Day3.sylvia.008", "line_id": "line.Day3.sylvia.008", "revision": "1", "text": "“Perhaps it likes the view.”" }, { "beat_id": "beat.line.Day3.sylvia.009", "line_id": "line.Day3.sylvia.009", "revision": "1", "text": "“The rent must be reasonable.”" }, { "beat_id": "beat.line.Day3.sylvia.010", "line_id": "line.Day3.sylvia.010", "revision": "1", "text": "Sylvia laughs; our reflections overlap on the glass panel." }, { "beat_id": "beat.line.Day3.sylvia.011", "line_id": "line.Day3.sylvia.011", "revision": "1", "text": "Along the front of the case runs a row of folding wooden viewing stools. Sylvia pulls the end stool down. Before she has slipped her coat off one shoulder, the wooden seat snaps back up with a hollow knock against the back of her knees." }, { "beat_id": "beat.line.Day3.sylvia.012", "line_id": "line.Day3.sylvia.012", "revision": "1", "text": "“Help,” she says." }, { "beat_id": "beat.line.Day3.sylvia.013", "line_id": "line.Day3.sylvia.013", "revision": "1", "text": "One hand holds the wooden seat flat while the other takes the coat from her shoulder." }, { "beat_id": "beat.line.Day3.sylvia.014", "line_id": "line.Day3.sylvia.014", "revision": "1", "text": "“Thank you.”" }, { "beat_id": "beat.line.Day3.sylvia.015", "line_id": "line.Day3.sylvia.015", "revision": "1", "text": "She sits, drawing the coat across both our laps the way she did on the gallery bench, her shoulder resting warm against mine." }, { "beat_id": "beat.line.Day3.sylvia.016", "line_id": "line.Day3.sylvia.016", "revision": "1", "text": "Behind the glass in front of us, the cross-section house glows softly: miniature staircases, paper-thin doors, and in the ground-floor hall, a tiny open cupboard under the stairs where a second painted figure stands behind a half-shut door." }, { "beat_id": "beat.line.Day3.sylvia.017", "line_id": "line.Day3.sylvia.017", "revision": "1", "text": "“A terrible place to hide,” I murmur." }, { "beat_id": "beat.line.Day3.sylvia.018", "line_id": "line.Day3.sylvia.018", "revision": "1", "text": "“I\'d live in the cupboard,” Sylvia whispers." }, { "beat_id": "beat.line.Day3.sylvia.019", "line_id": "line.Day3.sylvia.019", "revision": "1", "text": "“No one would find you.”" }, { "beat_id": "beat.line.Day3.sylvia.020", "line_id": "line.Day3.sylvia.020", "revision": "1", "text": "“You wouldn\'t have to look very hard.”" }, { "beat_id": "beat.line.Day3.sylvia.021", "line_id": "line.Day3.sylvia.021", "revision": "1", "text": "Under the shared coat across our knees, her hand finds mine, slides her fingers across the palm, and settles there." }, { "beat_id": "beat.line.Day3.sylvia.022", "line_id": "line.Day3.sylvia.022", "revision": "1", "text": "Inside the miniature house, the tiny bulb on the landing brightens by a step, throwing a thread of yellow light across the painted cupboard door." }, { "beat_id": "beat.line.Day3.sylvia.023", "line_id": "line.Day3.sylvia.023", "revision": "1", "text": "Sylvia leans half an inch closer to the glass. Her lips part slightly; her eyes follow the miniature staircase as if someone were about to come down it, her hand resting forgotten in mine." }, { "beat_id": "beat.line.Day3.sylvia.024", "line_id": "line.Day3.sylvia.024", "revision": "1", "text": "A stool beside her in the dark. Anyone could have sat here." }, { "beat_id": "beat.line.Day3.sylvia.025", "line_id": "line.Day3.sylvia.025", "revision": "1", "text": "“Sylvia.”" }, { "beat_id": "beat.line.Day3.sylvia.026", "line_id": "line.Day3.sylvia.026", "revision": "1", "text": "“Mm?”" }, { "beat_id": "beat.line.Day3.sylvia.027", "line_id": "line.Day3.sylvia.027", "revision": "1", "text": "Step in front of the glass so she has to look at me instead." }] }, { "entry_id": "Day3.sylvia.result.A", "lines": [{ "beat_id": "beat.line.Day3.sylvia.result.A.001", "line_id": "line.Day3.sylvia.result.A.001", "revision": "1", "text": "“Come out to the balcony for a minute. When the light cycle finishes.”" }, { "beat_id": "beat.line.Day3.sylvia.result.A.002", "line_id": "line.Day3.sylvia.result.A.002", "revision": "1", "text": "“Let the attic bulb come on first.”" }, { "beat_id": "beat.line.Day3.sylvia.result.A.003", "line_id": "line.Day3.sylvia.result.A.003", "revision": "1", "text": "The tiny landing light dims; three seconds later, the attic window goes dark. Sylvia lifts our joined hands." }, { "beat_id": "beat.line.Day3.sylvia.result.A.004", "line_id": "line.Day3.sylvia.result.A.004", "revision": "1", "text": "“Now?”" }, { "beat_id": "beat.line.Day3.sylvia.result.A.005", "line_id": "line.Day3.sylvia.result.A.005", "revision": "1", "text": "“Now.”" }, { "beat_id": "beat.line.Day3.sylvia.result.A.006", "line_id": "line.Day3.sylvia.result.A.006", "revision": "1", "text": "Outside in the cool corridor, she leans one shoulder against the wall." }, { "beat_id": "beat.line.Day3.sylvia.result.A.007", "line_id": "line.Day3.sylvia.result.A.007", "revision": "1", "text": "“What did you want to show me?”" }, { "beat_id": "beat.line.Day3.sylvia.result.A.008", "line_id": "line.Day3.sylvia.result.A.008", "revision": "1", "text": "“Nothing in the case.”" }, { "beat_id": "beat.line.Day3.sylvia.result.A.009", "line_id": "line.Day3.sylvia.result.A.009", "revision": "1", "text": "“I was comfortable on that stool.”" }, { "beat_id": "beat.line.Day3.sylvia.result.A.010", "line_id": "line.Day3.sylvia.result.A.010", "revision": "1", "text": "“Only after I held it down.”" }, { "beat_id": "beat.line.Day3.sylvia.result.A.011", "line_id": "line.Day3.sylvia.result.A.011", "revision": "1", "text": "She offers her arm; we step back inside before the miniature house lights begin their next cycle." }] }, { "entry_id": "Day3.sylvia.result.B", "lines": [{ "beat_id": "beat.line.Day3.sylvia.result.B.001", "line_id": "line.Day3.sylvia.result.B.001", "revision": "1", "text": "“Nothing.”" }, { "beat_id": "beat.line.Day3.sylvia.result.B.002", "line_id": "line.Day3.sylvia.result.B.002", "revision": "1", "text": "Sylvia glances sideways, then back at the lit cross-section house." }, { "beat_id": "beat.line.Day3.sylvia.result.B.003", "line_id": "line.Day3.sylvia.result.B.003", "revision": "1", "text": "“You nearly made me miss the timer.”" }, { "beat_id": "beat.line.Day3.sylvia.result.B.004", "line_id": "line.Day3.sylvia.result.B.004", "revision": "1", "text": "Her fingers tighten once around my palm, then relax. For ten minutes the tiny bulbs inside the miniature rooms switch on and off in sequence—attic, landing, under-stair cupboard—while her little finger stays hooked against mine under the shared coat." }] }, { "entry_id": "Day3.sylvia.result.C", "lines": [{ "beat_id": "beat.line.Day3.sylvia.result.C.001", "line_id": "line.Day3.sylvia.result.C.001", "revision": "1", "text": "“Come out into the corridor with me for a minute.”" }, { "beat_id": "beat.line.Day3.sylvia.result.C.002", "line_id": "line.Day3.sylvia.result.C.002", "revision": "1", "text": "“Why?”" }, { "beat_id": "beat.line.Day3.sylvia.result.C.003", "line_id": "line.Day3.sylvia.result.C.003", "revision": "1", "text": "“I\'d rather talk to you than look at a wooden house.”" }, { "beat_id": "beat.line.Day3.sylvia.result.C.004", "line_id": "line.Day3.sylvia.result.C.004", "revision": "1", "text": "Sylvia looks from the lit miniature staircase to my mouth, then smiles." }, { "beat_id": "beat.line.Day3.sylvia.result.C.005", "line_id": "line.Day3.sylvia.result.C.005", "revision": "1", "text": "“All right.”" }, { "beat_id": "beat.line.Day3.sylvia.result.C.006", "line_id": "line.Day3.sylvia.result.C.006", "revision": "1", "text": "In the quiet corridor outside the door, she leans beside the window." }, { "beat_id": "beat.line.Day3.sylvia.result.C.007", "line_id": "line.Day3.sylvia.result.C.007", "revision": "1", "text": "“Well?”" }, { "beat_id": "beat.line.Day3.sylvia.result.C.008", "line_id": "line.Day3.sylvia.result.C.008", "revision": "1", "text": "“I like being out with you.”" }, { "beat_id": "beat.line.Day3.sylvia.result.C.009", "line_id": "line.Day3.sylvia.result.C.009", "revision": "1", "text": "“You cancelled a walk to tell me that in a hallway.”" }, { "beat_id": "beat.line.Day3.sylvia.result.C.010", "line_id": "line.Day3.sylvia.result.C.010", "revision": "1", "text": "“The lighting is better out here.”" }, { "beat_id": "beat.line.Day3.sylvia.result.C.011", "line_id": "line.Day3.sylvia.result.C.011", "revision": "1", "text": "She laughs softly and opens her palm beside mine." }, { "beat_id": "beat.line.Day3.sylvia.result.C.012", "line_id": "line.Day3.sylvia.result.C.012", "revision": "1", "text": "“We can walk the long way back when the building closes,” she says." }, { "beat_id": "beat.line.Day3.sylvia.result.C.013", "line_id": "line.Day3.sylvia.result.C.013", "revision": "1", "text": "After the building closes. There is an after." }] }, { "entry_id": "Day3.sylvia.result.D", "lines": [{ "beat_id": "beat.line.Day3.sylvia.result.D.001", "line_id": "line.Day3.sylvia.result.D.001", "revision": "1", "text": "“Come outside with me.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.002", "line_id": "line.Day3.sylvia.result.D.002", "revision": "1", "text": "“Wait until the landing light changes.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.003", "line_id": "line.Day3.sylvia.result.D.003", "revision": "1", "text": "“Now.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.004", "line_id": "line.Day3.sylvia.result.D.004", "revision": "1", "text": "The hand pulls free of hers. The folding stool snaps up behind the knees as two steps carry me into the narrow space directly between her stool and the illuminated glass case." }, { "beat_id": "beat.line.Day3.sylvia.result.D.005", "line_id": "line.Day3.sylvia.result.D.005", "revision": "1", "text": "My coat blocks the cross-section house completely, throwing a dark rectangle across her knees and glasses." }, { "beat_id": "beat.line.Day3.sylvia.result.D.006", "line_id": "line.Day3.sylvia.result.D.006", "revision": "1", "text": "Sylvia tilts her head back to look up." }, { "beat_id": "beat.line.Day3.sylvia.result.D.007", "line_id": "line.Day3.sylvia.result.D.007", "revision": "1", "text": "“Sit down, Priscilla.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.008", "line_id": "line.Day3.sylvia.result.D.008", "revision": "1", "text": "“I didn\'t cancel six o\'clock to watch you look at someone else.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.009", "line_id": "line.Day3.sylvia.result.D.009", "revision": "1", "text": "Her eyes stay on my face for a full beat." }, { "beat_id": "beat.line.Day3.sylvia.result.D.010", "line_id": "line.Day3.sylvia.result.D.010", "revision": "1", "text": "“The two-inch man in the cupboard?”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.011", "line_id": "line.Day3.sylvia.result.D.011", "revision": "1", "text": "“Come outside.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.012", "line_id": "line.Day3.sylvia.result.D.012", "revision": "1", "text": "The light from the miniature house behind my back catches the corner of Sylvia\'s mouth. She takes her coat, stands sideways off the stool, and walks out into the corridor." }, { "beat_id": "beat.line.Day3.sylvia.result.D.013", "line_id": "line.Day3.sylvia.result.D.013", "revision": "1", "text": "As the door swings shut behind us, she turns and pushes her coat into my hands." }, { "beat_id": "beat.line.Day3.sylvia.result.D.014", "line_id": "line.Day3.sylvia.result.D.014", "revision": "1", "text": "“Hold that.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.015", "line_id": "line.Day3.sylvia.result.D.015", "revision": "1", "text": "She smooths her cardigan cuff—and then laughs, a short, clear sound against the quiet wall." }, { "beat_id": "beat.line.Day3.sylvia.result.D.016", "line_id": "line.Day3.sylvia.result.D.016", "revision": "1", "text": "“What?”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.017", "line_id": "line.Day3.sylvia.result.D.017", "revision": "1", "text": "“You stood in front of a wooden model.” She shakes her head, still smiling. “You looked ridiculous.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.018", "line_id": "line.Day3.sylvia.result.D.018", "revision": "1", "text": "“You were looking at it.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.019", "line_id": "line.Day3.sylvia.result.D.019", "revision": "1", "text": "“I couldn\'t see anything else with your coat in the way.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.020", "line_id": "line.Day3.sylvia.result.D.020", "revision": "1", "text": "“Stay out here a minute.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.021", "line_id": "line.Day3.sylvia.result.D.021", "revision": "1", "text": "The laugh stops. She takes her coat back slowly, without taking her eyes off mine." }, { "beat_id": "beat.line.Day3.sylvia.result.D.022", "line_id": "line.Day3.sylvia.result.D.022", "revision": "1", "text": "“If you\'re going to interrupt the whole evening, Priscilla, you\'d better have something else prepared.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.023", "line_id": "line.Day3.sylvia.result.D.023", "revision": "1", "text": "“I don\'t.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.024", "line_id": "line.Day3.sylvia.result.D.024", "revision": "1", "text": "“Then you\'d better hold my attention.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.025", "line_id": "line.Day3.sylvia.result.D.025", "revision": "1", "text": "“How?”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.026", "line_id": "line.Day3.sylvia.result.D.026", "revision": "1", "text": "“Something better than the little house.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.027", "line_id": "line.Day3.sylvia.result.D.027", "revision": "1", "text": "Nothing prepared." }, { "beat_id": "beat.line.Day3.sylvia.result.D.028", "line_id": "line.Day3.sylvia.result.D.028", "revision": "1", "text": "Her smile widens. She steps under the corridor lamp and slides her right hand back into mine—palm to palm, her thumb pressing steadily against the inside of my wrist, leaving a faint grey trace of afternoon pencil lead directly over the pulse." }, { "beat_id": "beat.line.Day3.sylvia.result.D.029", "line_id": "line.Day3.sylvia.result.D.029", "revision": "1", "text": "“There,” she says softly. “Now look.”" }, { "beat_id": "beat.line.Day3.sylvia.result.D.030", "line_id": "line.Day3.sylvia.result.D.030", "revision": "1", "text": "Behind the closed door, the timer relay clicks and the miniature house resets in the dark. Her eyes do not leave mine." }] }, { "entry_id": "Day3.sylvia.result.E", "lines": [{ "beat_id": "beat.line.Day3.sylvia.result.E.001", "line_id": "line.Day3.sylvia.result.E.001", "revision": "1", "text": "“Come out into the corridor with me for a minute.”" }, { "beat_id": "beat.line.Day3.sylvia.result.E.002", "line_id": "line.Day3.sylvia.result.E.002", "revision": "1", "text": "“Why?”" }, { "beat_id": "beat.line.Day3.sylvia.result.E.003", "line_id": "line.Day3.sylvia.result.E.003", "revision": "1", "text": "“I\'d rather talk to you than look at a wooden house.”" }, { "beat_id": "beat.line.Day3.sylvia.result.E.004", "line_id": "line.Day3.sylvia.result.E.004", "revision": "1", "text": "Sylvia looks from the lit miniature staircase to my mouth, then smiles." }, { "beat_id": "beat.line.Day3.sylvia.result.E.005", "line_id": "line.Day3.sylvia.result.E.005", "revision": "1", "text": "“All right.”" }, { "beat_id": "beat.line.Day3.sylvia.result.E.006", "line_id": "line.Day3.sylvia.result.E.006", "revision": "1", "text": "In the quiet corridor outside the door, she leans beside the window." }, { "beat_id": "beat.line.Day3.sylvia.result.E.007", "line_id": "line.Day3.sylvia.result.E.007", "revision": "1", "text": "“Well?”" }, { "beat_id": "beat.line.Day3.sylvia.result.E.008", "line_id": "line.Day3.sylvia.result.E.008", "revision": "1", "text": "“I like being out with you.”" }, { "beat_id": "beat.line.Day3.sylvia.result.E.009", "line_id": "line.Day3.sylvia.result.E.009", "revision": "1", "text": "“You cancelled a walk to tell me that in a hallway.”" }, { "beat_id": "beat.line.Day3.sylvia.result.E.010", "line_id": "line.Day3.sylvia.result.E.010", "revision": "1", "text": "“The lighting is better out here.”" }, { "beat_id": "beat.line.Day3.sylvia.result.E.011", "line_id": "line.Day3.sylvia.result.E.011", "revision": "1", "text": "She laughs softly and opens her palm beside mine." }, { "beat_id": "beat.line.Day3.sylvia.result.E.012", "line_id": "line.Day3.sylvia.result.E.012", "revision": "1", "text": "“We can walk the long way back when the building closes,” she says." }, { "beat_id": "beat.line.Day3.sylvia.result.E.013", "line_id": "line.Day3.sylvia.result.E.013", "revision": "1", "text": "After the building closes. There is an after." }, { "beat_id": "beat.line.Day3.sylvia.result.E.014", "line_id": "line.Day3.sylvia.result.E.014", "revision": "1", "text": "Someone else is watching." }, { "beat_id": "beat.line.Day3.sylvia.result.E.015", "line_id": "line.Day3.sylvia.result.E.015", "revision": "1", "text": "Not from the stairwell, and not from behind the glass. A certainty that belongs to no footstep in the building." }, { "beat_id": "beat.line.Day3.sylvia.result.E.016", "line_id": "line.Day3.sylvia.result.E.016", "revision": "1", "text": "You." }, { "beat_id": "beat.line.Day3.sylvia.result.E.017", "line_id": "line.Day3.sylvia.result.E.017", "revision": "1", "text": "You turned the page of her sketchbook in a room with no wind. You waited to see whether I would leave the library gate empty for this hill." }, { "beat_id": "beat.line.Day3.sylvia.result.E.018", "line_id": "line.Day3.sylvia.result.E.018", "revision": "1", "text": "The glass panel gives back only two coats under the lamp." }] }, { "entry_id": "Day4", "lines": [{ "beat_id": "beat.line.Day4.one", "line_id": "line.Day4.one", "revision": "1", "text": "In the rehearsal room next door, a practice piano plays a slow four-bar phrase, pauses to correct a chord, and begins the same four notes again." }, { "beat_id": "beat.line.Day4.002", "line_id": "line.Day4.002", "revision": "1", "text": "Outside Studio B, the heavy door is ajar by less than an inch. Over the piano next door, two voices are talking near the wooden bench—unhurried, mid-conversation." }, { "beat_id": "beat.line.Day4.003", "line_id": "line.Day4.003", "revision": "1", "text": "“...you\'ve made the chin too square.”" }, { "beat_id": "beat.line.Day4.004", "line_id": "line.Day4.004", "revision": "1", "text": "“Then stop moving your head when you talk.”" }, { "beat_id": "beat.line.Day4.005", "line_id": "line.Day4.005", "revision": "1", "text": "“I wasn\'t talking. I was breathing.”" }, { "beat_id": "beat.line.Day4.006", "line_id": "line.Day4.006", "revision": "1", "text": "“Do less of that for thirty seconds.”" }, { "beat_id": "beat.line.Day4.007", "line_id": "line.Day4.007", "revision": "1", "text": "A short, genuine laugh from the floorboards—Lavinia\'s—followed by the dry rustle of heavy paper closing." }, { "beat_id": "beat.line.Day4.008", "line_id": "line.Day4.008", "revision": "1", "text": "“I\'ll bring the rest on Friday,” the other voice says quietly." }, { "beat_id": "beat.line.Day4.009", "line_id": "line.Day4.009", "revision": "1", "text": "When the main door swings inward under the hand a moment later, the far side door by the dressing passage is just settling into its frame with a soft click." }, { "beat_id": "beat.line.Day4.010", "line_id": "line.Day4.010", "revision": "1", "text": "On the narrow wooden ledge beside the bench stands a low glass jar of water. White flowers sit inside it, their heads just above the rim." }, { "beat_id": "beat.line.Day4.011", "line_id": "line.Day4.011", "revision": "1", "text": "Lavinia sits on the rosin-warmed floorboards with her back resting against the front of the low wooden bench, both legs stretched out loosely in front of her." }, { "beat_id": "beat.line.Day4.012", "line_id": "line.Day4.012", "revision": "1", "text": "When the space on the bench behind her is taken, she leans the back of her head directly against my knee and reaches up for the paper cup." }, { "beat_id": "beat.line.Day4.013", "line_id": "line.Day4.013", "revision": "1", "text": "Her fingers close around the warm cardboard." }, { "beat_id": "beat.line.Day4.014", "line_id": "line.Day4.014", "revision": "1", "text": "“That isn\'t iced.”" }, { "beat_id": "beat.line.Day4.015", "line_id": "line.Day4.015", "revision": "1", "text": "“The ice machine in the canteen was being cleaned.”" }, { "beat_id": "beat.line.Day4.016", "line_id": "line.Day4.016", "revision": "1", "text": "“In October.”" }, { "beat_id": "beat.line.Day4.017", "line_id": "line.Day4.017", "revision": "1", "text": "“They clean it on Thursdays.”" }, { "beat_id": "beat.line.Day4.018", "line_id": "line.Day4.018", "revision": "1", "text": "“You\'re a terrible liar when you don\'t need to be.”" }, { "beat_id": "beat.line.Day4.019", "line_id": "line.Day4.019", "revision": "1", "text": "“You\'re drinking it.”" }, { "beat_id": "beat.line.Day4.020", "line_id": "line.Day4.020", "revision": "1", "text": "“Because my hands are cold.” She takes a slow mouthful over the rim, her head still resting against the wool of my skirt, and glances sideways at the open canvas bag beside my shoe. A paperback protrudes from the top, a strip of paper marking the middle pages." }, { "beat_id": "beat.line.Day4.021", "line_id": "line.Day4.021", "revision": "1", "text": "Without asking, her free hand reaches into the bag, draws the book out, and opens it to the marker." }, { "beat_id": "beat.line.Day4.022", "line_id": "line.Day4.022", "revision": "1", "text": "“Page eighty,” she says, tilting the leaf toward the window light. “Read the part you underlined twice.”" }, { "beat_id": "beat.line.Day4.023", "line_id": "line.Day4.023", "revision": "1", "text": "“It\'s for tomorrow\'s seminar.”" }, { "beat_id": "beat.line.Day4.024", "line_id": "line.Day4.024", "revision": "1", "text": "“You underlined it twice because you were pleased with your own point. Start from the top.” She settles the back of her neck more comfortably against my knee and watches my reflection in the wall-length mirror across the floorboards." }, { "beat_id": "beat.line.Day4.025", "line_id": "line.Day4.025", "revision": "1", "text": "Looking down at the page over her shoulder, I begin reading." }, { "beat_id": "beat.line.Day4.026", "line_id": "line.Day4.026", "revision": "1", "text": "By the fourth sentence, the footnote at the bottom of the page is clearly wrong about the heroine\'s motive, and it takes three more sentences to explain why the author ruined the chapter by making her apologize too soon." }, { "beat_id": "beat.line.Day4.027", "line_id": "line.Day4.027", "revision": "1", "text": "In the mirror across the room, Lavinia is no longer looking at the paperback; she is watching my mouth." }, { "beat_id": "beat.line.Day4.028", "line_id": "line.Day4.028", "revision": "1", "text": "When I pause at the margin note, she reaches up without turning her head and takes my free hand, drawing my palm down until it rests against her collarbone above the wool cardigan." }, { "beat_id": "beat.line.Day4.029", "line_id": "line.Day4.029", "revision": "1", "text": "“You still drop the end of the sentence,” she murmurs." }, { "beat_id": "beat.line.Day4.030", "line_id": "line.Day4.030", "revision": "1", "text": "“You still lean back to hear it.”" }, { "beat_id": "beat.line.Day4.031", "line_id": "line.Day4.031", "revision": "1", "text": "“Before I went, I leaned in.”" }, { "beat_id": "beat.line.Day4.032", "line_id": "line.Day4.032", "revision": "1", "text": "“And now?”" }, { "beat_id": "beat.line.Day4.033", "line_id": "line.Day4.033", "revision": "1", "text": "Her thumb passes once across the knuckle of my index finger." }, { "beat_id": "beat.line.Day4.034", "line_id": "line.Day4.034", "revision": "1", "text": "“Keep reading,” she says softly." }, { "beat_id": "beat.line.Day4.035", "line_id": "line.Day4.035", "revision": "1", "text": "Her hand over mine. Not a word about Friday." }, { "beat_id": "beat.line.Day4.036", "line_id": "line.Day4.036", "revision": "1", "text": "“It\'s warm in here,” Lavinia says, releasing my hand only to slip her wool cardigan off her shoulders." }, { "beat_id": "beat.line.Day4.037", "line_id": "line.Day4.037", "revision": "1", "text": "As she shifts sideways to lay the cardigan on the bench, the late-afternoon light catches a dark shadow along the pale rib-seam of her practice bodice just above the left hip." }, { "beat_id": "beat.line.Day4.038", "line_id": "line.Day4.038", "revision": "1", "text": "At first glance it looks like a streak of grey dust from the window sill or the underside of the bench." }, { "beat_id": "beat.line.Day4.039", "line_id": "line.Day4.039", "revision": "1", "text": "Then she leans half an inch toward the mirror, and the shadow separates into four distinct marks." }, { "beat_id": "beat.line.Day4.040", "line_id": "line.Day4.040", "revision": "1", "text": "A wider oval pressed into the wool in front; three narrower lines curving back toward the spine." }, { "beat_id": "beat.line.Day4.041", "line_id": "line.Day4.041", "revision": "1", "text": "A left hand." }, { "beat_id": "beat.line.Day4.042", "line_id": "line.Day4.042", "revision": "1", "text": "And set two inches higher on the ribcage than any dance partner places his hand for a lift—not at the hip bone where weight is taken, but high on the ribs, where someone standing directly in front of the bench would take a sitter\'s waist in her left hand to turn the shoulder toward the window light." }, { "beat_id": "beat.line.Day4.043", "line_id": "line.Day4.043", "revision": "1", "text": "Before Lavinia can lean her head back against my knee, a folded linen handkerchief is already between my fingers, dampened against the warm condensation on the cup lid." }, { "beat_id": "beat.line.Day4.044", "line_id": "line.Day4.044", "revision": "1", "text": "“Hold still,” I say." }, { "beat_id": "beat.line.Day4.045", "line_id": "line.Day4.045", "revision": "1", "text": "“What are you doing?”" }, { "beat_id": "beat.line.Day4.046", "line_id": "line.Day4.046", "revision": "1", "text": "The damp linen presses against the front mark, expecting dry dust to lift off the wool." }, { "beat_id": "beat.line.Day4.047", "line_id": "line.Day4.047", "revision": "1", "text": "It does not lift. Under the wet cloth, the grey mark smears darker—velvety, heavy, and slightly greasy against the pale weave." }, { "beat_id": "beat.line.Day4.048", "line_id": "line.Day4.048", "revision": "1", "text": "Only one person in this building uses soft, unlacquered 4B woodless graphite sticks that coat the heel of the left palm and the inside of the fingers because she dislikes the noise of a pencil sharpener in quiet rooms. Yesterday afternoon in the exhibition room, that exact grey film sat along the side of her thumb when she handed me half a mandarin; twenty minutes ago on these floorboards, she didn\'t even wipe her left hand on her rag before putting her fingers around Lavinia\'s waist." }, { "beat_id": "beat.line.Day4.049", "line_id": "line.Day4.049", "revision": "1", "text": "She held her ribs with the lead still on her skin." }, { "beat_id": "beat.line.Day4.050", "line_id": "line.Day4.050", "revision": "1", "text": "Beneath the thin bodice, the muscle over Lavinia\'s ribs flinches once, then goes taut under the sudden force of my hand." }, { "beat_id": "beat.line.Day4.051", "line_id": "line.Day4.051", "revision": "1", "text": "“There\'s pencil lead on your waist,” I say, my voice dropping half a tone." }, { "beat_id": "beat.line.Day4.052", "line_id": "line.Day4.052", "revision": "1", "text": "“She was turning my shoulder toward the window.”" }, { "beat_id": "beat.line.Day4.053", "line_id": "line.Day4.053", "revision": "1", "text": "“With her bare hand on your ribs?”" }, { "beat_id": "beat.line.Day4.054", "line_id": "line.Day4.054", "revision": "1", "text": "“I kept moving when I breathed.” In the mirror across the floorboards, Lavinia watches the muscle in my jaw tighten—and the corner of her mouth lifts in a slow, deliberate provocation. “Her hands were warm. Unlike yours.”" }, { "beat_id": "beat.line.Day4.055", "line_id": "line.Day4.055", "revision": "1", "text": "The second pass of the damp linen scrubs hard enough to pull the seam of the bodice sideways against her skin. Because the 4B lead is soft and wax-heavy, the wet cloth only drives a faint grey shadow deeper into the pale wool." }, { "beat_id": "beat.line.Day4.056", "line_id": "line.Day4.056", "revision": "1", "text": "Dropping the stained handkerchief onto the bench, I slip my bare right hand directly over the damp waistband of her bodice—pressing my palm flat and hard against her ribs, thumb over the front smudge, fingers spanning the three marks toward her spine, holding her waist still against my knee until my own heat goes all the way through the damp wool into her skin." }, { "beat_id": "beat.line.Day4.057", "line_id": "line.Day4.057", "revision": "1", "text": "Above her collar, Lavinia\'s breath catches audibly." }, { "beat_id": "beat.line.Day4.058", "line_id": "line.Day4.058", "revision": "1", "text": "“That\'s warm enough,” she whispers." }, { "beat_id": "beat.line.Day4.059", "line_id": "line.Day4.059", "revision": "1", "text": "“It was still damp,” I say quietly, not taking my palm off her waist until her ribs rise twice against my hand." }, { "beat_id": "beat.line.Day4.060", "line_id": "line.Day4.060", "revision": "1", "text": "Slowly, she pulls herself up from the floorboards and sits on the wooden bench beside me, leaving me kneeling on the boards by her feet. Her eyes in the mirror are wide and bright." }, { "beat_id": "beat.line.Day4.061", "line_id": "line.Day4.061", "revision": "1", "text": "She reaches into her cardigan pocket, takes out a small tin of honey throat pastilles, and flicks the lid open with her thumb." }, { "beat_id": "beat.line.Day4.062", "line_id": "line.Day4.062", "revision": "1", "text": "One amber square slips over the metal rim, strikes the pleat of her wrap skirt just above the knee, and stays lodged in the hollow of the wool." }, { "beat_id": "beat.line.Day4.063", "line_id": "line.Day4.063", "revision": "1", "text": "Neither of us reaches for it with our fingers." }, { "beat_id": "beat.line.Day4.064", "line_id": "line.Day4.064", "revision": "1", "text": "“You forgot lunch again, didn\'t you?” she says, her voice still slightly breathless." }, { "beat_id": "beat.line.Day4.065", "line_id": "line.Day4.065", "revision": "1", "text": "“I had a biscuit.”" }, { "beat_id": "beat.line.Day4.066", "line_id": "line.Day4.066", "revision": "1", "text": "“That isn\'t lunch.” In the mirror behind her back, her reflected eyes stay locked on the crown of my head. “Go on, then.”" }, { "beat_id": "beat.line.Day4.067", "line_id": "line.Day4.067", "revision": "1", "text": "Take it from her skirt without using the hands." }] }, { "entry_id": "Day4.A", "lines": [{ "beat_id": "beat.line.Day4.A.001", "line_id": "line.Day4.A.001", "revision": "1", "text": "Both hands rest flat on my knees without chasing the shoe under the bench." }, { "beat_id": "beat.line.Day4.A.002", "line_id": "line.Day4.A.002", "revision": "1", "text": "“Did you ask her to tie it, or did you leave the door unlatched so I\'d think she did?”" }, { "beat_id": "beat.line.Day4.A.003", "line_id": "line.Day4.A.003", "revision": "1", "text": "“That isn\'t your business.”" }, { "beat_id": "beat.line.Day4.A.004", "line_id": "line.Day4.A.004", "revision": "1", "text": "“It will blister your tendon before Saturday.”" }, { "beat_id": "beat.line.Day4.A.005", "line_id": "line.Day4.A.005", "revision": "1", "text": "A beat of silence. Then her right foot slides back out from under the bench and stops an inch from my knee." }, { "beat_id": "beat.line.Day4.A.006", "line_id": "line.Day4.A.006", "revision": "1", "text": "“Then tie it properly,” Lavinia says quietly. “Not too tight.”" }, { "beat_id": "beat.line.Day4.A.007", "line_id": "line.Day4.A.007", "revision": "1", "text": "The square knot comes undone; the satin crosses once, tucks flat behind the ankle bone where it belongs, and smooths down. When I sit back on the bench beside her, she leans her shoulder against mine and opens the paperback again." }, { "beat_id": "beat.line.Day4.A.008", "line_id": "line.Day4.A.008", "revision": "1", "text": "“Read the rest of the page,” she says." }] }, { "entry_id": "Day4.B", "lines": [{ "beat_id": "beat.line.Day4.B.001", "line_id": "line.Day4.B.001", "revision": "1", "text": "Fingertips brush the leather heel under the bench, then open and draw back before closing around the arch." }, { "beat_id": "beat.line.Day4.B.002", "line_id": "line.Day4.B.002", "revision": "1", "text": "“If you want a square knot on your tendon, keep it.”" }, { "beat_id": "beat.line.Day4.B.003", "line_id": "line.Day4.B.003", "revision": "1", "text": "In the mirror, Lavinia\'s chin tilts slightly." }, { "beat_id": "beat.line.Day4.B.004", "line_id": "line.Day4.B.004", "revision": "1", "text": "“Stopping there?”" }, { "beat_id": "beat.line.Day4.B.005", "line_id": "line.Day4.B.005", "revision": "1", "text": "“The foot keeps moving.”" }, { "beat_id": "beat.line.Day4.B.006", "line_id": "line.Day4.B.006", "revision": "1", "text": "“You weren\'t so patient with my waist.”" }, { "beat_id": "beat.line.Day4.B.007", "line_id": "line.Day4.B.007", "revision": "1", "text": "Lavinia looks down at the crooked knot for three seconds, then bends, jerks the square knot undone with her own fingers, and reties it flat while her shoulder brushes my knee without telling me to leave." }] }, { "entry_id": "Day4.C", "lines": [{ "beat_id": "beat.line.Day4.C.001", "line_id": "line.Day4.C.001", "revision": "1", "text": "Instead of reaching into the shadow under the bench, my left palm stays open just above the floorboards where her shoe stood a moment ago." }, { "beat_id": "beat.line.Day4.C.002", "line_id": "line.Day4.C.002", "revision": "1", "text": "“You always tie a square knot when you\'re in a hurry,” I say quietly. “Nobody else touched your shoe.”" }, { "beat_id": "beat.line.Day4.C.003", "line_id": "line.Day4.C.003", "revision": "1", "text": "“You sound very certain.”" }, { "beat_id": "beat.line.Day4.C.004", "line_id": "line.Day4.C.004", "revision": "1", "text": "“She ties left-over-right on her welfare packages. That knot is right-over-left.”" }, { "beat_id": "beat.line.Day4.C.005", "line_id": "line.Day4.C.005", "revision": "1", "text": "A short, reluctant breath leaves Lavinia\'s nose—half laugh, half sigh. Her heel slides forward out of the shadow and settles directly into my open palm." }, { "beat_id": "beat.line.Day4.C.006", "line_id": "line.Day4.C.006", "revision": "1", "text": "The leather at the back of the shoe is warm." }, { "beat_id": "beat.line.Day4.C.007", "line_id": "line.Day4.C.007", "revision": "1", "text": "“You\'re insufferable,” she mutters." }, { "beat_id": "beat.line.Day4.C.008", "line_id": "line.Day4.C.008", "revision": "1", "text": "The heel stays cradled in my left palm while my right hand undoes the square knot and folds the satin flat behind the bone. When I lift my head, our eyes meet in the mirror glass behind her shoulder, and she draws me up onto the bench beside her." }] }, { "entry_id": "Day4.D", "lines": [{ "beat_id": "beat.line.Day4.D.001", "line_id": "line.Day4.D.001", "revision": "1", "text": "Before her shoe can settle in the shadow under the bench, five fingers of my left hand lock around the arch and heel, draw her foot out from beneath the seat, and set her heel squarely on top of my own knee." }, { "beat_id": "beat.line.Day4.D.002", "line_id": "line.Day4.D.002", "revision": "1", "text": "In the mirror, Lavinia\'s breath catches; her fingers tighten on the edge of the wooden bench." }, { "beat_id": "beat.line.Day4.D.003", "line_id": "line.Day4.D.003", "revision": "1", "text": "“Let go.”" }, { "beat_id": "beat.line.Day4.D.004", "line_id": "line.Day4.D.004", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day4.D.005", "line_id": "line.Day4.D.005", "revision": "1", "text": "Instead of easing the square knot open, my right hand catches the loose satin end and pulls it once, cleanly—stripping the square knot undone with a dry hiss of ribbon across her skin." }, { "beat_id": "beat.line.Day4.D.006", "line_id": "line.Day4.D.006", "revision": "1", "text": "“She ties her welfare string like that so a parcel won\'t come undone in the post,” I say quietly, my thumb pressing into the warm hollow below her outer ankle bone so she cannot slide her foot a fraction of an inch back. “Leave a square knot over your tendon for ten minutes and it will bruise the skin before you even reach the barre.”" }, { "beat_id": "beat.line.Day4.D.007", "line_id": "line.Day4.D.007", "revision": "1", "text": "“It wasn\'t hurting me,” Lavinia whispers." }, { "beat_id": "beat.line.Day4.D.008", "line_id": "line.Day4.D.008", "revision": "1", "text": "“It was hurting my eyes.”" }, { "beat_id": "beat.line.Day4.D.009", "line_id": "line.Day4.D.009", "revision": "1", "text": "My left palm stays wrapped around the warm tendon above her heel while my right hand crosses the pale satin twice—drawing the ribbon taut against her ankle, half a degree tighter than her usual rehearsal tension so she will feel the pressure of my fingers every time she points her foot—and tucks the flat fold behind the bone where no one else\'s hand can reach it without undoing mine." }, { "beat_id": "beat.line.Day4.D.010", "line_id": "line.Day4.D.010", "revision": "1", "text": "Then, without taking my left hand off her ankle, I rise and plant my right knee directly on the wooden bench between her knees—leaning in until her shoulders meet the cool surface of the wall-length mirror and my right palm presses flat over the damp waistband of her bodice where the four pencil marks were." }, { "beat_id": "beat.line.Day4.D.011", "line_id": "line.Day4.D.011", "revision": "1", "text": "Above my collar, Lavinia does not push my shoulder back. Instead, her right hand comes up and closes against the side of my neck—her fingers curling behind my ear, the pad of her thumb pressing hard into the pulse point just below my jaw." }, { "beat_id": "beat.line.Day4.D.012", "line_id": "line.Day4.D.012", "revision": "1", "text": "In the glass behind her cheek, a small pale circle of condensation forms from her breath." }, { "beat_id": "beat.line.Day4.D.013", "line_id": "line.Day4.D.013", "revision": "1", "text": "“You tied it too tight,” she whispers, her thumb pressing firmer into my throat." }, { "beat_id": "beat.line.Day4.D.014", "line_id": "line.Day4.D.014", "revision": "1", "text": "“You\'ll remember who tied it,” I whisper against the corner of her mouth, my fingers tightening on her waist." }, { "beat_id": "beat.line.Day4.D.015", "line_id": "line.Day4.D.015", "revision": "1", "text": "“And my ribs?” Her eyes blaze two inches from mine. “Are you going to keep your hand there until Friday so she sees it?”" }, { "beat_id": "beat.line.Day4.D.016", "line_id": "line.Day4.D.016", "revision": "1", "text": "“If I have to.”" }, { "beat_id": "beat.line.Day4.D.017", "line_id": "line.Day4.D.017", "revision": "1", "text": "For three full seconds neither of us moves in the mirror—my palm over the erased pencil marks at her waist, my other hand holding her ankle on the bench, her thumb pressed into the pulse at my throat." }, { "beat_id": "beat.line.Day4.D.018", "line_id": "line.Day4.D.018", "revision": "1", "text": "“Ești nebună,” she breathes in Romanian, and then in English: “You\'re completely out of your mind.”" }] }, { "entry_id": "Day4.D.default", "lines": [{ "beat_id": "beat.line.Day4.D.default.001", "line_id": "line.Day4.D.default.001", "revision": "1", "text": "Lavinia\'s thumb slides from my pulse to the back of my jaw, tilting my chin half an inch until her lower lip brushes the corner of mine—warm, sharp with honey from the pastille, neither of us calling it a kiss—before she drops her forehead hard against my collarbone while the mirror holds us both." }, { "beat_id": "beat.line.Day4.D.default.002", "line_id": "line.Day4.D.default.002", "revision": "1", "text": "“Sit down properly before someone walks past the door,” she whispers into my collar, her fingers still twisted in my lapel." }, { "beat_id": "beat.line.Day4.D.default.003", "line_id": "line.Day4.D.default.003", "revision": "1", "text": "When I slide off my knee onto the bench beside her, she does not let go of my hand; she pulls the open paperback across both our laps and sets her finger under the line where we stopped." }, { "beat_id": "beat.line.Day4.D.default.004", "line_id": "line.Day4.D.default.004", "revision": "1", "text": "“Go on,” she says softly, her shoulder pressed flush against mine. “Read.”" }] }, { "entry_id": "Day4.D.friday", "lines": [{ "beat_id": "beat.line.Day4.D.friday.001", "line_id": "line.Day4.D.friday.001", "revision": "1", "text": "“When did she say she was bringing the rest on Friday?” I whisper, my thumb still resting on the turn axis at her waist." }, { "beat_id": "beat.line.Day4.D.friday.002", "line_id": "line.Day4.D.friday.002", "revision": "1", "text": "“Before rehearsal,” Lavinia whispers back, a sudden, dangerous smile curving her mouth two inches from mine." }, { "beat_id": "beat.line.Day4.D.friday.003", "line_id": "line.Day4.D.friday.003", "revision": "1", "text": "“Then I\'ll be here first.”" }, { "beat_id": "beat.line.Day4.D.friday.004", "line_id": "line.Day4.D.friday.004", "revision": "1", "text": "She laughs once against my mouth, her thumb sliding from my throat to my nape as she pulls me down onto the bench beside her." }] }, { "entry_id": "Day4.D.mirror", "lines": [{ "beat_id": "beat.line.Day4.D.mirror.001", "line_id": "line.Day4.D.mirror.001", "revision": "1", "text": "“Turn your head,” I murmur against her temple, keeping my palm warm over the damp wool at her waist. “Look in the glass.”" }, { "beat_id": "beat.line.Day4.D.mirror.002", "line_id": "line.Day4.D.mirror.002", "revision": "1", "text": "Lavinia turns her cheek half an inch against the cool mirror until her eyes meet mine in the reflection behind us—where my coat blocks the rest of the room and only my hand on her ribs is visible." }, { "beat_id": "beat.line.Day4.D.mirror.003", "line_id": "line.Day4.D.mirror.003", "revision": "1", "text": "“Satisfied?” she whispers to the glass." }, { "beat_id": "beat.line.Day4.D.mirror.004", "line_id": "line.Day4.D.mirror.004", "revision": "1", "text": "“Her hand isn\'t there now.”" }, { "beat_id": "beat.line.Day4.D.mirror.005", "line_id": "line.Day4.D.mirror.005", "revision": "1", "text": "Her thumb presses once more against my jaw before she pulls me down onto the bench beside her." }] }, { "entry_id": "Day4.E", "lines": [{ "beat_id": "beat.line.Day4.E.001", "line_id": "line.Day4.E.001", "revision": "1", "text": "Instead of reaching into the shadow under the bench, my left palm stays open just above the floorboards where her shoe stood a moment ago." }, { "beat_id": "beat.line.Day4.E.002", "line_id": "line.Day4.E.002", "revision": "1", "text": "“You always tie a square knot when you\'re in a hurry,” I say quietly. “Nobody else touched your shoe.”" }, { "beat_id": "beat.line.Day4.E.003", "line_id": "line.Day4.E.003", "revision": "1", "text": "“You sound very certain.”" }, { "beat_id": "beat.line.Day4.E.004", "line_id": "line.Day4.E.004", "revision": "1", "text": "“She ties left-over-right on her welfare packages. That knot is right-over-left.”" }, { "beat_id": "beat.line.Day4.E.005", "line_id": "line.Day4.E.005", "revision": "1", "text": "A short, reluctant breath leaves Lavinia\'s nose—half laugh, half sigh. Her heel slides forward out of the shadow and settles directly into my open palm." }, { "beat_id": "beat.line.Day4.E.006", "line_id": "line.Day4.E.006", "revision": "1", "text": "The leather at the back of the shoe is warm." }, { "beat_id": "beat.line.Day4.E.007", "line_id": "line.Day4.E.007", "revision": "1", "text": "“You\'re insufferable,” she mutters." }, { "beat_id": "beat.line.Day4.E.008", "line_id": "line.Day4.E.008", "revision": "1", "text": "The heel stays cradled in my left palm while my right hand undoes the square knot and folds the satin flat behind the bone. When I lift my head, our eyes meet in the mirror glass behind her shoulder, and she draws me up onto the bench beside her." }, { "beat_id": "beat.line.Day4.E.009", "line_id": "line.Day4.E.009", "revision": "1", "text": "In the mirror: the bench, the barre, the white flowers in the glass jar, and the narrow strip of corridor pane behind the door." }, { "beat_id": "beat.line.Day4.E.010", "line_id": "line.Day4.E.010", "revision": "1", "text": "The piano in the next studio stopped minutes ago. Not one shadow has crossed the frosted glass." }, { "beat_id": "beat.line.Day4.E.011", "line_id": "line.Day4.E.011", "revision": "1", "text": "Yet the main door was unlatched by the exact width of a voice when I reached the top of the stairs." }, { "beat_id": "beat.line.Day4.E.012", "line_id": "line.Day4.E.012", "revision": "1", "text": "You." }, { "beat_id": "beat.line.Day4.E.013", "line_id": "line.Day4.E.013", "revision": "1", "text": "Waiting to see whether I would open it early or listen first." }, { "beat_id": "beat.line.Day4.E.014", "line_id": "line.Day4.E.014", "revision": "1", "text": "The paper cup is warm against the lip—the exact spot on the rim where Lavinia drank." }, { "beat_id": "beat.line.Day4.E.015", "line_id": "line.Day4.E.015", "revision": "1", "text": "Stay behind the glass if you like. The pencil marks are already gone." }] }, { "entry_id": "Day4.impulse", "lines": [{ "beat_id": "beat.line.Day4.impulse.001", "line_id": "line.Day4.impulse.001", "revision": "1", "text": "Below the edge of the bench, the pale satin ribbon around Lavinia\'s right ankle has come undone at the cross—tied in an unfamiliar square knot right over the tendon instead of folded flat behind the ankle bone where it belongs, one loose end trailing across the rosin." }, { "beat_id": "beat.line.Day4.impulse.002", "line_id": "line.Day4.impulse.002", "revision": "1", "text": "Kneeling on the floorboards in front of her, I gather both satin ends to untie the square knot." }, { "beat_id": "beat.line.Day4.impulse.003", "line_id": "line.Day4.impulse.003", "revision": "1", "text": "Just as my thumbs touch the cross, her heel slides half a step backward under the bench." }, { "beat_id": "beat.line.Day4.impulse.004", "line_id": "line.Day4.impulse.004", "revision": "1", "text": "The satin slips free." }, { "beat_id": "beat.line.Day4.impulse.005", "line_id": "line.Day4.impulse.005", "revision": "1", "text": "“Careful,” Lavinia says softly, watching the top of my head in the mirror. “You\'ll undo her knot.”" }, { "beat_id": "beat.line.Day4.impulse.006", "line_id": "line.Day4.impulse.006", "revision": "1", "text": "My hands stop dead above the floorboards." }, { "beat_id": "beat.line.Day4.impulse.007", "line_id": "line.Day4.impulse.007", "revision": "1", "text": "In the wall-length glass behind the bench, Lavinia\'s eyes are fixed on my face—waiting to see what that sentence does to me." }, { "beat_id": "beat.line.Day4.impulse.008", "line_id": "line.Day4.impulse.008", "revision": "1", "text": "“You tied this yourself,” I say." }, { "beat_id": "beat.line.Day4.impulse.009", "line_id": "line.Day4.impulse.009", "revision": "1", "text": "“Did I?”" }, { "beat_id": "beat.line.Day4.impulse.010", "line_id": "line.Day4.impulse.010", "revision": "1", "text": "“She doesn\'t know how a ballet ribbon crosses the joint.”" }, { "beat_id": "beat.line.Day4.impulse.011", "line_id": "line.Day4.impulse.011", "revision": "1", "text": "“That\'s why it\'s a square knot,” Lavinia says smoothly, and as my fingers reach for her ankle a second time, she slides her heel another three inches back into the shadow beneath the bench—an awkward angle for her knee, baiting me to chase her foot under the seat. “Leave it. It holds well enough.”" }, { "beat_id": "beat.line.Day4.impulse.012", "line_id": "line.Day4.impulse.012", "revision": "1", "text": "A square knot over the tendon. On her ankle." }, { "beat_id": "beat.line.Day4.impulse.013", "line_id": "line.Day4.impulse.013", "revision": "1", "text": "Hold the heel where it is." }] }, { "entry_id": "Day4.pastille.default", "lines": [{ "beat_id": "beat.line.Day4.pastille.default.001", "line_id": "line.Day4.pastille.default.001", "revision": "1", "text": "Two fingers lift the amber square neatly from the pleat of the skirt and set it on the lid of her tin." }, { "beat_id": "beat.line.Day4.pastille.default.002", "line_id": "line.Day4.pastille.default.002", "revision": "1", "text": "“It didn\'t touch the floor.”" }, { "beat_id": "beat.line.Day4.pastille.default.003", "line_id": "line.Day4.pastille.default.003", "revision": "1", "text": "Lavinia looks at the pastille on the metal lid, then down at my bare hand still resting near her hip." }, { "beat_id": "beat.line.Day4.pastille.default.004", "line_id": "line.Day4.pastille.default.004", "revision": "1", "text": "“Ce păcat,” she says under her breath. “You weren\'t so polite when you had your hand on my ribs.”" }] }, { "entry_id": "Day4.pastille.yes", "lines": [{ "beat_id": "beat.line.Day4.pastille.yes.001", "line_id": "line.Day4.pastille.yes.001", "revision": "1", "text": "Both knees stay on the floorboards between the edge of the bench and her shoes." }, { "beat_id": "beat.line.Day4.pastille.yes.002", "line_id": "line.Day4.pastille.yes.002", "revision": "1", "text": "Lavinia\'s fingers stop on the rim of the open tin." }, { "beat_id": "beat.line.Day4.pastille.yes.003", "line_id": "line.Day4.pastille.yes.003", "revision": "1", "text": "Instead of lifting my hand from the bench, my chin lowers across the wool of the wrap skirt. Beneath the cloth, the tendon at her knee pulls taut for half a breath." }, { "beat_id": "beat.line.Day4.pastille.yes.004", "line_id": "line.Day4.pastille.yes.004", "revision": "1", "text": "My lips brush the fold of the dark wool and take the amber square cleanly. Lemon and sharp honey." }, { "beat_id": "beat.line.Day4.pastille.yes.005", "line_id": "line.Day4.pastille.yes.005", "revision": "1", "text": "Before my head can rise, Lavinia\'s free hand comes down—fingers tangling into the hair at the nape of my neck, holding my face an inch above her knee." }, { "beat_id": "beat.line.Day4.pastille.yes.006", "line_id": "line.Day4.pastille.yes.006", "revision": "1", "text": "“Nu te saturi niciodată,” she murmurs in Romanian." }, { "beat_id": "beat.line.Day4.pastille.yes.007", "line_id": "line.Day4.pastille.yes.007", "revision": "1", "text": "Then, in English, her thumb grazing my right cheekbone:" }, { "beat_id": "beat.line.Day4.pastille.yes.008", "line_id": "line.Day4.pastille.yes.008", "revision": "1", "text": "“All it takes is four marks of pencil on my waist.”" }, { "beat_id": "beat.line.Day4.pastille.yes.009", "line_id": "line.Day4.pastille.yes.009", "revision": "1", "text": "“They\'re gone now.”" }, { "beat_id": "beat.line.Day4.pastille.yes.010", "line_id": "line.Day4.pastille.yes.010", "revision": "1", "text": "“The grey is still on your handkerchief.”" }] }, { "entry_id": "Day5", "lines": [{ "beat_id": "beat.line.Day5.one", "line_id": "line.Day5.one", "revision": "1", "text": "Rain strikes the high louver glass near the ceiling of Room 2.17 in uneven gusts, turning the afternoon light the color of wet slate." }, { "beat_id": "beat.line.Day5.002", "line_id": "line.Day5.002", "revision": "1", "text": "The room is six paces from wall to wall—no eye-level window, only the slanted ceiling louvers streaming with water above and the tall frosted glass pane of the corridor door. Above the doorframe, the metal louver of the ceiling vent hums softly, sending a cool draft across the terrazzo floor toward the door side of the table." }, { "beat_id": "beat.line.Day5.003", "line_id": "line.Day5.003", "revision": "1", "text": "There are two chairs in the room: a curved-back wooden chair standing in the sheltered corner under the warm amber wall lamp, out of the vent draft, and a narrower flat-slat chair on the cold side of the table near the door." }, { "beat_id": "beat.line.Day5.004", "line_id": "line.Day5.004", "revision": "1", "text": "I leave the curved-back chair in the sheltered corner empty and sit on the cold side of the table." }, { "beat_id": "beat.line.Day5.005", "line_id": "line.Day5.005", "revision": "1", "text": "A moment later, the door swings inward. Lavinia steps across the threshold, shaking rain from the collar of her coat." }, { "beat_id": "beat.line.Day5.006", "line_id": "line.Day5.006", "revision": "1", "text": "“You were waiting,” she says." }, { "beat_id": "beat.line.Day5.007", "line_id": "line.Day5.007", "revision": "1", "text": "“I came in early.”" }, { "beat_id": "beat.line.Day5.008", "line_id": "line.Day5.008", "revision": "1", "text": "Before the door latch has settled behind her back, a tall shadow slows outside in the corridor. Through the frosted glass panel, the blurred silhouette of a flat cardboard portfolio rests under a left arm." }, { "beat_id": "beat.line.Day5.009", "line_id": "line.Day5.009", "revision": "1", "text": "No knock comes." }, { "beat_id": "beat.line.Day5.010", "line_id": "line.Day5.010", "revision": "1", "text": "Instead, a left hand rises outside the pane, slips the slotted loop of a white card over the outer brass handle, and smooths the paper flat against the glass before footsteps recede quietly down the hall." }, { "beat_id": "beat.line.Day5.011", "line_id": "line.Day5.011", "revision": "1", "text": "Through the frosted glass, the black lettering floats in reverse at the height of Lavinia\'s shoulder:" }, { "beat_id": "beat.line.Day5.012", "line_id": "line.Day5.012", "revision": "1", "text": "Quiet assessment in progress. Please do not disturb." }, { "beat_id": "beat.line.Day5.013", "line_id": "line.Day5.013", "revision": "1", "text": "Lavinia glances once at the reversed letters on the glass, then looks down at the curved-back wooden chair standing in the warm corner under the wall lamp—and at the plain chair I took in the draft by the door." }, { "beat_id": "beat.line.Day5.014", "line_id": "line.Day5.014", "revision": "1", "text": "Before she sits, two fingertips of her right hand rest for half a second on the top rail of the curved chair back." }, { "beat_id": "beat.line.Day5.015", "line_id": "line.Day5.015", "revision": "1", "text": "Then both of her hands take the chair by its back, lift it clear of the floor, and set it down ninety degrees from the table—facing my chair directly." }, { "beat_id": "beat.line.Day5.016", "line_id": "line.Day5.016", "revision": "1", "text": "When she sits, less than two inches remain between our knees." }, { "beat_id": "beat.line.Day5.017", "line_id": "line.Day5.017", "revision": "1", "text": "“Is the chair comfortable?” I ask." }, { "beat_id": "beat.line.Day5.018", "line_id": "line.Day5.018", "revision": "1", "text": "“It was facing the table.”" }, { "beat_id": "beat.line.Day5.019", "line_id": "line.Day5.019", "revision": "1", "text": "“You changed that.”" }, { "beat_id": "beat.line.Day5.020", "line_id": "line.Day5.020", "revision": "1", "text": "“Yes.”" }, { "beat_id": "beat.line.Day5.021", "line_id": "line.Day5.021", "revision": "1", "text": "From her chosen angle, the programme folder on the desk cannot be read without turning her head away from my face." }, { "beat_id": "beat.line.Day5.022", "line_id": "line.Day5.022", "revision": "1", "text": "The chair stays where she set it; only the folder moves—lifted across the corner of the table into her direct line of sight." }, { "beat_id": "beat.line.Day5.023", "line_id": "line.Day5.023", "revision": "1", "text": "“You move everything,” Lavinia says." }, { "beat_id": "beat.line.Day5.024", "line_id": "line.Day5.024", "revision": "1", "text": "“Only the folder.”" }, { "beat_id": "beat.line.Day5.025", "line_id": "line.Day5.025", "revision": "1", "text": "Outside in the corridor, two sets of footsteps approach the door. Their tall, headless shadows stretch through the frosted glass across the ceiling and slide down the wall behind Lavinia\'s throat—slowing beside the reversed white card on the handle, dropping to a murmur, and passing on." }, { "beat_id": "beat.line.Day5.026", "line_id": "line.Day5.026", "revision": "1", "text": "Inside the six-pace room, Lavinia picks up the red pencil. For a while the only sound under the rain is the turn of paper as we check the staging sequence—where my draft shortened the transition walk from the wings so she does not cross the full diagonal before the variation." }, { "beat_id": "beat.line.Day5.027", "line_id": "line.Day5.027", "revision": "1", "text": "Lavinia\'s eyes linger on that shortened stage-cross note for a beat. She does not object to it. Instead, the tip of her red pencil stops two lines lower, beneath the sentence describing the performance for visitors." }, { "beat_id": "beat.line.Day5.028", "line_id": "line.Day5.028", "revision": "1", "text": "“You wrote will,” she says, striking a single red line through the word." }, { "beat_id": "beat.line.Day5.029", "line_id": "line.Day5.029", "revision": "1", "text": "“You crossed it out.”" }, { "beat_id": "beat.line.Day5.030", "line_id": "line.Day5.030", "revision": "1", "text": "“I noticed.”" }, { "beat_id": "beat.line.Day5.031", "line_id": "line.Day5.031", "revision": "1", "text": "“There are two more,” I say, touching a fingertip to the lower margin instead of taking the pencil from her hand." }, { "beat_id": "beat.line.Day5.032", "line_id": "line.Day5.032", "revision": "1", "text": "Lavinia looks from my finger to my face, then draws two clean red lines through the remaining modal verbs. By the bottom of the sheet, the page holds a third version that neither of us would have written alone." }, { "beat_id": "beat.line.Day5.033", "line_id": "line.Day5.033", "revision": "1", "text": "As Lavinia sets the red pencil down, the cuff of her cardigan brushes a black pen lying at the upper edge of the desk blotter." }, { "beat_id": "beat.line.Day5.034", "line_id": "line.Day5.034", "revision": "1", "text": "Pinned beneath the barrel is a small square of yellow paper, folded once on a slight left-handed diagonal and pressed flat with the side of a thumbnail." }, { "beat_id": "beat.line.Day5.035", "line_id": "line.Day5.035", "revision": "1", "text": "When Lavinia\'s sleeve shifts the pen, the yellow fold springs half-open against the wood." }, { "beat_id": "beat.line.Day5.036", "line_id": "line.Day5.036", "revision": "1", "text": "Inside, in Sylvia\'s neat, upright hand, are two lines:" }, { "beat_id": "beat.line.Day5.037", "line_id": "line.Day5.037", "revision": "1", "text": "I moved the curved chair out of the vent draft. That corner stays warmer." }, { "beat_id": "beat.line.Day5.038", "line_id": "line.Day5.038", "revision": "1", "text": "My hand stops on the edge of the folder." }, { "beat_id": "beat.line.Day5.039", "line_id": "line.Day5.039", "revision": "1", "text": "Lavinia\'s fingers rest on the barrel of the black pen. She reads the two lines once, looks down at the curved wooden arm under her elbow, and then looks across at my chair in the cold draft by the door." }, { "beat_id": "beat.line.Day5.040", "line_id": "line.Day5.040", "revision": "1", "text": "“You didn\'t move this chair,” she says quietly." }, { "beat_id": "beat.line.Day5.041", "line_id": "line.Day5.041", "revision": "1", "text": "“It was there when I came in.”" }, { "beat_id": "beat.line.Day5.042", "line_id": "line.Day5.042", "revision": "1", "text": "“And you took the other one.”" }, { "beat_id": "beat.line.Day5.043", "line_id": "line.Day5.043", "revision": "1", "text": "Without lifting her eyes from mine, Lavinia\'s thumb nudges the black pen across the polished wood—pushing the folded yellow slip ahead of the barrel, half an inch, another inch—until both the pen and the yellow note slide over the far edge of the desk and drop into the wastepaper basket beside the table leg." }, { "beat_id": "beat.line.Day5.044", "line_id": "line.Day5.044", "revision": "1", "text": "“The red pencil works better,” she says evenly." }, { "beat_id": "beat.line.Day5.045", "line_id": "line.Day5.045", "revision": "1", "text": "Before my hand can move toward the basket, her other hand draws her phone from her coat pocket." }, { "beat_id": "beat.line.Day5.046", "line_id": "line.Day5.046", "revision": "1", "text": "The camera shutter clicks once in the six-pace room." }, { "beat_id": "beat.line.Day5.047", "line_id": "line.Day5.047", "revision": "1", "text": "“Don\'t.”" }, { "beat_id": "beat.line.Day5.048", "line_id": "line.Day5.048", "revision": "1", "text": "“You took mine on Monday\'s screen.”" }, { "beat_id": "beat.line.Day5.049", "line_id": "line.Day5.049", "revision": "1", "text": "“That was Sylvia\'s phone.”" }, { "beat_id": "beat.line.Day5.050", "line_id": "line.Day5.050", "revision": "1", "text": "“And this is mine.”" }, { "beat_id": "beat.line.Day5.051", "line_id": "line.Day5.051", "revision": "1", "text": "The small rectangle of light tilts toward her chin—reflected twice in the dark, rain-streaked louver panes near the ceiling." }, { "beat_id": "beat.line.Day5.052", "line_id": "line.Day5.052", "revision": "1", "text": "“Delete it,” I say." }, { "beat_id": "beat.line.Day5.053", "line_id": "line.Day5.053", "revision": "1", "text": "Lavinia looks down at the image on her glass, then up at me." }, { "beat_id": "beat.line.Day5.054", "line_id": "line.Day5.054", "revision": "1", "text": "“May I keep it? Just for myself.”" }, { "beat_id": "beat.line.Day5.055", "line_id": "line.Day5.055", "revision": "1", "text": "“You knew I didn\'t want one taken.”" }, { "beat_id": "beat.line.Day5.056", "line_id": "line.Day5.056", "revision": "1", "text": "“I know.”" }, { "beat_id": "beat.line.Day5.057", "line_id": "line.Day5.057", "revision": "1", "text": "I lean forward across the two-inch gap between our chairs to see the screen." }, { "beat_id": "beat.line.Day5.058", "line_id": "line.Day5.058", "revision": "1", "text": "In the photograph, my hand is still half-raised above the empty corner of the blotter where the yellow slip lay a second ago, my mouth unarranged." }] }, { "entry_id": "Day5.A", "lines": [{ "beat_id": "beat.line.Day5.A.001", "line_id": "line.Day5.A.001", "revision": "1", "text": "“That one isn\'t due today. That is all.” The second folder stays closed on the wood. “Let me see the screen.”" }, { "beat_id": "beat.line.Day5.A.002", "line_id": "line.Day5.A.002", "revision": "1", "text": "Lavinia turns the phone around. In the frame: eyes looking straight into the lens, one hand half-raised above the blotter." }, { "beat_id": "beat.line.Day5.A.003", "line_id": "line.Day5.A.003", "revision": "1", "text": "“This one,” I say quietly. “Don\'t send it to anyone.”" }, { "beat_id": "beat.line.Day5.A.004", "line_id": "line.Day5.A.004", "revision": "1", "text": "“I won\'t.”" }, { "beat_id": "beat.line.Day5.A.005", "line_id": "line.Day5.A.005", "revision": "1", "text": "She switches off the screen and slips the phone into her coat pocket. At the door, her hand pauses on the inner latch without turning the wooden chair back to the desk." }, { "beat_id": "beat.line.Day5.A.006", "line_id": "line.Day5.A.006", "revision": "1", "text": "“Tomorrow evening,” she says. “My flat.”" }] }, { "entry_id": "Day5.B", "lines": [{ "beat_id": "beat.line.Day5.B.001", "line_id": "line.Day5.B.001", "revision": "1", "text": "Fingertips touch the cardboard cover of the second folder, then draw back." }, { "beat_id": "beat.line.Day5.B.002", "line_id": "line.Day5.B.002", "revision": "1", "text": "“There is another folder, but it can wait,” I say. “Delete the picture first.”" }, { "beat_id": "beat.line.Day5.B.003", "line_id": "line.Day5.B.003", "revision": "1", "text": "Lavinia looks at my hand leaving the folder, then down at the phone in her lap." }, { "beat_id": "beat.line.Day5.B.004", "line_id": "line.Day5.B.004", "revision": "1", "text": "“You\'re certain?”" }, { "beat_id": "beat.line.Day5.B.005", "line_id": "line.Day5.B.005", "revision": "1", "text": "“Yes.”" }, { "beat_id": "beat.line.Day5.B.006", "line_id": "line.Day5.B.006", "revision": "1", "text": "Two taps on the glass; she turns the empty camera roll toward the desk, stands, and leaves the wooden chair still facing mine. At the door, she takes the reversed white card off the outer handle and drops it onto my desk blotter." }, { "beat_id": "beat.line.Day5.B.007", "line_id": "line.Day5.B.007", "revision": "1", "text": "“Tomorrow evening,” she says. “My flat.”" }] }, { "entry_id": "Day5.C", "lines": [{ "beat_id": "beat.line.Day5.C.001", "line_id": "line.Day5.C.001", "revision": "1", "text": "“The visitor notes are still inconsistent,” I say, resting a hand on the second folder." }, { "beat_id": "beat.line.Day5.C.002", "line_id": "line.Day5.C.002", "revision": "1", "text": "“They are not due today.”" }, { "beat_id": "beat.line.Day5.C.003", "line_id": "line.Day5.C.003", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day5.C.004", "line_id": "line.Day5.C.004", "revision": "1", "text": "Lavinia glances at the frosted pane where the reversed notice hangs, then at the second folder." }, { "beat_id": "beat.line.Day5.C.005", "line_id": "line.Day5.C.005", "revision": "1", "text": "“Show me,” she says. “And I\'m keeping the photograph.”" }, { "beat_id": "beat.line.Day5.C.006", "line_id": "line.Day5.C.006", "revision": "1", "text": "“Don\'t show it to anyone.”" }, { "beat_id": "beat.line.Day5.C.007", "line_id": "line.Day5.C.007", "revision": "1", "text": "“Who would I show it to?”" }, { "beat_id": "beat.line.Day5.C.008", "line_id": "line.Day5.C.008", "revision": "1", "text": "She pulls the second folder across the two-inch gap between the chairs and opens it across her knees. When we finish, she closes the folder." }, { "beat_id": "beat.line.Day5.C.009", "line_id": "line.Day5.C.009", "revision": "1", "text": "“Tomorrow evening,” she says. “Come to the flat.”" }] }, { "entry_id": "Day5.D", "lines": [{ "beat_id": "beat.line.Day5.D.001", "line_id": "line.Day5.D.001", "revision": "1", "text": "The second folder slides across the edge of the desk until its first page overlaps her knee." }, { "beat_id": "beat.line.Day5.D.002", "line_id": "line.Day5.D.002", "revision": "1", "text": "“The visitor notes are still inconsistent,” I say." }, { "beat_id": "beat.line.Day5.D.003", "line_id": "line.Day5.D.003", "revision": "1", "text": "“They are not due today.”" }, { "beat_id": "beat.line.Day5.D.004", "line_id": "line.Day5.D.004", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day5.D.005", "line_id": "line.Day5.D.005", "revision": "1", "text": "“And if I don\'t feel like checking them?”" }, { "beat_id": "beat.line.Day5.D.006", "line_id": "line.Day5.D.006", "revision": "1", "text": "Four fingers of my left hand rest across the top edge of her phone—not taking it from her palm, only tilting the lit screen down against the dark wool of her skirt." }, { "beat_id": "beat.line.Day5.D.007", "line_id": "line.Day5.D.007", "revision": "1", "text": "“Then delete the photograph before you open the door,” I say softly. “Or stay until the second folder is finished, and you may keep it.”" }, { "beat_id": "beat.line.Day5.D.008", "line_id": "line.Day5.D.008", "revision": "1", "text": "In the slate-grey light of the six-pace room, Lavinia\'s eyes narrow." }, { "beat_id": "beat.line.Day5.D.009", "line_id": "line.Day5.D.009", "revision": "1", "text": "“You\'re bargaining with me.”" }, { "beat_id": "beat.line.Day5.D.010", "line_id": "line.Day5.D.010", "revision": "1", "text": "“You asked whether you could keep it.”" }, { "beat_id": "beat.line.Day5.D.011", "line_id": "line.Day5.D.011", "revision": "1", "text": "Three seconds of silence. Outside in the corridor, a distant bell rings and fades behind the notice on the glass." }, { "beat_id": "beat.line.Day5.D.012", "line_id": "line.Day5.D.012", "revision": "1", "text": "Lavinia clicks the phone screen dark and drops it into her coat pocket." }, { "beat_id": "beat.line.Day5.D.013", "line_id": "line.Day5.D.013", "revision": "1", "text": "Then she hooks the toe of her right shoe behind the front wooden leg of my chair and pulls it sharply forward—sliding my chair two inches closer until our knees lock together beneath the desk edge and my right thigh is caught squarely between hers." }, { "beat_id": "beat.line.Day5.D.014", "line_id": "line.Day5.D.014", "revision": "1", "text": "The force of dragging my chair slips the rain-wet leather heel of her loafer off her foot." }, { "beat_id": "beat.line.Day5.D.015", "line_id": "line.Day5.D.015", "revision": "1", "text": "Under the table, without looking down, she lifts her stockinged foot and presses the rain-soaked arch against the inside of my ankle—sliding the wet nylon slowly up my shin, wiping the cold rainwater from her heel onto my skin and hem until the clammy chill soaks through to the bone and her own foot warms against my calf." }, { "beat_id": "beat.line.Day5.D.016", "line_id": "line.Day5.D.016", "revision": "1", "text": "My leg shivers once; her knees close firmer around my thigh to hold my shin still against her wet sole." }, { "beat_id": "beat.line.Day5.D.017", "line_id": "line.Day5.D.017", "revision": "1", "text": "She picks up the red pencil and sets her free hand flat over my knee." }, { "beat_id": "beat.line.Day5.D.018", "line_id": "line.Day5.D.018", "revision": "1", "text": "“Your ankle was dry,” she says quietly." }, { "beat_id": "beat.line.Day5.D.019", "line_id": "line.Day5.D.019", "revision": "1", "text": "“Yours is wet.”" }, { "beat_id": "beat.line.Day5.D.020", "line_id": "line.Day5.D.020", "revision": "1", "text": "“Not anymore. Open page one.”" }] }, { "entry_id": "Day5.D.arch", "lines": [{ "beat_id": "beat.line.Day5.D.arch.001", "line_id": "line.Day5.D.arch.001", "revision": "1", "text": "Before opening the folder, my left hand slides down under the desk edge and closes directly around the damp arch of her stockinged foot—holding her heel against the wet patch on my shin until both the nylon and my palm are warm." }, { "beat_id": "beat.line.Day5.D.arch.002", "line_id": "line.Day5.D.arch.002", "revision": "1", "text": "Lavinia\'s fingers tighten on the red pencil." }, { "beat_id": "beat.line.Day5.D.arch.003", "line_id": "line.Day5.D.arch.003", "revision": "1", "text": "“Open page one,” she whispers, leaving her foot in my hand beneath the table." }, { "beat_id": "beat.line.Day5.D.arch.004", "line_id": "line.Day5.D.arch.004", "revision": "1", "text": "When the last page is turned, she slides her warmed foot back into her loafer, leaving my ankle damp and chilled." }, { "beat_id": "beat.line.Day5.D.arch.005", "line_id": "line.Day5.D.arch.005", "revision": "1", "text": "“Tomorrow night,” she says softly. “At my flat.”" }] }, { "entry_id": "Day5.D.default", "lines": [{ "beat_id": "beat.line.Day5.D.default.001", "line_id": "line.Day5.D.default.001", "revision": "1", "text": "With my thigh locked between her knees and the cold, damp streak from her stocking clinging to my shin beneath the desk, I open the first page of the visitor notes across both our laps." }, { "beat_id": "beat.line.Day5.D.default.002", "line_id": "line.Day5.D.default.002", "revision": "1", "text": "Neither of us moves the chairs apart; even after her foot warms against my calf, the damp patch she wiped onto my skin stays cold in the vent draft from the door." }, { "beat_id": "beat.line.Day5.D.default.003", "line_id": "line.Day5.D.default.003", "revision": "1", "text": "When the last page is turned, she slides her warmed foot back into her loafer, leaving my ankle damp and chilled." }, { "beat_id": "beat.line.Day5.D.default.004", "line_id": "line.Day5.D.default.004", "revision": "1", "text": "“Tomorrow night,” she says softly. “At my flat.”" }] }, { "entry_id": "Day5.D.note", "lines": [{ "beat_id": "beat.line.Day5.D.note.001", "line_id": "line.Day5.D.note.001", "revision": "1", "text": "Keeping my wet shin pressed against her foot, I reach down into the wastepaper basket beside the table leg, lift out only the folded yellow slip—leaving the black pen at the bottom—and tear the yellow paper cleanly in half across the desk blotter." }, { "beat_id": "beat.line.Day5.D.note.002", "line_id": "line.Day5.D.note.002", "revision": "1", "text": "Lavinia watches the two halves drop back into the bin, her foot pressing once more against the wet patch on my ankle." }, { "beat_id": "beat.line.Day5.D.note.003", "line_id": "line.Day5.D.note.003", "revision": "1", "text": "“Open page one,” she says." }, { "beat_id": "beat.line.Day5.D.note.004", "line_id": "line.Day5.D.note.004", "revision": "1", "text": "When the last page is turned, she slides her warmed foot back into her loafer, leaving my ankle damp and chilled." }, { "beat_id": "beat.line.Day5.D.note.005", "line_id": "line.Day5.D.note.005", "revision": "1", "text": "“Tomorrow night,” she says softly. “At my flat.”" }] }, { "entry_id": "Day5.E", "lines": [{ "beat_id": "beat.line.Day5.E.001", "line_id": "line.Day5.E.001", "revision": "1", "text": "“The visitor notes are still inconsistent,” I say, resting a hand on the second folder." }, { "beat_id": "beat.line.Day5.E.002", "line_id": "line.Day5.E.002", "revision": "1", "text": "“They are not due today.”" }, { "beat_id": "beat.line.Day5.E.003", "line_id": "line.Day5.E.003", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day5.E.004", "line_id": "line.Day5.E.004", "revision": "1", "text": "Lavinia glances at the frosted pane where the reversed notice hangs, then at the second folder." }, { "beat_id": "beat.line.Day5.E.005", "line_id": "line.Day5.E.005", "revision": "1", "text": "“Show me,” she says. “And I\'m keeping the photograph.”" }, { "beat_id": "beat.line.Day5.E.006", "line_id": "line.Day5.E.006", "revision": "1", "text": "“Don\'t show it to anyone.”" }, { "beat_id": "beat.line.Day5.E.007", "line_id": "line.Day5.E.007", "revision": "1", "text": "“Who would I show it to?”" }, { "beat_id": "beat.line.Day5.E.008", "line_id": "line.Day5.E.008", "revision": "1", "text": "She pulls the second folder across the two-inch gap between the chairs and opens it across her knees." }, { "beat_id": "beat.line.Day5.E.009", "line_id": "line.Day5.E.009", "revision": "1", "text": "Through the frosted door pane, the reversed black letters of the notice hang without moving." }, { "beat_id": "beat.line.Day5.E.010", "line_id": "line.Day5.E.010", "revision": "1", "text": "Sylvia walked down this corridor with a drawing pad under her arm. Yet the yellow slip under the pen was written on paper from a pad that hasn\'t been stocked in this building since last winter." }, { "beat_id": "beat.line.Day5.E.011", "line_id": "line.Day5.E.011", "revision": "1", "text": "And three different shadows have stopped outside the frosted glass, each one arriving at the exact second Lavinia\'s hand moved toward her coat pocket." }, { "beat_id": "beat.line.Day5.E.012", "line_id": "line.Day5.E.012", "revision": "1", "text": "You." }, { "beat_id": "beat.line.Day5.E.013", "line_id": "line.Day5.E.013", "revision": "1", "text": "You like small rooms, don\'t you?" }, { "beat_id": "beat.line.Day5.E.014", "line_id": "line.Day5.E.014", "revision": "1", "text": "Lavinia turns a page against my knee." }, { "beat_id": "beat.line.Day5.E.015", "line_id": "line.Day5.E.015", "revision": "1", "text": "Leave the card on the handle a little longer. The second folder has twelve pages." }, { "beat_id": "beat.line.Day5.E.016", "line_id": "line.Day5.E.016", "revision": "1", "text": "When we finish, she closes the folder." }, { "beat_id": "beat.line.Day5.E.017", "line_id": "line.Day5.E.017", "revision": "1", "text": "“Tomorrow evening,” she says. “Come to the flat.”" }] }, { "entry_id": "Day5.cheek", "lines": [{ "beat_id": "beat.line.Day5.cheek.001", "line_id": "line.Day5.cheek.001", "revision": "1", "text": "At the corner of my mouth, a smile begins—and stops halfway as the muscle at the right cheekbone pulls slightly." }, { "beat_id": "beat.line.Day5.cheek.002", "line_id": "line.Day5.cheek.002", "revision": "1", "text": "Lavinia\'s gaze leaves the lit screen and fixes on my right cheek." }, { "beat_id": "beat.line.Day5.cheek.003", "line_id": "line.Day5.cheek.003", "revision": "1", "text": "“Does it still hurt?” she asks quietly." }, { "beat_id": "beat.line.Day5.cheek.004", "line_id": "line.Day5.cheek.004", "revision": "1", "text": "Bring her hand to the cheek and say it doesn\'t hurt now." }] }, { "entry_id": "Day5.cheek.default", "lines": [{ "beat_id": "beat.line.Day5.cheek.default.001", "line_id": "line.Day5.cheek.default.001", "revision": "1", "text": "“Only when someone makes me laugh too quickly.” Both of my hands stay flat on the margin of the folder." }, { "beat_id": "beat.line.Day5.cheek.default.002", "line_id": "line.Day5.cheek.default.002", "revision": "1", "text": "Lavinia studies the cheekbone for a second, then lifts two fingers of her own accord and hooks a strand of hair behind my right ear." }, { "beat_id": "beat.line.Day5.cheek.default.003", "line_id": "line.Day5.cheek.default.003", "revision": "1", "text": "“Then don\'t laugh,” she says softly." }, { "beat_id": "beat.line.Day5.cheek.default.004", "line_id": "line.Day5.cheek.default.004", "revision": "1", "text": "Her knuckle grazes the mark once before her hand covers the phone screen again." }] }, { "entry_id": "Day5.cheek.yes", "lines": [{ "beat_id": "beat.line.Day5.cheek.yes.001", "line_id": "line.Day5.cheek.yes.001", "revision": "1", "text": "My fingers close lightly around Lavinia\'s free wrist and guide her palm flat against my right cheek." }, { "beat_id": "beat.line.Day5.cheek.yes.002", "line_id": "line.Day5.cheek.yes.002", "revision": "1", "text": "“Not now.”" }, { "beat_id": "beat.line.Day5.cheek.yes.003", "line_id": "line.Day5.cheek.yes.003", "revision": "1", "text": "The skin of her palm is cool from the rain outside. For a second her fingers lie still over the cheekbone." }, { "beat_id": "beat.line.Day5.cheek.yes.004", "line_id": "line.Day5.cheek.yes.004", "revision": "1", "text": "“Let go of my hand,” she says softly." }, { "beat_id": "beat.line.Day5.cheek.yes.005", "line_id": "line.Day5.cheek.yes.005", "revision": "1", "text": "My fingers open and release her wrist." }, { "beat_id": "beat.line.Day5.cheek.yes.006", "line_id": "line.Day5.cheek.yes.006", "revision": "1", "text": "Lavinia\'s hand does not leave my face. It stays there for a beat—and then the pad of her thumb presses firmer into the cheekbone, steady and deliberate, until the back of my head touches the wooden upright of the chair." }, { "beat_id": "beat.line.Day5.cheek.yes.007", "line_id": "line.Day5.cheek.yes.007", "revision": "1", "text": "Outside the frosted glass, a tall shadow pauses in the corridor, reads the reversed card on the handle, and glides past." }, { "beat_id": "beat.line.Day5.cheek.yes.008", "line_id": "line.Day5.cheek.yes.008", "revision": "1", "text": "I do not turn my head away from her thumb. My eyes stay open on hers until the pressure eases and her hand returns to her lap." }] }, { "entry_id": "Day5.impulse", "lines": [{ "beat_id": "beat.line.Day5.impulse.001", "line_id": "line.Day5.impulse.001", "revision": "1", "text": "Lavinia\'s thumb rests on the side button of her phone, the portrait still open on the glass." }, { "beat_id": "beat.line.Day5.impulse.002", "line_id": "line.Day5.impulse.002", "revision": "1", "text": "Beside her elbow on the corner of the desk lies a second folder—visitor notes, real work, not due today." }, { "beat_id": "beat.line.Day5.impulse.003", "line_id": "line.Day5.impulse.003", "revision": "1", "text": "Rain thickens against the high louver window. On the outer handle, the reversed white card keeps the hallway empty." }, { "beat_id": "beat.line.Day5.impulse.004", "line_id": "line.Day5.impulse.004", "revision": "1", "text": "“Are we finished for today?” Lavinia asks, her eyes dropping to the second folder beside her sleeve." }, { "beat_id": "beat.line.Day5.impulse.005", "line_id": "line.Day5.impulse.005", "revision": "1", "text": "Open the second folder and make her pay for the photograph with another hour." }] }, { "entry_id": "Day6", "lines": [{ "beat_id": "beat.line.Day6.one", "line_id": "line.Day6.one", "revision": "1", "text": "At the top of the stairs, my right hand rises to knock on the flat door; my left hand holds the closed long black umbrella." }, { "beat_id": "beat.line.Day6.002", "line_id": "line.Day6.002", "revision": "1", "text": "Just before my knuckles reach the wood, the door swings inward." }, { "beat_id": "beat.line.Day6.003", "line_id": "line.Day6.003", "revision": "1", "text": "Lavinia stands on the threshold in her stockinged feet. Without a word, her hand takes the closed long umbrella from my left hand and sets it inside the hallway stand." }, { "beat_id": "beat.line.Day6.004", "line_id": "line.Day6.004", "revision": "1", "text": "My raised right hand stays arrested in the air for half a beat—then redirects two inches to the wooden doorjamb and completes one light, exact knock against the frame." }, { "beat_id": "beat.line.Day6.005", "line_id": "line.Day6.005", "revision": "1", "text": "Lavinia watches the knuckles finish the knock against the wood before she steps back to let me cross the threshold." }, { "beat_id": "beat.line.Day6.006", "line_id": "line.Day6.006", "revision": "1", "text": "In the narrow kitchen off the hall, the kettle switch clicks down on the first press." }, { "beat_id": "beat.line.Day6.007", "line_id": "line.Day6.007", "revision": "1", "text": "No need to look for the light switch; the pale strip under the upper cabinet is already on." }, { "beat_id": "beat.line.Day6.008", "line_id": "line.Day6.008", "revision": "1", "text": "Right hand to the second cupboard from the window: two thin porcelain cups on the lower shelf, the one with the hairline chip turned toward the wall so only my own fingers will take it. Left hand to the tin behind the flour jar: loose black tea, then the small square honey pot." }, { "beat_id": "beat.line.Day6.009", "line_id": "line.Day6.009", "revision": "1", "text": "Beside the sink, on the wire drying rack, sits a third mug—heavy blue stoneware, not part of the flat\'s set. Three clear drops of water still cling to the inner rim, and the handle is turned to the left." }, { "beat_id": "beat.line.Day6.010", "line_id": "line.Day6.010", "revision": "1", "text": "On the threshold behind the counter, Lavinia\'s stockinged feet come to a stop." }, { "beat_id": "beat.line.Day6.011", "line_id": "line.Day6.011", "revision": "1", "text": "In the dark glass of the kitchen window above the sink, her reflection leans one shoulder against the doorframe, arms folded over her cardigan, watching my hands at the counter." }, { "beat_id": "beat.line.Day6.012", "line_id": "line.Day6.012", "revision": "1", "text": "“You still remember where the honey is,” she says." }, { "beat_id": "beat.line.Day6.013", "line_id": "line.Day6.013", "revision": "1", "text": "“It hasn\'t moved.”" }, { "beat_id": "beat.line.Day6.014", "line_id": "line.Day6.014", "revision": "1", "text": "“The cups moved.”" }, { "beat_id": "beat.line.Day6.015", "line_id": "line.Day6.015", "revision": "1", "text": "“Only to the left side of the shelf.”" }, { "beat_id": "beat.line.Day6.016", "line_id": "line.Day6.016", "revision": "1", "text": "My fingers lift the heavy blue stoneware mug from the wire rack, dry its base once with the dish towel, and place it on the highest shelf above the refrigerator—behind the glass salad bowl, out of sight from the doorway." }, { "beat_id": "beat.line.Day6.017", "line_id": "line.Day6.017", "revision": "1", "text": "In the window glass above the sink, the corner of Lavinia\'s mouth curves." }, { "beat_id": "beat.line.Day6.018", "line_id": "line.Day6.018", "revision": "1", "text": "“She brought soup on Wednesday,” Lavinia says calmly. “After the exhibition.”" }, { "beat_id": "beat.line.Day6.019", "line_id": "line.Day6.019", "revision": "1", "text": "“How thoughtful of her,” I say, opening the tea tin. “She always likes to leave a container she has to come back for.”" }, { "beat_id": "beat.line.Day6.020", "line_id": "line.Day6.020", "revision": "1", "text": "Lavinia steps out of the doorway and comes up beside my elbow at the counter, close enough that her sleeve brushes mine as I measure one spoonful of loose leaves into the warmed pot." }, { "beat_id": "beat.line.Day6.021", "line_id": "line.Day6.021", "revision": "1", "text": "“A little more,” she says." }, { "beat_id": "beat.line.Day6.022", "line_id": "line.Day6.022", "revision": "1", "text": "I pause with the spoon above the tin. “You used to say a second spoonful made it bitter.”" }, { "beat_id": "beat.line.Day6.023", "line_id": "line.Day6.023", "revision": "1", "text": "“I tried it your way,” she says, looking down into the dark leaves. “I like it stronger now.”" }, { "beat_id": "beat.line.Day6.024", "line_id": "line.Day6.024", "revision": "1", "text": "Half a spoonful more drops into the pot." }, { "beat_id": "beat.line.Day6.025", "line_id": "line.Day6.025", "revision": "1", "text": "“Like that?”" }, { "beat_id": "beat.line.Day6.026", "line_id": "line.Day6.026", "revision": "1", "text": "“Yes.”" }, { "beat_id": "beat.line.Day6.027", "line_id": "line.Day6.027", "revision": "1", "text": "Boiling water fills the porcelain pot, and we carry the tray into the living room." }, { "beat_id": "beat.line.Day6.028", "line_id": "line.Day6.028", "revision": "1", "text": "As I set the tray on the low table, my hand goes to the wall switch beside the bookcase and clicks off the overhead bulb—leaving only the low amber shade in the corner and the pale blue square of the television across the rug." }, { "beat_id": "beat.line.Day6.029", "line_id": "line.Day6.029", "revision": "1", "text": "Lavinia does not look up from the sofa cushion as the ceiling light goes out." }, { "beat_id": "beat.line.Day6.030", "line_id": "line.Day6.030", "revision": "1", "text": "“The glare?” she asks." }, { "beat_id": "beat.line.Day6.031", "line_id": "line.Day6.031", "revision": "1", "text": "“It reflects in the screen.”" }, { "beat_id": "beat.line.Day6.032", "line_id": "line.Day6.032", "revision": "1", "text": "“It never bothered you before.”" }, { "beat_id": "beat.line.Day6.033", "line_id": "line.Day6.033", "revision": "1", "text": "Rain streaking the dark window pane above the sofa." }, { "beat_id": "beat.line.Day6.034", "line_id": "line.Day6.034", "revision": "1", "text": "On the rug beside the low table, a practice skirt still damp at the hem, her head resting back against the wool cushion under the white ceiling bulb." }, { "beat_id": "beat.line.Day6.035", "line_id": "line.Day6.035", "revision": "1", "text": "Laying the back of a cool wrist across her closed eyelids to block the glare; her eyelashes brushing once against the skin before the hand rises to click the wall switch down." }, { "beat_id": "beat.line.Day6.036", "line_id": "line.Day6.036", "revision": "1", "text": "From the corner of the sofa, Lavinia looks toward the television." }, { "beat_id": "beat.line.Day6.037", "line_id": "line.Day6.037", "revision": "1", "text": "“They\'ve been in that corridor for ten minutes,” she says." }, { "beat_id": "beat.line.Day6.038", "line_id": "line.Day6.038", "revision": "1", "text": "“Nine,” I say." }, { "beat_id": "beat.line.Day6.039", "line_id": "line.Day6.039", "revision": "1", "text": "“That isn\'t better.”" }, { "beat_id": "beat.line.Day6.040", "line_id": "line.Day6.040", "revision": "1", "text": "“No. He\'s opened the same door four times without once checking the latch first.” My fingers tap once against the rim of the saucer. “If he wanted to be inside the room, he\'d have taken the key by now.”" }, { "beat_id": "beat.line.Day6.041", "line_id": "line.Day6.041", "revision": "1", "text": "On the screen, the man in the wet raincoat opens a heavy mahogany door, steps through the frame, and finds himself walking down the exact same carpeted corridor from the opposite end." }, { "beat_id": "beat.line.Day6.042", "line_id": "line.Day6.042", "revision": "1", "text": "“We could stop it,” she says." }, { "beat_id": "beat.line.Day6.043", "line_id": "line.Day6.043", "revision": "1", "text": "“I\'d like to see whether he ever reaches a room.”" }, { "beat_id": "beat.line.Day6.044", "line_id": "line.Day6.044", "revision": "1", "text": "Lavinia settles back against the cushion. The pale blue light from the television moves across the hollow of her throat and the corner of her mouth." }, { "beat_id": "beat.line.Day6.045", "line_id": "line.Day6.045", "revision": "1", "text": "Without turning her head toward my chair, she asks: “What did he just take out of his pocket?”" }, { "beat_id": "beat.line.Day6.046", "line_id": "line.Day6.046", "revision": "1", "text": "Silence for a beat." }, { "beat_id": "beat.line.Day6.047", "line_id": "line.Day6.047", "revision": "1", "text": "“A key?” I say." }, { "beat_id": "beat.line.Day6.048", "line_id": "line.Day6.048", "revision": "1", "text": "“He didn\'t put his hand in his pocket.” Lavinia turns her head on the cushion and catches my eyes on the side of her face instead of the television. “Watch the film, not me.”" }, { "beat_id": "beat.line.Day6.049", "line_id": "line.Day6.049", "revision": "1", "text": "Beside her saucer on the low table, her phone plays a slow piano recording at low volume. With her teacup resting against her knee, she hums a short four-note phrase—coming in half a beat before the piano reaches it, while our voices cover the middle bars of the track." }, { "beat_id": "beat.line.Day6.050", "line_id": "line.Day6.050", "revision": "1", "text": "“You\'re early,” I say." }, { "beat_id": "beat.line.Day6.051", "line_id": "line.Day6.051", "revision": "1", "text": "“Not on the other recording.”" }, { "beat_id": "beat.line.Day6.052", "line_id": "line.Day6.052", "revision": "1", "text": "When the track changes, I look toward her phone beside the teapot. “What was the one before this? We talked through half of it.”" }, { "beat_id": "beat.line.Day6.053", "line_id": "line.Day6.053", "revision": "1", "text": "“You were answering me.”" }, { "beat_id": "beat.line.Day6.054", "line_id": "line.Day6.054", "revision": "1", "text": "“I won\'t this time.”" }, { "beat_id": "beat.line.Day6.055", "line_id": "line.Day6.055", "revision": "1", "text": "Lavinia restarts the piano track—and before she settles back, I set my cup down on the saucer and tip my head toward the narrow strip of rug between the low table and the television." }, { "beat_id": "beat.line.Day6.056", "line_id": "line.Day6.056", "revision": "1", "text": "“Shall we?”" }, { "beat_id": "beat.line.Day6.057", "line_id": "line.Day6.057", "revision": "1", "text": "Lavinia looks at my offered hand, then at the phone." }, { "beat_id": "beat.line.Day6.058", "line_id": "line.Day6.058", "revision": "1", "text": "“Not to this. Wait.”" }, { "beat_id": "beat.line.Day6.059", "line_id": "line.Day6.059", "revision": "1", "text": "She picks up her phone from beside the teapot, scrolls through two lines, and starts the other recording. After listening to its opening bars, she sets the phone down on the wood." }, { "beat_id": "beat.line.Day6.060", "line_id": "line.Day6.060", "revision": "1", "text": "“This one.”" }, { "beat_id": "beat.line.Day6.061", "line_id": "line.Day6.061", "revision": "1", "text": "I stand and offer my hand." }, { "beat_id": "beat.line.Day6.062", "line_id": "line.Day6.062", "revision": "1", "text": "Lavinia takes it. When we step into the narrow space beside the table, she lays her left hand on my shoulder; I step closer and rest my right palm at the small of her back." }, { "beat_id": "beat.line.Day6.063", "line_id": "line.Day6.063", "revision": "1", "text": "As we begin, my gaze drops once toward the edge of the rug." }, { "beat_id": "beat.line.Day6.064", "line_id": "line.Day6.064", "revision": "1", "text": "Lavinia immediately makes her next step smaller." }, { "beat_id": "beat.line.Day6.065", "line_id": "line.Day6.065", "revision": "1", "text": "“You\'re still watching your feet,” she says softly." }, { "beat_id": "beat.line.Day6.066", "line_id": "line.Day6.066", "revision": "1", "text": "“This is an improvement.”" }, { "beat_id": "beat.line.Day6.067", "line_id": "line.Day6.067", "revision": "1", "text": "She laughs." }, { "beat_id": "beat.line.Day6.068", "line_id": "line.Day6.068", "revision": "1", "text": "We do not move far. Lavinia begins a slow turn and feels me follow; on the next bar, I change direction first, and she adjusts her weight without saying anything. The low table passes out of her line of sight, then returns." }, { "beat_id": "beat.line.Day6.069", "line_id": "line.Day6.069", "revision": "1", "text": "When the song finishes, I glance toward the phone on the table. “Another?”" }, { "beat_id": "beat.line.Day6.070", "line_id": "line.Day6.070", "revision": "1", "text": "“Not yet.”" }, { "beat_id": "beat.line.Day6.071", "line_id": "line.Day6.071", "revision": "1", "text": "Lavinia keeps her hand in mine. Without any music in the room—only the faint hum of the television and the man on screen opening another door onto the same hallway—she takes one more slow step across the rug, and I move with her for three silent turns." }, { "beat_id": "beat.line.Day6.072", "line_id": "line.Day6.072", "revision": "1", "text": "Finally she stops." }, { "beat_id": "beat.line.Day6.073", "line_id": "line.Day6.073", "revision": "1", "text": "“I want my tea,” she murmurs." }, { "beat_id": "beat.line.Day6.074", "line_id": "line.Day6.074", "revision": "1", "text": "My hand opens from hers, and we return to our seats." }, { "beat_id": "beat.line.Day6.075", "line_id": "line.Day6.075", "revision": "1", "text": "Lavinia picks up her cup and takes a sip of the stronger tea." }, { "beat_id": "beat.line.Day6.076", "line_id": "line.Day6.076", "revision": "1", "text": "“In the story we read before I went,” she says quietly over the rim, “you said the woman at the end was right to send her away.”" }, { "beat_id": "beat.line.Day6.077", "line_id": "line.Day6.077", "revision": "1", "text": "“I changed my mind the next day,” I say." }, { "beat_id": "beat.line.Day6.078", "line_id": "line.Day6.078", "revision": "1", "text": "“You wrote it down.”" }, { "beat_id": "beat.line.Day6.079", "line_id": "line.Day6.079", "revision": "1", "text": "Her hand reaches to the low shelf beside the sofa and lifts a dark-green linen notebook—but instead of opening it, she holds it closed against her chest, her fingers pressing into the linen cover." }, { "beat_id": "beat.line.Day6.080", "line_id": "line.Day6.080", "revision": "1", "text": "“May I see it?” I ask." }, { "beat_id": "beat.line.Day6.081", "line_id": "line.Day6.081", "revision": "1", "text": "Lavinia does not open the cover. In the blue light from the television, her eyes stay on mine—quieter now, without the teasing edge." }, { "beat_id": "beat.line.Day6.082", "line_id": "line.Day6.082", "revision": "1", "text": "“Say it first,” she whispers." }, { "beat_id": "beat.line.Day6.083", "line_id": "line.Day6.083", "revision": "1", "text": "“You already have the note in your hand.”" }, { "beat_id": "beat.line.Day6.084", "line_id": "line.Day6.084", "revision": "1", "text": "“I know what the paper says. I\'ve had the paper for months.” Her fingers tighten slightly on the green cover. “I want to hear you say it before you see it.”" }, { "beat_id": "beat.line.Day6.085", "line_id": "line.Day6.085", "revision": "1", "text": "On the screen, the corridor door swings shut in silence." }, { "beat_id": "beat.line.Day6.086", "line_id": "line.Day6.086", "revision": "1", "text": "“You were right about the ending,” I say softly. “She shouldn\'t have let her go.”" }, { "beat_id": "beat.line.Day6.087", "line_id": "line.Day6.087", "revision": "1", "text": "For a second Lavinia\'s throat moves as she swallows. Then she opens the green cover to a marked page and passes it across the low table into my hands." }, { "beat_id": "beat.line.Day6.088", "line_id": "line.Day6.088", "revision": "1", "text": "Fixed to the upper margin of the page with a strip of yellowed tape is a small square of paper in my handwriting:" }, { "beat_id": "beat.line.Day6.089", "line_id": "line.Day6.089", "revision": "1", "text": "You were right about the ending." }, { "beat_id": "beat.line.Day6.090", "line_id": "line.Day6.090", "revision": "1", "text": "“Just that page,” she murmurs." }, { "beat_id": "beat.line.Day6.091", "line_id": "line.Day6.091", "revision": "1", "text": "“I still disliked the last chapter.”" }, { "beat_id": "beat.line.Day6.092", "line_id": "line.Day6.092", "revision": "1", "text": "“You didn\'t put that in the note.”" }, { "beat_id": "beat.line.Day6.093", "line_id": "line.Day6.093", "revision": "1", "text": "When the next track on her phone ends in a soft click, Lavinia turns half-sideways on the sofa to look through her recordings." }, { "beat_id": "beat.line.Day6.094", "line_id": "line.Day6.094", "revision": "1", "text": "The green notebook lies open across my knees." }, { "beat_id": "beat.line.Day6.095", "line_id": "line.Day6.095", "revision": "1", "text": "Beneath the bottom edge of my taped note, the lower half of the page is covered in Lavinia\'s slanted dark ink—two lines in Romanian at the top, and below them an exchange in English laid out like a play script." }, { "beat_id": "beat.line.Day6.096", "line_id": "line.Day6.096", "revision": "1", "text": "In the second line, she had written the milder word leave first, struck it through twice with a heavy nib, and rewritten it harder above the line:" }, { "beat_id": "beat.line.Day6.097", "line_id": "line.Day6.097", "revision": "1", "text": "P: I\'d do it again if you limped." }, { "beat_id": "beat.line.Day6.098", "line_id": "line.Day6.098", "revision": "1", "text": "L: Even if I told you to l̶e̶a̶v̶e̶ get out?" }, { "beat_id": "beat.line.Day6.099", "line_id": "line.Day6.099", "revision": "1", "text": "P: Don\'t tell me to get out when you\'ve already taken my coat." }, { "beat_id": "beat.line.Day6.100", "line_id": "line.Day6.100", "revision": "1", "text": "And at the very bottom margin of the page, underlined twice in the same dark ink:" }, { "beat_id": "beat.line.Day6.101", "line_id": "line.Day6.101", "revision": "1", "text": "Don\'t ask her to stay." }, { "beat_id": "beat.line.Day6.102", "line_id": "line.Day6.102", "revision": "1", "text": "Lavinia looks back from her phone before starting the track." }, { "beat_id": "beat.line.Day6.103", "line_id": "line.Day6.103", "revision": "1", "text": "Her eyes drop immediately to my thumb holding the lower corner of the taped note up from the page." }, { "beat_id": "beat.line.Day6.104", "line_id": "line.Day6.104", "revision": "1", "text": "“Not that page,” she says, extending her hand palm-up between us." }, { "beat_id": "beat.line.Day6.105", "line_id": "line.Day6.105", "revision": "1", "text": "The notebook stays open across my knees." }, { "beat_id": "beat.line.Day6.106", "line_id": "line.Day6.106", "revision": "1", "text": "“You wrote my part,” I say quietly." }, { "beat_id": "beat.line.Day6.107", "line_id": "line.Day6.107", "revision": "1", "text": "“Give it back.”" }, { "beat_id": "beat.line.Day6.108", "line_id": "line.Day6.108", "revision": "1", "text": "“Do I sound like that to you?”" }, { "beat_id": "beat.line.Day6.109", "line_id": "line.Day6.109", "revision": "1", "text": "Slowly, Lavinia lowers her extended hand to her knee. In the blue flicker from the television—where the man in the raincoat is opening another identical door—her eyes sharpen." }, { "beat_id": "beat.line.Day6.110", "line_id": "line.Day6.110", "revision": "1", "text": "“A minute ago you had to say it before you saw it,” she says, her English suddenly crisp and stripped of play. “Now that you\'ve seen this one without asking, let\'s hear you say it aloud.”" }, { "beat_id": "beat.line.Day6.111", "line_id": "line.Day6.111", "revision": "1", "text": "“Lavinia—”" }, { "beat_id": "beat.line.Day6.112", "line_id": "line.Day6.112", "revision": "1", "text": "“Go on. The first line. Let\'s hear whether I got your voice right.”" }, { "beat_id": "beat.line.Day6.113", "line_id": "line.Day6.113", "revision": "1", "text": "My eyes drop to the slanted ink on the page." }, { "beat_id": "beat.line.Day6.114", "line_id": "line.Day6.114", "revision": "1", "text": "“I would be concerned if the pain returned.”" }, { "beat_id": "beat.line.Day6.115", "line_id": "line.Day6.115", "revision": "1", "text": "“Stop.” Lavinia leans forward on the sofa, her palm striking the wool cushion beside her hip. “That isn\'t what is written on the page. Don\'t polish it. You usually only amend my documents when I\'m in another room.”" }, { "beat_id": "beat.line.Day6.116", "line_id": "line.Day6.116", "revision": "1", "text": "“Read what is written, Priscilla,” she says softly, her eyes gleaming in the blue light. “From the top. Without improving me.”" }, { "beat_id": "beat.line.Day6.117", "line_id": "line.Day6.117", "revision": "1", "text": "Stand up and read the next line right between her knees." }] }, { "entry_id": "Day6.A", "lines": [{ "beat_id": "beat.line.Day6.A.001", "line_id": "line.Day6.A.001", "revision": "1", "text": "“I\'m asking about tonight,” I say quietly, not reaching for the notebook. “I\'d like to stay longer.”" }, { "beat_id": "beat.line.Day6.A.002", "line_id": "line.Day6.A.002", "revision": "1", "text": "Lavinia looks at me for a long beat, then sets the green notebook on the shelf behind her head." }, { "beat_id": "beat.line.Day6.A.003", "line_id": "line.Day6.A.003", "revision": "1", "text": "“Then stay.”" }, { "beat_id": "beat.line.Day6.A.004", "line_id": "line.Day6.A.004", "revision": "1", "text": "I set my cup down on the saucer. Lavinia picks up her phone and looks at the first piano track." }, { "beat_id": "beat.line.Day6.A.005", "line_id": "line.Day6.A.005", "revision": "1", "text": "“I preferred the first time we heard that song,” she says." }, { "beat_id": "beat.line.Day6.A.006", "line_id": "line.Day6.A.006", "revision": "1", "text": "“We talked through part of it.”" }, { "beat_id": "beat.line.Day6.A.007", "line_id": "line.Day6.A.007", "revision": "1", "text": "“I know. I preferred it that way.”" }, { "beat_id": "beat.line.Day6.A.008", "line_id": "line.Day6.A.008", "revision": "1", "text": "As I begin to ask whether the man on the television has reached the stairs yet, Lavinia returns the earlier track not to its beginning, but directly to the middle passage our voices covered before—letting my sentence and her answer cover the exact same bars of music a second time." }] }, { "entry_id": "Day6.B", "lines": [{ "beat_id": "beat.line.Day6.B.001", "line_id": "line.Day6.B.001", "revision": "1", "text": "My fingers touch the linen corner of the notebook on her lap, then draw back." }, { "beat_id": "beat.line.Day6.B.002", "line_id": "line.Day6.B.002", "revision": "1", "text": "“You have morning call tomorrow. I shouldn\'t keep you up if you want the room to yourself.”" }, { "beat_id": "beat.line.Day6.B.003", "line_id": "line.Day6.B.003", "revision": "1", "text": "Lavinia watches me from the corner of the sofa." }, { "beat_id": "beat.line.Day6.B.004", "line_id": "line.Day6.B.004", "revision": "1", "text": "“You hide her mug above my refrigerator, read my private page, and now you\'re offering to go home?”" }, { "beat_id": "beat.line.Day6.B.005", "line_id": "line.Day6.B.005", "revision": "1", "text": "“Unless you ask me to stay.”" }, { "beat_id": "beat.line.Day6.B.006", "line_id": "line.Day6.B.006", "revision": "1", "text": "“I invited you.”" }, { "beat_id": "beat.line.Day6.B.007", "line_id": "line.Day6.B.007", "revision": "1", "text": "Neither of us moves closer; the stronger tea cools in the two porcelain cups while the corridor tape runs on." }] }, { "entry_id": "Day6.C", "lines": [{ "beat_id": "beat.line.Day6.C.001", "line_id": "line.Day6.C.001", "revision": "1", "text": "“You wrote both parts,” I say quietly. “Did you write what happens after she says that?”" }, { "beat_id": "beat.line.Day6.C.002", "line_id": "line.Day6.C.002", "revision": "1", "text": "“No. The page ended.”" }, { "beat_id": "beat.line.Day6.C.003", "line_id": "line.Day6.C.003", "revision": "1", "text": "“May I sit with you first?”" }, { "beat_id": "beat.line.Day6.C.004", "line_id": "line.Day6.C.004", "revision": "1", "text": "“Before what?”" }, { "beat_id": "beat.line.Day6.C.005", "line_id": "line.Day6.C.005", "revision": "1", "text": "“Before you decide whether to tell me to get out.”" }, { "beat_id": "beat.line.Day6.C.006", "line_id": "line.Day6.C.006", "revision": "1", "text": "Lavinia looks down at the cushion beside her thigh, then lifts her phone and the green notebook onto the shelf to clear the wool." }, { "beat_id": "beat.line.Day6.C.007", "line_id": "line.Day6.C.007", "revision": "1", "text": "“Sit down,” she says. “And watch the film, not me.”" }, { "beat_id": "beat.line.Day6.C.008", "line_id": "line.Day6.C.008", "revision": "1", "text": "On the sofa, less than an inch separates our shoulders. While I point out that the man on the screen is wearing a different raincoat in the next doorway, Lavinia reaches for her phone and returns the first piano track directly to the middle passage our voices covered earlier—letting our ongoing conversation cover the music again as her shoulder settles against mine." }] }, { "entry_id": "Day6.D", "lines": [{ "beat_id": "beat.line.Day6.D.001", "line_id": "line.Day6.D.001", "revision": "1", "text": "One hand reaches down, takes the closed green notebook from her lap, and opens it back to the marked page." }, { "beat_id": "beat.line.Day6.D.002", "line_id": "line.Day6.D.002", "revision": "1", "text": "Before Lavinia can catch my wrist, two fingers pinch the bottom margin—where Don\'t ask her to stay is underlined twice—and tear the narrow strip of paper cleanly along the crease." }, { "beat_id": "beat.line.Day6.D.003", "line_id": "line.Day6.D.003", "revision": "1", "text": "Lavinia\'s breath catches in her throat." }, { "beat_id": "beat.line.Day6.D.004", "line_id": "line.Day6.D.004", "revision": "1", "text": "“What are you doing?”" }, { "beat_id": "beat.line.Day6.D.005", "line_id": "line.Day6.D.005", "revision": "1", "text": "The torn strip of paper folds once and slips into my pocket. The notebook goes onto the low table." }, { "beat_id": "beat.line.Day6.D.006", "line_id": "line.Day6.D.006", "revision": "1", "text": "“Amending the ending,” I say softly. “You left a contradiction at the bottom.”" }, { "beat_id": "beat.line.Day6.D.007", "line_id": "line.Day6.D.007", "revision": "1", "text": "“Get out.”" }, { "beat_id": "beat.line.Day6.D.008", "line_id": "line.Day6.D.008", "revision": "1", "text": "“Tell me without holding my sleeve.”" }, { "beat_id": "beat.line.Day6.D.009", "line_id": "line.Day6.D.009", "revision": "1", "text": "In the blue flicker of the television screen, Lavinia looks down: her left hand has caught the cuff of my shirt and is twisting the linen tight around my wrist." }, { "beat_id": "beat.line.Day6.D.010", "line_id": "line.Day6.D.010", "revision": "1", "text": "She does not let go. Instead, she pulls my cuff hard enough to bring my knee down onto the sofa cushion right between her hip and the armrest." }, { "beat_id": "beat.line.Day6.D.011", "line_id": "line.Day6.D.011", "revision": "1", "text": "“You\'re insufferable,” she whispers against my mouth, her free hand tangling into the hair behind my ear and drawing my head down until our foreheads strike lightly together. “You think everything in this flat belongs to you.”" }, { "beat_id": "beat.line.Day6.D.012", "line_id": "line.Day6.D.012", "revision": "1", "text": "“Only the cup with the chip,” I murmur, and slide my right arm around her waist—my palm settling flat over the thin wool at her ribs—until her back presses into the sofa cushions beneath me." }] }, { "entry_id": "Day6.D.dark", "lines": [{ "beat_id": "beat.line.Day6.D.dark.001", "line_id": "line.Day6.D.dark.001", "revision": "1", "text": "Without lifting my weight from her waist, my left hand reaches blindly behind the sofa arm and presses the power switch on the television set." }, { "beat_id": "beat.line.Day6.D.dark.002", "line_id": "line.Day6.D.dark.002", "revision": "1", "text": "The blue corridor collapses into a single white pinpoint and vanishes, leaving only the corner lamp and Lavinia\'s hands pulling me down by the collar." }] }, { "entry_id": "Day6.D.default", "lines": [{ "beat_id": "beat.line.Day6.D.default.001", "line_id": "line.Day6.D.default.001", "revision": "1", "text": "Beneath me on the cushion, Lavinia\'s fingers uncurl from my twisted cuff only to slide up inside my sleeve, holding my forearm against her ribs while her mouth parts against mine—warm and bitter-sweet with the stronger tea." }, { "beat_id": "beat.line.Day6.D.default.002", "line_id": "line.Day6.D.default.002", "revision": "1", "text": "“I told you to watch the film,” she whispers against my lips without opening her eyes." }, { "beat_id": "beat.line.Day6.D.default.003", "line_id": "line.Day6.D.default.003", "revision": "1", "text": "“I\'m watching,” I murmur against her throat." }, { "beat_id": "beat.line.Day6.D.default.004", "line_id": "line.Day6.D.default.004", "revision": "1", "text": "On the television screen behind our shoulders, the man in the raincoat opens another door onto the exact same corridor. Neither of us turns to look." }] }, { "entry_id": "Day6.D.word", "lines": [{ "beat_id": "beat.line.Day6.D.word.001", "line_id": "line.Day6.D.word.001", "revision": "1", "text": "“You wrote leave first,” I whisper against her lips, my thumb tracing the rib seam beneath her cardigan. “Why did you cross it out?”" }, { "beat_id": "beat.line.Day6.D.word.002", "line_id": "line.Day6.D.word.002", "revision": "1", "text": "“Because you never listen to leave,” she breathes, pulling my mouth down to hers as the screen flickers blue across the rug." }] }, { "entry_id": "Day6.E", "lines": [{ "beat_id": "beat.line.Day6.E.001", "line_id": "line.Day6.E.001", "revision": "1", "text": "“You wrote both parts,” I say quietly. “Did you write what happens after she says that?”" }, { "beat_id": "beat.line.Day6.E.002", "line_id": "line.Day6.E.002", "revision": "1", "text": "“No. The page ended.”" }, { "beat_id": "beat.line.Day6.E.003", "line_id": "line.Day6.E.003", "revision": "1", "text": "“May I sit with you first?”" }, { "beat_id": "beat.line.Day6.E.004", "line_id": "line.Day6.E.004", "revision": "1", "text": "“Before what?”" }, { "beat_id": "beat.line.Day6.E.005", "line_id": "line.Day6.E.005", "revision": "1", "text": "“Before you decide whether to tell me to get out.”" }, { "beat_id": "beat.line.Day6.E.006", "line_id": "line.Day6.E.006", "revision": "1", "text": "Lavinia looks down at the cushion beside her thigh, then lifts her phone and the green notebook onto the shelf to clear the wool." }, { "beat_id": "beat.line.Day6.E.007", "line_id": "line.Day6.E.007", "revision": "1", "text": "“Sit down,” she says. “And watch the film, not me.”" }, { "beat_id": "beat.line.Day6.E.008", "line_id": "line.Day6.E.008", "revision": "1", "text": "On the sofa, less than an inch separates our shoulders. While I point out that the man on the screen is wearing a different raincoat in the next doorway, Lavinia reaches for her phone and returns the first piano track directly to the middle passage our voices covered earlier—letting our ongoing conversation cover the music again as her shoulder settles against mine." }, { "beat_id": "beat.line.Day6.E.009", "line_id": "line.Day6.E.009", "revision": "1", "text": "On the screen, the same brass door handle turns again. Same shadow across the carpet. Same white scratch on the lower left frame of the film." }, { "beat_id": "beat.line.Day6.E.010", "line_id": "line.Day6.E.010", "revision": "1", "text": "A tape does not repeat the exact same scratch fourteen times without a splice." }, { "beat_id": "beat.line.Day6.E.011", "line_id": "line.Day6.E.011", "revision": "1", "text": "And when the cupboard door opened in the kitchen, the chipped porcelain cup was already sitting at the very front edge of the shelf—next to a honey jar whose lid had already been loosened." }, { "beat_id": "beat.line.Day6.E.012", "line_id": "line.Day6.E.012", "revision": "1", "text": "You." }, { "beat_id": "beat.line.Day6.E.013", "line_id": "line.Day6.E.013", "revision": "1", "text": "You keep opening the same corridor until the two of us walk into the room you want." }, { "beat_id": "beat.line.Day6.E.014", "line_id": "line.Day6.E.014", "revision": "1", "text": "Lavinia\'s shoulder rises and falls warmly against my chest." }, { "beat_id": "beat.line.Day6.E.015", "line_id": "line.Day6.E.015", "revision": "1", "text": "Let the tape run all night if you like. The door is already shut behind us." }] }, { "entry_id": "Day6.impulse", "lines": [{ "beat_id": "beat.line.Day6.impulse.001", "line_id": "line.Day6.impulse.001", "revision": "1", "text": "On the television screen, the corridor door clicks shut without a word of dialogue." }, { "beat_id": "beat.line.Day6.impulse.002", "line_id": "line.Day6.impulse.002", "revision": "1", "text": "Lavinia holds the closed green notebook against her lap." }, { "beat_id": "beat.line.Day6.impulse.003", "line_id": "line.Day6.impulse.003", "revision": "1", "text": "“That line at the bottom wasn\'t written for you,” she says." }, { "beat_id": "beat.line.Day6.impulse.004", "line_id": "line.Day6.impulse.004", "revision": "1", "text": "“I know.”" }, { "beat_id": "beat.line.Day6.impulse.005", "line_id": "line.Day6.impulse.005", "revision": "1", "text": "“You don\'t know when I wrote it.”" }, { "beat_id": "beat.line.Day6.impulse.006", "line_id": "line.Day6.impulse.006", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day6.impulse.007", "line_id": "line.Day6.impulse.007", "revision": "1", "text": "Take the line at the bottom off the page and stay the night." }] }, { "entry_id": "Day6.rehearsal.default", "lines": [{ "beat_id": "beat.line.Day6.rehearsal.default.001", "line_id": "line.Day6.rehearsal.default.001", "revision": "1", "text": "From the chair across the low table, my gaze stays on her mouth instead of the paper." }, { "beat_id": "beat.line.Day6.rehearsal.default.002", "line_id": "line.Day6.rehearsal.default.002", "revision": "1", "text": "“I\'d do it again if you limped.”" }, { "beat_id": "beat.line.Day6.rehearsal.default.003", "line_id": "line.Day6.rehearsal.default.003", "revision": "1", "text": "“A little flat,” Lavinia says, resting her chin on her knuckles. “You were much more convincing before I went away. Read the next one.”" }, { "beat_id": "beat.line.Day6.rehearsal.default.004", "line_id": "line.Day6.rehearsal.default.004", "revision": "1", "text": "“Don\'t tell me to get out when you\'ve already taken my coat.”" }, { "beat_id": "beat.line.Day6.rehearsal.default.005", "line_id": "line.Day6.rehearsal.default.005", "revision": "1", "text": "Lavinia reaches across the low table, draws the green notebook from between my fingers, and closes it across her lap." }, { "beat_id": "beat.line.Day6.rehearsal.default.006", "line_id": "line.Day6.rehearsal.default.006", "revision": "1", "text": "“You see?” she says softly. “You didn\'t need to edit a single word.”" }] }, { "entry_id": "Day6.rehearsal.yes", "lines": [{ "beat_id": "beat.line.Day6.rehearsal.yes.001", "line_id": "line.Day6.rehearsal.yes.001", "revision": "1", "text": "My chair slides back an inch on the rug. Two unhurried paces close the gap between the low table and the sofa until my shins brush the hem of her skirt right between her knees." }, { "beat_id": "beat.line.Day6.rehearsal.yes.002", "line_id": "line.Day6.rehearsal.yes.002", "revision": "1", "text": "Lavinia does not lean back, though she has to tilt her chin up to keep my face in view." }, { "beat_id": "beat.line.Day6.rehearsal.yes.003", "line_id": "line.Day6.rehearsal.yes.003", "revision": "1", "text": "“I\'d do it again if you limped,” I read, low and level." }, { "beat_id": "beat.line.Day6.rehearsal.yes.004", "line_id": "line.Day6.rehearsal.yes.004", "revision": "1", "text": "“Still too polite,” she whispers, though her fingers tighten on the edge of the sofa cushion. “You were much more ruthless when you altered the form before I left. Read the next one.”" }, { "beat_id": "beat.line.Day6.rehearsal.yes.005", "line_id": "line.Day6.rehearsal.yes.005", "revision": "1", "text": "I let the open notebook close against my thigh, no longer looking at the ink, and brace my free hand on the back cushion of the sofa an inch from her bare collarbone." }, { "beat_id": "beat.line.Day6.rehearsal.yes.006", "line_id": "line.Day6.rehearsal.yes.006", "revision": "1", "text": "“Don\'t tell me to get out when you\'ve already taken my coat.”" }, { "beat_id": "beat.line.Day6.rehearsal.yes.007", "line_id": "line.Day6.rehearsal.yes.007", "revision": "1", "text": "Lavinia\'s hand rises and closes hard around my wrist braced beside her neck—her nails pressing into the pulse point, holding my arm against her collarbone instead of pushing it away." }, { "beat_id": "beat.line.Day6.rehearsal.yes.008", "line_id": "line.Day6.rehearsal.yes.008", "revision": "1", "text": "When her hand loosens around my wrist, I give the closed notebook back to her." }] }, { "entry_id": "Day7", "lines": [{ "beat_id": "beat.line.Day7.one", "line_id": "line.Day7.one", "revision": "1", "text": "Outside the studio, visitors crowd the corridor with damp programmes." }, { "beat_id": "beat.line.Day7.002", "line_id": "line.Day7.002", "revision": "1", "text": "Inside the narrow warm-up room behind the stage, the crowd noise drops to a muffled hum through the double acoustic doors." }, { "beat_id": "beat.line.Day7.003", "line_id": "line.Day7.003", "revision": "1", "text": "Beside the dressing counter, Lavinia stands with her weight settled into her left hip. Her right heel stays half an inch clear of the floorboards—the exact guarded transfer from before she went away, when she insisted to the department that nothing was wrong." }, { "beat_id": "beat.line.Day7.004", "line_id": "line.Day7.004", "revision": "1", "text": "She holds her left wrist out between us. A thin gold chain hangs open across the bone, the tiny spring ring slipping from her thumb." }, { "beat_id": "beat.line.Day7.005", "line_id": "line.Day7.005", "revision": "1", "text": "“My hands are cold,” she says without looking up. “Do the clasp.”" }, { "beat_id": "beat.line.Day7.006", "line_id": "line.Day7.006", "revision": "1", "text": "Two fingers take the gold link. Beneath my thumb, the skin on the inside of her wrist is warm, not cold at all; the pulse beats fast and shallow just beneath the tendon before she has even stepped back onto the floor." }, { "beat_id": "beat.line.Day7.007", "line_id": "line.Day7.007", "revision": "1", "text": "The spring ring clicks shut." }, { "beat_id": "beat.line.Day7.008", "line_id": "line.Day7.008", "revision": "1", "text": "Instead of letting go, my thumb passes once over the closed gold clasp and rests in the hollow of her wrist." }, { "beat_id": "beat.line.Day7.009", "line_id": "line.Day7.009", "revision": "1", "text": "Lavinia does not draw her arm back." }, { "beat_id": "beat.line.Day7.010", "line_id": "line.Day7.010", "revision": "1", "text": "“You\'re taking a long time over one catch,” she says softly." }, { "beat_id": "beat.line.Day7.011", "line_id": "line.Day7.011", "revision": "1", "text": "“It\'s small.”" }, { "beat_id": "beat.line.Day7.012", "line_id": "line.Day7.012", "revision": "1", "text": "“Your hands aren\'t shaking.”" }, { "beat_id": "beat.line.Day7.013", "line_id": "line.Day7.013", "revision": "1", "text": "“Yours aren\'t cold.”" }, { "beat_id": "beat.line.Day7.014", "line_id": "line.Day7.014", "revision": "1", "text": "Her fingers curl once around the back of my wrist—holding my thumb against her pulse for the length of a breath—before she lets her arm fall to her side." }, { "beat_id": "beat.line.Day7.015", "line_id": "line.Day7.015", "revision": "1", "text": "On the dressing counter beside the rosin box lies a folded white card in Sylvia\'s neat, left-handed diagonal crease:" }, { "beat_id": "beat.line.Day7.016", "line_id": "line.Day7.016", "revision": "1", "text": "Quiet rest room reserved downstairs. Key at the desk if you want to leave by the lower gate." }, { "beat_id": "beat.line.Day7.017", "line_id": "line.Day7.017", "revision": "1", "text": "Lavinia sees where my gaze has stopped." }, { "beat_id": "beat.line.Day7.018", "line_id": "line.Day7.018", "revision": "1", "text": "“She left that before the first piece,” Lavinia says. “And the visitors in the front row asked for the second variation.”" }, { "beat_id": "beat.line.Day7.019", "line_id": "line.Day7.019", "revision": "1", "text": "“The programme only promised one.”" }, { "beat_id": "beat.line.Day7.020", "line_id": "line.Day7.020", "revision": "1", "text": "“I told the rehearsal director I\'d do the second.”" }, { "beat_id": "beat.line.Day7.021", "line_id": "line.Day7.021", "revision": "1", "text": "“With your right heel off the floor?”" }, { "beat_id": "beat.line.Day7.022", "line_id": "line.Day7.022", "revision": "1", "text": "“It won\'t take long.”" }, { "beat_id": "beat.line.Day7.023", "line_id": "line.Day7.023", "revision": "1", "text": "She bends toward the rosin box. Before her fingers reach the wood, her right knee gives a small, silent tremor under the skirt; her palm catches the edge of the counter and stays there a beat longer than the reach requires." }, { "beat_id": "beat.line.Day7.024", "line_id": "line.Day7.024", "revision": "1", "text": "“Don\'t say a word,” she says." }, { "beat_id": "beat.line.Day7.025", "line_id": "line.Day7.025", "revision": "1", "text": "“Nothing has been said.”" }, { "beat_id": "beat.line.Day7.026", "line_id": "line.Day7.026", "revision": "1", "text": "She straightens and looks toward the rear exit glass, where rain is streaking the courtyard light." }, { "beat_id": "beat.line.Day7.027", "line_id": "line.Day7.027", "revision": "1", "text": "“After the second piece,” she says, her English flat and clear, “I\'m taking the lower gate by myself. Not the bar. Not the flat. I want one evening where nobody is writing my schedule.”" }, { "beat_id": "beat.line.Day7.028", "line_id": "line.Day7.028", "revision": "1", "text": "Cross the second piece off the stage-door board while her back is turned." }] }, { "entry_id": "Day7.A", "lines": [{ "beat_id": "beat.line.Day7.A.001", "line_id": "line.Day7.A.001", "revision": "1", "text": "“If you go back out on that floor,” I say quietly, “I\'ll bring a chair onto the stage for you in the middle of the piece.”" }, { "beat_id": "beat.line.Day7.A.002", "line_id": "line.Day7.A.002", "revision": "1", "text": "Lavinia\'s hand stops an inch from the brass push-bar." }, { "beat_id": "beat.line.Day7.A.003", "line_id": "line.Day7.A.003", "revision": "1", "text": "“You wouldn\'t dare.”" }, { "beat_id": "beat.line.Day7.A.004", "line_id": "line.Day7.A.004", "revision": "1", "text": "“The form is on the counter. It only takes one signature.”" }, { "beat_id": "beat.line.Day7.A.005", "line_id": "line.Day7.A.005", "revision": "1", "text": "Lavinia turns slowly. Her chest rises fast; her eyes are bright and furious in the dressing-room light." }, { "beat_id": "beat.line.Day7.A.006", "line_id": "line.Day7.A.006", "revision": "1", "text": "“You really can\'t leave a single thing alone, can you?”" }, { "beat_id": "beat.line.Day7.A.007", "line_id": "line.Day7.A.007", "revision": "1", "text": "“Not when it\'s you.”" }, { "beat_id": "beat.line.Day7.A.008", "line_id": "line.Day7.A.008", "revision": "1", "text": "Beyond the wall, the stage manager announces that the session has concluded. Chairs scrape back; footsteps move toward the main hall. Lavinia lowers her hand from the brass bar and reaches for her street coat." }] }, { "entry_id": "Day7.B", "lines": [{ "beat_id": "beat.line.Day7.B.001", "line_id": "line.Day7.B.001", "revision": "1", "text": "My hand lifts toward her sleeve, then stops in the six inches of air between us without touching the wool." }, { "beat_id": "beat.line.Day7.B.002", "line_id": "line.Day7.B.002", "revision": "1", "text": "“Go on, then. Push the door open.”" }, { "beat_id": "beat.line.Day7.B.003", "line_id": "line.Day7.B.003", "revision": "1", "text": "Lavinia looks at my stopped hand, then at the heavy acoustic door." }, { "beat_id": "beat.line.Day7.B.004", "line_id": "line.Day7.B.004", "revision": "1", "text": "To depress the bar and swing the soundproof panel outward, she has to plant her right foot flat and drive her weight through the ankle. She shifts her stance once—and stops." }, { "beat_id": "beat.line.Day7.B.005", "line_id": "line.Day7.B.005", "revision": "1", "text": "In the narrow wire-glass strip of the door, her reflection watches mine." }, { "beat_id": "beat.line.Day7.B.006", "line_id": "line.Day7.B.006", "revision": "1", "text": "Through the wall, the stage manager thanks the visitors for attending and directs them toward the foyer. The window for the second piece closes while neither of us moves." }, { "beat_id": "beat.line.Day7.B.007", "line_id": "line.Day7.B.007", "revision": "1", "text": "Lavinia lets out a short, quiet breath that sounds almost like a laugh." }, { "beat_id": "beat.line.Day7.B.008", "line_id": "line.Day7.B.008", "revision": "1", "text": "“You knew I\'d wait a second too long,” she says, and reaches for her coat." }] }, { "entry_id": "Day7.C", "lines": [{ "beat_id": "beat.line.Day7.C.001", "line_id": "line.Day7.C.001", "revision": "1", "text": "“Don\'t open it,” I say quietly. “It wasn\'t only because of your leg.”" }, { "beat_id": "beat.line.Day7.C.002", "line_id": "line.Day7.C.002", "revision": "1", "text": "Lavinia\'s fingers stop on the brass push-bar. She does not turn around right away." }, { "beat_id": "beat.line.Day7.C.003", "line_id": "line.Day7.C.003", "revision": "1", "text": "“What did you say?”" }, { "beat_id": "beat.line.Day7.C.004", "line_id": "line.Day7.C.004", "revision": "1", "text": "“Before you went away. I told myself it was for your leg, and I told the department it was for your leg. But I sent the amendment without showing you because I knew that if you read it first, you would still get on the plane and leave me behind.”" }, { "beat_id": "beat.line.Day7.C.005", "line_id": "line.Day7.C.005", "revision": "1", "text": "Slowly, Lavinia turns her back to the acoustic door. Through the thick wood behind her shoulder, the stage manager announces that the session has ended. Neither of us looks toward the hall." }, { "beat_id": "beat.line.Day7.C.006", "line_id": "line.Day7.C.006", "revision": "1", "text": "“You made me wait four months to hear you say that without an excuse,” she whispers." }, { "beat_id": "beat.line.Day7.C.007", "line_id": "line.Day7.C.007", "revision": "1", "text": "“I\'m saying it now. Sit down and let me take your ribbons off.”" }, { "beat_id": "beat.line.Day7.C.008", "line_id": "line.Day7.C.008", "revision": "1", "text": "She sinks onto the wooden bench and reaches down with unsteady fingers; I kneel on the floorboards in front of her, untie the pale satin from her right ankle, and slip her street shoe onto her foot before we walk out to the rear door." }] }, { "entry_id": "Day7.D.default", "lines": [{ "beat_id": "beat.line.Day7.D.default.001", "line_id": "line.Day7.D.default.001", "revision": "1", "text": "“Sit down,” I say gently, smoothing the hair back from her temple as if nothing had happened at the door. “Put your street shoes on before your ankle stiffens.”" }, { "beat_id": "beat.line.Day7.D.default.002", "line_id": "line.Day7.D.default.002", "revision": "1", "text": "Lavinia sinks onto the wooden bench, her chest still rising fast, her eyes never leaving my face as I kneel at her feet, untie the rehearsal ribbons from her ankles, and slip both of her street shoes on for her. Before we step toward the rear passage, my hand lifts Sylvia\'s white lower-gate card from the counter and drops it into the bin beside the rosin box." }] }, { "entry_id": "Day7.D.pocket", "lines": [{ "beat_id": "beat.line.Day7.D.pocket.001", "line_id": "line.Day7.D.pocket.001", "revision": "1", "text": "While I button her street coat up to her chin, I take Sylvia\'s white lower-gate card from the counter, fold it once, and slip it into Lavinia\'s outer pocket before sliding my own hand in after it." }, { "beat_id": "beat.line.Day7.D.pocket.002", "line_id": "line.Day7.D.pocket.002", "revision": "1", "text": "“Keep the souvenir if you like,” I murmur against her ear. “We\'re taking the hill path.”" }, { "beat_id": "beat.line.Day7.D.pocket.003", "line_id": "line.Day7.D.pocket.003", "revision": "1", "text": "Lavinia laughs once—breathless and dark—before I kneel to slip her street shoes onto her feet." }] }, { "entry_id": "Day7.E", "lines": [{ "beat_id": "beat.line.Day7.E.001", "line_id": "line.Day7.E.001", "revision": "1", "text": "“Don\'t open it,” I say quietly. “It wasn\'t only because of your leg.”" }, { "beat_id": "beat.line.Day7.E.002", "line_id": "line.Day7.E.002", "revision": "1", "text": "Lavinia\'s fingers stop on the brass push-bar. She does not turn around right away." }, { "beat_id": "beat.line.Day7.E.003", "line_id": "line.Day7.E.003", "revision": "1", "text": "“What did you say?”" }, { "beat_id": "beat.line.Day7.E.004", "line_id": "line.Day7.E.004", "revision": "1", "text": "“Before you went away. I told myself it was for your leg, and I told the department it was for your leg. But I sent the amendment without showing you because I knew that if you read it first, you would still get on the plane and leave me behind.”" }, { "beat_id": "beat.line.Day7.E.005", "line_id": "line.Day7.E.005", "revision": "1", "text": "Slowly, Lavinia turns her back to the acoustic door. Through the thick wood behind her shoulder, the stage manager announces that the session has ended. Neither of us looks toward the hall." }, { "beat_id": "beat.line.Day7.E.006", "line_id": "line.Day7.E.006", "revision": "1", "text": "“You made me wait four months to hear you say that without an excuse,” she whispers." }, { "beat_id": "beat.line.Day7.E.007", "line_id": "line.Day7.E.007", "revision": "1", "text": "“I\'m saying it now. Sit down and let me take your ribbons off.”" }, { "beat_id": "beat.line.Day7.E.008", "line_id": "line.Day7.E.008", "revision": "1", "text": "She sinks onto the wooden bench and reaches down with unsteady fingers; I kneel on the floorboards in front of her, untie the pale satin from her right ankle, and slip her street shoe onto her foot before we walk out to the rear door." }, { "beat_id": "beat.line.Day7.E.009", "line_id": "line.Day7.E.009", "revision": "1", "text": "The stage manager knocked three minutes early." }, { "beat_id": "beat.line.Day7.E.010", "line_id": "line.Day7.E.010", "revision": "1", "text": "And through the frosted glass of the rear passage, the downstairs welfare desk—where Sylvia was scheduled to sit with the lower-gate key—is already dark, its chair folded against the wall, leaving only one unlocked exit to the courtyard." }, { "beat_id": "beat.line.Day7.E.011", "line_id": "line.Day7.E.011", "revision": "1", "text": "You." }, { "beat_id": "beat.line.Day7.E.012", "line_id": "line.Day7.E.012", "revision": "1", "text": "Seven days of mistimed clocks, rain showers, and reversed door cards, all narrowing like a corridor in a film to this bench." }, { "beat_id": "beat.line.Day7.E.013", "line_id": "line.Day7.E.013", "revision": "1", "text": "You wanted to see what remains when every other door is locked." }, { "beat_id": "beat.line.Day7.E.014", "line_id": "line.Day7.E.014", "revision": "1", "text": "Look closely, then." }] }, { "entry_id": "Day7.clipboard.default", "lines": [{ "beat_id": "beat.line.Day7.clipboard.default.001", "line_id": "line.Day7.clipboard.default.001", "revision": "1", "text": "The clipboard stays untouched on the hook; two steps place my shoulder directly between Lavinia and the inner studio door." }, { "beat_id": "beat.line.Day7.clipboard.default.002", "line_id": "line.Day7.clipboard.default.002", "revision": "1", "text": "“The stage manager already moved the next slot to the main hall,” I say." }, { "beat_id": "beat.line.Day7.clipboard.default.003", "line_id": "line.Day7.clipboard.default.003", "revision": "1", "text": "“He didn\'t tell me.”" }, { "beat_id": "beat.line.Day7.clipboard.default.004", "line_id": "line.Day7.clipboard.default.004", "revision": "1", "text": "“He asked me to tell you.”" }, { "beat_id": "beat.line.Day7.clipboard.default.005", "line_id": "line.Day7.clipboard.default.005", "revision": "1", "text": "Lavinia looks down at my empty hands, then up at my mouth." }, { "beat_id": "beat.line.Day7.clipboard.default.006", "line_id": "line.Day7.clipboard.default.006", "revision": "1", "text": "“You\'re lying.”" }, { "beat_id": "beat.line.Day7.clipboard.default.007", "line_id": "line.Day7.clipboard.default.007", "revision": "1", "text": "“Go out and ask him. You\'ll have to walk across the floor on that right leg in front of twenty-four people to do it.”" }] }, { "entry_id": "Day7.clipboard.yes", "lines": [{ "beat_id": "beat.line.Day7.clipboard.yes.001", "line_id": "line.Day7.clipboard.yes.001", "revision": "1", "text": "While Lavinia adjusts the cardigan over her shoulders, two silent steps reach the clipboard hanging beside the inner studio door." }, { "beat_id": "beat.line.Day7.clipboard.yes.002", "line_id": "line.Day7.clipboard.yes.002", "revision": "1", "text": "In the Second Variation / Floor Q&A row, one clean stroke of the pen crosses out Second Variation and writes beside it:" }, { "beat_id": "beat.line.Day7.clipboard.yes.003", "line_id": "line.Day7.clipboard.yes.003", "revision": "1", "text": "Session concluded. Clear hall." }, { "beat_id": "beat.line.Day7.clipboard.yes.004", "line_id": "line.Day7.clipboard.yes.004", "revision": "1", "text": "Behind her back, the pen cap clicks shut." }, { "beat_id": "beat.line.Day7.clipboard.yes.005", "line_id": "line.Day7.clipboard.yes.005", "revision": "1", "text": "“What did you just write?” Lavinia asks, turning around." }, { "beat_id": "beat.line.Day7.clipboard.yes.006", "line_id": "line.Day7.clipboard.yes.006", "revision": "1", "text": "“The visitor count exceeded the room limit. They have to clear the studio after the interlude.”" }, { "beat_id": "beat.line.Day7.clipboard.yes.007", "line_id": "line.Day7.clipboard.yes.007", "revision": "1", "text": "“There are twenty people out there.”" }, { "beat_id": "beat.line.Day7.clipboard.yes.008", "line_id": "line.Day7.clipboard.yes.008", "revision": "1", "text": "“Twenty-four. The fire notice says twenty.”" }] }, { "entry_id": "Day7.crossed.D", "lines": [{ "beat_id": "beat.line.Day7.crossed.D.001", "line_id": "line.Day7.crossed.D.001", "revision": "1", "text": "Before her fingertips touch the brass push-bar, my right hand closes around her left wrist—directly over the thin gold bracelet clasp—and draws her arm down from the door. My left palm plants flat against the heavy acoustic panel beside her cheek, holding the door shut with my weight." }, { "beat_id": "beat.line.Day7.crossed.D.002", "line_id": "line.Day7.crossed.D.002", "revision": "1", "text": "Lavinia\'s breath catches hard." }, { "beat_id": "beat.line.Day7.crossed.D.003", "line_id": "line.Day7.crossed.D.003", "revision": "1", "text": "“Let go.”" }, { "beat_id": "beat.line.Day7.crossed.D.004", "line_id": "line.Day7.crossed.D.004", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day7.crossed.D.005", "line_id": "line.Day7.crossed.D.005", "revision": "1", "text": "“Tell me right now that you sent that form for my leg,” she whispers fiercely against my mouth, her free hand twisting into the wool at my lapel. “Go on. Use your committee voice one more time.”" }, { "beat_id": "beat.line.Day7.crossed.D.006", "line_id": "line.Day7.crossed.D.006", "revision": "1", "text": "“It wasn\'t for your leg,” I whisper against her lips, every trace of polish gone, my voice softer than in the library and completely still. “You could have danced on it for another month. I altered the form because I couldn\'t bear the thought of someone else watching you in another city while I stayed here.”" }, { "beat_id": "beat.line.Day7.crossed.D.007", "line_id": "line.Day7.crossed.D.007", "revision": "1", "text": "Against the heavy wood, Lavinia\'s shoulders go rigid; her eyes widen an inch from mine." }] }, { "entry_id": "Day7.crossed.D.board", "lines": [{ "beat_id": "beat.line.Day7.crossed.D.board.001", "line_id": "line.Day7.crossed.D.board.001", "revision": "1", "text": "After I kneel to tie her street shoes and draw her coat over her shoulders, I pause for half a second beside the inner door where my black line strikes through Second Variation on the hanging clipboard." }, { "beat_id": "beat.line.Day7.crossed.D.board.002", "line_id": "line.Day7.crossed.D.board.002", "revision": "1", "text": "Lavinia looks at my handwriting on the board, then up at my mouth, her fingers tightening around mine as we turn toward the rear courtyard door." }] }, { "entry_id": "Day7.crossed.D.no_recording", "lines": [{ "beat_id": "beat.line.Day7.crossed.D.no_recording.001", "line_id": "line.Day7.crossed.D.no_recording.001", "revision": "1", "text": "“That\'s all?” she breathes." }, { "beat_id": "beat.line.Day7.crossed.D.no_recording.002", "line_id": "line.Day7.crossed.D.no_recording.002", "revision": "1", "text": "“No,” I whisper, sliding my right hand from her gold bracelet to lace tightly between her fingers and pressing our joined hands flat against the door panel beside her hip. “Two minutes ago I crossed your second piece off the stage manager\'s board behind your back.”" }, { "beat_id": "beat.line.Day7.crossed.D.no_recording.003", "line_id": "line.Day7.crossed.D.no_recording.003", "revision": "1", "text": "Through the thick soundproof panel two inches behind her head, the stage manager\'s voice announces to the crowd that the performance has concluded. Chairs scrape back; twenty-four pairs of footsteps file out into the corridor and fade away." }, { "beat_id": "beat.line.Day7.crossed.D.no_recording.004", "line_id": "line.Day7.crossed.D.no_recording.004", "revision": "1", "text": "The second piece is gone." }, { "beat_id": "beat.line.Day7.crossed.D.no_recording.005", "line_id": "line.Day7.crossed.D.no_recording.005", "revision": "1", "text": "Lavinia does not call out through the door, and she does not let go of my lapel. Instead, her free hand slides up from my collar into the hair at the back of my neck, her fingers locking hard at my nape as she pulls my mouth down to hers—her breath hot, trembling, and electric against my lips." }, { "beat_id": "beat.line.Day7.crossed.D.no_recording.006", "line_id": "line.Day7.crossed.D.no_recording.006", "revision": "1", "text": "“Ești un monstru,” she breathes against my mouth—and then in English, her forehead dropping hard against my collarbone: “You\'re completely monstrous.”" }] }, { "entry_id": "Day7.crossed.D.recording", "lines": [{ "beat_id": "beat.line.Day7.crossed.D.recording.001", "line_id": "line.Day7.crossed.D.recording.001", "revision": "1", "text": "“That\'s all?” she breathes." }, { "beat_id": "beat.line.Day7.crossed.D.recording.002", "line_id": "line.Day7.crossed.D.recording.002", "revision": "1", "text": "“No,” I whisper, sliding my right hand from her gold bracelet to lace tightly between her fingers and pressing our joined hands flat against the door panel beside her hip. “When you asked for an answer on Monday, I recorded Sylvia reading a line out of her novel and sent it to your phone so you wouldn\'t hear how badly I wanted you back. And two minutes ago I crossed your second piece off the stage manager\'s board behind your back.”" }, { "beat_id": "beat.line.Day7.crossed.D.recording.003", "line_id": "line.Day7.crossed.D.recording.003", "revision": "1", "text": "Through the thick soundproof panel two inches behind her head, the stage manager\'s voice announces to the crowd that the performance has concluded. Chairs scrape back; twenty-four pairs of footsteps file out into the corridor and fade away." }, { "beat_id": "beat.line.Day7.crossed.D.recording.004", "line_id": "line.Day7.crossed.D.recording.004", "revision": "1", "text": "The second piece is gone." }, { "beat_id": "beat.line.Day7.crossed.D.recording.005", "line_id": "line.Day7.crossed.D.recording.005", "revision": "1", "text": "Lavinia does not call out through the door, and she does not let go of my lapel. Instead, her free hand slides up from my collar into the hair at the back of my neck, her fingers locking hard at my nape as she pulls my mouth down to hers—her breath hot, trembling, and electric against my lips." }, { "beat_id": "beat.line.Day7.crossed.D.recording.006", "line_id": "line.Day7.crossed.D.recording.006", "revision": "1", "text": "“Ești un monstru,” she breathes against my mouth—and then in English, her forehead dropping hard against my collarbone: “You\'re completely monstrous.”" }] }, { "entry_id": "Day7.crossed.impulse", "lines": [{ "beat_id": "beat.line.Day7.crossed.impulse.001", "line_id": "line.Day7.crossed.impulse.001", "revision": "1", "text": "Through the double acoustic panel, applause rises and thins as the pianist finishes the interlude. In a moment the stage manager will check the door." }, { "beat_id": "beat.line.Day7.crossed.impulse.002", "line_id": "line.Day7.crossed.impulse.002", "revision": "1", "text": "Lavinia takes one step toward the brass push-bar. Her right heel touches the floorboards, hesitates for a fraction of a second, and takes her weight anyway." }, { "beat_id": "beat.line.Day7.crossed.impulse.003", "line_id": "line.Day7.crossed.impulse.003", "revision": "1", "text": "“Move, Priscilla,” she says. “I\'m doing the second piece, and then I\'m going home alone.”" }, { "beat_id": "beat.line.Day7.crossed.impulse.004", "line_id": "line.Day7.crossed.impulse.004", "revision": "1", "text": "Hold the door shut and give her the truth she\'s been trying to tear out of me all week." }] }, { "entry_id": "Day7.untouched.D", "lines": [{ "beat_id": "beat.line.Day7.untouched.D.001", "line_id": "line.Day7.untouched.D.001", "revision": "1", "text": "Before her fingertips touch the brass push-bar, my right hand closes around her left wrist—directly over the thin gold bracelet clasp—and draws her arm down from the door. My left palm plants flat against the heavy acoustic panel beside her cheek, holding the door shut with my weight." }, { "beat_id": "beat.line.Day7.untouched.D.002", "line_id": "line.Day7.untouched.D.002", "revision": "1", "text": "Lavinia\'s breath catches hard." }, { "beat_id": "beat.line.Day7.untouched.D.003", "line_id": "line.Day7.untouched.D.003", "revision": "1", "text": "“Let go.”" }, { "beat_id": "beat.line.Day7.untouched.D.004", "line_id": "line.Day7.untouched.D.004", "revision": "1", "text": "“No.”" }, { "beat_id": "beat.line.Day7.untouched.D.005", "line_id": "line.Day7.untouched.D.005", "revision": "1", "text": "“Tell me right now that you sent that form for my leg,” she whispers fiercely against my mouth, her free hand twisting into the wool at my lapel. “Go on. Use your committee voice one more time.”" }, { "beat_id": "beat.line.Day7.untouched.D.006", "line_id": "line.Day7.untouched.D.006", "revision": "1", "text": "“It wasn\'t for your leg,” I whisper against her lips, every trace of polish gone, my voice softer than in the library and completely still. “You could have danced on it for another month. I altered the form because I couldn\'t bear the thought of someone else watching you in another city while I stayed here.”" }, { "beat_id": "beat.line.Day7.untouched.D.007", "line_id": "line.Day7.untouched.D.007", "revision": "1", "text": "Against the heavy wood, Lavinia\'s shoulders go rigid; her eyes widen an inch from mine." }] }, { "entry_id": "Day7.untouched.D.board", "lines": [{ "beat_id": "beat.line.Day7.untouched.D.board.001", "line_id": "line.Day7.untouched.D.board.001", "revision": "1", "text": "After I kneel to tie her street shoes and draw her coat over her shoulders, I pause for half a second beside the inner door where Second Variation remains untouched on the hanging clipboard." }, { "beat_id": "beat.line.Day7.untouched.D.board.002", "line_id": "line.Day7.untouched.D.board.002", "revision": "1", "text": "Lavinia looks at the unchanged row on the board, then up at my mouth, her fingers tightening around mine as we turn toward the rear courtyard door." }] }, { "entry_id": "Day7.untouched.D.no_recording", "lines": [{ "beat_id": "beat.line.Day7.untouched.D.no_recording.001", "line_id": "line.Day7.untouched.D.no_recording.001", "revision": "1", "text": "Through the thick soundproof panel two inches behind her head, the stage manager\'s voice announces to the crowd that the performance has concluded. Chairs scrape back; twenty-four pairs of footsteps file out into the corridor and fade away." }, { "beat_id": "beat.line.Day7.untouched.D.no_recording.002", "line_id": "line.Day7.untouched.D.no_recording.002", "revision": "1", "text": "The second piece is gone." }, { "beat_id": "beat.line.Day7.untouched.D.no_recording.003", "line_id": "line.Day7.untouched.D.no_recording.003", "revision": "1", "text": "Lavinia does not call out through the door, and she does not let go of my lapel. Instead, her free hand slides up from my collar into the hair at the back of my neck, her fingers locking hard at my nape as she pulls my mouth down to hers—her breath hot, trembling, and electric against my lips." }, { "beat_id": "beat.line.Day7.untouched.D.no_recording.004", "line_id": "line.Day7.untouched.D.no_recording.004", "revision": "1", "text": "“Ești un monstru,” she breathes against my mouth—and then in English, her forehead dropping hard against my collarbone: “You\'re completely monstrous.”" }] }, { "entry_id": "Day7.untouched.D.recording", "lines": [{ "beat_id": "beat.line.Day7.untouched.D.recording.001", "line_id": "line.Day7.untouched.D.recording.001", "revision": "1", "text": "“That\'s all?” she breathes." }, { "beat_id": "beat.line.Day7.untouched.D.recording.002", "line_id": "line.Day7.untouched.D.recording.002", "revision": "1", "text": "“No,” I whisper, sliding my right hand from her gold bracelet to lace tightly between her fingers and pressing our joined hands flat against the door panel beside her hip. “When you asked for an answer on Monday, I recorded Sylvia reading a line out of her novel and sent it to your phone so you wouldn\'t hear how badly I wanted you back.”" }, { "beat_id": "beat.line.Day7.untouched.D.recording.003", "line_id": "line.Day7.untouched.D.recording.003", "revision": "1", "text": "Through the thick soundproof panel two inches behind her head, the stage manager\'s voice announces to the crowd that the performance has concluded. Chairs scrape back; twenty-four pairs of footsteps file out into the corridor and fade away." }, { "beat_id": "beat.line.Day7.untouched.D.recording.004", "line_id": "line.Day7.untouched.D.recording.004", "revision": "1", "text": "The second piece is gone." }, { "beat_id": "beat.line.Day7.untouched.D.recording.005", "line_id": "line.Day7.untouched.D.recording.005", "revision": "1", "text": "Lavinia does not call out through the door, and she does not let go of my lapel. Instead, her free hand slides up from my collar into the hair at the back of my neck, her fingers locking hard at my nape as she pulls my mouth down to hers—her breath hot, trembling, and electric against my lips." }, { "beat_id": "beat.line.Day7.untouched.D.recording.006", "line_id": "line.Day7.untouched.D.recording.006", "revision": "1", "text": "“Ești un monstru,” she breathes against my mouth—and then in English, her forehead dropping hard against my collarbone: “You\'re completely monstrous.”" }] }, { "entry_id": "Day7.untouched.impulse", "lines": [{ "beat_id": "beat.line.Day7.untouched.impulse.001", "line_id": "line.Day7.untouched.impulse.001", "revision": "1", "text": "Through the double acoustic panel, applause rises and thins as the pianist finishes the interlude. In a moment the stage manager will check the door." }, { "beat_id": "beat.line.Day7.untouched.impulse.002", "line_id": "line.Day7.untouched.impulse.002", "revision": "1", "text": "Lavinia takes one step toward the brass push-bar. Her right heel touches the floorboards, hesitates for a fraction of a second, and takes her weight anyway." }, { "beat_id": "beat.line.Day7.untouched.impulse.003", "line_id": "line.Day7.untouched.impulse.003", "revision": "1", "text": "“Move, Priscilla,” she says. “I\'m doing the second piece, and then I\'m going home alone.”" }, { "beat_id": "beat.line.Day7.untouched.impulse.004", "line_id": "line.Day7.untouched.impulse.004", "revision": "1", "text": "Hold the door shut and give her the truth she\'s been trying to tear out of me all week." }] }, { "entry_id": "ending.alone.normal", "lines": [{ "beat_id": "beat.line.ending.alone.normal.001", "line_id": "line.ending.alone.normal.001", "revision": "1", "text": "At the rear doors of the building, the evening rain falls straight down through the courtyard lamp light." }, { "beat_id": "beat.line.ending.alone.normal.002", "line_id": "line.ending.alone.normal.002", "revision": "1", "text": "The long black umbrella stands in the rack beside the threshold." }, { "beat_id": "beat.line.ending.alone.normal.003", "line_id": "line.ending.alone.normal.003", "revision": "1", "text": "My right hand takes the curved wooden handle; my shoulder pushes the heavy door outward, and my thumb presses the catch." }, { "beat_id": "beat.line.ending.alone.normal.004", "line_id": "line.ending.alone.normal.004", "revision": "1", "text": "The black canopy opens with a soft thrum against the wet air." }, { "beat_id": "beat.line.ending.alone.normal.005", "line_id": "line.ending.alone.normal.005", "revision": "1", "text": "On the stone threshold, Lavinia buttons her coat to the chin. The heavy canvas bag hangs from her right shoulder." }, { "beat_id": "beat.line.ending.alone.normal.006", "line_id": "line.ending.alone.normal.006", "revision": "1", "text": "Without asking, my left hand slips the canvas strap off her shoulder and settles it over my own arm." }, { "beat_id": "beat.line.ending.alone.normal.007", "line_id": "line.ending.alone.normal.007", "revision": "1", "text": "Then I extend the umbrella over the top step—the wooden handle held in my right hand, tilting the canopy three inches toward my own side." }, { "beat_id": "beat.line.ending.alone.normal.008", "line_id": "line.ending.alone.normal.008", "revision": "1", "text": "On the wet stone, the dry circle is barely wide enough for two pairs of shoes." }, { "beat_id": "beat.line.ending.alone.normal.009", "line_id": "line.ending.alone.normal.009", "revision": "1", "text": "Lavinia looks at the rain falling past the black rim, then at the narrow dry space flush against my dry coat." }, { "beat_id": "beat.line.ending.alone.normal.010", "line_id": "line.ending.alone.normal.010", "revision": "1", "text": "“That isn\'t very wide,” she says." }, { "beat_id": "beat.line.ending.alone.normal.011", "line_id": "line.ending.alone.normal.011", "revision": "1", "text": "“It\'s the same umbrella as Tuesday.”" }, { "beat_id": "beat.line.ending.alone.normal.012", "line_id": "line.ending.alone.normal.012", "revision": "1", "text": "“You\'re holding it differently.”" }, { "beat_id": "beat.line.ending.alone.normal.013", "line_id": "line.ending.alone.normal.013", "revision": "1", "text": "“Come here.”" }, { "beat_id": "beat.line.ending.alone.normal.014", "line_id": "line.ending.alone.normal.014", "revision": "1", "text": "For a second she stands under the stone lintel." }, { "beat_id": "beat.line.ending.alone.normal.015", "line_id": "line.ending.alone.normal.015", "revision": "1", "text": "Then she steps out under the canopy—close enough that her left arm presses the full length of my coat from shoulder to hip, her right foot taking the first step down with no weight on the turn." }, { "beat_id": "beat.line.ending.alone.normal.016", "line_id": "line.ending.alone.normal.016", "revision": "1", "text": "At the bottom of the walk, where the hillside path divides toward the station and the flats, she does not look toward the station." }, { "beat_id": "beat.line.ending.alone.normal.017", "line_id": "line.ending.alone.normal.017", "revision": "1", "text": "Her left hand slips inside the pocket of my coat, where five fingers are already waiting to close around hers." }, { "beat_id": "beat.line.ending.alone.normal.018", "line_id": "line.ending.alone.normal.018", "revision": "1", "text": "“What time are you coming tomorrow?” she asks." }, { "beat_id": "beat.line.ending.alone.normal.019", "line_id": "line.ending.alone.normal.019", "revision": "1", "text": "“Whenever you wake up.”" }, { "beat_id": "beat.line.ending.alone.normal.020", "line_id": "line.ending.alone.normal.020", "revision": "1", "text": "“That isn\'t a time.”" }, { "beat_id": "beat.line.ending.alone.normal.021", "line_id": "line.ending.alone.normal.021", "revision": "1", "text": "“Before then.”" }, { "beat_id": "beat.line.ending.alone.normal.022", "line_id": "line.ending.alone.normal.022", "revision": "1", "text": "Lavinia laughs once under her breath, rests her temple against my shoulder beneath the black canopy, and lets the turn take us up the hill." }] }], "kind": "scene_caption_registry", "schema_version": 1 }, "challenges": [{ "board_profile_id": "week.canonical_solo", "challenge_id": "Day1.challenge", "end_marker_id": "Day1.reading.end", "entry_id": "Day1.reading", "playable_marker_id": "Day1.reading.playable", "targets": { "lost": "target.Day1.result.D", "never_started": "target.Day1.result.A", "perfect": "target.Day1.result.E", "unfinished": "target.Day1.result.B", "won": "target.Day1.result.C" } }, { "board_profile_id": "week.canonical_solo", "challenge_id": "Day2.challenge", "end_marker_id": "Day2.answer.end", "entry_id": "Day2.answer", "playable_marker_id": "Day2.answer.playable", "targets": { "lost": "target.Day2.result.D", "never_started": "target.Day2.result.A", "perfect": "target.Day2.result.E", "unfinished": "target.Day2.result.B", "won": "target.Day2.result.C" } }, { "board_profile_id": "week.canonical_solo", "challenge_id": "Day3.lavinia.challenge", "end_marker_id": "Day3.lavinia.end", "entry_id": "Day3.lavinia", "playable_marker_id": "Day3.lavinia.playable", "targets": { "lost": "target.Day3.lavinia.result.D", "never_started": "target.Day3.lavinia.result.A", "perfect": "target.Day3.lavinia.result.E", "unfinished": "target.Day3.lavinia.result.B", "won": "target.Day3.lavinia.result.C" } }, { "board_profile_id": "week.canonical_solo", "challenge_id": "Day3.sylvia.challenge", "end_marker_id": "Day3.sylvia.end", "entry_id": "Day3.sylvia", "playable_marker_id": "Day3.sylvia.playable", "targets": { "lost": "target.Day3.sylvia.result.D", "never_started": "target.Day3.sylvia.result.A", "perfect": "target.Day3.sylvia.result.E", "unfinished": "target.Day3.sylvia.result.B", "won": "target.Day3.sylvia.result.C" } }, { "board_profile_id": "week.canonical_solo", "challenge_id": "Day4.challenge", "end_marker_id": "Day4.impulse.end", "entry_id": "Day4.impulse", "playable_marker_id": "Day4.impulse.playable", "targets": { "lost": "target.Day4.D", "never_started": "target.Day4.A", "perfect": "target.Day4.E", "unfinished": "target.Day4.B", "won": "target.Day4.C" } }, { "board_profile_id": "week.canonical_solo", "challenge_id": "Day5.challenge", "end_marker_id": "Day5.impulse.end", "entry_id": "Day5.impulse", "playable_marker_id": "Day5.impulse.playable", "targets": { "lost": "target.Day5.D", "never_started": "target.Day5.A", "perfect": "target.Day5.E", "unfinished": "target.Day5.B", "won": "target.Day5.C" } }, { "board_profile_id": "week.canonical_solo", "challenge_id": "Day6.challenge", "end_marker_id": "Day6.impulse.end", "entry_id": "Day6.impulse", "playable_marker_id": "Day6.impulse.playable", "targets": { "lost": "target.Day6.D", "never_started": "target.Day6.A", "perfect": "target.Day6.E", "unfinished": "target.Day6.B", "won": "target.Day6.C" } }, { "board_profile_id": "week.canonical_solo", "challenge_id": "Day7.crossed.challenge", "end_marker_id": "Day7.crossed.impulse.end", "entry_id": "Day7.crossed.impulse", "playable_marker_id": "Day7.crossed.impulse.playable", "targets": { "lost": "target.Day7.crossed.D", "never_started": "target.Day7.A", "perfect": "target.Day7.E", "unfinished": "target.Day7.B", "won": "target.Day7.C" } }, { "board_profile_id": "week.canonical_solo", "challenge_id": "Day7.untouched.challenge", "end_marker_id": "Day7.untouched.impulse.end", "entry_id": "Day7.untouched.impulse", "playable_marker_id": "Day7.untouched.impulse.playable", "targets": { "lost": "target.Day7.untouched.D", "never_started": "target.Day7.A", "perfect": "target.Day7.E", "unfinished": "target.Day7.B", "won": "target.Day7.C" } }], "contact_definitions": { "kind": "scene_contact_definitions", "messages": [], "replies": [], "schema_version": 1 }, "contacts": [], "context_registry": { "kind": "dialogic_frozen_context_registry", "schema_version": 1, "schemas": [{ "entry_id": "Day1", "fields": { "admission_receipt_id": "id", "entry_id": { "const": "Day1" }, "entry_role": { "const": "scene" }, "occurrence_id": "id" }, "schema_id": "context.scene.Day1.v1", "schema_version": 1 }, { "entry_id": "Day1.coda", "fields": { "admission_receipt_id": "id", "entry_id": { "const": "Day1.coda" }, "entry_role": { "const": "scene" }, "occurrence_id": "id" }, "schema_id": "context.scene.Day1.coda.v1", "schema_version": 1 }, { "entry_id": "Day1.photo.default", "fields": { "admission_receipt_id": "id", "entry_id": { "const": "Day1.photo.default" }, "entry_role": { "const": "scene" }, "occurrence_id": "id" }, "schema_id": "context.scene.Day1.photo.default.v1", "schema_version": 1 }, { "entry_id": "Day1.photo.yes", "fields": { "admission_receipt_id": "id", "entry_id": { "const": "Day1.photo.yes" }, "entry_role": { "const": "scene" }, "occurrence_id": "id" }, "schema_id": "context.scene.Day1.photo.yes.v1", "schema_version": 1 }, { "entry_id": "Day1.reading", "fields": { "admission_receipt_id": "id", "entry_id": { "const": "Day1.reading" }, "entry_role": { "const": "scene" }, "occurrence_id": "id" }, "schema_id": "context.scene.Day1.reading.v1", "schema_version": 1 }, { "entry_id": "Day1.result.A", "fields": { "admission_receipt_id": "id", "entry_id": { "const": "Day1.result.A" }, "entry_role": { "const": "scene" }, "occurrence_id": "id" }, "schema_id": "context.scene.Day1.result.A.v1", "schema_version": 1 }, { "entry_id": "Day1.result.B", "fields": { "admission_receipt_id": "id", "entry_id": { "const": "Day1.result.B" }, "entry_role": { "const": "scene" }, "occurrence_id": "id" }, "schema_id": "context.scene.Day1.result.B.v1", "schema_version": 1 }, { "entry_id": "Day1.result.C", "fields": { "admission_receipt_id": "id", "entry_id": { "const": "Day1.result.C" }, "entry_role": { "const": "scene" }, "occurrence_id": "id" }, "schema_id": "context.scene.Day1.result.C.v1", "schema_version": 1 }, { "entry_id": "Day1.result.D", "fields": { "admission_receipt_id": "id", "entry_id": { "const": "Day1.result.D" }, "entry_role": { "const": "scene" }, "occurrence_id": "id" }, "schema_id": "context.scene.Day1.result.D.v1", "schema_version": 1 }, { "entry_id": "Day1.result.E", "fields": { "admission_receipt_id": "id", "entry_id": { "const": "Day1.result.E" }, "entry_role": { "const": "scene" }, "occurrence_id": "id" }, "schema_id": "context.scen