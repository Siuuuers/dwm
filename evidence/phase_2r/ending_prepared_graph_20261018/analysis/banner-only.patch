+    def test_pinned_engine_banner_accepts_only_exact_source_supported_forms(self):
+        prefix = "Godot Engine v4.6.3.stable.dwm_publication_probe_v1.35e80b3a8"
+        website = " - https://godotengine.org"
+        for case, banner, accepted in [
+            ("exact dated banner", prefix + " (2026-05-20 13:47:53 UTC)" + website, True),
+            ("exact undated banner", prefix + website, True),
+            ("wrong commit timestamp", prefix + " (2026-05-20 13:47:54 UTC)" + website, False),
+            ("wrong commit identity", prefix.replace("35e80b3a8", "35e80b3a9") + website, False),
+        ]:
+            with self.subTest(case=case):
+                data = fixture(READER)
+                data["banner"] = banner
+                if accepted:
+                    code, report = self.execute(case, data)
+                    self.assertEqual(code, 0, report)
+                    self.assertTrue(report["binding_ok"])
+                    self.assertEqual(report["observed_engine_banner"], banner)
+                else:
+                    self.refused(case, data, "different native engine")
+
