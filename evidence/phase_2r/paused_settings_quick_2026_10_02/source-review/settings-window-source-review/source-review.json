  "findings": [
    {
      "id": "native_popup_contacts",
      "basis": [
        "scene/main/viewport.cpp:3464",
        "scene/main/viewport.cpp:3501",
        "scene/main/window.cpp:1879",
        "scene/gui/option_button.cpp:651"
      ],
      "conclusion": "Embedded subwindow dispatch returns before parent _input. OptionButton owns an internal PopupMenu. A contact pressed in Settings and released in that popup bypassed the shared parent ledger; popup-only presses were also absent. Visibility snapshots alone cannot observe packets that never reached the ledger.",
      "classification": "Production input-custody gap inferred from exact engine and project source; cloud regression required."
    },
    {
      "id": "reset_dispatch_fixture",
      "basis": [
        "scene/main/window.cpp:1897",
        "scene/gui/dialogs.cpp:39",
        "scene/gui/dialogs.cpp:144"
      ],
      "conclusion": "Direct Window.push_input bypasses Window::_input_from_window, where AcceptDialog recognizes native Escape. Cancel schedules hide deferred. The original test therefore never canceled its native dialog; later Quick assertions failed behind that still-open owner. The revised test enters through the embedded parent viewport and resumes at the real hide signal before the immediate held-contact retry.",
      "classification": "Focus1 observed test failure, explained by exact engine dispatch."
    },
    {
      "id": "single_owner_fix",
      "basis": [
        "scripts/ui/pause/PauseQuickCommands.gd:11",
        "scripts/ui/pause/PauseQuickCommands.gd:71",
        "scripts/ui/pause/PauseSurface.gd:307"
      ],
      "conclusion": "Each mounted Settings Window gets a private ALWAYS input observer forwarding to the existing InputManager and immediately retaining those contacts. No visibility guard drops final packets after native hiding; visibility signals also retire contacts synchronously. No second contact ledger, Save owner, or durable format is introduced. Settings F5 admission remains action-specific; F9 is outside this bounded admission."
    }
  ],
