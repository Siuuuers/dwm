diff --git a/tests/integration/startup_new_acc_attribution.gd b/tests/integration/startup_new_acc_attribution.gd
new file mode 100644
--- /dev/null
+++ b/tests/integration/startup_new_acc_attribution.gd
@@ -0,0 +1,143 @@
+extends Node
+## Native project main scene, FINAL bootstrap, actual viewport clicks; diagnostic only.
+const TIMING := preload("res://tests/support/StartupAttributionTiming.gd")
+const VALIDATION := preload("res://scripts/narrative/SceneValidationTiming.gd")
+const FIRST_LINE := "line.Day1.one"
+const FIRST_EN := "Sylvia slides the fuller teacup onto my mat and keeps the one with the small chip on the rim for herself."
+var folder := OS.get_environment("DWM_STARTUP_OUTPUT")
+var phase := OS.get_environment("DWM_STARTUP_CASE")
+var milestones: Dictionary = {}
+var failures: Array[String] = []
+var max_frame_gap_us := 0
+var previous_frame_us := 0
+var profiling := false
+var observation: Dictionary = {}
+
+func _ready() -> void:
+	get_tree().process_frame.connect(_frame)
+	_run.call_deferred()
+
+func _frame() -> void:
+	var now := Time.get_ticks_usec()
+	if previous_frame_us > 0: max_frame_gap_us = maxi(max_frame_gap_us, now - previous_frame_us)
+	previous_frame_us = now
+
+func _mark(key: String) -> void:
+	milestones[key] = TIMING.stamp()
+
+func _check(ok: bool, message: String) -> bool:
+	if ok: return true
+	failures.append(message)
+	_finish(false)
+	return false
+
+func _capture(name_: String) -> bool:
+	var image := get_viewport().get_texture().get_image()
+	return not image.is_empty() and image.save_png(folder.path_join(name_ + ".png")) == OK
+
+func _click(control: Control) -> void:
+	var point := control.get_global_transform_with_canvas() * (control.size / 2.0)
+	for down: bool in [true, false]:
+		var event := InputEventMouseButton.new()
+		event.position = point
+		event.global_position = point
+		event.button_index = MOUSE_BUTTON_LEFT
+		event.pressed = down
+		get_viewport().push_input(event, true)
+		await get_tree().process_frame
+
+func _run() -> void:
+	var user_path := ProjectSettings.globalize_path("user://").replace("\\", "/").to_lower()
+	var appdata := OS.get_environment("APPDATA").replace("\\", "/").to_lower()
+	if not _check(not folder.is_empty() and phase in ["fresh", "retained"] and not appdata.is_empty()
+			and user_path.begins_with(appdata + "/") and DisplayServer.get_name() != "headless", "isolated rendered invocation required"): return
+	var tree := get_tree()
+	var bootstrap: Node = tree.root.get_node("ApplicationBootstrap")
+	var deadline := Time.get_ticks_msec() + 300000
+	var menu: Node
+	var button: Button
+	while Time.get_ticks_msec() < deadline:
+		menu = tree.current_scene
+		if menu != null and menu.has_node("%NewAccButton") and bootstrap.get_startup_state().get("ready", false):
+			button = menu.get_node("%NewAccButton")
+			if button.is_visible_in_tree() and not button.disabled and not menu._title_transition: break
+		await tree.process_frame
+	if not _check(is_instance_valid(button) and button.is_visible_in_tree() and not button.disabled
+			and bootstrap.get_startup_state().get("ready", false), "Title did not become usable"): return
+	await RenderingServer.frame_post_draw
+	_mark("title_drawn_usable")
+	if not _check(_capture("title"), "Title screenshot failed"): return
+	var saves: Node = tree.root.get_node("SaveManager")
+	var bridge: Node = tree.root.get_node("DialogicBridge")
+	var game: Node = tree.root.get_node("GameState")
+	profiling = VALIDATION.begin_scope("new_acc_" + phase, "", "", 0)
+	previous_frame_us = Time.get_ticks_usec()
+	max_frame_gap_us = 0
+	_mark("new_acc_input")
+	await _click(button)
+	var confirmed := false
+	deadline = Time.get_ticks_msec() + 300000
+	var caption: Node
+	while Time.get_ticks_msec() < deadline:
+		if is_instance_valid(menu) and is_instance_valid(menu._confirmation) and menu._confirmation.is_visible_in_tree() and not menu._title_transition:
+			if not _check(phase == "retained" and not confirmed and not str(menu._new_acc_token).is_empty()
+					and not menu._confirmation.confirm_button.disabled, "unexpected or invalid New Acc consent"): return
+			await RenderingServer.frame_post_draw
+			_mark("consent_drawn")
+			if not _check(_capture("consent"), "consent screenshot failed"): return
+			confirmed = true
+			previous_frame_us = Time.get_ticks_usec() # Exclude deliberate screenshot dwell from frame-gap sampling.
+			_mark("confirm_input")
+			await _click(menu._confirmation.confirm_button)
+		caption = tree.root.get_node("SceneRouter")._production_pause._find_caption(tree.root)
+		if is_instance_valid(caption) and caption.caption_text.is_visible_in_tree():
+			if not milestones.has("caption_first_visible"): _mark("caption_first_visible")
+			var native: Node = caption.caption_text
+			var event: DialogicTextEvent = bridge._runtime_adapter._current_skip_text(true)
+			if bridge._runtime_adapter.current_line_id() == FIRST_LINE and event != null \
+					and event.state == DialogicTextEvent.States.DONE and not native.revealing \
+					and native.visible_ratio == 1.0 and bridge.is_current_line_presentation_acknowledged() \
+					and not saves._new_run_busy and game.capture_live_session().value.active:
+				await RenderingServer.frame_post_draw
+				_mark("caption_complete_drawn_idle")
+				observation = {"line_id": FIRST_LINE, "text": native.get_parsed_text(),
+					"visible": native.is_visible_in_tree(), "revealing": native.revealing,
+					"visible_ratio": native.visible_ratio, "event_done": true,
+					"new_run_busy": saves._new_run_busy, "active": game.capture_live_session().value.active}
+				break
+		await tree.process_frame
+	if not _check(not observation.is_empty() and confirmed == (phase == "retained"), "first caption or expected consent not reached"): return
+	if profiling:
+		VALIDATION.end_scope(true)
+		profiling = false
+	var locale: String = tree.root.get_node("LocalizationManager").get_locale()
+	var texts: Dictionary = load("res://scripts/localization/StoryLocalization.gd").catalog(locale)
+	if not _check(observation.text == texts.get(FIRST_LINE, FIRST_EN), "first caption text differs from authored text"): return
+	var incomplete: Dictionary = saves._continuation_journal.list_incomplete()
+	if not _check(incomplete.get("ok", false) and incomplete.value.is_empty(), "New Acc left incomplete journal operations"): return
+	if not _check(_capture("caption"), "caption screenshot failed"): return
+	_finish(true)
+
+func _finish(ok: bool) -> void:
+	if profiling:
+		VALIDATION.end_scope(false)
+		profiling = false
+	var rendering := {}
+	for method: String in ["get_current_rendering_method", "get_current_rendering_driver_name", "get_video_adapter_name", "get_video_adapter_api_version"]:
+		if RenderingServer.has_method(method): rendering[method] = RenderingServer.call(method)
+	var profile: Node = get_tree().root.get_node("ProfileManager")
+	var preferences := {}
+	for key: String in ["preferences.accessibility.text_size", "preferences.accessibility.font_style", "preferences.reading.reveal_speed", "preferences.reading.auto_enabled"]:
+		preferences[key] = profile.get_preference(key, null)
+	var report := {"complete": ok, "case": phase, "milestones": milestones, "phases": TIMING.rows,
+		"observation": observation, "failures": failures, "max_new_acc_frame_gap_us": max_frame_gap_us,
+		"engine": Engine.get_version_info(), "rendering": rendering, "preferences": preferences,
+		"user_path": ProjectSettings.globalize_path("user://"), "argv": OS.get_cmdline_args(),
+		"scope": "Instrumented native project launch; inclusive phases overlap. Natural default text reveal. Consent screenshot dwell separate. Two same-runner processes; fresh means empty user profile, not cold OS disk cache. No performance acceptance threshold or user-device claim."}
+	var output := FileAccess.open(folder.path_join("results.json"), FileAccess.WRITE)
+	if output != null:
+		output.store_string(JSON.stringify(report, "\t") + "\n")
+		output.close()
+	else: ok = false
+	print("STARTUP_NEW_ACC_ATTRIBUTION ", JSON.stringify(report))
+	get_tree().quit(0 if ok else 1)
diff --git a/tests/support/StartupAttributionTiming.gd b/tests/support/StartupAttributionTiming.gd
new file mode 100644
--- /dev/null
+++ b/tests/support/StartupAttributionTiming.gd
@@ -0,0 +1,10 @@
+extends RefCounted
+## Temporary diagnostic-branch instrumentation. Inclusive phases overlap.
+static var rows: Array[Dictionary] = []
+static func stamp() -> Dictionary:
+	return {"ticks_us": Time.get_ticks_usec(), "unix_ms": Time.get_unix_time_from_system() * 1000.0}
+static func finish(phase: String, began: Dictionary, ok: bool = true) -> void:
+	if OS.get_environment("DWM_STARTUP_ATTRIBUTION") != "1": return
+	var ended := stamp()
+	rows.append({"phase": phase, "start": began, "end": ended,
+		"elapsed_us": int(ended.ticks_us) - int(began.ticks_us), "ok": ok})
diff --git a/tools/testing/Invoke-StartupNewAccAttribution.ps1 b/tools/testing/Invoke-StartupNewAccAttribution.ps1
new file mode 100644
--- /dev/null
+++ b/tools/testing/Invoke-StartupNewAccAttribution.ps1
@@ -0,0 +1,101 @@
+#requires -Version 7.0
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+if (-not $IsWindows) { throw 'Windows cloud runner required.' }
+$repositoryRoot = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../..'))
+$output = Join-Path $repositoryRoot '.godot/ci/startup-newacc'
+if (Test-Path -LiteralPath $output) { throw 'Fresh diagnostic output required.' }
+New-Item -ItemType Directory -Path $output | Out-Null
+$engine = $env:GODOT_CONSOLE_PATH
+if (-not (Test-Path -LiteralPath $engine -PathType Leaf)) { throw 'Pinned Godot executable required.' }
+$record = [ordered]@{
+    source_ref = (git -C $repositoryRoot rev-parse HEAD).Trim()
+    runtime_base = '88e44efbf6d65cc3b70118e73923eb408db98b7e'
+    renderer_request = 'ProjectDefault'; status = 'started'; processes = @()
+    engine_sha256 = (Get-FileHash -LiteralPath $engine -Algorithm SHA256).Hash.ToLowerInvariant()
+    source_hashes = @{}; font_hashes = @{}
+    clock_note = 'External launch UTC and child UTC share one host; launch intervals have millisecond wall-clock precision. Named child intervals use monotonic microseconds. Pre-bootstrap includes native renderer, autoload/preload and diagnostic attachment; it does not attribute that entire interval to resources.'
+}
+foreach ($relative in @('autoload/ApplicationBootstrap.gd', 'autoload/SaveManager.gd', 'scripts/ui/MenuScene.gd',
+    'tests/integration/startup_new_acc_attribution.gd', 'tests/support/StartupAttributionTiming.gd',
+    'tools/testing/Invoke-StartupNewAccAttribution.ps1', 'scripts/ui/UiTypography.gd', 'project.godot',
+    'data/manifests/scene_story_registration.json')) {
+    $record.source_hashes[$relative] = (Get-FileHash -LiteralPath (Join-Path $repositoryRoot $relative) -Algorithm SHA256).Hash.ToLowerInvariant()
+}
+foreach ($font in @(git -C $repositoryRoot ls-files '*.ttf' '*.otf' '*.woff' '*.woff2')) {
+    $record.font_hashes[$font] = (Get-FileHash -LiteralPath (Join-Path $repositoryRoot $font) -Algorithm SHA256).Hash.ToLowerInvariant()
+}
+try {
+    foreach ($case in @('fresh', 'retained')) {
+        $caseOutput = Join-Path $output $case
+        New-Item -ItemType Directory -Path $caseOutput | Out-Null
+        $argv = @('--path', $repositoryRoot, '--audio-driver', 'Dummy', '--windowed', '--resolution', '1280x720',
+            '--log-file', (Join-Path $caseOutput 'render.log'))
+        $start = [Diagnostics.ProcessStartInfo]::new()
+        $start.FileName = $engine; $start.WorkingDirectory = $repositoryRoot
+        $start.UseShellExecute = $false; $start.RedirectStandardOutput = $true; $start.RedirectStandardError = $true
+        foreach ($argument in $argv) { $start.ArgumentList.Add($argument) }
+        foreach ($key in @('APPDATA', 'LOCALAPPDATA', 'DWM_TEST_ROOT')) {
+            $value = Join-Path $output "shared-user/$key"
+            New-Item -ItemType Directory -Path $value -Force | Out-Null
+            $start.Environment[$key] = $value
+        }
+        $start.Environment['DWM_STARTUP_ATTRIBUTION'] = '1'
+        $start.Environment['DWM_SCENE_VALIDATION_PROFILE'] = '1'
+        $start.Environment['DWM_STARTUP_CASE'] = $case
+        $start.Environment['DWM_STARTUP_OUTPUT'] = $caseOutput
+        $processRecord = [ordered]@{ case = $case; argv = $argv; clean_exit = $false; timed_out = $false }
+        $record.processes += $processRecord
+        $process = $null
+        try {
+            $clock = [Diagnostics.Stopwatch]::StartNew()
+            $processRecord.launch_unix_ms = [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()
+            $process = [Diagnostics.Process]::Start($start)
+            $processRecord.pid = $process.Id
+            $stdout = $process.StandardOutput.ReadToEndAsync()
+            $stderr = $process.StandardError.ReadToEndAsync()
+            $finished = $process.WaitForExit(600000)
+            if (-not $finished) {
+                $processRecord.timed_out = $true
+                $process.Kill($true)
+                $process.WaitForExit(10000) | Out-Null
+            }
+            $clock.Stop()
+            $processRecord.lifetime_ms = $clock.Elapsed.TotalMilliseconds
+            if (-not [Threading.Tasks.Task]::WaitAll([Threading.Tasks.Task[]]@($stdout, $stderr), 10000)) { throw 'Output did not close.' }
+            $stdout.Result | Set-Content -LiteralPath (Join-Path $caseOutput 'stdout.log') -Encoding utf8
+            $stderr.Result | Set-Content -LiteralPath (Join-Path $caseOutput 'stderr.log') -Encoding utf8
+            $processRecord.exit_code = $process.ExitCode
+            $processRecord.clean_exit = $finished -and $process.ExitCode -eq 0
+            $report = Get-Content -LiteralPath (Join-Path $caseOutput 'results.json') -Raw | ConvertFrom-Json -AsHashtable
+            $text = $stdout.Result + $stderr.Result + (Get-Content -LiteralPath (Join-Path $caseOutput 'render.log') -Raw)
+            if (-not $processRecord.clean_exit -or -not $report.complete -or $report.failures.Count -ne 0 -or
+                $text -match 'SCRIPT ERROR:|ERROR: Failed to load|Unicode parsing error|Unexpected NUL character') { throw "$case diagnostic failed." }
+            $bootstrap = @($report.phases | Where-Object phase -eq 'bootstrap.total')
+            if ($bootstrap.Count -ne 1) { throw 'Expected one FINAL bootstrap.' }
+            $m = $report.milestones
+            $processRecord.launch_to_bootstrap_start_ms = $bootstrap[0].start.unix_ms - $processRecord.launch_unix_ms
+            $processRecord.launch_to_title_drawn_ms = $m.title_drawn_usable.unix_ms - $processRecord.launch_unix_ms
+            $processRecord.new_acc_to_caption_complete_ms = ($m.caption_complete_drawn_idle.ticks_us - $m.new_acc_input.ticks_us) / 1000.0
+            $processRecord.rendering = $report.rendering
+            $processRecord.user_path = $report.user_path
+            if ($case -eq 'retained') {
+                $processRecord.input_to_consent_ms = ($m.consent_drawn.ticks_us - $m.new_acc_input.ticks_us) / 1000.0
+                $processRecord.consent_dwell_ms = ($m.confirm_input.ticks_us - $m.consent_drawn.ticks_us) / 1000.0
+                $processRecord.confirm_to_caption_complete_ms = ($m.caption_complete_drawn_idle.ticks_us - $m.confirm_input.ticks_us) / 1000.0
+            }
+            $processRecord.images = @(Get-ChildItem -LiteralPath $caseOutput -Filter '*.png' | ForEach-Object {
+                @{ name = $_.Name; size = $_.Length; sha256 = (Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash.ToLowerInvariant() }
+            })
+            $expectedImages = if ($case -eq 'fresh') { 2 } else { 3 }
+            if ($processRecord.images.Count -ne $expectedImages) { throw 'Missing milestone screenshots.' }
+        } finally {
+            if ($null -ne $process) { $process.Dispose() }
+        }
+    }
+    if ($record.processes[0].user_path -ne $record.processes[1].user_path) { throw 'Processes did not share a user profile.' }
+    $record.status = 'collected_requires_attribution_and_visual_review'
+} finally {
+    $record | ConvertTo-Json -Depth 40 | Set-Content -LiteralPath (Join-Path $output 'processes.json') -Encoding utf8
+}
+Write-Host ('STARTUP_NEW_ACC_COLLECTION ' + ($record | ConvertTo-Json -Depth 40 -Compress))
