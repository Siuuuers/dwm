@@ -58,0 +59,30 @@
+
+func test_successful_prepare_detaches_candidate_from_nested_checkpoint_input() -> void:
+	var wired: Dictionary = fixture._wired()
+	var input: Dictionary = _inputs(wired, 301)
+	var expected: Dictionary = input.duplicate(true)
+	var prepared: Dictionary = wired.port.prepare(input, &"post_result",
+		{"kind": &"autosave", "reason": &"automatic"})
+	assert_true(prepared.get("ok", false), str(prepared))
+	assert_eq(input, expected, "successful preparation is read-only over its source input")
+	if not prepared.get("ok", false): return
+	var candidate: Dictionary = prepared.value.candidate
+	var snapshot: Dictionary = candidate.autosave_document.current_snapshot.snapshot
+	snapshot.gameplay.money = 999
+	snapshot.applied_effect_transaction_ids.append("effect.alias.probe")
+	snapshot.contacts["alias_probe"] = {"nested": ["candidate-only"]}
+	assert_eq(input, expected,
+		"mutating nested prepared output cannot reach gameplay, arrays, or Contacts in the input")
+
+
+func test_prepare_read_refusal_leaves_nested_checkpoint_input_unchanged() -> void:
+	var wired: Dictionary = _saved()
+	var input: Dictionary = _inputs(wired, 302)
+	var expected: Dictionary = input.duplicate(true)
+	wired.files.fail_after(wired.files.operation_count() + 1)
+	var refused: Dictionary = wired.port.prepare(input, &"post_result",
+		{"kind": &"autosave", "reason": &"automatic"})
+	assert_false(refused.get("ok", true))
+	assert_eq(refused.get("code"), &"reconcile_required", str(refused))
+	assert_eq(input, expected, "a real storage refusal cannot mutate any checkpoint-input branch")
+
