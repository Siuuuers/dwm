{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "desktop-identity-issuer-boundary",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"owner_beads_id",
		"boundary_subject",
		"boundary_commit",
		"issuer_path",
		"issuer_sha256",
		"root_store_path",
		"root_store_sha256",
		"day_advance_identity_port_path",
		"day_advance_identity_port_sha256",
		"operation_journal_path",
		"operation_journal_sha256",
		"data_catalog_path",
		"data_catalog_sha256",
		"schedule_registry_path",
		"schedule_registry_sha256",
		"shop_registry_path",
		"shop_registry_sha256",
		"public_surface_sha256",
		"root_store_public_surface_sha256",
		"day_advance_identity_port_public_surface_sha256",
		"focused_log_path",
		"focused_log_sha256"
	],
	"properties": {
		"schema_version": {"const": 1},
		"owner_beads_id": {"const": "dwm-p2r.16"},
		"boundary_subject": {"const": "feat(desktop): bind production identity issuance and catalog projections"},
		"boundary_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
		"issuer_path": {"const": "scripts/application/desktop/DesktopIdentityNonceIssuer.gd"},
		"issuer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
		"root_store_path": {"const": "scripts/infrastructure/identity/DesktopIssuerRootStore.gd"},
		"root_store_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
		"day_advance_identity_port_path": {"const": "scripts/application/run/CausalDayAdvanceIdentityPort.gd"},
		"day_advance_identity_port_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
		"operation_journal_path": {"const": "scripts/infrastructure/save/DesktopContinuationOperationJournal.gd"},
		"operation_journal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
		"data_catalog_path": {"const": "scripts/data/DataCatalog.gd"},
		"data_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
		"schedule_registry_path": {"const": "scripts/domain/schedule/ScheduleActionRegistry.gd"},
		"schedule_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
		"shop_registry_path": {"const": "scripts/domain/shop/MinesweeperShopRegistry.gd"},
		"shop_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
		"public_surface_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
		"root_store_public_surface_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
		"day_advance_identity_port_public_surface_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
		"focused_log_path": {"const": "evidence/phase_2r/logs/p2r16-identity-catalog-green.log"},
		"focused_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
	}
}
