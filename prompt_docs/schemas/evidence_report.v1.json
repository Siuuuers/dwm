{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 2R evidence report v1",
  "type": "object",
  "required": ["schema_version", "evidence_id", "kind", "immutable", "captured_at_utc", "worktree", "versions", "external_tools", "counts", "source_archive", "preserved_outside_authority", "legacy_heading_inventory", "commands", "archived_logs", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "const": "baseline"},
    "immutable": {"type": "boolean", "const": true},
    "captured_at_utc": {"type": "string", "minLength": 1},
    "worktree": {
      "type": "object",
      "required": ["commit", "status_porcelain_utf8", "status_porcelain_base64", "status_sha256"],
      "additionalProperties": false,
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"},
        "status_porcelain_utf8": {"type": "string"},
        "status_porcelain_base64": {"type": "string"},
        "status_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "versions": {
      "type": "object",
      "required": ["godot", "dialogic", "gut", "beads", "rg"],
      "additionalProperties": false,
      "properties": {
        "godot": {"type": "string", "minLength": 1},
        "dialogic": {"type": "string", "minLength": 1},
        "gut": {"type": "string", "minLength": 1},
        "beads": {"type": "string", "minLength": 1},
        "rg": {"type": "string", "minLength": 1}
      }
    },
    "external_tools": {
      "type": "object",
      "required": ["codegraph_command"],
      "additionalProperties": false,
      "properties": {
        "codegraph_command": {
          "type": "object",
          "required": ["resolved_path", "sha256", "version"],
          "additionalProperties": false,
          "properties": {
            "resolved_path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "version": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["game_state_lines", "english_timelines", "timeline_todo_markers", "timelines_with_todo"],
      "additionalProperties": false,
      "properties": {
        "game_state_lines": {"type": "integer", "minimum": 0},
        "english_timelines": {"type": "integer", "minimum": 0},
        "timeline_todo_markers": {"type": "integer", "minimum": 0},
        "timelines_with_todo": {"type": "integer", "minimum": 0}
      }
    },
    "source_archive": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["path", "git_blob_id_or_null", "byte_length", "sha256", "utf8_valid", "content_utf8", "content_base64", "working_tree_patch_utf8", "working_tree_patch_base64", "working_tree_patch_sha256"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "git_blob_id_or_null": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"},
          "byte_length": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "utf8_valid": {"type": "boolean", "const": true},
          "content_utf8": {"type": "string"},
          "content_base64": {"type": "string"},
          "working_tree_patch_utf8": {"type": "string"},
          "working_tree_patch_base64": {"type": "string"},
          "working_tree_patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "preserved_outside_authority": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "byte_length", "sha256", "content_base64"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "byte_length": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "content_base64": {"type": "string"}
        }
      }
    },
    "legacy_heading_inventory": {
      "type": "object",
      "required": ["path", "sha256", "heading_count", "document_count"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "const": "evidence/phase_2r/legacy/legacy_heading_inventory.v1.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "heading_count": {"type": "integer", "minimum": 0},
        "document_count": {"type": "integer", "const": 12}
      }
    },
    "commands": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["suite_id", "argv", "exit_code", "log_path", "test_root", "user_dir", "started_at_utc", "ended_at_utc"],
        "additionalProperties": false,
        "properties": {
          "suite_id": {"type": "string", "enum": ["baseline-import", "baseline-existing-gut", "baseline-existing-scenes"]},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
          "log_path": {"type": "string", "minLength": 1},
          "test_root": {"type": "string", "minLength": 1},
          "user_dir": {"type": "string", "minLength": 1},
          "started_at_utc": {"type": "string", "minLength": 1},
          "ended_at_utc": {"type": "string", "minLength": 1}
        }
      }
    },
    "archived_logs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["suite_id", "source_log_path", "evidence_log_path", "sha256", "byte_length"],
        "additionalProperties": false,
        "properties": {
          "suite_id": {"type": "string", "enum": ["baseline-import", "baseline-existing-gut", "baseline-existing-scenes"]},
          "source_log_path": {"type": "string", "minLength": 1},
          "evidence_log_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_length": {"type": "integer", "minimum": 0}
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["suite_id", "exit_code", "log_sha256"],
        "additionalProperties": false,
        "properties": {
          "suite_id": {"type": "string", "enum": ["baseline-existing-gut", "baseline-existing-scenes"]},
          "exit_code": {"type": "integer", "minimum": 1, "maximum": 255},
          "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
