{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 2R Beads execution contract",
  "type": "object",
  "required": ["schema_version", "spec_id", "metadata_namespace", "forbidden_top_level_metadata_keys", "execution_spine", "child_contracts", "deferred_decision_contract"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "spec_id": {"const": "spec.phase_2r.foundation_repair"},
    "metadata_namespace": {"const": "phase2r"},
    "forbidden_top_level_metadata_keys": {
      "const": ["scope", "exclusions", "evidence_links", "requirement_ids", "verification_commands"]
    },
    "execution_spine": {
      "type": "object",
      "required": ["ranked_issue_ids", "node_contracts"],
      "additionalProperties": false,
      "properties": {
        "ranked_issue_ids": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^dwm-(?:p2r\\.[0-9]+|wks)$"}
        },
        "node_contracts": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["issue_id", "expected_issue_type", "expected_priority", "allowed_statuses", "expected_blockers", "expected_contract_sha256"],
            "additionalProperties": false,
            "properties": {
              "issue_id": {"type": "string", "pattern": "^dwm-(?:p2r\\.[0-9]+|wks)$"},
              "expected_issue_type": {"enum": ["task", "chore", "feature"]},
              "expected_priority": {"type": "integer", "minimum": 0},
              "allowed_statuses": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["open", "in_progress", "closed"]}
              },
              "expected_blockers": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^dwm-[a-z0-9.-]+$"}
              },
              "expected_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "child_contracts": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["issue_id", "plan_path", "expected_spec_id", "expected_labels", "expected_metadata"],
        "additionalProperties": false,
        "properties": {
          "issue_id": {"type": "string", "pattern": "^dwm-(?:p2r\\.[0-9]+|wks)$"},
          "plan_path": {"type": "string", "pattern": "^docs/superpowers/plans/[^/]+\\.md$"},
          "expected_spec_id": {"type": "string", "pattern": "^spec\\.[a-z0-9_.]+$"},
          "expected_labels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "expected_metadata": {
            "type": "object",
            "required": ["scope", "exclusions", "evidence_links", "requirement_ids", "verification_commands"],
            "additionalProperties": false,
            "properties": {
              "scope": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "exclusions": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "evidence_links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["command_record_id", "path", "requirement_id", "sha256"],
                  "additionalProperties": false,
                  "properties": {
                    "command_record_id": {"type": "string", "minLength": 1},
                    "path": {"type": "string", "minLength": 1},
                    "requirement_id": {"type": "string", "pattern": "^req\\.[a-z0-9_.]+$"},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  }
                }
              },
              "requirement_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^req\\.[a-z0-9_.]+$"}
              },
              "verification_commands": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "deferred_decision_contract": {
      "type": "object",
      "required": [
        "issue_id",
        "title",
        "description",
        "acceptance_criteria",
        "expected_spec_id",
        "expected_status",
        "expected_priority",
        "expected_issue_type",
        "expected_labels",
        "expected_dependencies",
        "expected_blocking_dependency_count",
        "expected_dependent_count"
      ],
      "additionalProperties": false,
      "properties": {
        "issue_id": {"const": "dwm-eob"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "acceptance_criteria": {"type": "string", "minLength": 1},
        "expected_spec_id": {"const": "spec.phase_2r.foundation_repair"},
        "expected_status": {"const": "open"},
        "expected_priority": {"type": "integer"},
        "expected_issue_type": {"const": "decision"},
        "expected_labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["issue_id", "dependency_type"],
            "additionalProperties": false,
            "properties": {
              "issue_id": {"type": "string", "minLength": 1},
              "dependency_type": {"enum": ["blocks", "discovered-from", "related"]}
            }
          }
        },
        "expected_blocking_dependency_count": {"type": "integer"},
        "expected_dependent_count": {"type": "integer"}
      }
    }
  }
}
