extends GutTest
const FIXTURE := preload("res://tests/support/DialogueLibraryFixture.gd")
const CATALOGUE := preload("res://scripts/narrative/DialogueLibraryCatalogue.gd")
const PROFILE := preload("res://autoload/ProfileManager.gd")
const STORAGE := preload("res://scripts/infrastructure/storage/JsonFileStorage.gd")

func test_fresh_process_retains_discoveries_and_library_reset_is_durable() -> void:
	assert_false(OS.get_environment("DWM_TEST_ROOT").is_empty())
	assert_true(FIXTURE.install().ok)
	var path := ProjectSettings.globalize_path("user://TEST.dialogue-library-process")
	assert_true(FileAccess.file_exists(path + "/profile.json"), "creator process must have persisted this profile")
	var profile: Node = autofree(PROFILE.new())
	assert_true(profile.initialize(STORAGE.new(path)).ok)
	assert_eq(profile.get_dialogue_library(), FIXTURE.discovery())
	var before := FileAccess.get_file_as_bytes(path + "/profile.json")
	var rows: Array = CATALOGUE.reached_passages(profile.get_dialogue_library())
	assert_eq(rows.size(), 1)
	assert_eq(FileAccess.get_file_as_bytes(path + "/profile.json"), before)
	assert_true(profile.reset_dialogue_library().ok)
	var restarted: Node = autofree(PROFILE.new())
	assert_true(restarted.initialize(STORAGE.new(path)).ok)
	assert_eq(restarted.get_dialogue_library(), {"checkpoints": [], "witnesses": {}})
	assert_true(restarted.is_caption_variant_witnessed(FIXTURE.beat()))
	assert_true(CATALOGUE.configure([], [], {}).ok)
