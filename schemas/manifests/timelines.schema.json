{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "locale", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "locale": {"const": "en"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "locale", "path", "content_status", "content_fingerprint",
          "labels", "lines", "markers", "effect_ids", "variable_ids",
          "route_ids", "ending_ids", "events"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "locale": {"const": "en"},
          "path": {"type": "string", "minLength": 1},
          "content_status": {"enum": ["placeholder", "draft", "approved", "final"]},
          "content_fingerprint": {"type": "string", "minLength": 1},
          "labels": {"type": "array", "items": {"type": "string"}},
          "lines": {"type": "array"},
          "markers": {"type": "array"},
          "effect_ids": {"type": "array", "items": {"type": "string"}},
          "variable_ids": {"type": "array", "items": {"type": "string"}},
          "route_ids": {"type": "array", "items": {"type": "string"}},
          "ending_ids": {"type": "array", "items": {"type": "string"}},
          "events": {"type": "array"}
        }
      }
    }
  }
}
