diff --git a/tests/support/SceneFirstRevealConnectedFixture.gd b/tests/support/SceneFirstRevealConnectedFixture.gd
new file mode 100644
index 00000000..9c8fb2f4
--- /dev/null
+++ b/tests/support/SceneFirstRevealConnectedFixture.gd
@@ -0,0 +1,58 @@
+extends "res://tests/support/ScenePlayableFixture.gd"
+## Real Profile, generation, physical owner, GameState, native Bridge and Save owners.
+## Parent supplies TEST-authored content and diagnostic ancillary restore participants.
+const PHYSICAL := preload("res://scripts/application/run/DatingPhysicalOwner.gd")
+const GENERATION := preload("res://scripts/application/minesweeper/MinesweeperBoardGenerationPort.gd")
+const ATTEMPTS := preload("res://scripts/profile/DatingAttemptLedger.gd")
+class ProfileWriteRefusal extends WriteRefusal:
+	var refuse_profile := false
+	var profile_refusals := 0
+	func write_bytes(path: String, bytes: PackedByteArray) -> Dictionary:
+		if refuse_profile and path.replace("\\", "/").ends_with("/profile.json.next"):
+			refuse_profile = false
+			profile_refusals += 1
+			return {"ok": false, "code": &"TEST.profile_write_refused", "message": path}
+		return super.write_bytes(path, bytes)
+var physical: RefCounted
+var challenge_command: Dictionary = {}
+var challenge_token := ""
+
+func setup_connected(scene_tree: SceneTree) -> Dictionary:
+	var checked: Dictionary = await setup_playable(scene_tree)
+	if not checked.ok: return checked
+	files = ProfileWriteRefusal.new()
+	storage._file_ops = files
+	checked = game.configure_scene_challenge_runtime()
+	if not checked.ok: return checked
+	physical = PHYSICAL.new()
+	checked = physical.configure(issuer, game, profile, GENERATION.new())
+	if checked.ok: checked = physical.configure_attempt_history(gate)
+	if checked.ok: checked = game.configure_dating_restore_reconciler(Callable(physical, "reconcile_restore_silent"))
+	return checked
+
+func admit_challenge() -> Dictionary:
+	var captured: Dictionary = game.capture_scene_challenge_command()
+	if not captured.get("ok", false): return captured
+	var bound: Dictionary = physical.configure_scene_challenges(captured.value.bundle, game)
+	if not bound.get("ok", false): return bound
+	challenge_command = captured.value.command.duplicate(true)
+	var begun: Dictionary = physical.begin_physical(challenge_command)
+	if begun.get("ok", false): challenge_token = begun.value.physical_token
+	return begun
+
+func reveal() -> Dictionary:
+	return physical.dispatch_scene_panel_action(challenge_token, "reveal", 323, 0)
+
+func panel() -> Dictionary:
+	return physical.pull_scene_panel(challenge_token)
+
+func challenge_record() -> Dictionary:
+	return game.capture_dating_challenge_state().value
+
+func challenge_attempt(branch: String = "") -> Dictionary:
+	var identity: Dictionary = game.capture_run_snapshot_input().lifecycle
+	return profile.get_dating_attempt(identity.run_id, ATTEMPTS.semantic_slot(challenge_command.context), "", branch)
+
+func close_restart() -> void:
+	await super.close_restart()
+	physical = null
diff --git a/tests/support/ScenePauseLoadFixture.gd b/tests/support/ScenePauseLoadFixture.gd
new file mode 100644
index 00000000..60fdfeff
--- /dev/null
+++ b/tests/support/ScenePauseLoadFixture.gd
@@ -0,0 +1,194 @@
+extends "res://tests/support/SceneFirstRevealConnectedFixture.gd"
+## Real Pause/Backup, input/audio, native Text, Run/Profile/Save and router owners.
+## TEST-authored scene content and empty configured host remain explicit; this is
+## connected integration, not shipped panel or rendered journey acceptance.
+const INPUT_OWNER := preload("res://autoload/InputManager.gd")
+const AUDIO_OWNER := preload("res://autoload/AudioManager.gd")
+const LOCALIZATION_OWNER := preload("res://autoload/LocalizationManager.gd")
+const AUDIO_PARTICIPANT := preload("res://scripts/application/restore/AudioRestoreParticipant.gd")
+class RefuseNextWrite extends ProfileWriteRefusal:
+	var armed := false
+	var refusal_count := 0
+	var refused_path := ""
+	func write_bytes(path: String, bytes: PackedByteArray) -> Dictionary:
+		if armed and path.ends_with(".next"):
+			armed = false
+			refusal_count += 1
+			refused_path = path
+			return {"ok": false, "code": &"TEST.pause_load_write_refused", "message": path}
+		return super.write_bytes(path, bytes)
+
+var input_owner: Node
+var audio_owner: Node
+var localization_owner: Node
+var pause: Node
+var write_fault: RefuseNextWrite
+var pause_closed_count := 0
+var input_backup: Dictionary = {}
+var pending_observation: Dictionary = {}
+var diagnostic_phase := "unstarted"
+var default_style_before: Dictionary = {}
+func default_style_projection() -> Dictionary:
+	var key := "dialogic/layout/default_style"
+	return {"exists": ProjectSettings.has_setting(key), "value": ProjectSettings.get_setting(key)}
+
+static func _scalar_fields(value: Dictionary) -> Dictionary:
+	var result := {}
+	for key: Variant in value:
+		var item: Variant = value[key]
+		if typeof(item) in [TYPE_BOOL, TYPE_INT, TYPE_FLOAT, TYPE_STRING, TYPE_STRING_NAME, TYPE_NIL]:
+			result[str(key)] = item
+		elif item is Dictionary:
+			result[str(key) + "_keys"] = item.keys()
+	return result
+
+static func _transient_state(owner: Object) -> Dictionary:
+	var result := {}
+	if not is_instance_valid(owner): return {"valid": false}
+	for property: Dictionary in owner.get_property_list():
+		var key: String = str(property.name)
+		if not (key.begins_with("_scene_") or key.begins_with("_pause") or key.begins_with("_restore") \
+			or key in ["_activity_phase", "_caption_restore_queued", "_caption_restore_frontier", "_caption_seek_frontier",
+				"paused", "current_state", "current_event_idx"]): continue
+		var value: Variant = owner.get(key)
+		if value is Dictionary: result[key] = _scalar_fields(value)
+		elif typeof(value) in [TYPE_BOOL, TYPE_INT, TYPE_FLOAT, TYPE_STRING, TYPE_STRING_NAME]: result[key] = value
+	return result
+
+func diagnostic_state() -> Dictionary:
+	var result := {"fixture_phase": diagnostic_phase, "ready_count": ready_count,
+		"route_confirmations": route_confirmations.size(), "narrative_confirmations": narrative_confirmations.size(),
+		"pause_closed_count": pause_closed_count}
+	if is_instance_valid(pause):
+		result["pause"] = {"loading": pause._loading, "pending": pause._pending_scene_load,
+			"state": pause.coordinator.get_state().value.state}
+	if is_instance_valid(manager):
+		result["save_activation"] = _scalar_fields(manager._scene_restore_activation)
+		result["save_failure"] = _scalar_fields(manager._scene_restore_activation.get("failure", {}))
+	result["router"] = _transient_state(router)
+	result["bridge"] = _transient_state(bridge)
+	result["adapter"] = _transient_state(adapter)
+	result["native"] = _transient_state(runtime)
+	return result
+
+func setup_pause(scene_tree: SceneTree) -> Dictionary:
+	default_style_before = default_style_projection()
+	diagnostic_phase = "parent_setup"
+	var checked: Dictionary = await setup_connected(scene_tree)
+	if not checked.get("ok", false): return checked
+	for action: StringName in InputMap.get_actions():
+		input_backup[action] = {"deadzone": InputMap.action_get_deadzone(action),
+			"events": InputMap.action_get_events(action).duplicate(true)}
+	input_owner = INPUT_OWNER.new()
+	audio_owner = AUDIO_OWNER.new()
+	localization_owner = LOCALIZATION_OWNER.new()
+	_replace_owner("InputManager", input_owner)
+	_replace_owner("AudioManager", audio_owner)
+	_replace_owner("LocalizationManager", localization_owner)
+	checked = input_owner.initialize(profile)
+	if checked.get("ok", false): checked = input_owner.configure_mutation_gate(gate)
+	if checked.get("ok", false): checked = audio_owner.initialize(profile)
+	if checked.get("ok", false): checked = audio_owner.configure_mutation_gate(gate)
+	if checked.get("ok", false): checked = localization_owner.initialize(profile)
+	if not checked.get("ok", false): return checked
+	participants.audio = AUDIO_PARTICIPANT.new(audio_owner)
+	checked = manager.configure_scene_restore_participants(participants)
+	if not checked.get("ok", false): return checked
+	checked = router.configure_mutation_gate(gate)
+	if not checked.get("ok", false): return checked
+	# Remove the inherited manual style. Initial admission and selected Load must
+	# obtain their actual witnessed layout from the production Bridge owner.
+	var inherited_layout: Node = runtime.Styles.get_layout_node()
+	if is_instance_valid(inherited_layout):
+		diagnostic_phase = "retire_inherited_layout"
+		inherited_layout.queue_free()
+		# setup_restart resumes from this layout's ready signal; its emitter is
+		# still locked until that callback unwinds. Await actual retirement.
+		for frame: int in 4:
+			await tree.process_frame
+			if not is_instance_valid(inherited_layout): break
+		if is_instance_valid(inherited_layout):
+			return {"ok": false, "code": &"TEST.pause_inherited_style_not_retired"}
+	if runtime.Styles.has_active_layout_node():
+		return {"ok": false, "code": &"TEST.pause_inherited_style_still_active"}
+	checked = router.configure_pause_services({"game_state": game, "saves": manager,
+		"bridge": bridge, "input": input_owner, "audio": audio_owner, "gate": gate,
+		"profile": profile, "localization": localization_owner,
+		"settings_services": {"tts": null, "window": null,
+			"profile_reset_admission": func() -> bool: return false}})
+	if not checked.get("ok", false): return checked
+	pause = router._production_pause
+	if pause._find_caption(tree.root) != null:
+		return {"ok": false, "code": &"TEST.pause_caption_survived_setup"}
+	if default_style_projection() != default_style_before:
+		return {"ok": false, "code": &"TEST.pause_default_style_changed"}
+	pause.coordinator.pause_closed.connect(func() -> void: pause_closed_count += 1)
+	write_fault = RefuseNextWrite.new()
+	files = write_fault
+	storage._file_ops = write_fault
+	diagnostic_phase = "setup_complete"
+	return {"ok": true}
+
+func audio_context() -> Dictionary:
+	return audio_owner.get_semantic_audio_context()
+
+func start(nonce: Variant = null) -> Dictionary:
+	return manager.start_scene_new_run("target_b", {"audio_context": audio_context(),
+		"content_version": 1, "route_id": "scene"}, nonce)
+
+func start_text() -> Dictionary:
+	diagnostic_phase = "start_scene"
+	var started: Dictionary = start()
+	if started.get("code") != &"scene_activation_pending": return started
+	diagnostic_phase = "await_initial_activation"
+	var activated: Dictionary = await await_activation()
+	if not activated.get("ok", false): return activated
+	return manager.save_latest_to_slot(1)
+
+func settle_load() -> Dictionary:
+	for frame: int in 240:
+		if not pause._loading and pause.coordinator.get_state().value.state == &"Active":
+			return {"ok": true}
+		if not manager._scene_restore_activation.get("failure", {}).is_empty():
+			return manager._scene_restore_activation.failure.duplicate(true)
+		await tree.process_frame
+	return {"ok": false, "code": &"TEST.pause_load_timeout", "pause": pause.coordinator.get_state()}
+
+func observe_pending_load() -> void:
+	for frame: int in 240:
+		if not is_instance_valid(pause): return
+		var operation_id: String = pause._pending_scene_load
+		if not operation_id.is_empty():
+			pending_observation = {"operation_id": operation_id, "tree_paused": tree.paused,
+				"input_state": input_owner.get_state().value.state,
+				"ready_count": ready_count, "closed_count": pause_closed_count,
+				"foreign_retry": manager.retry_scene_activation("TEST.foreign_scene_restore")}
+			return
+		if ready_count > 0: return
+		await tree.process_frame
+
+func close_restart() -> void:
+	if tree == null: return
+	tree.paused = false
+	if is_instance_valid(pause): pause.free()
+	pause = null
+	await super.close_restart()
+	var audio_runtime: Node = audio_owner._playback_port._root if is_instance_valid(audio_owner) \
+		and audio_owner._playback_port != null else null
+	for owner: Node in [input_owner, audio_owner, localization_owner]:
+		if is_instance_valid(owner): owner.free()
+	if is_instance_valid(audio_runtime): audio_runtime.free()
+	for name: String in ["InputManager", "AudioManager", "LocalizationManager"]:
+		if not original_owners.has(name): continue
+		var original: Node = original_owners[name].node
+		if is_instance_valid(original) and original.get_parent() == null:
+			tree.root.add_child(original)
+			tree.root.move_child(original, mini(original_owners[name].index, tree.root.get_child_count() - 1))
+	if not input_backup.is_empty():
+		for action: StringName in InputMap.get_actions():
+			if not input_backup.has(action): InputMap.erase_action(action)
+		for action: StringName in input_backup:
+			if not InputMap.has_action(action): InputMap.add_action(action, input_backup[action].deadzone)
+			InputMap.action_set_deadzone(action, input_backup[action].deadzone)
+			InputMap.action_erase_events(action)
+			for event: InputEvent in input_backup[action].events: InputMap.action_add_event(action, event)
diff --git a/tests/support/ScenePauseLoadTestBase.gd b/tests/support/ScenePauseLoadTestBase.gd
new file mode 100644
index 00000000..062ee9d0
--- /dev/null
+++ b/tests/support/ScenePauseLoadTestBase.gd
@@ -0,0 +1,216 @@
+extends "res://addons/gut/test.gd"
+## One case per fresh Godot process: registration and issuer authority are immutable.
+## Connected Text Pause -> selected schema-5 Load. No fake positive native,
+## restore, route, suspension, Profile or Run acknowledgement is supplied.
+const FIXTURE := preload("res://tests/support/ScenePauseLoadFixture.gd")
+const WITNESSED_CAPTION := preload("res://scripts/ui/witnessed/WitnessedCaptionLayer.gd")
+var fixture: RefCounted
+var fixture_ready := false
+var prior_root := ""
+var sequence := 0
+var _watchdog: Timer
+var _watch_finished := false
+var _test_stage := "before_setup"
+var _watch_started := 0
+
+func _on_test_timeout() -> void:
+	if _watch_finished: return
+	var state := {"stage": _test_stage, "elapsed_ms": Time.get_ticks_msec() - _watch_started,
+		"tree_paused": get_tree().paused}
+	if fixture != null: state["owners"] = fixture.diagnostic_state()
+	print("DWM_PAUSE_TEST_TIMEOUT " + JSON.stringify(state))
+	get_tree().quit(1)
+
+func before_each() -> void:
+	process_mode = Node.PROCESS_MODE_ALWAYS
+	_watch_finished = false
+	_watch_started = Time.get_ticks_msec()
+	_test_stage = "setup"
+	_watchdog = Timer.new()
+	_watchdog.process_mode = Node.PROCESS_MODE_ALWAYS
+	_watchdog.one_shot = true
+	_watchdog.wait_time = 30.0
+	add_child(_watchdog)
+	_watchdog.timeout.connect(_on_test_timeout)
+	_watchdog.start()
+	prior_root = OS.get_environment("DWM_TEST_ROOT")
+	sequence += 1
+	if prior_root.is_empty():
+		assert_false(prior_root.is_empty(), "cloud wrapper must isolate test storage")
+		return
+	OS.set_environment("DWM_TEST_ROOT", prior_root.path_join("scene_pause_%d" % sequence))
+	fixture = FIXTURE.new()
+	var checked: Dictionary = await fixture.setup_pause(get_tree())
+	fixture_ready = checked.get("ok", false)
+	assert_true(fixture_ready, str(checked))
+	if fixture_ready:
+		assert_false(fixture.runtime.Styles.has_active_layout_node(), "initial activation starts without a preinstalled layout")
+		assert_eq(fixture.default_style_projection(), fixture.default_style_before)
+
+func after_each() -> void:
+	_test_stage = "cleanup"
+	if fixture_ready: assert_eq(fixture.default_style_projection(), fixture.default_style_before,
+		"scene activation must not change the global default style")
+	if fixture != null: await fixture.close_restart()
+	fixture = null
+	fixture_ready = false
+	OS.set_environment("DWM_TEST_ROOT", prior_root)
+	_watch_finished = true
+	if is_instance_valid(_watchdog):
+		_watchdog.stop()
+		_watchdog.queue_free()
+
+func _ok(result: Dictionary) -> bool:
+	assert_true(result.get("ok", false), str(result))
+	return result.get("ok", false)
+
+func _witnessed_caption(phase: String) -> bool:
+	var caption: Node = fixture.pause._find_caption(get_tree().root)
+	assert_true(is_instance_valid(caption), phase + " publishes the genuine witnessed caption")
+	if not is_instance_valid(caption): return false
+	assert_eq(caption.get_script(), WITNESSED_CAPTION)
+	assert_eq(caption.get_viewport(), get_tree().root)
+	assert_eq(fixture.default_style_projection(), fixture.default_style_before)
+	return caption.get_script() == WITNESSED_CAPTION and caption.get_viewport() == get_tree().root
+
+func happy_load(quick: bool) -> void:
+	_test_stage = "start_text"
+	if not fixture_ready or not _ok(await fixture.start_text()): return
+	if not _witnessed_caption("source"): return
+	if quick and not _ok(fixture.manager.quick_save_latest()): return
+	var source: Dictionary = fixture.game.capture_run_snapshot_input().duplicate(true)
+	var profile_before: Dictionary = fixture.profile_bytes()
+	var selected: Dictionary = fixture.manager.get_latest_stable_checkpoint()
+	if not _ok(selected): return
+	var checkpoint: Dictionary = selected.value.bundle.snapshot.narrative_checkpoint.duplicate(true)
+	assert_eq(checkpoint.reading_session.schema_version, 5)
+	assert_eq(checkpoint.reading_session.boundary, "line")
+	_test_stage = "pause_source"
+	if not _ok(await fixture.pause.request_pause()): return
+	assert_true(get_tree().paused)
+	assert_eq(fixture.pause.coordinator.get_state().value.state, &"Suspended")
+	assert_eq(fixture.input_owner.get_state().value.state, &"Suspended")
+	assert_eq(fixture.audio_owner.get_state().value.state, &"Suspended")
+	var old_handle: Dictionary = fixture.pause._handle.duplicate(true)
+	var prepared: Dictionary = fixture.pause._backup_port.prepare_quick_action("load") if quick \
+		else fixture.pause._backup_port.prepare_action("load", "slot:1")
+	if not _ok(prepared): return
+	var token: String = prepared.value.token
+	fixture.ready_count = 0
+	var routes: int = fixture.route_confirmations.size()
+	var narratives: int = fixture.narrative_confirmations.size()
+	fixture.call_deferred("observe_pending_load")
+	_test_stage = "commit_quick_load" if quick else "commit_slot_load"
+	var committed: Dictionary = await fixture.pause._backup_port.commit_action(token)
+	if not _ok(committed): return
+	_test_stage = "settle_load"
+	if not _ok(await fixture.settle_load()): return
+	if not _witnessed_caption("destination"): return
+	assert_eq(fixture.ready_count, 1, "one real destination readiness publication")
+	assert_eq(fixture.route_confirmations.size(), routes + 1)
+	assert_eq(fixture.narrative_confirmations.size(), narratives + 1)
+	assert_eq(fixture.pause_closed_count, 1)
+	assert_false(fixture.pending_observation.is_empty(), "real asynchronous activation retains operation identity")
+	if not fixture.pending_observation.is_empty():
+		assert_true(fixture.pending_observation.tree_paused)
+		assert_eq(fixture.pending_observation.input_state, &"Suspended")
+		assert_eq(fixture.pending_observation.ready_count, 0)
+		assert_eq(fixture.pending_observation.closed_count, 0)
+		assert_false(fixture.pending_observation.foreign_retry.get("ok", false))
+	assert_false(get_tree().paused)
+	assert_eq(fixture.pause.coordinator.get_state().value.state, &"Active")
+	assert_eq(fixture.input_owner.get_state().value.state, &"Active")
+	assert_eq(fixture.audio_owner.get_state().value.state, &"Active")
+	assert_eq(fixture.bridge.get_state().value.state, &"Active")
+	assert_false(fixture.router.is_restore_publication_held())
+	assert_false(fixture.pause._loading)
+	assert_false(fixture.pause.surface.visible)
+	var destination: Dictionary = fixture.game.capture_run_snapshot_input()
+	assert_ne(destination.lifecycle.branch_id, source.lifecycle.branch_id)
+	assert_eq(fixture.bridge._reading_session.boundary, "line")
+	var restored_checkpoint: Dictionary = fixture.bridge.capture_reading_checkpoint(false)
+	if not _ok(restored_checkpoint): return
+	assert_eq(restored_checkpoint.value.reading_session.entry_id, checkpoint.reading_session.entry_id)
+	assert_eq(restored_checkpoint.value.reading_session.program_index, checkpoint.reading_session.program_index)
+	assert_eq(fixture.profile_bytes(), profile_before, "Load and publication never repeat Profile consequences")
+	assert_eq(fixture.native_markers, [], "no source challenge marker is replayed")
+	assert_eq(fixture.challenge_record(), {})
+	assert_eq(destination.command_receipts, source.command_receipts, "selected Load does not replay scene effects")
+	var after: Dictionary = destination.duplicate(true)
+	_test_stage = "duplicate_consent"
+	var duplicate: Dictionary = await fixture.pause._backup_port.commit_action(token)
+	assert_false(duplicate.get("ok", false), "consumed consent cannot Load twice")
+	for frame: int in 8: await get_tree().process_frame
+	assert_eq(fixture.ready_count, 1)
+	assert_eq(fixture.pause_closed_count, 1)
+	assert_eq(fixture.game.capture_run_snapshot_input(), after)
+	assert_eq(fixture.profile_bytes(), profile_before)
+	if not quick: return
+	# A completed old handle must never retire a newly suspended real native source,
+	# including when the caller legitimately owns a later restore lease.
+	_test_stage = "pause_destination"
+	if not _ok(await fixture.pause.request_pause()): return
+	var newer_handle: Dictionary = fixture.pause._handle.duplicate(true)
+	assert_ne(newer_handle, old_handle)
+	var frontier: Dictionary = fixture.bridge.capture_pause_frontier()
+	if not _ok(frontier): return
+	var lease: Dictionary = fixture.gate.acquire(&"restore")
+	if not _ok(lease): return
+	_test_stage = "refuse_old_handle"
+	var stale: Dictionary = await fixture.bridge.complete_pause_restore(old_handle)
+	fixture.gate.release(&"restore", lease.value.token)
+	assert_false(stale.get("ok", false), "old completion cannot consume a new native pause")
+	assert_eq(fixture.pause._handle, newer_handle)
+	assert_eq(fixture.bridge.capture_pause_frontier(), frontier)
+	assert_eq(fixture.pause.coordinator.get_state().value.state, &"Suspended")
+	assert_true(get_tree().paused)
+	_test_stage = "continue_destination"
+	if not _ok(await fixture.pause.request_continue()): return
+	assert_false(get_tree().paused)
+	assert_eq(fixture.game.capture_run_snapshot_input(), after)
+	assert_eq(fixture.profile_bytes(), profile_before)
+
+func refused_load() -> void:
+	_test_stage = "start_text"
+	if not fixture_ready or not _ok(await fixture.start_text()): return
+	if not _witnessed_caption("source"): return
+	_test_stage = "pause_source"
+	if not _ok(await fixture.pause.request_pause()): return
+	var source: Dictionary = fixture.game.capture_run_snapshot_input().duplicate(true)
+	var session: Dictionary = fixture.game.capture_live_session().value.duplicate(true)
+	var profile_before: Dictionary = fixture.profile_bytes()
+	var frontier: Dictionary = fixture.bridge.capture_pause_frontier()
+	if not _ok(frontier): return
+	var handle: Dictionary = fixture.pause._handle.duplicate(true)
+	var prepared: Dictionary = fixture.pause._backup_port.prepare_action("load", "slot:1")
+	if not _ok(prepared): return
+	fixture.ready_count = 0
+	fixture.write_fault.armed = true
+	_test_stage = "commit_write_refusal"
+	var refused: Dictionary = await fixture.pause._backup_port.commit_action(prepared.value.token)
+	assert_false(refused.get("ok", false), str(refused))
+	assert_eq(fixture.write_fault.refusal_count, 1, fixture.write_fault.refused_path)
+	assert_false(refused.get("committed", false), "failure precedes destination ownership")
+	assert_true(get_tree().paused)
+	assert_eq(fixture.pause.coordinator.get_state().value.state, &"Suspended")
+	assert_eq(fixture.pause._handle, handle)
+	assert_false(fixture.pause._loading)
+	assert_eq(fixture.ready_count, 0)
+	assert_eq(fixture.pause_closed_count, 0)
+	assert_eq(fixture.game.capture_live_session().value, session)
+	assert_eq(fixture.game.capture_run_snapshot_input(), source)
+	assert_eq(fixture.profile_bytes(), profile_before)
+	assert_eq(fixture.bridge.capture_pause_frontier(), frontier)
+	assert_eq(fixture.input_owner.get_state().value.state, &"Suspended")
+	assert_eq(fixture.audio_owner.get_state().value.state, &"Suspended")
+	assert_false(fixture.router.is_restore_publication_held())
+	_test_stage = "continue_refused_source"
+	if not _ok(await fixture.pause.request_continue()): return
+	assert_false(get_tree().paused)
+	assert_eq(fixture.pause_closed_count, 1)
+	assert_eq(fixture.input_owner.get_state().value.state, &"Active")
+	assert_eq(fixture.audio_owner.get_state().value.state, &"Active")
+	assert_eq(fixture.bridge.get_state().value.state, &"Active")
+	assert_eq(fixture.game.capture_run_snapshot_input(), source)
+	assert_eq(fixture.profile_bytes(), profile_before)
+	assert_eq(fixture.native_markers, [])
