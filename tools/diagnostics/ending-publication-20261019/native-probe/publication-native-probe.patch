+	}
+
+	~PublicationProbe() {
+		if (!stopped) {
+			Dictionary row;
+			row["event"] = "session_end";
+			row["complete"] = current.is_empty();
+			row["updates"] = int64_t(update_seq);
+			row["open_windows"] = int64_t(epochs.size());
